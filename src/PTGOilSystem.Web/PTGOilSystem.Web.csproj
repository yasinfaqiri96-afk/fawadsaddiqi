  <!-- A Debug publish with NoBuild=true may reuse a manifest made without bundles.
       Explicit publish items keep those generated files in the final output. -->
  <Target Name="IncludeProductionBundlesInPublish" AfterTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildCssBundles">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
          Condition="'%(ResolvedFileToPublish.RelativePath)' == 'wwwroot/css/ptg-core.bundle.css' Or '%(ResolvedFileToPublish.RelativePath)' == 'wwwroot/css/ptg-app.bundle.css' Or '%(ResolvedFileToPublish.RelativePath)' == 'wwwroot/js/ptg-core.bundle.js'" />
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/wwwroot/css/ptg-core.bundle.css"
          RelativePath="wwwroot/css/ptg-core.bundle.css" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/wwwroot/css/ptg-app.bundle.css"
          RelativePath="wwwroot/css/ptg-app.bundle.css" CopyToPublishDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(MSBuildProjectDirectory)/wwwroot/js/ptg-core.bundle.js"
          RelativePath="wwwroot/js/ptg-core.bundle.js" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
