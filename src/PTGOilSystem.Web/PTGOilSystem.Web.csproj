  <!-- ===================================================================
       باندل CSS: همان فایل‌های css/ptg با همان ترتیب _Layout در دو بستهٔ
       ثابت جمع می‌شوند تا در محیط غیرتوسعه به‌جای ۳۵ درخواست، دو درخواست
       ارسال شود. فایل‌های منبع دست‌نخورده می‌مانند و در Development
       جداگانه لود می‌شوند. کامنت‌ها و فاصله‌های اضافی حذف می‌شود.
       =================================================================== -->
  <UsingTask TaskName="BundleCss" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var sb = new System.Text.StringBuilder();
        var lf = ((char)10).ToString();
        foreach (var item in Sources)
        {
            var path = item.GetMetadata("FullPath");
            if (!System.IO.File.Exists(path)) { continue; }
            var raw = System.IO.File.ReadAllText(path);
            // strip /* ... */ comments
            var noComment = new System.Text.StringBuilder(raw.Length);
            for (int i = 0; i < raw.Length; i++)
            {
                if (raw[i] == (char)47 && i + 1 < raw.Length && raw[i + 1] == (char)42)
                {
                    int end = raw.IndexOf("*/", i + 2, System.StringComparison.Ordinal);
                    if (end < 0) { i = raw.Length; break; }
                    i = end + 1;
                    continue;
                }
                noComment.Append(raw[i]);
            }
            // collapse blank lines and trim each line
            var outSb = new System.Text.StringBuilder(noComment.Length);
            foreach (var line in noComment.ToString().Split((char)10))
            {
                var t = line.Trim();
                if (t.Length == 0) { continue; }
                outSb.Append(t).Append(lf);
            }
            sb.Append("/* ").Append(System.IO.Path.GetFileName(path)).Append(" */").Append(lf);
            sb.Append(outSb.ToString());
        }
        var text = sb.ToString();
        var existing = System.IO.File.Exists(Output) ? System.IO.File.ReadAllText(Output) : null;
        if (existing != text) { System.IO.File.WriteAllText(Output, text, new System.Text.UTF8Encoding(false)); }
      ]]></Code>
    </Task>
  </UsingTask>

  <!-- ===================================================================
       باندل JS: همان فایل‌های پایهٔ shell با همان ترتیب _Layout در یک بسته
       جمع می‌شوند تا در محیط غیرتوسعه به‌جای ۱۹ درخواست، یک درخواست ارسال
       شود. فایل‌ها بدون هیچ تغییری پشت‌سرهم می‌آیند (هر فایل خودش داخل یک
       IIFE و در صورت نیاز 'use strict' دارد)، پس رفتار اسکریپت‌ها عوض نمی‌شود.
       منابع دست‌نخورده می‌مانند و در Development جداگانه لود می‌شوند.
       =================================================================== -->
  <UsingTask TaskName="BundleJs" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <Sources ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <Output ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var sb = new System.Text.StringBuilder();
        var lf = ((char)10).ToString();
        foreach (var item in Sources)
        {
            var path = item.GetMetadata("FullPath");
            if (!System.IO.File.Exists(path)) { continue; }
            sb.Append("/* ").Append(System.IO.Path.GetFileName(path)).Append(" */").Append(lf);
            sb.Append(System.IO.File.ReadAllText(path));
            // جداکنندهٔ امن: فایل بعدی همیشه از یک خط تازه شروع می‌شود.
            sb.Append(lf).Append(";").Append(lf);
        }
        var text = sb.ToString();
        var existing = System.IO.File.Exists(Output) ? System.IO.File.ReadAllText(Output) : null;
        if (existing != text) { System.IO.File.WriteAllText(Output, text, new System.Text.UTF8Encoding(false)); }
      ]]></Code>
    </Task>
  </UsingTask>

