@*
    ShipmentSaleForm — صفحهٔ «ثبت فروش از جریان حمل محموله / کشتی».
    فقط از Views/Sales/CreateFromShipment.cshtml استفاده می‌شود.

    این فرم دیگر پوستهٔ اختصاصی ندارد: تمام مارک‌آپ روی واژگان مشترک
    (.ak-form-page / form.ak-form / .ak-form-section / .ak-form-grid / .ak-field)
    نشسته و دیزاینش را از 76-form-system.css می‌گیرد — همان سیستمی که فرم
    «ثبت دریافت / پرداخت» مرجع آن است. فایل 91-shipment-sale-form.css حذف شد.

    بخش‌ها: ۱) عنوان  ۲) کارت‌های آماری  ۳) منبع فروش  ۴) اطلاعات فروش
            ۵) جزئیات قراردادها  ۶) خلاصهٔ زندهٔ فروش  ۷) نوار دکمه‌های پایین
*@
@model PTGOilSystem.Web.Models.Sales.ShipmentFlowSaleCreateViewModel
@using System.Globalization
@{
    var cancelUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Details", "ShipmentPnl", new { id = Model.ShipmentId });
    var baseCurrency = PTGOilSystem.Web.Services.SystemCurrency.BaseCurrencyCode;
    var shipmentTitle = string.IsNullOrWhiteSpace(Model.VesselName) ? Model.ShipmentCode : Model.VesselName;
    var mt = UiText.T(Context, "تن", "MT");
}

<div class="ak-form-page" data-shipment-sale-form dir="rtl">
    @* ۱. عنوان و توضیح صفحه — همان هدر مشترک بقیهٔ فرم‌ها *@
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "ثبت فروش از جریان حمل محموله / کشتی", "Register Sale from Shipment in Transit"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right", (string?)cancelUrl))" />

    @* ۲. چهار کارت آماری — کامپوننت مشترک stat-card *@
    <div class="ak-stat-grid" aria-label="@UiText.T(Context, "خلاصهٔ محموله", "Shipment summary")">
        <vc:stat-card title="@UiText.T(Context, "مقدار قابل فروش", "Sellable quantity")"
                      value="@Model.AvailableQuantityMt.ToString("N3")" unit="@mt" avatar="shipment-remaining"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "فروش قبلی", "Previous sales")"
                      value="@Model.PreviousSalesQuantityMt.ToString("N3")" unit="@mt" avatar="shipment-sales"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "کسری ثبت‌شده", "Registered shortage")"
                      value="@Model.RegisteredShortageQuantityMt.ToString("N3")" unit="@mt" avatar="shortage"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "بار قابل فروش در جریان", "Loaded quantity in transit")"
                      value="@Model.LoadedQuantityMt.ToString("N3")" unit="@mt" avatar="shipment-loaded"></vc:stat-card>
    </div>

    <form asp-action="CreateFromShipment" asp-controller="Sales" method="post" class="ak-form" id="shipment-flow-sale-form">
        @Html.AntiForgeryToken()
        <input asp-for="ShipmentId" type="hidden" />
        <input asp-for="ReturnUrl" type="hidden" />

        <div asp-validation-summary="All" class="alert alert-danger ak-form-alert" role="alert"></div>

        @* ۳. منبع فروش *@
        <section class="ak-form-section">
            <h2 class="ak-form-group-title">@UiText.T(Context, "۱. منبع فروش", "1. Sale Source")</h2>
            <div class="ak-form-grid">
                <div class="ak-field fec-span-3">
                    <span class="ak-label">@UiText.T(Context, "محموله / کشتی", "Shipment / Vessel")</span>
                    <input class="ak-input is-readonly" value="@shipmentTitle" readonly aria-readonly="true" />
                </div>
                <div class="ak-field fec-span-3">
                    <span class="ak-label">@UiText.T(Context, "محصول", "Product")</span>
                    <input class="ak-input is-readonly" value="@Model.ProductName" readonly aria-readonly="true" />
                </div>
                <div class="ak-field fec-span-3">
                    <span class="ak-label">@UiText.T(Context, "مرحله فعلی بار", "Current stage")</span>
                    <input class="ak-input is-readonly" value="@Model.CurrentStageName" readonly aria-readonly="true" />
                </div>
                <div class="ak-field fec-span-3">
                    <label asp-for="SaleDate" class="ak-label"></label>
                    <input asp-for="SaleDate" type="date" class="ak-input" />
                    <span asp-validation-for="SaleDate" class="field-validation-error"></span>
                </div>

                @if (Model.SourceContractRequired)
                {
                    <div class="ak-field fec-span-6">
                        <label asp-for="SourcePurchaseContractId" class="ak-label">
                            @UiText.T(Context, "قرارداد منبع بار", "Source purchase contract") <span class="ak-req">*</span>
                        </label>
                        <select asp-for="SourcePurchaseContractId" class="ak-input" data-source-contract>
                            <option value="">@UiText.T(Context, "انتخاب قرارداد منبع", "Select source contract")</option>
                            @foreach (var row in Model.Contracts)
                            {
                                <option value="@row.ContractId"
                                        data-available="@row.AvailableQuantityMt.ToString(CultureInfo.InvariantCulture)"
                                        selected="@(Model.SourcePurchaseContractId == row.ContractId)">
                                    @row.ContractNumber@(string.IsNullOrWhiteSpace(row.CompanyName) ? "" : " — جواز " + row.CompanyName) (@row.AvailableQuantityMt.ToString("N3") @mt)
                                </option>
                            }
                        </select>
                        <span asp-validation-for="SourcePurchaseContractId" class="field-validation-error"></span>
                    </div>
                }
                else
                {
                    @* فروش سهمی از همهٔ قراردادهای محموله؛ مقدار انتخاب‌شده (در محمولهٔ تک‌قراردادی) حفظ می‌شود. *@
                    <input asp-for="SourcePurchaseContractId" type="hidden" />
                }
            </div>

            <div class="ak-note">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                <span>@UiText.T(Context, "مقدار قابل فروش = بار موجود در جریان - کسری‌های ثبت‌شده - فروش‌های قبلی", "Sellable = loaded in transit − registered shortage − previous sales")</span>
                <button type="button" class="ak-btn" data-sell-all>@UiText.T(Context, "فروش کل محموله", "Sell entire shipment")</button>
            </div>
        </section>

        @* ۴. اطلاعات فروش *@
        <section class="ak-form-section">
            <h2 class="ak-form-group-title">@UiText.T(Context, "۲. اطلاعات فروش", "2. Sale Information")</h2>
            <div class="ak-form-grid">
                <div class="ak-field fec-span-4">
                    <label asp-for="BuyerKey" class="ak-label"></label>
                    <select asp-for="BuyerKey" asp-items="ViewBag.Buyers" class="ak-input">
                        <option value="">@UiText.T(Context, "انتخاب خریدار", "Select buyer")</option>
                    </select>
                    <span asp-validation-for="BuyerKey" class="field-validation-error"></span>
                </div>
                <div class="ak-field fec-span-4">
                    <label asp-for="QuantityMt" class="ak-label"></label>
                    <div class="ak-input-unit">
                        <input asp-for="QuantityMt" class="ak-input ak-num" min="0.0001" step="0.0001" data-sale-quantity />
                        <span>@mt</span>
                    </div>
                    <span asp-validation-for="QuantityMt" class="field-validation-error"></span>
                </div>
                <div class="ak-field fec-span-4">
                    <label asp-for="UnitPriceInCurrency" class="ak-label"></label>
                    <div class="ak-input-unit">
                        <input asp-for="UnitPriceInCurrency" class="ak-input ak-num" min="0.0001" step="0.0001" data-sale-unit-price data-sale-price-pending-target />
                        <span data-currency-unit>@Model.Currency</span>
                    </div>
                    <span asp-validation-for="UnitPriceInCurrency" class="field-validation-error"></span>
                </div>

                <div class="ak-field fec-span-4">
                    <label asp-for="Currency" class="ak-label"></label>
                    <select asp-for="Currency" asp-items="ViewBag.Currencies" class="ak-input" data-sale-currency></select>
                    <span asp-validation-for="Currency" class="field-validation-error"></span>
                </div>
                <div class="ak-field fec-span-8">
                    <label asp-for="InvoiceNumber" class="ak-label"></label>
                    <input asp-for="InvoiceNumber" class="ak-input" />
                    <span asp-validation-for="InvoiceNumber" class="field-validation-error"></span>
                </div>
                <div class="ak-field fec-span-4" data-fx-wrap @(string.Equals(Model.Currency, baseCurrency, StringComparison.OrdinalIgnoreCase) ? "hidden" : null)>
                    <label asp-for="AppliedFxRateToUsd" class="ak-label"></label>
                    <input asp-for="AppliedFxRateToUsd" class="ak-input ak-num" min="0.000001" step="0.000001" data-sale-fx data-sale-price-pending-target />
                    <span asp-validation-for="AppliedFxRateToUsd" class="field-validation-error"></span>
                </div>
                @* فروش با قیمت باز: بار ثبت می‌شود؛ قیمت بعداً از صفحهٔ همان فروش تعیین می‌شود. *@
                <div class="ak-field ak-col-full">
                    <div class="form-check">
                        <input asp-for="IsSalePricePending" class="form-check-input" type="checkbox" data-sale-price-pending-toggle />
                        <label asp-for="IsSalePricePending" class="form-check-label">@UiText.T(Context, "قیمت فروش هنوز مشخص نیست", "Sale price not yet known")</label>
                    </div>
                    <div class="form-text" data-sale-price-pending-hint hidden>@UiText.T(Context, "بار و موجودی همین حالا ثبت می‌شود؛ طلب مشتری، عاید و مفاد پس از تعیین قیمت از صفحهٔ همین فروش ثبت می‌شود.", "Delivery is recorded now; receivable, revenue and profit are posted once the price is set from the sale page.")</div>
                </div>

                <div class="ak-field fec-span-6">
                    <label asp-for="DestinationLocationId" class="ak-label"></label>
                    <select asp-for="DestinationLocationId" asp-items="ViewBag.Destinations" class="ak-input">
                        <option value="">@UiText.T(Context, "بدون مقصد مشخص", "No specific destination")</option>
                    </select>
                    <span asp-validation-for="DestinationLocationId" class="field-validation-error"></span>
                </div>
                <div class="ak-field fec-span-6">
                    <label asp-for="Notes" class="ak-label"></label>
                    <textarea asp-for="Notes" class="ak-input" rows="3" placeholder="@UiText.T(Context, "اختیاری", "Optional")"></textarea>
                    <span asp-validation-for="Notes" class="field-validation-error"></span>
                </div>
            </div>
        </section>

        @* ۵. جزئیات قراردادها *@
        <section class="ak-form-section">
            <div class="d-flex justify-content-between align-items-center gap-2">
                <h2 class="ak-form-group-title">@UiText.T(Context, "جزئیات قراردادها", "Contract Details")</h2>
                <button type="button" class="ak-btn ak-btn--ghost" data-ssf-collapse aria-expanded="true"
                        aria-controls="ssf-contracts-panel"
                        aria-label="@UiText.T(Context, "باز و بسته کردن جزئیات قراردادها", "Toggle contract details")">
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </button>
            </div>
            <div class="ak-table-wrap" id="ssf-contracts-panel">
                <table class="ak-table">
                    <thead>
                        <tr>
                            <th>@UiText.T(Context, "قرارداد", "Contract")</th>
                            <th>@UiText.T(Context, "مقدار در کشتی", "Quantity on vessel")</th>
                            <th>@UiText.T(Context, "کسری سهمی", "Allocated shortage")</th>
                            <th>@UiText.T(Context, "مقدار قابل فروش", "Sellable quantity")</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model.Contracts)
                        {
                            <tr data-contract-row
                                data-contract-id="@row.ContractId"
                                data-available="@row.AvailableQuantityMt.ToString(CultureInfo.InvariantCulture)"
                                data-total-cost="@row.TotalCostUsd.ToString(CultureInfo.InvariantCulture)">
                                <td>
                                    @row.ContractNumber
                                    @if (!string.IsNullOrWhiteSpace(row.CompanyName))
                                    {
                                        <small class="text-muted d-block">@row.CompanyName</small>
                                    }
                                </td>
                                <td class="ak-num">@row.LoadedQuantityMt.ToString("N3") @mt</td>
                                <td class="ak-num">@row.ShortageQuantityMt.ToString("N3") @mt</td>
                                <td class="ak-num">@row.AvailableQuantityMt.ToString("N3") @mt</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>@UiText.T(Context, "مجموع", "Total")</th>
                            <th class="ak-num">@Model.LoadedQuantityMt.ToString("N3") @mt</th>
                            <th class="ak-num">@Model.RegisteredShortageQuantityMt.ToString("N3") @mt</th>
                            <th class="ak-num">@Model.AvailableQuantityMt.ToString("N3") @mt</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </section>

        @* ۶. خلاصه زنده فروش *@
        <section class="ak-form-section">
            <h2 class="ak-form-group-title">@UiText.T(Context, "۳. خلاصه زنده فروش", "3. Live Sale Summary")</h2>
            <dl class="ak-list">
                <div class="ak-list-row">
                    <dt>@UiText.T(Context, "مقدار فروش", "Sale quantity")</dt>
                    <dd class="ak-num" data-summary-quantity>0.000 @mt</dd>
                </div>
                <div class="ak-list-row">
                    <dt>@UiText.T(Context, "قیمت فروش هر تن", "Unit sale price")</dt>
                    <dd class="ak-num" data-summary-price>0</dd>
                </div>
                <div class="ak-list-row">
                    <dt>@UiText.T(Context, "کل فروش", "Total sale")</dt>
                    <dd class="ak-num" data-summary-total>0</dd>
                </div>
                <div class="ak-list-row">
                    <dt>@UiText.T(Context, "قیمت تمام‌شده تقریبی", "Estimated cost")</dt>
                    <dd class="ak-num" data-summary-cost>USD 0.00</dd>
                </div>
                <div class="ak-list-row">
                    <dt>@UiText.T(Context, "سود تخمینی", "Estimated profit")</dt>
                    <dd class="ak-num" data-summary-profit>USD 0.00</dd>
                </div>
                <div class="ak-list-row">
                    <dt>@UiText.T(Context, "باقی‌مانده بعد از فروش", "Remaining after sale")</dt>
                    <dd class="ak-num" data-summary-remaining>@Model.AvailableQuantityMt.ToString("N3", CultureInfo.InvariantCulture) @mt</dd>
                </div>
            </dl>
        </section>

        @* ۷. نوار دکمه‌های پایین *@
        <div class="ak-footer-actions">
            <button type="submit" class="ak-save">
                <i class="bi bi-check-lg" aria-hidden="true"></i>
                <span>@UiText.T(Context, "ثبت فروش", "Save Sale")</span>
            </button>
            <button type="submit" name="PrintAfterSave" value="true" class="ak-btn">
                <i class="bi bi-printer" aria-hidden="true"></i>
                <span>@UiText.T(Context, "ثبت و چاپ بل", "Save and print bill")</span>
            </button>
            <a href="@(cancelUrl ?? "#")" class="ak-cancel">@UiText.T(Context, "انصراف", "Cancel")</a>
        </div>
    </form>
    <script src="~/js/sale-price-pending.js" asp-append-version="true" defer></script>
</div>
