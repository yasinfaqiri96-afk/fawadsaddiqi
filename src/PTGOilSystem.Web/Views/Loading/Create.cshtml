@using Microsoft.AspNetCore.Mvc.Rendering
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.Loading
@using PTGOilSystem.Web.Models.ExcelImport
@model PTGOilSystem.Web.Models.Loading.LoadingCreateViewModel
@{
    ViewData["Title"] = "ثبت بارگیری";
    var contractCheckboxOptions = (ViewBag.Contracts as IEnumerable<SelectListItem>)?.ToList() ?? new List<SelectListItem>();
    var contractProductIds = ViewBag.ContractProductIds as IReadOnlyDictionary<int, int> ?? new Dictionary<int, int>();
    var contractProductNames = ViewBag.ContractProductNames as IReadOnlyDictionary<int, string> ?? new Dictionary<int, string>();
    var productNames = ViewBag.ProductNames as IReadOnlyDictionary<int, string> ?? new Dictionary<int, string>();
    var selectedProductName = productNames.TryGetValue(Model.ProductId, out var productName) ? productName : "";
    var isContractLocked = Model.LockContract;
    var rowContractOptions = ViewBag.RowContractOptions as IReadOnlyList<SelectListItem> ?? Array.Empty<SelectListItem>();
    var showRowContractSelector = ViewBag.ShowRowContractSelector as bool? == true;
    var usesCompactRowPreview = !string.IsNullOrWhiteSpace(Model.ImportedRowsJson);
    // در حالت فشرده، اسکریپت صفحه بلافاصله سطرهای دیدنی را از loadingImportedRowsData
    // می‌سازد و tbody را با replaceChildren جایگزین می‌کند. رندر همان سطرها در سرور فقط
    // چند صد کیلوبایت HTML دور‌ریختنی می‌ساخت و پارس صفحهٔ برگشتی را ده‌ها ثانیه طول می‌داد
    // (دکمهٔ ذخیره در همان مدت روی حالت چرخان می‌ماند).
    var previewRows = usesCompactRowPreview
        ? Enumerable.Empty<LoadingCreateRowViewModel>()
        : Model.Rows;
    var rowEditors = previewRows
        .Select((row, index) => new LoadingCreateRowEditorViewModel
        {
            RowKey = row.RowKey,
            Sequence = index + 1,
            TransportType = Model.TransportType,
            Row = row,
            ShowContractSelector = showRowContractSelector,
            ContractOptions = rowContractOptions,
            RecordFreight = Model.RecordFreight
        })
        .ToList();
    // یک فایل اکسل می‌تواند صدها سطر با یک علت خطای مشترک بسازد. پیام‌های یکسان در یک
    // خط با تعداد سطر نشان داده می‌شوند تا خطا خوانا بماند (خودِ اعتبارسنجی تغییری نمی‌کند).
    var groupedValidationErrors = ViewData.ModelState
        .SelectMany(entry => entry.Value?.Errors ?? (IEnumerable<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>)Array.Empty<Microsoft.AspNetCore.Mvc.ModelBinding.ModelError>())
        .Select(error => error.ErrorMessage)
        .Where(message => !string.IsNullOrWhiteSpace(message))
        .GroupBy(message => message, StringComparer.Ordinal)
        .Select(group => new { Message = group.Key, Count = group.Count() })
        .ToList();
    var recordFreight = Model.RecordFreight;
    var freightColumnCss = recordFreight ? "" : "d-none";
    var isWagon = Model.TransportType == LoadingTransportType.Wagon;
    var wagonFreightColumnCss = recordFreight && isWagon ? "" : "d-none";
    var logisticsServiceProviderOptions = ViewBag.LogisticsServiceProviders as IReadOnlyList<SelectListItem> ?? Array.Empty<SelectListItem>();
    var hasLocalReturnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl);
    var cancelUrl = hasLocalReturnUrl ? Model.ReturnUrl : Url.Action("Index");
    var initialTotalQuantityMt = Model.Rows.Sum(row => row.LoadedQuantityMt);
    var initialLoadingValueUsd = Model.Rows.Sum(row => row.LoadedQuantityMt * (row.LoadingPriceUsd ?? 0m));
    var initialAverageLoadingUsd = initialTotalQuantityMt > 0m ? initialLoadingValueUsd / initialTotalQuantityMt : 0m;
    var initialPendingPriceRows = Model.Rows.Count(row => !row.LoadingPriceUsd.HasValue || row.LoadingPriceUsd.Value <= 0m);
    var initialAllPriced = Model.Rows.Count > 0 && initialPendingPriceRows == 0;
    var initialTransportExpensesUsd = Model.Rows.Sum(row =>
        (row.TransportExpenseUsd ?? 0m)
        + (row.WarehouseExpenseUsd ?? 0m)
        + (row.OtherExpenseUsd ?? 0m)
        + (row.RailwayExpenseUsd ?? 0m));
    var initialLockedRubValue = Model.Rows.Sum(row =>
        row.AmountRubAtRubLock
        ?? (string.Equals(row.SettlementCurrencyCode, "RUB", StringComparison.OrdinalIgnoreCase)
            && row.LoadingPriceUsd.HasValue
            && row.RubPerUsdRate.HasValue
                ? row.LoadedQuantityMt * row.LoadingPriceUsd.Value * row.RubPerUsdRate.Value
                : 0m));
    var initialPendingRubRows = Model.Rows.Count(row =>
        string.Equals(row.SettlementCurrencyCode, "RUB", StringComparison.OrdinalIgnoreCase)
        && !row.AmountRubAtRubLock.HasValue
        && (!row.LoadingPriceUsd.HasValue || !row.RubPerUsdRate.HasValue));
    // ارقام روبلی خوانده‌شده از فایل (مستقل از نرخ تبادله). اگر موجود باشد، جای «در انتظار نرخ» نشان داده می‌شود.
    var initialFileRubValue = Model.Rows.Sum(row =>
        row.SettlementValueRub
        ?? (row.SettlementUnitPriceRub.HasValue ? row.LoadedQuantityMt * row.SettlementUnitPriceRub.Value : 0m));
    var hasFileRub = Model.Rows.Any(row => row.SettlementValueRub.HasValue || row.SettlementUnitPriceRub.HasValue);
    var frubColumnCss = hasFileRub ? "" : "d-none";
    var initialAverageRub = hasFileRub && initialTotalQuantityMt > 0m ? initialFileRubValue / initialTotalQuantityMt : 0m;
    var initialWagonCount = Model.Rows.Count(row => !string.IsNullOrWhiteSpace(row.WagonNumber));
    var initialChargeableQuantityMt = Model.Rows.Sum(row =>
        row.ChargeableQuantityMt
        ?? ((row.RailwayRateUsd ?? row.FreightRateUsdPerMt) is > 0m ? row.LoadedQuantityMt : 0m));
    var initialRailwayExpenseUsd = Model.Rows.Sum(row => row.RailwayExpenseUsd ?? 0m);
    // کارت آماری واحد پول را در بخش unit خودش نشان می‌دهد، پس مقدار بدون نماد ارز ساخته می‌شود.
    var initialRubSummaryText = hasFileRub
        ? NumberDisplay.Money(initialFileRubValue)
        : initialLockedRubValue > 0m
            ? NumberDisplay.Money(initialLockedRubValue)
            : initialPendingRubRows > 0 ? "در انتظار نرخ" : "-";
    var createPostUrl = Url.Action("Create", "Loading");
    var importPostUrl = Url.Action("ImportWorkbook", "Loading");
    var importSampleUrl = Url.Action("DownloadSample", "LoadingExcelImport") ?? "/Loading/ExcelImport/sample";
    // همان کامپوننت مشترک بقیهٔ صفحات: دکمهٔ سبز + مودال. حالت external یعنی خودِ این صفحه
    // فایل را می‌فرستد و سطرها را به جدول اضافه می‌کند؛ هیچ Job سمت سرور ساخته نمی‌شود.
    var loadingImportOptions = new ExcelImportComponentOptions
    {
        InputId = "loadingExcelImportFile",
        FileFieldName = "LoadingImportWorkbookFile",
        Mode = "external",
        AcceptExtensions = ".xlsx",
        Title = "امپورت سطرهای بارگیری از اکسل",
        Description = "فایل اکسل بارگیری را انتخاب کنید؛ سطرهای فایل مستقیم به جدول همین فرم افزوده می‌شود.",
        StartButtonText = "خواندن فایل و افزودن سطرها",
        SuccessTitle = "سطرهای فایل به جدول افزوده شد",
        ToggleText = "امپورت از اکسل",
        MaxFileSizeMb = 20,
        RequiresConfirmation = false,
        ShowResultDetails = false,
        Compact = true,
        SampleUrl = importSampleUrl
    };
}

<div class="ak-form-page ak-form-page--wide loading-import-workbook" data-loading-create-page>
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "ثبت بارگیری", "Loading Registration"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right", (string?)cancelUrl))" />

    <form asp-action="Create" method="post" enctype="multipart/form-data" class="ak-form" data-loading-create-form data-create-action="@createPostUrl">
        @Html.AntiForgeryToken()
        @Html.FormToken()
        @Html.FormDraft("Loading.Create")
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="LockContract" type="hidden" />
        <input type="hidden" name="ImportedRowsJson" id="loadingImportedRowsJson" value="" />

        @if (usesCompactRowPreview)
        {
            <script type="application/json" id="loadingImportedRowsData">@Html.Raw(Model.ImportedRowsJson)</script>
        }

        @if (groupedValidationErrors.Count > 0)
        {
            <div class="alert alert-danger ak-form-alert validation-summary-errors" data-loading-validation-summary>
                <ul>
                    @foreach (var validationError in groupedValidationErrors)
                    {
                        <li>
                            @validationError.Message
                            @if (validationError.Count > 1)
                            {
                                <strong>(@validationError.Count سطر)</strong>
                            }
                        </li>
                    }
                </ul>
            </div>
        }
        <div class="loading-operation-status d-none" data-loading-operation-status role="status" aria-live="polite">
            <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            <div>
                <strong data-loading-operation-title>در حال پردازش...</strong>
                <span data-loading-operation-detail>لطفاً صفحه را نبندید.</span>
            </div>
        </div>
        <div id="platts-pricing-notice" class="alert alert-warning loading-pricing-notice d-none" role="alert">
            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
            <strong>نرخ پلتس ثبت نشده است</strong>
            <span id="platts-pricing-notice-reason" class="small"></span>
        </div>

        <section class="ak-form-section" aria-label="مشخصات بارگیری">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "اطلاعات عمومی", "General Information"), (string?)UiText.T(Context, "قرارداد، محصول و نوع حمل را مشخص کنید.", "Select the contract, product and transport type.")))" />
            @* پنج مشخصهٔ اصلی در نمایش دسکتاپ یک ردیف‌اند؛ مسئول کرایه در صورت فعال‌شدن به ردیف بعد می‌رود. *@
            <div class="ak-form-grid ak-form-grid--5">
                    <div class="ak-field">
                        <label asp-for="ContractId" class="ak-label"></label>
                        <div data-loading-contract-field>
                            <input asp-for="ContractId" type="hidden" data-loading-primary-contract />
                            <button type="button" class="ak-input" data-loading-contract-toggle aria-haspopup="listbox" aria-expanded="false" disabled="@(isContractLocked ? "disabled" : null)">
                                <span data-loading-contract-summary>انتخاب قرارداد</span>
                                <i class="bi bi-chevron-down"></i>
                            </button>
                            <div class="loading-contract-checklist" data-loading-contract-select data-loading-contract-menu>
                                @foreach (var option in contractCheckboxOptions)
                                {
                                    var checkboxId = $"loading_contract_{option.Value}";
                                    var optionContractId = int.TryParse(option.Value, out var parsedContractId) ? parsedContractId : 0;
                                    var optionProductId = contractProductIds.TryGetValue(optionContractId, out var productId) ? productId : 0;
                                    var optionProductName = contractProductNames.TryGetValue(optionContractId, out var contractProductName) ? contractProductName : "";
                                    <label class="loading-contract-check" for="@checkboxId" data-loading-contract-option>
                                        <input id="@checkboxId" type="checkbox" name="SelectedContractIds" value="@option.Value"
                                               checked="@option.Selected" disabled="@(isContractLocked ? "disabled" : null)"
                                               data-contract-product-id="@(optionProductId > 0 ? optionProductId.ToString() : null)"
                                               data-contract-product-name="@optionProductName" data-loading-contract-checkbox />
                                        <span data-loading-contract-label>@option.Text</span>
                                    </label>
                                }
                            </div>
                        </div>
                        <span asp-validation-for="ContractId" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field">
                        <label asp-for="ProductId" class="ak-label">جنس</label>
                        <input asp-for="ProductId" type="hidden" data-loading-product-id />
                        <div class="ak-input" data-loading-product-summary>
                            @(string.IsNullOrWhiteSpace(selectedProductName) ? "از قرارداد تعیین می‌شود" : selectedProductName)
                        </div>
                        <span asp-validation-for="ProductId" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field">
                        <label asp-for="OriginLocationId" class="ak-label"></label>
                        <select asp-for="OriginLocationId" asp-items="ViewBag.Origins" class="ak-input"><option value=""></option></select>
                    </div>
                    <div class="ak-field">
                        <label asp-for="TransportType" class="ak-label"></label>
                        <select asp-for="TransportType" class="ak-input" data-loading-transport-type>
                            <option value="0"></option>
                            <option value="@((int)LoadingTransportType.Vessel)">کشتی</option>
                            <option value="@((int)LoadingTransportType.Wagon)">واگن</option>
                            <option value="@((int)LoadingTransportType.Truck)">موتر</option>
                        </select>
                    </div>
                    <div class="ak-toggle-field loading-freight-toggle-field">
                        <label class="ak-label" for="RecordFreight">کرایه و ترانسپورت</label>
                        <label class="form-check loading-freight-toggle-control">
                            <input type="checkbox" asp-for="RecordFreight" class="form-check-input" data-loading-freight-toggle />
                            <span class="form-check-label" data-loading-freight-toggle-text>کرایه ثبت شود</span>
                        </label>
                    </div>
                    <div class="ak-field @freightColumnCss" data-loading-freight-responsibility>
                        <label asp-for="FreightCostResponsibility" class="ak-label"></label>
                        <select asp-for="FreightCostResponsibility" class="ak-input">
                            <option value=""></option><option value="1">بدوش خریدار</option><option value="2">بدوش فروشنده</option><option value="3">مشترک</option>
                        </select>
                        <span asp-validation-for="FreightCostResponsibility" class="ak-field-error"></span>
                    </div>
                    <input asp-for="Notes" type="hidden" />
            </div>
        </section>

        @* کارت‌های آماری از همان کامپوننت مشترک سیستم (vc:stat-card / ak-stat-grid) — دقیقاً مثل بقیهٔ صفحه‌ها.
           مقدارها زنده‌اند و اسکریپت پایین همین ویو داخل [data-ak-stat-value] هر کارت می‌نویسد. *@
        @* تا وقتی هیچ سطری داده ندارد (نه دستی، نه از اکسل) کارت‌ها پنهان‌اند؛
           اسکریپت پایین با شمارش سطرهای دارای مقدار آن‌ها را نشان می‌دهد. *@
        <section class="ak-stat-grid d-none" data-loading-stats aria-label="خلاصه ثبت بارگیری">
            <vc:stat-card title="مقدار بارگیری" value="@NumberDisplay.Quantity(initialTotalQuantityMt)" unit="MT"
                          avatar="loading" css-class="lic-stat-quantity"></vc:stat-card>
            <vc:stat-card title="ارزش بارگیری" value="@NumberDisplay.Money(initialLoadingValueUsd)" unit="USD"
                          avatar="purchase-value" css-class="lic-stat-value"></vc:stat-card>
            <vc:stat-card title="اوسط بارگیری" value="@NumberDisplay.Money(initialAverageLoadingUsd)" unit="USD / MT"
                          avatar="analysis" css-class="lic-stat-average"></vc:stat-card>
            <vc:stat-card title="ارزش روبلی" value="@initialRubSummaryText" unit="RUB"
                          avatar="exchange-rate" css-class="lic-stat-rub"></vc:stat-card>
            <vc:stat-card title="کرایه حمل" value="@NumberDisplay.Money(initialTransportExpensesUsd)" unit="USD"
                          avatar="transported" css-class="@($"lic-stat-expense {freightColumnCss}")"></vc:stat-card>
        </section>

        <section class="ak-form-section" aria-label="سطرهای بارگیری">
            <div class="lic-table-toolbar" data-lic-toolbar>
                <div class="lic-toolbar-counts">
                    <span>کل ردیف‌ها: <strong data-lic-count-total>0</strong></span>
                    <span class="lic-count-ok">معتبر: <strong data-lic-count-valid>0</strong></span>
                    <span class="lic-count-err">دارای خطا: <strong data-lic-count-error>0</strong></span>
                </div>
                @* دکمه‌های عملیات سطر: فقط کامپوننت مشترک دکمه سیستم (.ak-btn)، بدون استایل محلی. *@
                <div class="lic-toolbar-actions">
                    <button type="button" class="ak-btn" data-loading-row-add>
                        <i class="bi bi-plus-lg" aria-hidden="true"></i> افزودن سطر
                    </button>
                    <div class="excel-import-inline" data-loading-import>
                        <partial name="~/Views/Shared/ExcelImport/_ExcelImport.cshtml" model="loadingImportOptions" />
                    </div>
                    @* «فایل نمونه» به‌جای دانلود مستقیم، راهنمای ستون‌های موردنیاز فایل را باز می‌کند؛
                       خودِ فایل نمونه از داخل همان مودال قابل دانلود است. *@
                    <button type="button" class="ak-btn ak-btn--ghost"
                            data-bs-toggle="modal" data-bs-target="#loadingImportGuideModal" data-loading-import-guide>
                        <i class="bi bi-info-circle" aria-hidden="true"></i> راهنمای فایل نمونه
                    </button>
                </div>
            </div>
            <div class="lic-import-note d-none" data-loading-import-summary role="status" aria-live="polite"></div>
            <div class="ak-table-wrap">
                <table class="ak-table">
                    @* عنوان‌ها کوتاه‌اند؛ عرض خوانای کنترل‌ها در wrapper مشترک جدول حفظ می‌شود. *@
                    <thead data-loading-table-head><tr>
                        <th>#</th>
                        <th class="@(showRowContractSelector ?"" : "d-none")" data-loading-contract-column>قرارداد</th>
                        <th>تاریخ</th><th data-loading-column-reference>مرجع</th><th data-loading-column-transport>وسیله حمل</th>
                        <th class="ak-col-num">وزن بارگیری</th><th class="ak-col-num">قیمت خرید فی تن</th><th class="ak-col-num">ارزش بار</th>
                        <th class="ak-col-num @wagonFreightColumnCss" data-loading-freight-column data-loading-wagon-freight-column>وزن قابل حساب خط آهن</th>
                        <th class="ak-col-num @frubColumnCss" data-loading-frub-column>روبل فی تن</th><th class="ak-col-num @frubColumnCss" data-loading-frub-column>ارزش روبلی</th>
                        <th class="ak-col-num @(hasFileRub ?"d-none" : "")" data-loading-rub-column>نرخ روبل</th>
                        <th class="ak-col-num @(hasFileRub ?"d-none" : "")" data-loading-rub-column>معادل روبلی</th>
                        <th class="@freightColumnCss" data-loading-freight-column data-loading-logistics-heading>ترانسپورت</th>
                        <th class="ak-col-num @freightColumnCss" data-loading-freight-column data-loading-freight-rate-heading>کرایه فی تن</th>
                        <th class="ak-col-num @wagonFreightColumnCss" data-loading-freight-column data-loading-wagon-freight-column>مجموع کرایه خط آهن</th>
                        <th>گیرنده</th><th>مقصد</th>
                        <th>نمبر ترانزیت</th><th>نام راننده</th><th>تماس راننده</th>
                        <th class="ak-col-actions"></th>
                    </tr></thead>
                    <tbody data-loading-rows>
                                @foreach (var rowEditor in rowEditors)
                                {
                                    await Html.RenderPartialAsync("_LoadingRowEditor", rowEditor, ViewData);
                                }
                    </tbody>
                </table>
            </div>
            <section class="ak-summary mt-3 @(isWagon ? "" : "d-none")" data-loading-wagon-summary aria-label="خلاصه واگن‌ها" aria-live="polite">
                <article class="ak-field">
                    <span>تعداد واگن</span>
                    <strong><bdi data-loading-wagon-count>@initialWagonCount</bdi></strong>
                </article>
                <article class="ak-field">
                    <span>مجموع وزن بارگیری</span>
                    <strong><bdi data-loading-wagon-loaded>@NumberDisplay.Quantity(initialTotalQuantityMt)</bdi> MT</strong>
                </article>
                <article class="ak-field">
                    <span>مجموع وزن قابل حساب</span>
                    <strong><bdi data-loading-wagon-chargeable>@NumberDisplay.Quantity(initialChargeableQuantityMt)</bdi> MT</strong>
                </article>
                <article class="ak-field is-primary">
                    <span>مجموع کرایه خط آهن</span>
                    <strong><bdi data-loading-wagon-expense>@NumberDisplay.Money(initialRailwayExpenseUsd)</bdi> USD</strong>
                </article>
            </section>
            <div class="lic-pagination" data-lic-pagination hidden>
                <button type="button" class="lic-page-btn" data-lic-prev>‹ قبلی</button>
                <span class="lic-page-info" data-lic-page-info></span>
                <button type="button" class="lic-page-btn" data-lic-next>بعدی ›</button>
            </div>
        </section>

        <div class="ak-footer-actions" data-loading-footer-actions>
            <span class="lic-footer-count">کل: <strong data-lic-count-total>0</strong> ردیف · <span class="lic-count-err">خطا: <strong data-lic-count-error>0</strong></span></span>
            <button type="submit" class="ak-save" data-loading-save data-busy-text="در حال ثبت...">ذخیره</button>
            <button type="reset" class="ak-cancel" data-loading-reset>بازنشانی</button>
            <a href="@cancelUrl" class="ak-cancel">لغو</a>
        </div>
    </form>

    @{
        var vesselOptions = ViewBag.VesselOptions as IReadOnlyList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
        var truckOptions = ViewBag.TruckOptions as IReadOnlyList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    }
    <datalist id="loading-vessel-options">
        @foreach (var opt in vesselOptions)
        {
            <option value="@opt.Text"></option>
        }
    </datalist>

    <datalist id="loading-truck-options">
        @foreach (var opt in truckOptions)
        {
            <option value="@opt.Text"></option>
        }
    </datalist>

    @{
        var driverOptions = ViewBag.LoadingDriverOptions as IReadOnlyList<PTGOilSystem.Web.Models.Loading.LoadingDriverOption> ?? Array.Empty<PTGOilSystem.Web.Models.Loading.LoadingDriverOption>();
    }
    @* «راننده آزاد» — راننده‌های ثبت‌شده، یک‌بار در صفحه؛ فیلد نام راننده در همین حالت به آن وصل می‌شود. *@
    <datalist id="loading-driver-options">
        @foreach (var driver in driverOptions)
        {
            <option value="@driver.FullName" label="@driver.Phone" data-driver-id="@driver.Id" data-driver-phone="@driver.Phone"></option>
        }
    </datalist>

    @{
        var logisticsProviderCatalog = ViewBag.LogisticsServiceProviders as IReadOnlyList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
        var operationalAssetCatalog = ViewBag.LoadingOperationalAssets as IReadOnlyList<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? Array.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    }
    @* Single copy of the transport lists. Row selects start with only their own value and
       are filled from here when the user opens them, so row count no longer multiplies
       the option count. Kept outside the form so they never post. *@
    <select id="loading-provider-catalog" class="d-none" aria-hidden="true" tabindex="-1" disabled>
        @foreach (var opt in logisticsProviderCatalog)
        {
            <option value="@opt.Value">@opt.Text</option>
        }
    </select>
    <select id="loading-asset-catalog" class="d-none" aria-hidden="true" tabindex="-1" disabled>
        @foreach (var opt in operationalAssetCatalog)
        {
            <option value="@opt.Value">@opt.Text</option>
        }
    </select>

    <template id="loading-row-template">
        @await Html.PartialAsync("_LoadingRowEditor", new LoadingCreateRowEditorViewModel
        {
            RowKey = "__key__",
            Sequence = 0,
            TransportType = Model.TransportType,
            ShowContractSelector = showRowContractSelector,
            ContractOptions = rowContractOptions,
            RecordFreight = Model.RecordFreight,
            Row = new LoadingCreateRowViewModel
            {
                RowKey = "__key__",
                LoadingDate = BusinessClock.Today
            }
        }, ViewData)
    </template>

    <div class="loading-date-overlay" data-loading-date-overlay aria-hidden="true">
        <div class="loading-date-picker" role="dialog" aria-modal="true" aria-label="انتخاب تاریخ">
            <div class="loading-date-header" data-loading-date-header>
                <button type="button" class="loading-date-year" data-loading-date-year data-loading-date-year-toggle aria-label="تغییر سال"></button>
                <div class="loading-date-long" data-loading-date-long></div>
                <div class="loading-date-locale" data-loading-date-locale>شمسی</div>
            </div>
            <div class="loading-date-body">
                <div class="loading-date-controls">
                    <button type="button" class="loading-date-nav" data-loading-date-prev aria-label="ماه قبلی">‹</button>
                    <div class="loading-date-month" data-loading-date-month></div>
                    <button type="button" class="loading-date-nav" data-loading-date-next aria-label="ماه بعدی">›</button>
                </div>
                <div class="loading-date-week" aria-hidden="true">
                    <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
                </div>
                <div class="loading-date-days" data-loading-date-days></div>
            </div>
        </div>
    </div>
</div>

@* راهنمای فایل اکسل — بیرون از .loading-import-workbook می‌ماند تا عرض‌های ستونیِ
   جدول سطرهای بارگیری روی جدول راهنما اثر نگذارد. عنوان‌های ستون دقیقاً همان‌هایی
   است که LoadingWorkbookParser می‌شناسد. *@
