                            </tr>
                            <tr>
                                <td>ارزش روبلی</td>
                                <td>Total RUB · RUB amount · ارزش روبلی · مجموع روبل — یا ستون Total بلافاصله بعد از قیمت روبلی</td>
                                <td>اختیاری</td>
                            </tr>
                            <tr>
                                <td>گیرنده</td>
                                <td>Consignee</td>
                                <td>اختیاری</td>
                            </tr>
                            <tr>
                                <td>مقصد</td>
                                <td>Destination · Belong to · مقصد</td>
                                <td>اختیاری</td>
                            </tr>
                            <tr>
                                <td>نمبر ترانزیت</td>
                                <td>Transit No · Transit number · Transit · نمبر ترانزیت · شماره ترانزیت</td>
                                <td>اختیاری</td>
                            </tr>
                            <tr>
                                <td>نام راننده</td>
                                <td>Driver · Driver name · نام راننده · راننده</td>
                                <td>اختیاری</td>
                            </tr>
                            <tr>
                                <td>شماره تماس راننده</td>
                                <td>Driver phone · Driver contact · Driver mobile · شماره تماس راننده · تماس راننده</td>
                                <td>اختیاری</td>
                            </tr>
                            <tr>
                                <td>شرکت ترانسپورتی</td>
                                <td>Transportation company · Transport company · Logistics company</td>
                                <td>اختیاری — فایل واگن</td>
                            </tr>
                            <tr>
                                <td>Platts</td>
                                <td>Platts · Platts USD</td>
                                <td>اختیاری — فایل واگن</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <ul class="ak-section-desc mt-3 mb-0 ps-3">
                    <li>سطر سرستون لازم نیست سطر اول باشد؛ سیستم آن را در هر جای شیت پیدا می‌کند.</li>
                    <li>تاریخ به شکل <span dir="ltr">yyyy-MM-dd</span> یا <span dir="ltr">dd.MM.yyyy</span> یا تاریخ خودِ اکسل پذیرفته می‌شود.</li>
                    <li>کرایه از شیت جداگانه خوانده می‌شود: موتر با ستون‌های CMR + Truck + Payable rent (کرایه پرداختی)، واگن با RWB No + Wagon No + کرایه خط‌آهن.</li>
                    <li>شیت‌هایی که در نامشان Sale، Balance، Account، فروش، بیلانس، مصارف، کرایه یا خط‌آهن باشد به‌عنوان سطر بارگیری خوانده نمی‌شوند.</li>
                    <li>قرارداد، جنس و نوع حمل از خودِ همین فرم گرفته می‌شود و لازم نیست در فایل باشد.</li>
                </ul>
            </div>
            <div class="modal-footer">
                <a href="@importSampleUrl" class="btn btn-light ak-secondary-action" data-loading-import-sample>
                    <i class="bi bi-download" aria-hidden="true"></i> دانلود فایل نمونه
                </a>
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">بستن</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const loadingForm = document.querySelector('[data-loading-create-form]');
            const transportSelect = document.querySelector('[data-loading-transport-type]');
            const rowsHost = document.querySelector('[data-loading-rows]');
            const template = document.getElementById('loading-row-template');
            const addButton = document.querySelector('[data-loading-row-add]');
            const resetButton = document.querySelector('[data-loading-reset]');
            const referenceColumn = document.querySelector('[data-loading-column-reference]');
            const transportColumn = document.querySelector('[data-loading-column-transport]');
            const contractSelect = document.querySelector('[data-loading-contract-select]');
            const contractField = document.querySelector('[data-loading-contract-field]');
            const contractToggle = document.querySelector('[data-loading-contract-toggle]');
            const contractSummary = document.querySelector('[data-loading-contract-summary]');
            const primaryContractInput = document.querySelector('[data-loading-primary-contract]');
            const productInput = document.querySelector('[data-loading-product-id]');
            const productSummary = document.querySelector('[data-loading-product-summary]');
            const contractColumn = document.querySelector('[data-loading-contract-column]');
            const freightToggle = document.querySelector('[data-loading-freight-toggle]');
            const freightToggleText = document.querySelector('[data-loading-freight-toggle-text]');
            const wagonSummary = document.querySelector('[data-loading-wagon-summary]');
            const suggestedPricingUrl = '@Url.Action("SuggestedPricing", "Loading")';
            const dateOverlay = document.querySelector('[data-loading-date-overlay]');
            const dateYearLabel = document.querySelector('[data-loading-date-year]');
            const dateLongLabel = document.querySelector('[data-loading-date-long]');
            const dateMonthLabel = document.querySelector('[data-loading-date-month]');
            const dateDaysHost = document.querySelector('[data-loading-date-days]');
            const datePrevButton = document.querySelector('[data-loading-date-prev]');
            const dateNextButton = document.querySelector('[data-loading-date-next]');
            const dateHeader = document.querySelector('[data-loading-date-header]');
            const operationStatus = document.querySelector('[data-loading-operation-status]');
            const operationTitle = document.querySelector('[data-loading-operation-title]');
            const operationDetail = document.querySelector('[data-loading-operation-detail]');

            if (!transportSelect || !rowsHost || !template || !addButton) {
                return;
            }

            let nextRowNumber = rowsHost.querySelectorAll('[data-loading-row]').length;
            let currentPricing = null;
            const pricingCache = new Map();
            const plattsNotice = document.getElementById('platts-pricing-notice');
            const plattsNoticeReason = document.getElementById('platts-pricing-notice-reason');

            // مقدارها داخل کامپوننت مشترک کارت آماری نوشته می‌شوند ([data-ak-stat-value]).
            window.licWriteStat = function (cardClass, text) {
                document.querySelectorAll(`.${cardClass} [data-ak-stat-value]`).forEach(el => {
                    const target = el.querySelector('bdi') || el;
                    target.textContent = text;
                    el.setAttribute('title', text);
                });
            };

            function rowHasFileRub(row) {
                return parseDecimal(row.querySelector('[data-row-frub-amount-hidden]')) > 0
                    || parseDecimal(row.querySelector('[data-row-frub-rate-hidden]')) > 0;
            }

            function setRowRubColumnsVisible(row, visible) {
                // وقتی روبل از فایل آمده، ستون FX «معادل روبلی» تکراری است؛ پنهانش کن.
                const show = visible && !rowHasFileRub(row);
                row.querySelectorAll('[data-loading-rub-column]').forEach(column => {
                    column.classList.toggle('d-none', !show);
                });
            }

            function refreshRubColumnsVisible() {
                const rows = Array.from(rowsHost.querySelectorAll('[data-loading-row]'));
                const anyFileRub = rows.some(rowHasFileRub);
                const hasRubRows = !anyFileRub && rows.some(row =>
                    (readHiddenValue(row, '[data-row-settlement-currency]') || '').toUpperCase() === 'RUB');

                document
                    .querySelectorAll('[data-loading-table-head] [data-loading-rub-column]')
                    .forEach(column => column.classList.toggle('d-none', !hasRubRows));
            }

            function updatePlattsNotice() {
                if (!plattsNotice) return;
                const show = currentPricing
                    && currentPricing.isFormulaPlatts
                    && currentPricing.plattsReferencePrice === null
                    && currentPricing.needsReview === true;
                plattsNotice.classList.toggle('d-none', !show);
                if (plattsNoticeReason && currentPricing && currentPricing.reason) {
                    plattsNoticeReason.textContent = currentPricing.reason;
                } else if (plattsNoticeReason) {
                    plattsNoticeReason.textContent = '';
                }
            }

            function normalizePricingPayload(payload) {
                if (!payload) {
                    return null;
                }

                const plattsReferencePrice = typeof payload.plattsReferencePrice === 'number'
                    ? payload.plattsReferencePrice
                    : (typeof payload.basePlattsPrice === 'number' ? payload.basePlattsPrice : null);

                return {
                    isFormulaPlatts: payload.isFormulaPlatts === true,
                    basePlattsPrice: typeof payload.basePlattsPrice === 'number' ? payload.basePlattsPrice : null,
                    plattsReferencePrice,
                    plattsReferenceSource: typeof payload.plattsReferenceSource === 'string' ? payload.plattsReferenceSource : '',
                    plattsReferenceDate: typeof payload.plattsReferenceDate === 'string' ? payload.plattsReferenceDate : '',
                    plattsReferenceFallbackApplied: payload.plattsReferenceFallbackApplied === true,
                    plattsReferenceReason: typeof payload.plattsReferenceReason === 'string' ? payload.plattsReferenceReason : '',
                    premiumDiscountUsd: typeof payload.premiumDiscountUsd === 'number' ? payload.premiumDiscountUsd : null,
                    finalUnitPrice: typeof payload.finalUnitPrice === 'number' ? payload.finalUnitPrice : null,
                    settlementCurrencyCode: typeof payload.settlementCurrencyCode === 'string' ? payload.settlementCurrencyCode : 'USD',
                    rubRatePolicy: typeof payload.rubRatePolicy === 'string' ? payload.rubRatePolicy : 'NotApplicable',
                    rubPerUsdRate: typeof payload.rubPerUsdRate === 'number' ? payload.rubPerUsdRate : null,
                    rubRateDate: typeof payload.rubRateDate === 'string' ? payload.rubRateDate : '',
                    rubRateSource: typeof payload.rubRateSource === 'string' ? payload.rubRateSource : '',
                    needsReview: payload.needsReview === true,
                    reason: typeof payload.reason === 'string' ? payload.reason : '',
                    remainingQuantityMt: typeof payload.remainingQuantityMt === 'number' ? payload.remainingQuantityMt : null
                };
            }

            async function getContractPricing(contractId) {
                if (!contractId || !suggestedPricingUrl) {
                    return null;
                }

                if (pricingCache.has(contractId)) {
                    const cached = pricingCache.get(contractId);
                    return typeof cached?.then === 'function' ? await cached : cached;
                }

                const pricingRequest = (async () => {
                    const separator = suggestedPricingUrl.includes('?') ? '&' : '?';
                    const response = await fetch(`${suggestedPricingUrl}${separator}contractId=${encodeURIComponent(contractId)}`, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    });

                    if (!response.ok) {
                        return null;
                    }

                    return normalizePricingPayload(await response.json());
                })().catch(() => null);

                pricingCache.set(contractId, pricingRequest);
                const pricing = await pricingRequest;
                pricingCache.set(contractId, pricing);
                return pricing;
            }

            function getPricingForRow(row) {
                const selectedContractIds = getSelectedContractIds();
                if (selectedContractIds.length > 1) {
                    const rowContractId = row.querySelector('[data-row-contract-select]')?.value || '';
                    const cached = rowContractId ? pricingCache.get(rowContractId) : null;
                    return cached && typeof cached.then !== 'function' ? cached : null;
                }

                return currentPricing;
            }

            const transportMap = {
                '1': { field: 'Vessel', label: 'کشتی', reference: 'Bill of Lading / بارنامه کشتی', placeholder: '' },
                '2': { field: 'Wagon', label: 'شماره واگن', reference: 'RWB No / شماره RWB', placeholder: '' },
                '3': { field: 'Truck', label: 'موتر', reference: 'CMR No / شماره CMR', placeholder: '' }
            };

            function getTransportConfig() {
                return transportMap[transportSelect.value] || { field: '', label: 'وسیله حمل', reference: 'RWB / CMR / Bill of Lading', placeholder: '' };
            }

            function formatNumber(value, fractionDigits) {
                return new Intl.NumberFormat('en-US', {
                    minimumFractionDigits: fractionDigits,
                    maximumFractionDigits: fractionDigits
                }).format(value);
            }

            function formatMoneyNumber(value) {
                // حداکثر ۲ اعشار، صفرهای آخر حذف: 1,250.00 → 1,250 و 1,250.50 → 1,250.5
                return formatNumber(value, 2).replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, '');
            }

            function formatQuantityNumber(value) {
                return formatNumber(value, 4).replace(/\.?0+$/, '');
            }

            function readOptionalDecimal(element) {
                if (!element || !element.value) {
                    return null;
                }

                const normalized = element.value.toString().replace(/,/g, '');
                const parsed = Number.parseFloat(normalized);
                return Number.isFinite(parsed) ? parsed : null;
            }

            function parseDecimal(element) {
                return readOptionalDecimal(element) ?? 0;
            }

            function formatInputNumber(value) {
                if (!Number.isFinite(value)) {
                    return '';
                }

                return value.toFixed(4).replace(/\.?0+$/, '');
            }

            function isEmptyValue(element) {
                return !element || !element.value || !element.value.trim();
            }

            function canAutofill(element) {
                return !!element && (isEmptyValue(element) || element.dataset.autofilled === 'true');
            }

            function setAutofilled(element, isAutofilled) {
                if (!element) {
                    return;
                }

                element.dataset.autofilled = isAutofilled ? 'true' : 'false';
            }

            function setHiddenDecimal(element, value) {
                if (!element) {
                    return;
                }

                element.value = Number.isFinite(value) && value > 0 ? formatInputNumber(value) : '';
            }

            function setHiddenValue(row, selector, value) {
                const input = row.querySelector(selector);
                if (input) {
                    input.value = value ?? '';
                }
            }

            function readHiddenValue(row, selector) {
                return row.querySelector(selector)?.value || '';
            }

            function getRowIsoDate(row) {
                return row.querySelector('[data-row-date-value]')?.value || '';
            }

            function formatRubSummary(value, pendingRows) {
                if (value > 0) {
                    return formatMoneyNumber(value);
                }

                return pendingRows > 0 ? 'در انتظار نرخ' : '-';
            }

            function applyRubSettlementToRow(row) {
                const pricing = getPricingForRow(row);
                const currency = (pricing?.settlementCurrencyCode || 'USD').toUpperCase();
                const policy = pricing?.rubRatePolicy || 'NotApplicable';
                const rateInput = row.querySelector('[data-row-rub-rate]');

                setHiddenValue(row, '[data-row-settlement-currency]', currency);
                setHiddenValue(row, '[data-row-rub-policy]', policy);
                setRowRubColumnsVisible(row, currency === 'RUB');

                if (!rateInput) {
                    return;
                }

                rateInput.disabled = currency !== 'RUB';
                rateInput.readOnly = currency === 'RUB' && policy === 'FixedContractRate';

                if (currency !== 'RUB') {
                    rateInput.value = '';
                    setAutofilled(rateInput, false);
                    setHiddenValue(row, '[data-row-rub-status]', 'NotRequired');
                    setHiddenValue(row, '[data-row-rub-date]', '');
                    setHiddenValue(row, '[data-row-rub-source]', '');
                    refreshRubColumnsVisible();
                    return;
                }

                if (policy === 'FixedContractRate') {
                    if (Number.isFinite(pricing?.rubPerUsdRate) && canAutofill(rateInput)) {
                        rateInput.value = formatInputNumber(pricing.rubPerUsdRate);
                        setAutofilled(rateInput, true);
                    }
                    setHiddenValue(row, '[data-row-rub-date]', pricing?.rubRateDate || getRowIsoDate(row));
                    setHiddenValue(row, '[data-row-rub-source]', pricing?.rubRateSource || 'Contract');
                    refreshRubColumnsVisible();
                    return;
                }

                rateInput.readOnly = false;
                const hasRate = readOptionalDecimal(rateInput) !== null;
                setHiddenValue(row, '[data-row-rub-date]', hasRate ? getRowIsoDate(row) : '');
                setHiddenValue(row, '[data-row-rub-source]', hasRate ? 'Manual' : '');
                refreshRubColumnsVisible();
            }

            function updateRowRubSnapshot(row, loadingValueUsd, hasUsdValue) {
                const currency = (readHiddenValue(row, '[data-row-settlement-currency]') || 'USD').toUpperCase();
                const rateInput = row.querySelector('[data-row-rub-rate]');
                const output = row.querySelector('[data-row-rub-value]');

                if (currency !== 'RUB') {
                    setHiddenValue(row, '[data-row-rub-status]', 'NotRequired');
                    setHiddenValue(row, '[data-row-rub-usd]', '');
                    setHiddenValue(row, '[data-row-rub-amount-hidden]', '');
                    if (output) {
                        output.textContent = '-';
                    }
                    return { amountRub: 0, pending: 0 };
                }

                const rate = readOptionalDecimal(rateInput);
                if (hasUsdValue && rate !== null && rate > 0) {
                    const amountRub = loadingValueUsd * rate;
                    setHiddenValue(row, '[data-row-rub-status]', 'Locked');
                    setHiddenDecimal(row.querySelector('[data-row-rub-usd]'), loadingValueUsd);
                    setHiddenDecimal(row.querySelector('[data-row-rub-amount-hidden]'), amountRub);
                    setHiddenValue(row, '[data-row-rub-date]', readHiddenValue(row, '[data-row-rub-date]') || getRowIsoDate(row));
                    setHiddenValue(row, '[data-row-rub-source]', readHiddenValue(row, '[data-row-rub-source]') || 'Manual');
                    if (output) {
                        output.textContent = `₽ ${formatMoneyNumber(amountRub)}`;
                    }
                    return { amountRub, pending: 0 };
                }

                setHiddenValue(row, '[data-row-rub-status]', 'Pending');
                setHiddenValue(row, '[data-row-rub-usd]', '');
                setHiddenValue(row, '[data-row-rub-amount-hidden]', '');
                if (output) {
                    output.textContent = 'در انتظار نرخ';
                }
                return { amountRub: 0, pending: 1 };
            }

            function getRowLogisticsMode(row) {
                const typeInput = row.querySelector('[data-row-logistics-type]');
                if (typeInput) {
                    return typeInput.value === 'owned' || typeInput.value === 'free' || typeInput.value === 'driver' ? typeInput.value : '';
                }

                const assetSelect = row.querySelector('[data-row-operational-asset]');
                if (assetSelect && assetSelect.value) {
                    return 'owned';
                }

                const providerSelect = row.querySelector('[data-row-logistics-provider]');
                return providerSelect && providerSelect.value ? 'free' : '';
            }

            // The full provider/asset lists are rendered once per page. Rows only carry their
            // own selected option until the user opens the select, which keeps an imported
            // sheet of thousands of rows from creating an option element per row per company.
            const providerCatalog = document.getElementById('loading-provider-catalog');
            const assetCatalog = document.getElementById('loading-asset-catalog');

            function catalogFor(mode) {
                return mode === 'owned' ? assetCatalog : mode === 'free' ? providerCatalog : null;
            }

            // A trimmed select cannot take a value whose option is absent, and the assignment
            // fails silently, so the option is recreated before the value is written.
            function ensureOption(select, value, text) {
                if (!select || !value) {
                    return;
                }

                if (Array.from(select.options).some(option => option.value === value)) {
                    return;
                }

                const option = document.createElement('option');
                option.value = value;
                option.textContent = text || value;
                select.appendChild(option);
            }

            function optionTextFor(mode, value) {
                const catalog = catalogFor(mode);
                if (!catalog || !value) {
                    return '';
                }

                const match = Array.from(catalog.options).find(option => option.value === value);
                return match ? match.textContent : '';
            }

            // Fills a row's visible select from the catalogue. Runs once per row, on first use.
            function hydrateLogisticsItemOptions(itemSelect, mode) {
                if (!itemSelect) {
                    return;
                }

                const catalog = catalogFor(mode);
                if (!catalog || itemSelect.dataset.hydratedMode === mode) {
                    return;
                }

                const selectedValue = itemSelect.value;
                itemSelect.replaceChildren();

                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = '';
                itemSelect.appendChild(placeholder);

                Array.from(catalog.options)
                    .filter(option => option.value)
                    .forEach(option => {
                        const itemOption = document.createElement('option');
                        itemOption.value = option.value;
                        itemOption.textContent = option.textContent;
                        itemSelect.appendChild(itemOption);
                    });

                itemSelect.dataset.hydratedMode = mode;
                itemSelect.value = Array.from(itemSelect.options).some(option => option.value === selectedValue)
                    ? selectedValue
                    : '';
            }

            function replaceLogisticsItemOptions(itemSelect, mode, selectedValue) {
                if (!itemSelect) {
                    return;
                }

                if (!mode) {
                    itemSelect.replaceChildren();
                    const placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.textContent = '';
                    itemSelect.appendChild(placeholder);
                    delete itemSelect.dataset.hydratedMode;
                    itemSelect.value = '';
                    itemSelect.disabled = true;
                    return;
                }

                itemSelect.disabled = false;

                // Already-open lists stay complete; untouched rows keep just their own value.
                if (itemSelect.dataset.hydratedMode === mode) {
                    itemSelect.value = Array.from(itemSelect.options).some(option => option.value === selectedValue)
                        ? selectedValue
                        : '';
                    return;
                }

                if (itemSelect.dataset.hydratedMode) {
                    // Mode switched: the stale list belongs to the other catalogue.
                    itemSelect.replaceChildren();
                    const placeholder = document.createElement('option');
                    placeholder.value = '';
                    placeholder.textContent = '';
                    itemSelect.appendChild(placeholder);
                    delete itemSelect.dataset.hydratedMode;
                }

                ensureOption(itemSelect, selectedValue, optionTextFor(mode, selectedValue));
                itemSelect.value = selectedValue || '';
            }

            // «راننده آزاد»: فیلد نام راننده همان سطر به فهرست راننده‌ها وصل می‌شود. نام موجود ⇒ DriverId
            // و تماس پر می‌شود؛ نام تازه ⇒ DriverId خالی و سرور هنگام ذخیره پروفایل راننده را می‌سازد.
            const driverCatalog = document.getElementById('loading-driver-options');

            function syncRowDriverSelection(row) {
                const nameInput = row.querySelector('[data-row-driver-name]');
                const idInput = row.querySelector('[data-row-driver-id]');
                const phoneInput = row.querySelector('[data-row-driver-phone]');
                if (!nameInput || !idInput) {
                    return;
                }

                if (getRowLogisticsMode(row) !== 'driver') {
                    idInput.value = '';
                    return;
                }

                const name = nameInput.value.trim();
                const phoneAutofilled = phoneInput?.dataset.driverAutofill === '1';
                const phone = phoneInput && !phoneAutofilled ? phoneInput.value.trim() : '';
                const options = driverCatalog && name
                    ? Array.from(driverCatalog.options).filter(option => option.value === name)
                    : [];
                const match = options.find(option => phone && (option.dataset.driverPhone || '') === phone)
                    || options[0]
                    || null;

                idInput.value = match ? (match.dataset.driverId || '') : '';
                if (phoneInput && (phoneAutofilled || !phoneInput.value.trim())) {
                    phoneInput.value = match ? (match.dataset.driverPhone || '') : '';
                    phoneInput.dataset.driverAutofill = match && phoneInput.value ? '1' : '';
                }
            }

            function syncRowDriverField(row, mode) {
                const nameInput = row.querySelector('[data-row-driver-name]');
                if (nameInput) {
                    if (mode === 'driver') {
                        nameInput.setAttribute('list', 'loading-driver-options');
                    } else {
                        nameInput.removeAttribute('list');
                    }
                }

                syncRowDriverSelection(row);
            }

            function syncRowLogisticsMode(row) {
                const providerSelect = row.querySelector('[data-row-logistics-provider]');
                const assetSelect = row.querySelector('[data-row-operational-asset]');
                const itemSelect = row.querySelector('[data-row-logistics-display]');
                const itemField = row.querySelector('[data-loading-logistics-item-field]');
                const mode = getRowLogisticsMode(row);
                syncRowDriverField(row, mode);
                if (mode === 'driver') {
                    // راننده جای شرکت خدماتی / دارایی را می‌گیرد؛ لیست دوم لازم نیست.
                    replaceLogisticsItemOptions(itemSelect, '', '');
                    if (itemField) {
                        itemField.hidden = true;
                    }
                    [providerSelect, assetSelect].forEach(select => {
                        if (select) {
                            select.value = '';
                            select.disabled = true;
                        }
                    });
                    row.dataset.logisticsMode = mode;
                    return mode;
                }

                const previousMode = row.dataset.logisticsMode || '';
                const modeChanged = !!previousMode && previousMode !== mode;
                const rowSourceSelect = mode === 'owned' ? assetSelect : mode === 'free' ? providerSelect : null;
                const selectedValue = modeChanged ? '' : (itemSelect?.value || rowSourceSelect?.value || '');

                replaceLogisticsItemOptions(itemSelect, mode, selectedValue);
                if (itemField) {
                    itemField.hidden = !mode;
                }
                row.dataset.logisticsMode = mode;

                if (!mode) {
                    if (providerSelect) {
                        providerSelect.value = '';
                        providerSelect.disabled = true;
                    }

                    if (assetSelect) {
                        assetSelect.value = '';
                        assetSelect.disabled = true;
                    }

                    return '';
                }

                const activeValue = itemSelect?.value || '';
                const activeText = activeValue ? optionTextFor(mode, activeValue) : '';

                if (providerSelect) {
                    providerSelect.disabled = mode !== 'free';
                    if (mode === 'free') {
                        ensureOption(providerSelect, activeValue, activeText);
                    }

                    providerSelect.value = mode === 'free' ? activeValue : '';
                }

                if (assetSelect) {
                    assetSelect.disabled = mode !== 'owned';
                    if (mode === 'owned') {
                        ensureOption(assetSelect, activeValue, activeText);
                    }

                    assetSelect.value = mode === 'owned' ? activeValue : '';
                }

                return mode;
            }

            function syncRowLogisticsName(row) {
                const mode = syncRowLogisticsMode(row);
                const providerSelect = row.querySelector('[data-row-logistics-provider]');
                const assetSelect = row.querySelector('[data-row-operational-asset]');
                const nameInput = row.querySelector('[data-row-logistics-name]');
                const activeSelect = mode === 'owned' ? assetSelect : providerSelect;
                if (!mode || mode === 'driver' || !activeSelect || !nameInput) {
                    if (nameInput && getTransportConfig().field !== 'Wagon') {
                        nameInput.value = '';
                    }
                    return;
                }

                const selectedOption = activeSelect.selectedOptions && activeSelect.selectedOptions.length > 0
                    ? activeSelect.selectedOptions[0]
                    : null;
                nameInput.value = activeSelect.value && selectedOption
                    ? selectedOption.textContent.trim()
                    : '';
            }

            function getSelectedContractOptions() {
                if (!contractSelect) {
                    return [];
                }

                return Array.from(contractSelect.querySelectorAll('[data-loading-contract-checkbox]:checked'))
                    .map(input => ({
                        value: input.value,
                        productId: input.dataset.contractProductId || '',
                        productName: input.dataset.contractProductName || '',
                        textContent: input
                            .closest('[data-loading-contract-option]')
                            ?.querySelector('[data-loading-contract-label]')
                            ?.textContent
                            ?.trim() || input.value
                    }))
                    .filter(option => option.value);
            }

            function getSelectedContractIds() {
                return getSelectedContractOptions().map(option => option.value);
            }

            function syncProductFromContracts(selectedOptions) {
                if (!productInput) {
                    return;
                }

                const options = selectedOptions || getSelectedContractOptions();
                const productOptions = options.filter(option => option.productId);
                const productIds = Array.from(new Set(productOptions.map(option => option.productId)));

                if (productIds.length === 1) {
                    const selectedProduct = productOptions.find(option => option.productId === productIds[0]);
                    productInput.value = productIds[0];
                    if (productSummary) {
                        productSummary.textContent = selectedProduct?.productName || 'جنس قرارداد';
                    }
                    return;
                }

                productInput.value = '';
                if (productSummary) {
                    productSummary.textContent = productIds.length > 1
                        ? 'قراردادهای انتخاب‌شده اجناسی متفاوت دارند'
                        : 'از قرارداد تعیین می‌شود';
                }
            }

            function updateContractSummary(selectedOptions) {
                if (!contractSummary) {
                    return;
                }

                const options = selectedOptions || getSelectedContractOptions();
                if (options.length === 0) {
                    contractSummary.textContent = 'انتخاب قرارداد';
                } else if (options.length === 1) {
                    contractSummary.textContent = options[0].textContent;
                } else {
                    contractSummary.textContent = `${options.length} قرارداد انتخاب شد`;
                }
            }

            function setContractDropdownOpen(isOpen) {
                if (!contractField || !contractToggle) {
                    return;
                }

                contractField.classList.toggle('is-open', isOpen);
                contractToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
            }

            function syncPrimaryContractInput(selectedOptions) {
                if (!primaryContractInput) {
                    return;
                }

                const options = selectedOptions || getSelectedContractOptions();
                primaryContractInput.value = options[0]?.value || '';
                syncProductFromContracts(options);
            }

            function replaceRowContractOptions(select, selectedOptions) {
                if (!select) {
                    return;
                }

                const currentValue = select.value;
                select.replaceChildren();

                const placeholder = document.createElement('option');
                placeholder.value = '';
                placeholder.textContent = '';
                select.appendChild(placeholder);

                selectedOptions.forEach(option => {
                    const rowOption = document.createElement('option');
                    rowOption.value = option.value;
                    rowOption.textContent = option.textContent;
                    select.appendChild(rowOption);
                });

                const selectedIds = selectedOptions.map(option => option.value);
                if (selectedIds.includes(currentValue)) {
                    select.value = currentValue;
                } else if (selectedIds.length === 1) {
                    select.value = selectedIds[0];
                } else {
                    select.value = '';
                }
            }

            function syncRowContractSelectors() {
                const selectedOptions = getSelectedContractOptions();
                syncPrimaryContractInput(selectedOptions);
                const showRowContracts = selectedOptions.length > 1;
                updateContractSummary(selectedOptions);

                if (contractColumn) {
                    contractColumn.classList.toggle('d-none', !showRowContracts);
                }

                rowsHost.querySelectorAll('[data-loading-contract-cell]').forEach(cell => {
                    cell.classList.toggle('d-none', !showRowContracts);
                });

                rowsHost.querySelectorAll('[data-row-contract-select]').forEach(select => {
                    replaceRowContractOptions(select, selectedOptions);
                });
            }

            function updateTransportControl(control, config) {
                if (control.tagName === 'SELECT') {
                    const firstOption = control.querySelector('option');
                    if (firstOption) {
                        firstOption.textContent = config.placeholder;
                    }
                    return;
                }

                    control.removeAttribute('placeholder');
            }

            function updateRowVisibility(row) {
                const config = getTransportConfig();
                row.querySelectorAll('[data-transport-field]').forEach((field, index) => {
                    const isActive = config.field !== '' && field.getAttribute('data-transport-field') === config.field;
                    const isPlaceholder = config.field === '' && index === 0;
                    field.classList.toggle('d-none', !isActive && !isPlaceholder);
                    field.setAttribute('aria-hidden', isPlaceholder ? 'true' : 'false');

                    field.querySelectorAll('input, select').forEach(control => {
                        control.disabled = !isActive;
                        if (!isActive) {
                            control.value = '';
                            return;
                        }

                        updateTransportControl(control, config);
                    });
                });

                row.querySelectorAll('[data-transport-label]').forEach(label => {
                    label.textContent = config.label;
                });

                row.querySelectorAll('[data-reference-label]').forEach(label => {
                    label.textContent = config.reference;
                });
            }

            function updateGridHead() {
                const config = getTransportConfig();

                if (referenceColumn) {
                    referenceColumn.textContent = config.reference;
                }

                if (transportColumn) {
                    transportColumn.textContent = config.label;
                }

                document.querySelectorAll('[data-loading-freight-rate-heading]').forEach(heading => {
                    heading.textContent = config.field === 'Wagon' ? 'کرایه خط آهن فی تن' : 'کرایه فی تن';
                });
                document.querySelectorAll('[data-loading-logistics-heading]').forEach(heading => {
                    heading.textContent = config.field === 'Wagon' ? 'شرکت ترانسپورتی' : 'ترانسپورت';
                });

                const showWagonFreight = config.field === 'Wagon' && (!freightToggle || freightToggle.checked);
                document.querySelectorAll('[data-loading-wagon-freight-column]').forEach(column => {
                    column.classList.toggle('d-none', !showWagonFreight);
                });

                if (wagonSummary) {
                    wagonSummary.classList.toggle('d-none', config.field !== 'Wagon');
                }
            }

            function updateSummaryTotals() {
                let quantity = 0;
                let value = 0;
                let rubValue = 0;
                let pendingRubRows = 0;
                let expenses = 0;
                let fileRubValue = 0;
                let hasFileRub = false;
                let wagonCount = 0;
                let chargeableQuantity = 0;
                let railwayExpense = 0;

                rowsHost.querySelectorAll('[data-loading-row]').forEach(row => {
                    const rowQuantity = parseDecimal(row.querySelector('[data-row-quantity]'));
                    const price = readOptionalDecimal(row.querySelector('[data-row-loading-price]'));
                    quantity += rowQuantity;

                    if (price !== null) {
                        value += rowQuantity * price;
                    }

                    expenses += parseDecimal(row.querySelector('[data-row-freight-expense]'));
                    expenses += parseDecimal(row.querySelector('[data-row-warehouse-expense]'));
                    expenses += parseDecimal(row.querySelector('[data-row-railway-expense]'));
                    expenses += parseDecimal(row.querySelector('[data-row-other-expense]'));

                    if (row.querySelector('input[name$=".WagonNumber"]')?.value.trim()) {
                        wagonCount += 1;
                    }
                    const rowRailwayRate = readOptionalDecimal(row.querySelector('[data-row-railway-rate]'))
                        ?? readOptionalDecimal(row.querySelector('[data-row-freight-rate]'));
                    const rowChargeableQuantity = readOptionalDecimal(row.querySelector('[data-row-chargeable-quantity]'));
                    if (rowChargeableQuantity !== null && rowChargeableQuantity > 0) {
                        chargeableQuantity += rowChargeableQuantity;
                    } else if (rowRailwayRate !== null && rowRailwayRate > 0) {
                        chargeableQuantity += rowQuantity;
                    }
                    railwayExpense += parseDecimal(row.querySelector('[data-row-railway-expense]'));

                    const rowRubValue = parseDecimal(row.querySelector('[data-row-rub-amount-hidden]'));
                    const rubStatus = readHiddenValue(row, '[data-row-rub-status]');
                    if (rowRubValue > 0) {
                        rubValue += rowRubValue;
                    } else if (rubStatus === 'Pending') {
                        pendingRubRows += 1;
                    }

                    // ارقام روبلی فایل: مجموع ثابت از ایمپورت (یا فی‌تن×مقدار اگر مجموع نبود).
                    const rowFrubTotal = parseDecimal(row.querySelector('[data-row-frub-amount-hidden]'));
                    const rowFrubRate = parseDecimal(row.querySelector('[data-row-frub-rate-hidden]'));
                    if (rowFrubTotal > 0) {
                        fileRubValue += rowFrubTotal;
                        hasFileRub = true;
                    } else if (rowFrubRate > 0 && rowQuantity > 0) {
                        fileRubValue += rowFrubRate * rowQuantity;
                        hasFileRub = true;
                    }
                });

                const average = quantity > 0 ? value / quantity : 0;
                // واحدها روی خود کارت آماری نوشته شده‌اند، پس مقدارها بدون نماد ارز می‌روند.
                const formattedRub = hasFileRub
                    ? formatMoneyNumber(fileRubValue)
                    : formatRubSummary(rubValue, pendingRubRows);

                window.licWriteStat('lic-stat-quantity', formatQuantityNumber(quantity));
                window.licWriteStat('lic-stat-value', formatMoneyNumber(value));
                window.licWriteStat('lic-stat-average', formatMoneyNumber(average));
                window.licWriteStat('lic-stat-rub', formattedRub);
                window.licWriteStat('lic-stat-expense', formatMoneyNumber(expenses));
                document.querySelector('[data-loading-wagon-count]')?.replaceChildren(String(wagonCount));
                document.querySelector('[data-loading-wagon-loaded]')?.replaceChildren(formatQuantityNumber(quantity));
                document.querySelector('[data-loading-wagon-chargeable]')?.replaceChildren(formatQuantityNumber(chargeableQuantity));
                document.querySelector('[data-loading-wagon-expense]')?.replaceChildren(formatMoneyNumber(railwayExpense));
                document.querySelectorAll('[data-loading-frub-column]').forEach(col => col.classList.toggle('d-none', !hasFileRub));
                refreshRubColumnsVisible();
            }

            function updateRowFreightSnapshot(row) {
                const rate = readOptionalDecimal(row.querySelector('[data-row-freight-rate]'));
                const quantity = parseDecimal(row.querySelector('[data-row-quantity]'));
                const freightExpense = row.querySelector('[data-row-freight-expense]');
                const railwayExpense = row.querySelector('[data-row-railway-expense]');
                const railwayRate = row.querySelector('[data-row-railway-rate]');
                const chargeableQuantity = row.querySelector('[data-row-chargeable-quantity]');
                const railwayExpenseText = row.querySelector('[data-row-railway-expense-text]');
                const config = getTransportConfig();

                if (rate === null) {
                    if (config.field === 'Wagon') {
                        setHiddenDecimal(freightExpense, 0);
                        setHiddenDecimal(railwayExpense, 0);
                        setHiddenDecimal(railwayRate, 0);
                        if (railwayExpenseText) railwayExpenseText.textContent = '-';
                    }
                    return;
                }

                const enteredChargeableQuantity = readOptionalDecimal(chargeableQuantity);
                const effectiveQuantity = config.field === 'Wagon'
                    ? (enteredChargeableQuantity !== null && enteredChargeableQuantity > 0 ? enteredChargeableQuantity : quantity)
                    : quantity;

                if (rate <= 0 || effectiveQuantity <= 0) {
                    setHiddenDecimal(freightExpense, 0);
                    setHiddenDecimal(railwayExpense, 0);
                    setHiddenDecimal(railwayRate, 0);
                    if (config.field !== 'Wagon') setHiddenDecimal(chargeableQuantity, 0);
                    if (railwayExpenseText) railwayExpenseText.textContent = '-';
                    return;
                }

                const total = effectiveQuantity * rate;
                if (config.field === 'Wagon') {
                    setHiddenDecimal(freightExpense, 0);
                    setHiddenDecimal(railwayExpense, total);
                    setHiddenDecimal(railwayRate, rate);
                    if (railwayExpenseText) railwayExpenseText.textContent = `$ ${formatMoneyNumber(total)}`;
                    return;
                }

                setHiddenDecimal(freightExpense, total);
                setHiddenDecimal(railwayExpense, 0);
                setHiddenDecimal(railwayRate, 0);
                setHiddenDecimal(chargeableQuantity, 0);
                if (railwayExpenseText) railwayExpenseText.textContent = '-';
            }

            // ستون‌های «روبل فی تن» و «ارزش روبلی» فقط در سرور از روی مدل نوشته می‌شدند.
            // سطرهای مجازی از قالبِ خالی ساخته می‌شوند، پس متنشان باید از همان مقادیر
            // پنهانِ سطر بازنویسی شود وگرنه با وجود دادهٔ درست، «-» می‌مانند.
            function refreshRowFileRubText(row) {
                const rateText = row.querySelector('[data-row-frub-rate-text]');
                const amountText = row.querySelector('[data-row-frub-amount-text]');
                if (!rateText && !amountText) {
                    return;
                }

                const rate = readOptionalDecimal(row.querySelector('[data-row-frub-rate-hidden]'));
                const amount = readOptionalDecimal(row.querySelector('[data-row-frub-amount-hidden]'));
                if (rateText) {
                    rateText.textContent = rate !== null && rate > 0 ? `₽ ${formatMoneyNumber(rate)}` : '-';
                }
                if (amountText) {
                    amountText.textContent = amount !== null && amount > 0 ? `₽ ${formatMoneyNumber(amount)}` : '-';
                }
            }

            function updateRowTotals(row) {
                updateRowFreightSnapshot(row);
                refreshRowFileRubText(row);
                applyRubSettlementToRow(row);
                const quantity = parseDecimal(row.querySelector('[data-row-quantity]'));
                const price = readOptionalDecimal(row.querySelector('[data-row-loading-price]'));
                const output = row.querySelector('[data-row-loading-value]');

                if (price === null) {
                    row.dataset.loadingValue = '';
                    updateRowRubSnapshot(row, 0, false);
                    if (output) {
                        output.textContent = 'در انتظار نرخ';
                    }
                    updateSummaryTotals();
                    return;
                }

                const total = quantity * price;
                row.dataset.loadingValue = total.toString();
                updateRowRubSnapshot(row, total, true);

                if (output) {
                    output.textContent = `$ ${formatMoneyNumber(total)}`;
                }

                updateSummaryTotals();
            }

            function resolveSuggestedLoadingPrice(pricing, plattsValue) {
                if (!pricing) {
                    return null;
                }

                if (pricing.isFormulaPlatts && plattsValue !== null) {
                    return plattsValue + (pricing.premiumDiscountUsd ?? 0);
                }

                return pricing.finalUnitPrice;
            }

            function getRowContractKey(row) {
                const selectedContractIds = getSelectedContractIds();
                return selectedContractIds.length > 1
                    ? row.querySelector('[data-row-contract-select]')?.value || ''
                    : selectedContractIds[0] || '';
            }

            // وزن پیش‌فرض سطر = باقیماندهٔ قرارداد منهای وزن سطرهای دیگر همان قرارداد؛
            // فقط فیلد خالی یا خودکارپرشده را پر می‌کند و کاربر می‌تواند آن را کم یا زیاد کند.
            function applyDefaultQuantityToRow(row, pricing) {
                const quantityInput = row.querySelector('[data-row-quantity]');
                const remaining = pricing?.remainingQuantityMt;
                if (!quantityInput || row.dataset.virtualIndex !== undefined
                    || typeof remaining !== 'number' || !canAutofill(quantityInput)) {
                    return;
                }

                const contractKey = getRowContractKey(row);
                const otherRowsQuantity = Array.from(rowsHost.querySelectorAll('[data-loading-row]'))
                    .filter(other => other !== row && getRowContractKey(other) === contractKey)
                    .reduce((sum, other) => sum + parseDecimal(other.querySelector('[data-row-quantity]')), 0);
                const suggested = remaining - otherRowsQuantity;

                quantityInput.value = suggested > 0 ? formatInputNumber(suggested) : '';
                setAutofilled(quantityInput, suggested > 0);
            }

            function applyPricingToRow(row) {
                const pricing = getPricingForRow(row);
                applyDefaultQuantityToRow(row, pricing);
                const plattsInput = row.querySelector('[data-row-platts]');
                const priceInput = row.querySelector('[data-row-loading-price]');

                if (pricing && pricing.isFormulaPlatts && plattsInput && canAutofill(plattsInput) && pricing.plattsReferencePrice !== null) {
                    plattsInput.value = formatInputNumber(pricing.plattsReferencePrice);
                    setAutofilled(plattsInput, true);
                }

                const suggestedLoadingPrice = resolveSuggestedLoadingPrice(pricing, readOptionalDecimal(plattsInput));
                if (suggestedLoadingPrice !== null && priceInput && canAutofill(priceInput)) {
                    priceInput.value = formatInputNumber(suggestedLoadingPrice);
                    setAutofilled(priceInput, true);
                }

                updateRowTotals(row);
            }

            function syncRowSequence() {
                rowsHost.querySelectorAll('[data-loading-row]').forEach((row, index) => {
                    const sequence = row.querySelector('[data-loading-row-sequence]');
                    if (sequence) {
                        sequence.textContent = String(index + 1);
                    }
                });
            }

            const loadingDateMonths = [
                'January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'
            ];
            const loadingDateWeekdays = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
            let activeDatePicker = null;
            let visibleDateMonth = new Date();
            let datePickerMode = 'day';
            let visibleYearStart = new Date().getFullYear() - 5;

            function parseIsoDate(value) {
                if (!value || !/^\d{4}-\d{2}-\d{2}$/.test(value)) {
                    return null;
                }

                const parts = value.split('-').map(Number);
                return new Date(parts[0], parts[1] - 1, parts[2]);
            }

            function toIsoDate(date) {
                const year = date.getFullYear();
                const month = String(date.getMonth() + 1).padStart(2, '0');
                const day = String(date.getDate()).padStart(2, '0');
                return `${year}-${month}-${day}`;
            }

            function formatDateLong(date) {
                return `${loadingDateWeekdays[date.getDay()]} ${date.getDate()} ${loadingDateMonths[date.getMonth()]}`;
            }

            function setDateDisplay(display, value) {
                if (!display) {
                    return;
                }

                display.dataset.dateDisplay = value;

                if ('value' in display) {
                    display.value = value;
                }

                const text = display.querySelector('[data-row-date-text]');
                if (text) {
                    text.textContent = value;
                } else {
                    display.textContent = value;
                }

                const visibleText = display.closest('[data-loading-date-picker]')?.querySelector('[data-row-date-visible]');
                if (visibleText) {
                    visibleText.textContent = value;
                }
            }

            function syncDateDisplay(row) {
                const hidden = row.querySelector('[data-row-date-value]');
                const display = row.querySelector('[data-row-date-display]');
                if (!hidden || !display) {
                    return;
                }

                if (!hidden.value) {
                    hidden.value = toIsoDate(new Date());
                }

                setDateDisplay(display, hidden.value);
            }

            function renderDatePicker() {
                if (!dateOverlay || !dateDaysHost || !dateYearLabel || !dateLongLabel || !dateMonthLabel || !activeDatePicker) {
                    return;
                }

                const selectedDate = parseIsoDate(activeDatePicker.hidden.value) ?? new Date();
                const monthDate = new Date(visibleDateMonth.getFullYear(), visibleDateMonth.getMonth(), 1);
                dateYearLabel.textContent = String(selectedDate.getFullYear());
                dateLongLabel.textContent = formatDateLong(selectedDate);
                dateYearLabel.classList.toggle('is-active', datePickerMode === 'year');
                dateOverlay.classList.toggle('is-year-mode', datePickerMode === 'year');

                if (datePickerMode === 'year') {
                    renderYearPicker(selectedDate);
                    return;
                }

                dateDaysHost.classList.remove('is-year-mode');
                dateMonthLabel.textContent = `${loadingDateMonths[monthDate.getMonth()]} ${monthDate.getFullYear()}`;
                dateDaysHost.replaceChildren();

                const firstDay = monthDate.getDay();
                const daysInMonth = new Date(monthDate.getFullYear(), monthDate.getMonth() + 1, 0).getDate();

                for (let blank = 0; blank < firstDay; blank++) {
                    const spacer = document.createElement('span');
                    spacer.className = 'loading-date-day is-muted';
                    spacer.setAttribute('aria-hidden', 'true');
                    dateDaysHost.appendChild(spacer);
                }

                for (let day = 1; day <= daysInMonth; day++) {
                    const date = new Date(monthDate.getFullYear(), monthDate.getMonth(), day);
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'loading-date-day';
                    button.dataset.dateValue = toIsoDate(date);
                    button.innerHTML = `<span>${day}</span>`;
                    if (toIsoDate(date) === toIsoDate(selectedDate)) {
                        button.classList.add('is-selected');
                    }
                    dateDaysHost.appendChild(button);
                }
            }

            function renderYearPicker(selectedDate) {
                const selectedYear = selectedDate.getFullYear();
                const startYear = visibleYearStart;
                dateMonthLabel.textContent = `${startYear} - ${startYear + 11}`;
                dateDaysHost.replaceChildren();
                dateDaysHost.classList.add('is-year-mode');

                for (let index = 0; index < 12; index++) {
                    const year = startYear + index;
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.className = 'loading-date-year-option';
                    button.dataset.yearValue = String(year);
                    button.textContent = String(year);
                    if (year === selectedYear) {
                        button.classList.add('is-selected');
                    }
                    dateDaysHost.appendChild(button);
                }
            }

            function openLoadingDatePicker(row) {
                const picker = row.querySelector('[data-loading-date-picker]');
                const hidden = row.querySelector('[data-row-date-value]');
                const display = row.querySelector('[data-row-date-display]');
                if (!dateOverlay || !picker || !hidden || !display) {
                    return;
                }

                activeDatePicker = { row, picker, hidden, display };
                picker.classList.add('is-open');
                const selectedDate = parseIsoDate(hidden.value) ?? new Date();
                if (!hidden.value) {
                    hidden.value = toIsoDate(selectedDate);
                    setDateDisplay(display, hidden.value);
                }
                visibleDateMonth = new Date(selectedDate.getFullYear(), selectedDate.getMonth(), 1);
                visibleYearStart = selectedDate.getFullYear() - 5;
                datePickerMode = 'day';
                renderDatePicker();
                dateOverlay.setAttribute('aria-hidden', 'false');
                dateOverlay.classList.remove('is-open');
                void dateOverlay.offsetWidth;
                requestAnimationFrame(() => dateOverlay.classList.add('is-open'));
            }

            function closeLoadingDatePicker() {
                if (activeDatePicker?.picker) {
                    activeDatePicker.picker.classList.remove('is-open');
                }
                activeDatePicker = null;
                if (dateOverlay) {
                    dateOverlay.classList.remove('is-open');
                    dateOverlay.classList.remove('is-year-mode');
                    dateOverlay.setAttribute('aria-hidden', 'true');
                }
                if (dateDaysHost) {
                    dateDaysHost.classList.remove('is-year-mode');
                }
                datePickerMode = 'day';
            }

            function selectLoadingDate(value) {
                if (!activeDatePicker || !value) {
                    return;
                }

                activeDatePicker.hidden.value = value;
                setDateDisplay(activeDatePicker.display, value);
                updateRowTotals(activeDatePicker.row);
                closeLoadingDatePicker();
            }

            function selectLoadingYear(value) {
                if (!activeDatePicker || !value) {
                    return;
                }

                const year = Number(value);
                if (!Number.isFinite(year)) {
                    return;
                }

                const selectedDate = parseIsoDate(activeDatePicker.hidden.value) ?? new Date();
                const day = Math.min(selectedDate.getDate(), new Date(year, visibleDateMonth.getMonth() + 1, 0).getDate());
                const nextDate = new Date(year, visibleDateMonth.getMonth(), day);
                activeDatePicker.hidden.value = toIsoDate(nextDate);
                setDateDisplay(activeDatePicker.display, activeDatePicker.hidden.value);
                visibleDateMonth = new Date(year, visibleDateMonth.getMonth(), 1);
                datePickerMode = 'day';
                dateDaysHost?.classList.remove('is-year-mode');
                renderDatePicker();
            }

            function toggleDateYearMode() {
                if (!activeDatePicker) {
                    return;
                }

                const selectedDate = parseIsoDate(activeDatePicker.hidden.value) ?? new Date();
                visibleYearStart = selectedDate.getFullYear() - 5;
                datePickerMode = datePickerMode === 'year' ? 'day' : 'year';
                renderDatePicker();
            }

            function updateAllRows() {
                syncRowContractSelectors();
                updateGridHead();
                rowsHost.querySelectorAll('[data-loading-row]').forEach(row => {
                    updateRowVisibility(row);
                    syncRowLogisticsName(row);
                    syncDateDisplay(row);
                    applyPricingToRow(row);
                });
                syncRowSequence();
                updateSummaryTotals();
            }

            window.loadingCreateRefreshRows = function () {
                updateAllRows();
                applyFreightVisibility();
            };

            async function refreshContractPricing() {
                if (!contractSelect || !suggestedPricingUrl) {
                    return;
                }

                syncRowContractSelectors();
                currentPricing = null;
                const selectedContractIds = getSelectedContractIds();
                if (selectedContractIds.length === 0) {
                    updatePlattsNotice();
                    updateAllRows();
                    return;
                }

                if (selectedContractIds.length === 1) {
                    currentPricing = await getContractPricing(selectedContractIds[0]);
                } else {
                    await Promise.all(selectedContractIds.map(getContractPricing));
                }

                updatePlattsNotice();
                updateAllRows();
            }

            // Controls that belong to the transport-company / operational-asset / freight columns.
            // When freight is not recorded these are cleared, disabled (so they never post) and hidden.
            const freightRowSelector = [
                '[data-row-logistics-type]',
                '[data-row-logistics-display]',
                '[data-row-logistics-provider]',
                '[data-row-operational-asset]',
                '[data-row-logistics-name]',
                '[data-row-freight-rate]',
                '[data-row-freight-expense]',
                '[data-row-railway-expense]',
                '[data-row-railway-rate]',
                '[data-row-chargeable-quantity]',
                '[data-row-driver-id]'
            ].join(',');

            function applyFreightVisibility() {
                const on = !freightToggle || freightToggle.checked;

                document
                    .querySelectorAll('[data-loading-freight-column]')
                    .forEach(cell => {
                        const wagonOnly = cell.hasAttribute('data-loading-wagon-freight-column');
                        cell.classList.toggle('d-none', !on || (wagonOnly && getTransportConfig().field !== 'Wagon'));
                    });

                document
                    .querySelectorAll('.lic-stat-expense, [data-loading-freight-responsibility]')
                    .forEach(el => el.classList.toggle('d-none', !on));

                if (freightToggleText) {
                    freightToggleText.textContent = on ? 'کرایه ثبت می‌شود' : 'بدون ثبت کرایه';
                }

                rowsHost.querySelectorAll('[data-loading-row]').forEach(row => {
                    const controls = row.querySelectorAll(freightRowSelector);
                    if (on) {
                        controls.forEach(control => { control.disabled = false; });
                    } else {
                        controls.forEach(control => {
                            control.value = '';
                            control.disabled = true;
                        });
                        row.dataset.logisticsMode = '';
                    }
                });

                updateSummaryTotals();
            }

            function addRow() {
                if (typeof window.loadingVirtualAppendRow === 'function'
                    && window.loadingVirtualAppendRow()) {
                    return;
                }

                const key = 'row_' + nextRowNumber++;
                const html = template.innerHTML.replaceAll('__key__', key);
                rowsHost.insertAdjacentHTML('beforeend', html);
                updateAllRows();
                applyFreightVisibility();
            }

            addButton.addEventListener('click', addRow);
            datePrevButton?.addEventListener('click', function () {
                if (datePickerMode === 'year') {
                    visibleYearStart -= 12;
                } else {
                    visibleDateMonth = new Date(visibleDateMonth.getFullYear(), visibleDateMonth.getMonth() - 1, 1);
                }
                renderDatePicker();
            });
            dateNextButton?.addEventListener('click', function () {
                if (datePickerMode === 'year') {
                    visibleYearStart += 12;
                } else {
                    visibleDateMonth = new Date(visibleDateMonth.getFullYear(), visibleDateMonth.getMonth() + 1, 1);
                }
                renderDatePicker();
            });
            dateYearLabel?.addEventListener('click', function (event) {
                event.stopPropagation();
                toggleDateYearMode();
            });
            dateHeader?.addEventListener('click', function (event) {
                if (event.target.closest('[data-loading-date-locale]')) {
                    return;
                }

                toggleDateYearMode();
            });
            dateDaysHost?.addEventListener('click', function (event) {
                const yearButton = event.target.closest('[data-year-value]');
                if (yearButton) {
                    selectLoadingYear(yearButton.dataset.yearValue);
                    return;
                }

                const dayButton = event.target.closest('[data-date-value]');
                if (dayButton) {
                    selectLoadingDate(dayButton.dataset.dateValue);
                }
            });
            dateOverlay?.addEventListener('click', function (event) {
                if (event.target === dateOverlay) {
                    closeLoadingDatePicker();
                }
            });
            resetButton?.addEventListener('click', function () {
                window.setTimeout(updateAllRows, 0);
            });
            contractToggle?.addEventListener('click', function () {
                setContractDropdownOpen(!contractField?.classList.contains('is-open'));
            });
            document.addEventListener('click', function (event) {
                if (!contractField || contractField.contains(event.target)) {
                    return;
                }

                setContractDropdownOpen(false);
            });
            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    setContractDropdownOpen(false);
                    closeLoadingDatePicker();
                }
            });
            transportSelect.addEventListener('change', updateAllRows);
            contractSelect?.addEventListener('change', refreshContractPricing);
            freightToggle?.addEventListener('change', function () {
                if (freightToggle.checked) {
                    updateAllRows();
                }
                applyFreightVisibility();
            });
            // قفل دکمهٔ ذخیره تا پایان ثبت سرور، تا ثبت تکراری رخ ندهد.
            const loadingSaveBtn = document.querySelector('[data-loading-save]');
            let loadingSubmitInProgress = false;

            function setLoadingSaveBusy(busy) {
                if (!loadingSaveBtn) {
                    return;
                }

                if (busy) {
                    if (!loadingSaveBtn.dataset.idleText) {
                        loadingSaveBtn.dataset.idleText = loadingSaveBtn.textContent;
                    }
                    loadingSaveBtn.textContent = loadingSaveBtn.dataset.busyText || 'در حال ثبت...';
                    loadingSaveBtn.setAttribute('aria-busy', 'true');
                    // غیرفعال‌سازی با تأخیر تا ارسال فرم متوقف نشود.
                    setTimeout(() => { loadingSaveBtn.disabled = true; }, 0);
                } else {
                    loadingSaveBtn.disabled = false;
                    loadingSaveBtn.removeAttribute('aria-busy');
                    if (loadingSaveBtn.dataset.idleText) {
                        loadingSaveBtn.textContent = loadingSaveBtn.dataset.idleText;
                    }
                }
            }

            function showOperationStatus(title, detail) {
                if (!operationStatus) {
                    return;
                }

                if (operationTitle) operationTitle.textContent = title;
                if (operationDetail) operationDetail.textContent = detail;
                // تلاش تازه، حالت خطای تلاش قبلی را پاک می‌کند.
                operationStatus.classList.remove('is-error');
                operationStatus.querySelector('.spinner-border')?.classList.remove('d-none');
                operationStatus.classList.remove('d-none');
                operationStatus.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
            }

            // اگر پاسخ سرور هرگز نرسد (قطع شبکه، بسته‌شدن اتصال، خطای پروکسی) دکمه نباید
            // تا ابد روی حالت «در حال ثبت» بماند؛ این نگهبان آن را آزاد و پیام روشن نشان می‌دهد.
            const loadingSubmitTimeoutMs = 120000;
            let loadingSubmitWatchdogId = null;
            // آیا همین حالا یک POST واقعی روی سیم است؟ فقط وقتی true می‌شود که رویداد
            // submit تا آخر بدون لغو رد شده باشد.
            let loadingPostInFlight = false;

            function clearLoadingSubmitWatchdog() {
                if (loadingSubmitWatchdogId !== null) {
                    window.clearTimeout(loadingSubmitWatchdogId);
                    loadingSubmitWatchdogId = null;
                }
            }

            // قفلِ ضدِ ارسالِ دوباره مالِ core.js است و روی خودِ فرم می‌نشیند
            // (data-ptg-submitting). اگر صفحه فقط حالتِ داخلی خودش را آزاد کند و این قفل
            // را نگه دارد، دکمه فعال به‌نظر می‌رسد ولی هر ذخیرهٔ بعدی تا پایان مهلتِ کهنگی
            // با پیام «ثبت قبلی هنوز در جریان است» لغو می‌شود و کاربر مجبور به رفرش است.
            // پس هر مسیرِ آزادسازی باید همین‌جا قفل مشترک را هم پس بدهد.
            function releaseSharedSubmitLock() {
                // تا وقتی POST زنده است قفل دست‌نخورده می‌ماند؛ آزادکردن زودهنگام یعنی
                // اجازهٔ ثبت دوباره وسط همان ثبت.
                if (loadingPostInFlight || !loadingForm) {
                    return;
                }

                window.PTG?.releaseFormSubmit?.(loadingForm);
            }

            // فقط نقاشیِ جعبهٔ وضعیت؛ هیچ قفلی آزاد نمی‌کند. برای حالتی است که POST واقعاً
            // در جریان است و قفل باید سرِ جایش بماند.
            function paintOperationFailure(title, detail) {
                if (!operationStatus) {
                    return;
                }

                operationStatus.classList.remove('d-none');
                operationStatus.classList.add('is-error');
                operationStatus.querySelector('.spinner-border')?.classList.add('d-none');
                if (operationTitle) operationTitle.textContent = title;
                if (operationDetail) operationDetail.textContent = detail;
            }

            // ثبت انجام نشد و هیچ POSTی در جریان نیست: همان بازنشانی مشترک (نگهبان، قفل
            // مشترک، دکمه) و بعد نمایش علت.
            function showOperationFailure(title, detail) {
                resetLoadingSubmissionUi(true);
                paintOperationFailure(title, detail);
            }

            // بخشِ سطرهای مجازی وقتی ثبت را متوقف می‌کند، علت را در همین جعبهٔ وضعیت
            // (بالای جدول، کنار دکمه) نشان می‌دهد نه فقط در نوار کوچک ایمپورت.
            window.loadingShowSubmitBlocked = function (title, detail) {
                showOperationFailure(title, detail);
            };

            // پیامِ خطا با آزادکردن دکمه پاک نمی‌شود؛ فقط حالتِ «در حال ثبت» برداشته می‌شود
            // تا کاربر دلیلِ ثبت‌نشدن را جلوی چشم داشته باشد. clearError=true همه‌چیز را پاک می‌کند.
            function resetLoadingSubmissionUi(clearError) {
                clearLoadingSubmitWatchdog();
                loadingSubmitInProgress = false;
                setLoadingSaveBusy(false);
                releaseSharedSubmitLock();
                if (!operationStatus) {
                    return;
                }

                if (clearError === true || !operationStatus.classList.contains('is-error')) {
                    operationStatus.classList.add('d-none');
                    operationStatus.classList.remove('is-error');
                    operationStatus.querySelector('.spinner-border')?.classList.remove('d-none');
                }
            }

            // اگر کنترلی اعتبارسنجی مرورگر را رد کند، خودِ مرورگر ارسال را متوقف می‌کند و
            // هیچ رویداد submit و هیچ POST ساخته نمی‌شود. قبلاً این حالت کاملاً بی‌صدا بود.
            // اینجا فیلد مقصر نام‌گذاری، اسکرول و focus می‌شود. مقدار بازگشتی: آیا مانعی هست.
            function reportLoadingInvalidField() {
                const invalid = loadingForm?.querySelector(':invalid');
                if (!invalid) {
                    return false;
                }

                const label = invalid.closest('[data-loading-row]')
                    ? `${invalid.getAttribute('name') || invalid.id || invalid.tagName} (در سطرهای بارگیری)`
                    : (invalid.getAttribute('name') || invalid.id || invalid.tagName);
                const isHidden = !(invalid.offsetWidth || invalid.offsetHeight || invalid.getClientRects().length);
                const reason = invalid.validationMessage || 'مقدار این فیلد معتبر نیست.';
                showOperationFailure(
                    'ثبت انجام نشد؛ فورم کامل نیست.',
                    `فیلد نامعتبر: ${label} — ${reason}`
                        + (isHidden ? ' این فیلد پنهان است؛ فیلترها را پاک کنید تا دیده شود.' : ''));

                if (!isHidden) {
                    invalid.scrollIntoView({ block: 'center', behavior: 'smooth' });
                    try { invalid.focus({ preventScroll: true }); } catch (_) { /* unfocusable */ }
                }

                return true;
            }

            // بازگشت با دکمهٔ Back مرورگر نباید دکمه را قفل نگه دارد.
            window.addEventListener('pageshow', function () {
                // صفحه از bfcache برگشته: هیچ POSTی از آن ارسال زنده نمانده است.
                loadingPostInFlight = false;
                resetLoadingSubmissionUi(true);
            });

            // اعتبارسنجی بومی مرورگر رویداد submit را شلیک نمی‌کند؛ رویداد invalid تنها
            // نشانهٔ آن است. با آن هم همان پیام روشن نشان داده می‌شود.
            loadingForm?.addEventListener('invalid', function () {
                window.setTimeout(reportLoadingInvalidField, 0);
            }, true);

            // گاردِ ضدِ ارسالِ دوباره (core.js) قبلاً ارسال را بی‌صدا لغو می‌کرد و هیچ
            // POST ساخته نمی‌شد. حالا دلیل را همین‌جا کنار دکمه نشان می‌دهیم.
            loadingForm?.addEventListener('ptg:submit-blocked', function (event) {
                const reason = event.detail?.reason;
                if (reason === 'in-progress') {
                    // اینجا تنها جایی است که قفل عمداً نگه داشته می‌شود: یعنی واقعاً یک POST
                    // در جریان است و آزادکردن قفل، همان ثبت تکراری را ممکن می‌کرد.
                    paintOperationFailure(
                        'ثبت قبلی هنوز در جریان است.',
                        'تا پایان ثبت قبلی صبر کنید؛ نیازی به رفرش نیست. اگر پاسخی نیامد، بعد از پایان مهلت دوباره ذخیره کنید.');
                    return;
                }

                if (!reportLoadingInvalidField()) {
                    showOperationFailure(
                        'ثبت انجام نشد.',
                        'ارسال فورم توسط مرورگر متوقف شد. صفحه را تازه کرده و دوباره تلاش کنید.');
                }
            });

            // پیش‌نویس خودکار (form-draft.js): پیش از خواندن فیلدها، سطرهای مجازی (امپورت بزرگ) در همان
            // فیلد فشردهٔ ثبت نوشته می‌شوند تا پیش‌نویس دقیقاً همان چیزی باشد که ذخیره ارسال می‌کند.
            loadingForm?.addEventListener('ptg:draft-serialize', function (event) {
                if (typeof window.loadingVirtualRowsBeforeSubmit === 'function') {
                    window.loadingVirtualRowsBeforeSubmit();
                }
                const summary = (contractSummary?.textContent || '').trim();
                event.detail.summary = summary && summary !== 'انتخاب قرارداد' ? summary : null;
                const rowCount = Number.parseInt(document.querySelector('[data-lic-count-total]')?.textContent || '', 10);
                event.detail.rowCount = Number.isFinite(rowCount) ? rowCount : null;
            });

            loadingForm?.addEventListener('submit', function (event) {
                if (loadingSubmitInProgress) {
                    event.preventDefault();
                    return;
                }
                if (typeof window.loadingVirtualRowsBeforeSubmit === 'function') {
                    window.loadingVirtualRowsBeforeSubmit();
                }
                loadingForm.action = loadingForm.dataset.createAction || '@createPostUrl';
                syncPrimaryContractInput();
                rowsHost.querySelectorAll('[data-loading-row]').forEach(row => {
                    syncRowLogisticsName(row);
                    updateRowFreightSnapshot(row);
                    updateRowTotals(row);
                });
            });

            // این listener در سطح document بعد از validation فرم اجرا می‌شود؛ بنابراین
            // spinner فقط زمانی روشن می‌شود که POST واقعاً اجازهٔ ارسال گرفته باشد.
            document.addEventListener('submit', function (event) {
                if (event.target !== loadingForm) {
                    return;
                }
                if (event.defaultPrevented) {
                    resetLoadingSubmissionUi();
                    return;
                }

                // حالت «در حال ثبت» فقط وقتی روشن می‌شود که فرم واقعاً معتبر باشد؛
                // وگرنه گاردِ core.js ارسال را لغو می‌کند و دکمه بی‌دلیل قفل می‌ماند.
                // از :invalid استفاده می‌شود نه checkValidity، چون checkValidity رویداد
                // invalid را شلیک می‌کند و گاردها را بی‌جهت بازنشانی می‌کند.
                if (!loadingForm.noValidate && reportLoadingInvalidField()) {
                    resetLoadingSubmissionUi();
                    return;
                }

                loadingSubmitInProgress = true;
                // از این لحظه POST واقعاً روی سیم است؛ تا وقتی خلافش ثابت نشود قفل مشترک
                // آزاد نمی‌شود، وگرنه ارسال دوم همان بارگیری‌ها را دوباره ثبت می‌کرد.
                loadingPostInFlight = true;
                setLoadingSaveBusy(true);
                const rowCount = document.querySelector('[data-lic-count-total]')?.textContent || '';
                showOperationStatus(
                    'در حال ثبت بارگیری‌ها...',
                    rowCount ? `${rowCount} سطر در یک عملیات امن ذخیره می‌شود. لطفاً صفحه را نبندید.` : 'لطفاً صفحه را نبندید.');

                clearLoadingSubmitWatchdog();
                loadingSubmitWatchdogId = window.setTimeout(function () {
                    loadingSubmitWatchdogId = null;
                    // مهلت تمام شد: POST مرده حساب می‌شود تا کاربر بدون رفرش دوباره
                    // تلاش کند. مهلت کهنگی قفل core.js هم دقیقاً همین اندازه است.
                    loadingPostInFlight = false;
                    showOperationFailure(
                        'پاسخی از سرور دریافت نشد.',
                        'ثبت انجام نشد یا پاسخ آن نرسید. ابتدا فهرست بارگیری‌ها را بررسی کنید؛ اگر ثبت نشده بود دوباره ذخیره کنید.');
                }, loadingSubmitTimeoutMs);

                // شنونده‌های بعدیِ همین رویداد (از جمله گاردِ ضدِ ارسالِ دوبارهٔ core.js و
                // اعتبارسنجی مرورگر) می‌توانند ارسال را لغو کنند و انتشار رویداد را هم
                // متوقف کنند؛ آن‌وقت هیچ ناوبری‌ای رخ نمی‌دهد. وضعیت نهایی رویداد در تیک
                // بعد سنجیده می‌شود تا دکمه هرگز روی حالت «در حال ثبت» قفل نماند.
                window.setTimeout(function () {
                    if (event.defaultPrevented) {
                        loadingPostInFlight = false;
                        resetLoadingSubmissionUi();
                    }
                }, 0);
            });

            // unobtrusive validation ارسال نامعتبر را در خود فرم متوقف می‌کند و رویداد
            // به document نمی‌رسد؛ در آن حالت UI باید آزاد بماند و نخستین خطا دیده شود.
            if (window.jQuery && loadingForm) {
                window.jQuery(loadingForm).on('invalid-form.validate', function () {
                    resetLoadingSubmissionUi();
                    window.requestAnimationFrame(function () {
                        const firstError = loadingForm.querySelector('.input-validation-error');
                        firstError?.scrollIntoView({ block: 'center', behavior: 'smooth' });
                        firstError?.focus({ preventScroll: true });
                    });
                });
            }


            rowsHost.addEventListener('click', event => {
                const dateTrigger = event.target.closest('[data-row-date-display]');
                if (dateTrigger) {
                    const row = dateTrigger.closest('[data-loading-row]');
                    if (row) {
                        openLoadingDatePicker(row);
                    }
                    return;
                }

                const removeButton = event.target.closest('[data-loading-row-remove]');
                if (!removeButton) {
                    return;
                }

                const row = removeButton.closest('[data-loading-row]');
                if (!row) {
                    return;
                }

                if (typeof window.loadingVirtualRemoveRow === 'function'
                    && window.loadingVirtualRemoveRow(row)) {
                    return;
                }

                row.remove();
                if (!rowsHost.querySelector('[data-loading-row]')) {
                    addRow();
                    return;
                }

                updateAllRows();
            });

            // Fill a row's transport list the moment the user reaches for it. Capture phase so
            // the options exist before the browser opens the dropdown.
            ['pointerdown', 'focusin', 'ak-entity:open'].forEach(eventName => {
                rowsHost.addEventListener(eventName, event => {
                    const itemSelect = event.target.closest('[data-row-logistics-display]');
                    if (!itemSelect) {
                        return;
                    }

                    const row = itemSelect.closest('[data-loading-row]');
                    if (row) {
                        hydrateLogisticsItemOptions(itemSelect, getRowLogisticsMode(row));
                    }
                }, true);
            });

            rowsHost.addEventListener('input', event => {
                const row = event.target.closest('[data-loading-row]');
                if (!row) {
                    return;
                }

                if (event.target.matches('[data-row-logistics-type], [data-row-logistics-display]')) {
                    syncRowLogisticsName(row);
                    updateRowTotals(row);
                    return;
                }

                if (event.target.matches('[data-row-driver-phone]')) {
                    event.target.dataset.driverAutofill = '';
                }

                if (event.target.matches('[data-row-driver-name], [data-row-driver-phone]')) {
                    syncRowDriverSelection(row);
                }

                if (event.target.matches('[data-row-platts]')) {
                    setAutofilled(event.target, false);
                    applyPricingToRow(row);
                    return;
                }

                if (event.target.matches('[data-row-loading-price], [data-row-quantity]')) {
                    setAutofilled(event.target, false);
                }

                if (event.target.matches('[data-row-rub-rate]')) {
                    setAutofilled(event.target, false);
                }

                updateRowTotals(row);
            });

            rowsHost.addEventListener('change', event => {
                const row = event.target.closest('[data-loading-row]');
                if (!row) {
                    return;
                }

                if (event.target.matches('[data-row-contract-select]')) {
                    applyPricingToRow(row);
                    return;
                }

                if (event.target.matches('[data-row-logistics-type], [data-row-logistics-display], [data-row-logistics-provider], [data-row-operational-asset]')) {
                    syncRowLogisticsName(row);
                    updateRowTotals(row);
                    return;
                }

                if (event.target.matches('[data-row-platts], [data-row-loading-price]')) {
                    applyPricingToRow(row);
                    return;
                }

                updateRowTotals(row);
            });

            updateAllRows();
            refreshContractPricing().finally(() => {
                // Pricing can populate imported rows after the preview status has already
                // rendered. Notify the preview once those programmatic values are final.
                window.setTimeout(() => document.dispatchEvent(new CustomEvent('loading:rows-refreshed')), 0);
            });
            applyFreightVisibility();
        })();
    </script>
    <script>
        // ---- Virtual preview / search / status filter -------------------
        // Large imports keep their complete row data in one compact JSON value.
        // Only the current page is materialised as form controls, preventing
        // thousands of table rows from freezing the browser.
        (function () {
            const host = document.querySelector('[data-loading-rows]');
            const toolbar = document.querySelector('[data-lic-toolbar]');
            if (!host || !toolbar) {
                return;
            }

            const searchInput = document.querySelector('[data-lic-search]');
            const filterSelect = document.querySelector('[data-lic-filter]');
            const pageSizeSelect = document.querySelector('[data-lic-pagesize]');
            const pager = document.querySelector('[data-lic-pagination]');
            const pageInfo = document.querySelector('[data-lic-page-info]');
            const prevBtn = document.querySelector('[data-lic-prev]');
            const nextBtn = document.querySelector('[data-lic-next]');
            const statsSection = document.querySelector('[data-loading-stats]');
            const countTotalEls = document.querySelectorAll('[data-lic-count-total]');
            const countValidEls = document.querySelectorAll('[data-lic-count-valid]');
            const countErrorEls = document.querySelectorAll('[data-lic-count-error]');
            const compactInput = document.getElementById('loadingImportedRowsJson');
            const compactData = document.getElementById('loadingImportedRowsData');
            const rowTemplate = document.getElementById('loading-row-template');
            const providerCatalog = document.getElementById('loading-provider-catalog');
            const assetCatalog = document.getElementById('loading-asset-catalog');

            let currentPage = 1;
            let virtualRows = null;
            let initialVirtualRows = null;
            if (compactData?.textContent) {
                try {
                    const parsed = JSON.parse(compactData.textContent);
                    if (Array.isArray(parsed)) {
                        virtualRows = parsed;
                        initialVirtualRows = JSON.parse(JSON.stringify(parsed));
                    }
                } catch (error) {
                    console.error('Loading import preview data is invalid.', error);
                }
            }

            const numericFields = new Set([
                'contractId', 'vesselId', 'truckId', 'logisticsServiceProviderId',
                'operationalAssetId', 'loadedQuantityMt', 'plattsUsd', 'loadingPriceUsd',
                'freightRateUsdPerMt', 'transportExpenseUsd', 'warehouseExpenseUsd',
                'otherExpenseUsd', 'chargeableQuantityMt', 'railwayRateUsd',
                'railwayExpenseUsd', 'rubPerUsdRate', 'amountUsdAtRubLock',
                'amountRubAtRubLock', 'settlementUnitPriceRub', 'settlementValueRub',
                'driverId'
            ]);
            const editableFields = [
                'contractId', 'loadingDate', 'importedTransportReference',
                'billOfLadingNumber', 'wagonNumber', 'routeDescription',
                'logisticsCompanyName', 'logisticsServiceProviderId', 'operationalAssetId',
                'consigneeName', 'destinationName', 'transitNumber', 'driverName',
                'driverPhone', 'loadedQuantityMt', 'plattsUsd',
                'loadingPriceUsd', 'freightRateUsdPerMt', 'transportExpenseUsd',
                'warehouseExpenseUsd', 'otherExpenseUsd', 'chargeableQuantityMt',
                'railwayRateUsd', 'railwayExpenseUsd', 'settlementCurrencyCode',
                'rubRateStatus', 'rubRatePolicy', 'rubPerUsdRate', 'rubRateDate',
                'rubRateSource', 'amountUsdAtRubLock', 'amountRubAtRubLock',
                'settlementUnitPriceRub', 'settlementValueRub',
                'logisticsMode', 'driverId'
            ];

            function rows() {
                return Array.from(host.querySelectorAll('[data-loading-row]'));
            }

            function propertyToField(property) {
                return property.charAt(0).toUpperCase() + property.slice(1);
            }

            function controlsFor(row, property) {
                const field = propertyToField(property);
                return Array.from(row.querySelectorAll(
                    `input[name$=".${field}"], select[name$=".${field}"]`));
            }

            function activeControl(row, property) {
                const controls = controlsFor(row, property);
                return controls.find(control => !control.disabled) || controls[0] || null;
            }

            function parseNumber(value) {
                if (value === null || value === undefined || value === '') {
                    return null;
                }
                const parsed = Number.parseFloat(String(value).replace(/,/g, ''));
                return Number.isFinite(parsed) ? parsed : null;
            }

            function syncDomRows() {
                if (!virtualRows) {
                    return;
                }

                rows().forEach(row => {
                    const index = Number.parseInt(row.dataset.virtualIndex || '', 10);
                    if (!Number.isInteger(index) || !virtualRows[index]) {
                        return;
                    }

                    const data = virtualRows[index];
                    editableFields.forEach(property => {
                        const control = activeControl(row, property);
                        if (!control) {
                            return;
                        }
                        data[property] = numericFields.has(property)
                            ? parseNumber(control.value)
                            : (control.value === '' ? null : control.value);
                    });

                    const lossEnabled = row.querySelector('input[name$=".Loss.Enabled"]');
                    const lossStage = row.querySelector('input[name$=".Loss.Stage"]');
                    data.loss = data.loss || {};
                    if (lossEnabled) data.loss.enabled = String(lossEnabled.value).toLowerCase() === 'true';
                    if (lossStage) data.loss.stage = lossStage.value;
                });
            }

            function ensureSelectOption(select, value, catalog) {
                if (!select || value === null || value === undefined || value === '') {
                    return;
                }
                const textValue = String(value);
                if (Array.from(select.options).some(option => option.value === textValue)) {
                    return;
                }
                const source = catalog
                    ? Array.from(catalog.options).find(option => option.value === textValue)
                    : null;
                select.add(new Option(source?.text || textValue, textValue));
            }

            function writeControlValue(row, property, value) {
                const controls = controlsFor(row, property);
                controls.forEach(control => {
                    if (control.matches('[data-row-logistics-provider]')) {
                        ensureSelectOption(control, value, providerCatalog);
                    } else if (control.matches('[data-row-operational-asset]')) {
                        ensureSelectOption(control, value, assetCatalog);
                    }
                    const normalized = value === null || value === undefined
                        ? ''
                        : (property.endsWith('Date') ? String(value).slice(0, 10) : String(value));
                    control.value = normalized;
                });
            }

            function hydrateLogistics(row, data) {
                const providerId = data.logisticsServiceProviderId;
                const assetId = data.operationalAssetId;
                const mode = assetId ? 'owned'
                    : providerId ? 'free'
                    : (data.logisticsMode === 'driver' || data.driverId) ? 'driver' : '';
                const typeSelect = row.querySelector('[data-row-logistics-type]');
                const displaySelect = row.querySelector('[data-row-logistics-display]');
                const selectedValue = assetId || providerId || '';
                const catalog = assetId ? assetCatalog : providerCatalog;
                if (typeSelect) typeSelect.value = mode;
                ensureSelectOption(displaySelect, selectedValue, catalog);
                if (displaySelect) displaySelect.value = selectedValue ? String(selectedValue) : '';
                const itemField = row.querySelector('[data-loading-logistics-item-field]');
                if (itemField && mode === 'driver') itemField.hidden = true;
                const driverNameInput = row.querySelector('[data-row-driver-name]');
                if (driverNameInput && mode === 'driver') driverNameInput.setAttribute('list', 'loading-driver-options');
                row.dataset.logisticsMode = mode;
            }

            function createVirtualRow(dataIndex) {
                const data = virtualRows[dataIndex];
                const key = data.rowKey || `row_${dataIndex}`;
                data.rowKey = key;
                const wrapper = document.createElement('tbody');
                wrapper.innerHTML = rowTemplate.innerHTML.replaceAll('__key__', key).trim();
                const row = wrapper.firstElementChild;
                row.dataset.virtualIndex = String(dataIndex);

                editableFields.forEach(property => writeControlValue(row, property, data[property]));
                const lossEnabled = row.querySelector('input[name$=".Loss.Enabled"]');
                const lossStage = row.querySelector('input[name$=".Loss.Stage"]');
                if (lossEnabled) lossEnabled.value = data.loss?.enabled === true ? 'true' : 'false';
                if (lossStage && data.loss?.stage) lossStage.value = data.loss.stage;
                hydrateLogistics(row, data);

                const sequence = row.querySelector('[data-loading-row-sequence]');
                if (sequence) sequence.textContent = String(dataIndex + 1);
                applyRowIssues(row, data);
                return row;
            }

            // خطاهای امپورت روی همان سطر و همان فیلد نشان داده می‌شوند؛ هیچ جدول یا پنل جدایی وجود ندارد.
            function importIssues(data) {
                return (data && data.importMeta && Array.isArray(data.importMeta.issues))
                    ? data.importMeta.issues
                    : [];
            }

            function applyRowIssues(row, data) {
                const issues = importIssues(data);
                const excelRow = data.importMeta?.excelRow;
                if (excelRow) {
                    const sequence = row.querySelector('[data-loading-row-sequence]');
                    if (sequence) sequence.title = `سطر ${excelRow} فایل اکسل`;
                }

                row.classList.toggle('lic-row-error', issues.length > 0);
                if (!issues.length) {
                    return;
                }

                issues.forEach(issue => {
                    const control = issue.field ? activeControl(row, issue.field) : null;
                    const cell = control ? control.closest('td') : row.querySelector('td');
                    if (control) {
                        control.classList.add('lic-input-error');
                        control.dataset.importIssueField = issue.field || '';
                    }
                    if (!cell) {
                        return;
                    }
                    const note = document.createElement('span');
                    note.className = 'ak-field-error';
                    note.dataset.importIssue = issue.field || '';
                    note.textContent = excelRow
                        ? `سطر ${excelRow} اکسل: ${issue.message}`
                        : issue.message;
                    cell.appendChild(note);
                });
            }

            // با اصلاح مقدار همان فیلد، خطای همان فیلد پاک می‌شود.
            function clearIssueForControl(control) {
                const row = control.closest('[data-loading-row]');
                if (!row || !control.classList.contains('lic-input-error')) {
                    return;
                }

                const index = Number.parseInt(row.dataset.virtualIndex || '', 10);
                const data = virtualRows && Number.isInteger(index) ? virtualRows[index] : null;
                const field = control.dataset.importIssueField || '';
                control.classList.remove('lic-input-error');
                row.querySelectorAll(`[data-import-issue="${field}"]`).forEach(note => note.remove());
                if (data && data.importMeta) {
                    data.importMeta.issues = importIssues(data).filter(issue => (issue.field || '') !== field);
                    row.classList.toggle('lic-row-error', data.importMeta.issues.length > 0);
                }
            }

            function fieldValue(row, suffix) {
                const el = row.querySelector('input[name$="' + suffix + '"]');
                return el ? (el.value || '') : '';
            }

            function rowStatus(row) {
                const qtyEl = row.querySelector('[data-row-quantity]');
                const priceEl = row.querySelector('[data-row-loading-price]');
                const qtyText = (qtyEl?.value || '').trim();
                const priceText = (priceEl?.value || '').trim();

                // A fresh untouched row is neutral, not an error. It becomes invalid only
                // after one of the two required numeric fields has been started.
                if (!qtyText && !priceText) {
                    return 'empty';
                }

                const qty = Number.parseFloat(qtyText.replace(/,/g, ''));
                const price = Number.parseFloat(priceText.replace(/,/g, ''));
                return Number.isFinite(qty) && qty > 0 && Number.isFinite(price) && price > 0
                    ? 'valid'
                    : 'error';
            }

            function dataStatus(row) {
                if (importIssues(row).length > 0) {
                    return 'error';
                }
                const qty = parseNumber(row.loadedQuantityMt);
                const price = parseNumber(row.loadingPriceUsd);
                if ((!qty || qty <= 0) && (!price || price <= 0)) {
                    return 'empty';
                }
                return qty > 0 && price > 0 ? 'valid' : 'error';
            }

            function rowMatchesSearch(row, term) {
                if (!term) {
                    return true;
                }
                const haystack = [
                    fieldValue(row, '.BillOfLadingNumber'),
                    fieldValue(row, '.WagonNumber'),
                    fieldValue(row, '.ImportedTransportReference'),
                    fieldValue(row, '.ConsigneeName'),
                    fieldValue(row, '.DestinationName')
                ].join(' ').toLowerCase();
                return haystack.indexOf(term) !== -1;
            }

            function dataMatchesSearch(row, term) {
                if (!term) {
                    return true;
                }
                const haystack = [
                    row.billOfLadingNumber,
                    row.wagonNumber,
                    row.importedTransportReference,
                    row.consigneeName,
                    row.destinationName
                ].filter(Boolean).join(' ').toLowerCase();
                return haystack.indexOf(term) !== -1;
            }

            function pageSize() {
                const n = Number.parseInt(pageSizeSelect?.value || '100', 10);
                return Number.isFinite(n) && n > 0 ? n : 100;
            }

            function setCountText(total, valid, errors) {
                countTotalEls.forEach(el => { el.textContent = total; });
                countValidEls.forEach(el => { el.textContent = valid; });
                countErrorEls.forEach(el => { el.textContent = errors; });
                // سطر خالیِ پیش‌فرض نه معتبر است نه خطادار؛ پس کارت‌های آماری تا ورود
                // نخستین مقدار (دستی یا از اکسل) پنهان می‌مانند.
                statsSection?.classList.toggle('d-none', valid + errors === 0);
            }

            function updateVirtualTotals() {
                if (!virtualRows) {
                    return;
                }
                let quantity = 0;
                let value = 0;
                let expenses = 0;
                let rubValue = 0;
                let pendingRub = 0;
                let fileRubValue = 0;
                let hasFileRub = false;
                let wagonCount = 0;
                let chargeableQuantity = 0;
                let railwayExpense = 0;

                virtualRows.forEach(row => {
                    const qty = parseNumber(row.loadedQuantityMt) || 0;
                    const price = parseNumber(row.loadingPriceUsd);
                    quantity += qty;
                    if (price !== null) value += qty * price;
                    expenses += parseNumber(row.transportExpenseUsd) || 0;
                    expenses += parseNumber(row.warehouseExpenseUsd) || 0;
                    expenses += parseNumber(row.railwayExpenseUsd) || 0;
                    expenses += parseNumber(row.otherExpenseUsd) || 0;
                    if (String(row.wagonNumber || '').trim()) wagonCount += 1;
                    const railRate = parseNumber(row.railwayRateUsd) ?? parseNumber(row.freightRateUsdPerMt);
                    const chargeable = parseNumber(row.chargeableQuantityMt);
                    if (chargeable !== null && chargeable > 0) chargeableQuantity += chargeable;
                    else if (railRate !== null && railRate > 0) chargeableQuantity += qty;
                    railwayExpense += parseNumber(row.railwayExpenseUsd) || 0;

                    const lockedRub = parseNumber(row.amountRubAtRubLock);
                    if (lockedRub && lockedRub > 0) rubValue += lockedRub;
                    else if (row.rubRateStatus === 'Pending') pendingRub += 1;

                    const fileTotal = parseNumber(row.settlementValueRub);
                    const fileRate = parseNumber(row.settlementUnitPriceRub);
                    if (fileTotal && fileTotal > 0) {
                        fileRubValue += fileTotal;
                        hasFileRub = true;
                    } else if (fileRate && fileRate > 0 && qty > 0) {
                        fileRubValue += fileRate * qty;
                        hasFileRub = true;
                    }
                });

                const money = valueToFormat => new Intl.NumberFormat('en-US', {
                    minimumFractionDigits: 0,
                    maximumFractionDigits: 2
                }).format(valueToFormat);
                const rubText = hasFileRub
                    ? money(fileRubValue)
                    : rubValue > 0 ? money(rubValue) : pendingRub > 0 ? 'در انتظار نرخ' : '-';

                // همان کارت‌های آماری مشترک؛ واحد ارز روی خود کارت است.
                window.licWriteStat('lic-stat-quantity', new Intl.NumberFormat('en-US', { maximumFractionDigits: 4 }).format(quantity));
                window.licWriteStat('lic-stat-value', money(value));
                window.licWriteStat('lic-stat-average', money(quantity > 0 ? value / quantity : 0));
                window.licWriteStat('lic-stat-expense', money(expenses));
                window.licWriteStat('lic-stat-rub', rubText);
                document.querySelector('[data-loading-wagon-count]')?.replaceChildren(String(wagonCount));
                document.querySelector('[data-loading-wagon-loaded]')?.replaceChildren(new Intl.NumberFormat('en-US', { maximumFractionDigits: 4 }).format(quantity));
                document.querySelector('[data-loading-wagon-chargeable]')?.replaceChildren(new Intl.NumberFormat('en-US', { maximumFractionDigits: 4 }).format(chargeableQuantity));
                document.querySelector('[data-loading-wagon-expense]')?.replaceChildren(money(railwayExpense));
            }

            function renderVirtual() {
                syncDomRows();
                const term = (searchInput?.value || '').trim().toLowerCase();
                const filter = filterSelect?.value || 'all';
                let valid = 0;
                let errors = 0;
                const visibleIndexes = [];

                virtualRows.forEach((row, index) => {
                    const status = dataStatus(row);
                    if (status === 'valid') valid += 1;
                    if (status === 'error') errors += 1;
                    const passStatus = filter === 'all'
                        || (filter === 'valid' && status === 'valid')
                        || (filter === 'error' && status === 'error');
                    if (passStatus && dataMatchesSearch(row, term)) visibleIndexes.push(index);
                });
                setCountText(virtualRows.length, valid, errors);

                const size = pageSize();
                const pageCount = Math.max(1, Math.ceil(visibleIndexes.length / size));
                currentPage = Math.min(Math.max(currentPage, 1), pageCount);
                const start = (currentPage - 1) * size;
                const pageIndexes = visibleIndexes.slice(start, start + size);
                const fragment = document.createDocumentFragment();
                pageIndexes.forEach(index => fragment.appendChild(createVirtualRow(index)));
                host.replaceChildren(fragment);
                window.loadingCreateRefreshRows?.();
                pageIndexes.forEach((index, pageIndex) => {
                    const sequence = host.querySelectorAll('[data-loading-row]')[pageIndex]
                        ?.querySelector('[data-loading-row-sequence]');
                    if (sequence) sequence.textContent = String(index + 1);
                });
                updateVirtualTotals();

                const needsPager = visibleIndexes.length > size;
                if (pager) pager.hidden = !needsPager;
                if (pageInfo) {
                    const from = visibleIndexes.length ? start + 1 : 0;
                    const to = Math.min(start + size, visibleIndexes.length);
                    pageInfo.textContent = `صفحه ${currentPage} از ${pageCount} — ردیف ${from} تا ${to} از ${visibleIndexes.length}`;
                }
                if (prevBtn) prevBtn.disabled = currentPage <= 1;
                if (nextBtn) nextBtn.disabled = currentPage >= pageCount;
            }

            function renderDomRows() {
                const all = rows();
                const term = (searchInput?.value || '').trim().toLowerCase();
                const filter = filterSelect?.value || 'all';

                let total = 0;
                let valid = 0;
                let errors = 0;
                const visible = [];

                all.forEach(row => {
                    total += 1;
                    const status = rowStatus(row);
                    const isValid = status === 'valid';
                    if (isValid) {
                        valid += 1;
                    }
                    if (status === 'error') {
                        errors += 1;
                    }
                    row.classList.toggle('lic-row-error', status === 'error');

                    const passStatus = filter === 'all'
                        || (filter === 'valid' && isValid)
                        || (filter === 'error' && status === 'error');
                    if (passStatus && rowMatchesSearch(row, term)) {
                        visible.push(row);
                    }
                });

                setCountText(total, valid, errors);

                const size = pageSize();
                const pageCount = Math.max(1, Math.ceil(visible.length / size));
                if (currentPage > pageCount) {
                    currentPage = pageCount;
                }
                if (currentPage < 1) {
                    currentPage = 1;
                }
                const start = (currentPage - 1) * size;
                const end = start + size;

                // Hide everything, then reveal only the current page slice.
                all.forEach(row => row.classList.add('lic-row-hidden'));
                visible.slice(start, end).forEach(row => row.classList.remove('lic-row-hidden'));

                if (pager) {
                    const needsPager = visible.length > size;
                    pager.hidden = !needsPager;
                    if (needsPager && pageInfo) {
                        const from = visible.length ? start + 1 : 0;
                        const to = Math.min(end, visible.length);
                        pageInfo.textContent = `صفحه ${currentPage} از ${pageCount} — ردیف ${from} تا ${to} از ${visible.length}`;
                    }
                    if (prevBtn) prevBtn.disabled = currentPage <= 1;
                    if (nextBtn) nextBtn.disabled = currentPage >= pageCount;
                }
            }

            function render() {
                if (virtualRows) {
                    renderVirtual();
                } else {
                    renderDomRows();
                }
            }

            let debounceId = null;
            function scheduleRender(resetPage) {
                if (resetPage) {
                    currentPage = 1;
                }
                window.clearTimeout(debounceId);
                debounceId = window.setTimeout(render, 120);
            }

            searchInput?.addEventListener('input', () => scheduleRender(true));
            filterSelect?.addEventListener('change', () => scheduleRender(true));
            pageSizeSelect?.addEventListener('change', () => scheduleRender(true));
            prevBtn?.addEventListener('click', () => { currentPage -= 1; render(); });
            nextBtn?.addEventListener('click', () => { currentPage += 1; render(); });

            host.addEventListener('input', () => {
                if (virtualRows) {
                    syncDomRows();
                    updateVirtualTotals();
                } else {
                    scheduleRender(false);
                }
            });
            host.addEventListener('change', () => {
                if (virtualRows) {
                    syncDomRows();
                    updateVirtualTotals();
                } else {
                    scheduleRender(false);
                }
            });
            document.addEventListener('loading:rows-refreshed', () => {
                if (virtualRows) {
                    syncDomRows();
                    updateVirtualTotals();
                } else {
                    scheduleRender(false);
                }
            });

            host.addEventListener('input', event => {
                if (event.target instanceof Element) {
                    clearIssueForControl(event.target);
                }
            }, true);
            host.addEventListener('change', event => {
                if (event.target instanceof Element) {
                    clearIssueForControl(event.target);
                }
            }, true);

            let domObserver = null;

            function bindDomObserver() {
                let addObserverPending = false;
                domObserver = new MutationObserver(mutations => {
                    if (mutations.some(m => m.addedNodes.length > 0)) addObserverPending = true;
                    scheduleRender(false);
                    if (addObserverPending) {
                        addObserverPending = false;
                        currentPage = Math.max(1, Math.ceil(rows().length / pageSize()));
                        render();
                    }
                });
                domObserver.observe(host, { childList: true });
            }

            function bindVirtualHooks() {
                window.loadingVirtualRowsBeforeSubmit = function () {
                    syncDomRows();
                    if (compactInput) compactInput.value = JSON.stringify(virtualRows);
                };

                window.loadingVirtualAppendRow = function () {
                    syncDomRows();
                    const today = new Date();
                    const isoDate = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
                    virtualRows.push({
                        rowKey: `row_${Date.now()}_${virtualRows.length}`,
                        contractId: Number.parseInt(document.querySelector('[data-loading-primary-contract]')?.value || '', 10) || null,
                        loadingDate: isoDate,
                        loadedQuantityMt: 0,
                        settlementCurrencyCode: 'USD',
                        rubRateStatus: 'NotRequired',
                        rubRatePolicy: 'NotApplicable',
                        loss: { enabled: false, stage: 'LoadingDifference' }
                    });
                    if (searchInput) searchInput.value = '';
                    if (filterSelect) filterSelect.value = 'all';
                    currentPage = Math.max(1, Math.ceil(virtualRows.length / pageSize()));
                    renderVirtual();
                    return true;
                };

                window.loadingVirtualRemoveRow = function (row) {
                    syncDomRows();
                    const index = Number.parseInt(row.dataset.virtualIndex || '', 10);
                    if (!Number.isInteger(index) || !virtualRows[index]) return false;
                    virtualRows.splice(index, 1);
                    if (virtualRows.length === 0) {
                        window.loadingVirtualAppendRow();
                    } else {
                        renderVirtual();
                    }
                    return true;
                };

                document.querySelector('[data-loading-freight-toggle]')?.addEventListener('change', event => {
                    syncDomRows();
                    if (!event.target.checked) {
                        virtualRows.forEach(row => {
                            row.logisticsServiceProviderId = null;
                            row.operationalAssetId = null;
                            row.logisticsMode = null;
                            row.driverId = null;
                            row.logisticsCompanyName = null;
                            row.freightRateUsdPerMt = null;
                            row.transportExpenseUsd = null;
                            row.chargeableQuantityMt = null;
                            row.railwayRateUsd = null;
                            row.railwayExpenseUsd = null;
                        });
                    }
                    updateVirtualTotals();
                });

                document.querySelectorAll('[data-loading-contract-checkbox]').forEach(checkbox => {
                    checkbox.addEventListener('change', () => {
                        syncDomRows();
                        const selectedIds = Array.from(document.querySelectorAll('[data-loading-contract-checkbox]:checked'))
                            .map(item => Number.parseInt(item.value, 10))
                            .filter(Number.isFinite);
                        if (selectedIds.length === 1) {
                            virtualRows.forEach(row => { row.contractId = selectedIds[0]; });
                        } else if (selectedIds.length > 1) {
                            virtualRows.forEach(row => {
                                if (!selectedIds.includes(Number(row.contractId))) row.contractId = null;
                            });
                        }
                        renderVirtual();
                    });
                });

                document.querySelector('[data-loading-reset]')?.addEventListener('click', () => {
                    window.setTimeout(() => {
                        virtualRows = JSON.parse(JSON.stringify(initialVirtualRows || []));
                        currentPage = 1;
                        renderVirtual();
                    }, 0);
                });
            }

            // ---- Excel import ------------------------------------------------
            // فایل خوانده می‌شود و سطرهایش مستقیماً به همان مجموعهٔ سطرهای فرم اضافه می‌شود.
            // هیچ پنل، مرحله، پیش‌نمایش یا ثبت جداگانه‌ای وجود ندارد.
            const importComponent = document.querySelector('[data-loading-import] [data-excel-import]');
            const importSummary = document.querySelector('[data-loading-import-summary]');
            const loadingFormEl = document.querySelector('[data-loading-create-form]');
            const importUrl = '@importPostUrl';

            // کلید Jobهای قدیمی امپورت دیگر معنایی ندارد؛ پاک می‌شود تا هیچ وضعیت کهنه‌ای برنگردد.
            try {
                Object.keys(localStorage)
                    .filter(key => key.startsWith('ptg-excel-job:') && key.includes('/Loading'))
                    .forEach(key => localStorage.removeItem(key));
            } catch (error) {
                /* دسترسی نبود، مهم نیست */
            }

            function isBlankData(data) {
                return !data.billOfLadingNumber
                    && !data.wagonNumber
                    && !data.importedTransportReference
                    && !data.consigneeName
                    && !data.destinationName
                    && !(parseNumber(data.loadedQuantityMt) > 0);
            }

            // سطرهای دستی موجود در DOM به همان ساختار داده‌ای سطرها تبدیل می‌شوند تا با
            // سطرهای اکسل در یک مجموعه قرار بگیرند و ثبت نهایی هر دو را با هم بفرستد.
            function captureDomRowsAsData() {
                return rows().map((row, index) => {
                    const data = { rowKey: row.dataset.rowKey || `row_${index}` };
                    editableFields.forEach(property => {
                        const control = activeControl(row, property);
                        if (!control) return;
                        data[property] = numericFields.has(property)
                            ? parseNumber(control.value)
                            : (control.value === '' ? null : control.value);
                    });
                    const lossStage = row.querySelector('input[name$=".Loss.Stage"]');
                    data.loss = { enabled: false, stage: lossStage?.value || 'LoadingDifference' };
                    // وزن پیش‌فرضِ خودکار به‌تنهایی سطر خالی را «پر» حساب نکند.
                    if (activeControl(row, 'loadedQuantityMt')?.dataset.autofilled === 'true'
                        && isBlankData({ ...data, loadedQuantityMt: null })) {
                        return null;
                    }
                    return data;
                }).filter(data => data && !isBlankData(data));
            }

            function ensureVirtualMode() {
                if (virtualRows) {
                    return;
                }
                virtualRows = captureDomRowsAsData();
                initialVirtualRows = JSON.parse(JSON.stringify(virtualRows));
                domObserver?.disconnect();
                domObserver = null;
                // سطرهای فعلی DOM دیگر نگاشت مستقیم به داده ندارند؛ رندر بعدی آن‌ها را از نو می‌سازد.
                rows().forEach(row => { delete row.dataset.virtualIndex; });
                bindVirtualHooks();
            }

            function showImportMessage(message, isError, onClick) {
                if (!importSummary) return;
                importSummary.textContent = message || '';
                importSummary.classList.toggle('d-none', !message);
                importSummary.classList.toggle('is-error', !!isError);
                importSummary.classList.toggle('is-clickable', typeof onClick === 'function');
                importSummary.onclick = typeof onClick === 'function' ? onClick : null;
            }

            function firstErrorIndex() {
                return virtualRows ? virtualRows.findIndex(row => importIssues(row).length > 0) : -1;
            }

            function goToFirstErrorRow() {
                const index = firstErrorIndex();
                if (index < 0) return;
                if (searchInput) searchInput.value = '';
                if (filterSelect) filterSelect.value = 'all';
                currentPage = Math.max(1, Math.ceil((index + 1) / pageSize()));
                renderVirtual();
                const target = host.querySelector('.lic-row-error');
                target?.scrollIntoView({ block: 'center', behavior: 'smooth' });
                target?.querySelector('.lic-input-error')?.focus({ preventScroll: true });
            }

            function applyImportedRows(payload) {
                ensureVirtualMode();
                const incoming = payload.rows || [];
                const stamp = Date.now();
                incoming.forEach((item, index) => {
                    const data = Object.assign({}, item.row);
                    data.rowKey = `xls_${stamp}_${index}`;
                    data.importMeta = {
                        excelRow: item.excelRowNumber,
                        sheet: item.sheetName,
                        issues: item.issues || []
                    };
                    virtualRows.push(data);
                });

                if (searchInput) searchInput.value = '';
                if (filterSelect) filterSelect.value = 'all';
                currentPage = 1;
                renderVirtual();
            }

            async function runImport(file) {
                const body = new FormData();
                body.append('ImportWorkbookFile', file);
                const token = loadingFormEl?.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) body.append('__RequestVerificationToken', token);
                document.querySelectorAll('[data-loading-contract-checkbox]:checked')
                    .forEach(checkbox => body.append('SelectedContractIds', checkbox.value));
                const primaryContract = document.querySelector('[data-loading-primary-contract]')?.value;
                if (primaryContract) body.append('ContractId', primaryContract);
                const originSelect = document.querySelector('#OriginLocationId');
                if (originSelect?.value) body.append('OriginLocationId', originSelect.value);
                if (document.querySelector('[data-loading-freight-toggle]')?.checked) {
                    body.append('RecordFreight', 'true');
                }

                const response = await fetch(importUrl, { method: 'POST', body, credentials: 'same-origin' });
                if (!response.ok) {
                    throw new Error('فایل ارسال نشد. اتصال یا حجم فایل را بررسی کنید.');
                }
                return response.json();
            }

            // کامپوننت مشترک فقط فایل را می‌دهد؛ خواندن و افزودن سطرها همان منطق قبلی است.
            importComponent?.addEventListener('excel-import:start', async event => {
                const api = event.detail;
                showImportMessage('', false, null);
                api.progress({ stage: 2, message: 'در حال خواندن سطرهای فایل…' });
                try {
                    const payload = await runImport(api.file);
                    if (!payload || payload.success !== true) {
                        const problems = (payload && payload.globalErrors) || [];
                        api.fail(problems.join(' ') || (payload && payload.message) || 'فایل قابل امپورت نیست.');
                        return;
                    }

                    if (payload.transportType) {
                        const transportSelect = document.querySelector('[data-loading-transport-type]');
                        if (transportSelect && String(transportSelect.value) !== String(payload.transportType)) {
                            transportSelect.value = String(payload.transportType);
                            transportSelect.dispatchEvent(new Event('change', { bubbles: true }));
                        }
                    }
                    if (payload.originLocationId) {
                        const originSelect = document.querySelector('#OriginLocationId');
                        if (originSelect && !originSelect.value) originSelect.value = String(payload.originLocationId);
                    }

                    applyImportedRows(payload);
                    showImportMessage(
                        payload.message,
                        payload.invalidRows > 0,
                        payload.invalidRows > 0 ? goToFirstErrorRow : null);
                    api.complete({ message: payload.message || 'سطرهای فایل به جدول افزوده شد.' });
                } catch (error) {
                    api.fail(error.message || 'خواندن فایل انجام نشد.');
                }
            });

            // جلوگیری از ثبت تا وقتی سطر دارای خطا در فرم هست.
            loadingFormEl?.addEventListener('submit', event => {
                if (!virtualRows) return;
                syncDomRows();
                const blocked = virtualRows.filter(row => importIssues(row).length > 0);
                if (blocked.length === 0) return;
                event.preventDefault();

                // علتِ نخستین سطر همراه پیام می‌آید؛ وگرنه کاربر فقط می‌بیند «ثبت نشد»
                // و دلیلش (مثلاً تکراری‌بودن) فقط داخل خودِ سطر پنهان می‌ماند.
                const reason = (importIssues(blocked[0])[0] || {}).message || '';
                const detail = `${blocked.length} سطر مشکل دارد و هیچ سطری ثبت نشد.`
                    + (reason ? ` نمونه: ${reason}` : '')
                    + ' سطرهای قرمز را اصلاح یا حذف کنید.';
                showImportMessage(detail, true, goToFirstErrorRow);
                if (typeof window.loadingShowSubmitBlocked === 'function') {
                    window.loadingShowSubmitBlocked('ثبت انجام نشد.', detail);
                } else {
                    document.querySelector('[data-loading-operation-status]')?.classList.add('d-none');
                }
                goToFirstErrorRow();
            });

            if (!virtualRows) {
                bindDomObserver();
            } else {
                rows().forEach((row, index) => { row.dataset.virtualIndex = String(index); });
                bindVirtualHooks();
            }

            render();
        })();
    </script>
}
