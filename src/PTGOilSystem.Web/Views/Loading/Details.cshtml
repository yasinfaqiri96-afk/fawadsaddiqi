@model PTGOilSystem.Web.Models.Loading.LoadingDetailsViewModel
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);

    ViewData["Title"] = T("جزئیات بارگیری", "Loading details");
    ViewData["HideSectionTabs"] = true;
    ViewData["LoadingExpenseEditorAssets"] = true;

    var returnUrl = ViewBag.ReturnUrl as string;
    var loadingListReturnUrl = Url.Action("Index", "Loading", new { contractId = Model.ContractId }) ?? "/Loading";
    var effectiveReturnUrl = !string.IsNullOrWhiteSpace(returnUrl) ? returnUrl : loadingListReturnUrl;
    var currentPageReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var contractUrl = Url.Action("Index", "ContractJourney", new { contractId = Model.ContractId }) ?? "#";
    var expenseEditorUrl = Url.Action("EditExpenses", "Loading", new { id = Model.Id, returnUrl = currentPageReturnUrl });
    var receiptEditorUrl = Model.CanRegisterReceipt
        ? Url.Action("Create", "LoadingReceipts", new { loadingId = Model.Id, returnUrl = currentPageReturnUrl })
        : null;

    var loadingComplete = Model.RemainingToReceiveMt <= 0m;
    var statusText = loadingComplete ? T("تکمیل‌شده", "Completed") : T("در انتظار رسید", "Awaiting receipt");
    var statusState = loadingComplete ? "is-active" : "is-warning";
    var loadingCostsGrandTotal = Model.LoadingCostsGrandTotalUsd;
    var shortageTotal = Model.ChargeableLossTotalMt;
    var isRubSettlement = string.Equals(Model.SettlementCurrencyCode, "RUB", StringComparison.OrdinalIgnoreCase);
    var showRubRateForm = isRubSettlement
        && Model.RubRateStatus == PTGOilSystem.Web.Models.Entities.RubSettlementRateStatus.Pending;

    // قیمت ثابت همان «قیمت فی تن» است؛ مبنا فقط وقتی Platts باشد سطر جدا می‌گیرد.
    var pricingMethod = Model.PlattsUsd.HasValue
        ? $"Platts {Model.PlattsUsd.Value:N2}"
        : null;

    var referenceLabel = Model.TransportType switch
    {
        PTGOilSystem.Web.Models.Entities.LoadingTransportType.Truck => T("شماره CMR", "CMR no."),
        PTGOilSystem.Web.Models.Entities.LoadingTransportType.Vessel => T("بارنامه کشتی", "Vessel bill"),
        PTGOilSystem.Web.Models.Entities.LoadingTransportType.Wagon => T("شماره RWB", "RWB no."),
        _ => T("شماره سند", "Document no.")
    };
    var transportVisualAvatar = Model.TransportType switch
    {
        PTGOilSystem.Web.Models.Entities.LoadingTransportType.Truck => "transported",
        PTGOilSystem.Web.Models.Entities.LoadingTransportType.Wagon => "wagon",
        _ => null
    };
    var transportVisualTitle = Model.TransportType switch
    {
        PTGOilSystem.Web.Models.Entities.LoadingTransportType.Truck => T("تانکر مواد نفتی", "Petroleum tanker truck"),
        PTGOilSystem.Web.Models.Entities.LoadingTransportType.Wagon => T("واگن نفتی", "Rail tank wagon"),
        _ => null
    };

    // هر fact فقط یک بار در صفحه می‌آید. هر fact که مقدار نداشته باشد خودکار حذف
    // می‌شود، پس ترتیب کارت‌ها هرگز جابه‌جا نمی‌شود.
    // مسیر بالای کارت اصلی: مبدأ و مقصد کنار هم.
    var routeNodes = new List<AkInfoItem>
    {
        new() { Label = T("ترمینل / مبدأ", "Terminal / origin"), Value = Model.OriginLocationName },
        new() { Label = T("مقصد", "Destination"), Value = Model.DestinationName }
    };

    // نوع حمل و نمبر وسیله زیر تصویر وسیله در کارت مقادیر نوشته می‌شوند؛ فقط وقتی
    // تصویری نیست (کشتی) اینجا تکرار می‌شوند تا هیچ داده‌ای گم نشود.
    var hasTransportVisual = transportVisualAvatar is not null;
    // شرکت خدماتی‌ای که سند کرایه دارد با مبلغش در کارت کرایه می‌آید.
    var serviceProviderIsFreightParty = Model.LogisticsServiceProviderId.HasValue
        && Model.FreightParties.Any(p => !p.IsInternal && p.ServiceProviderId == Model.LogisticsServiceProviderId);
    var mainItems = new List<AkInfoItem>
    {
        new() { Label = T("نوع حمل", "Transport type"), Value = hasTransportVisual ? null : Model.TransportTypeLabel },
        new() { Label = T("نمبر وسیله", "Vehicle no."), Value = hasTransportVisual ? null : Model.VehicleSummary, IsNumeric = true },
        new() { Label = referenceLabel, Value = Model.BillOfLadingNumber, IsNumeric = true },
        new() { Label = T("نمبر ترانزیت", "Transit no."), Value = Model.TransitNumber, IsNumeric = true },
        new() { Label = T("راننده", "Driver"), Value = Model.DriverName,
                Href = Model.DriverId.HasValue ? Url.Action("Details", "Drivers", new { id = Model.DriverId.Value }) : null },
        new() { Label = T("تماس راننده", "Driver phone"), Value = Model.DriverPhone, IsNumeric = true },
        new() { Label = T("شرکت خدماتی", "Service provider"), Value = serviceProviderIsFreightParty ? null : Model.LogisticsCompanyName,
                Href = Model.LogisticsServiceProviderId.HasValue
                    ? Url.Action("Details", "ServiceProviders", new { id = Model.LogisticsServiceProviderId.Value, returnUrl = currentPageReturnUrl })
                    : null }
    };

    var transportDetailsUrl = Model.ActiveTransportCount > 0 && Model.FirstActiveTransportLegId.HasValue
        ? Model.ActiveTransportCount == 1
            ? Url.Action("Details", "InventoryTransportLegs", new { id = Model.FirstActiveTransportLegId.Value, returnUrl = currentPageReturnUrl })
            : Url.Action("CancelFromLoading", "Transports", new { loadingId = Model.Id })
        : null;

    var pricingItems = new List<AkInfoItem>
    {
        new() { Label = T("مبنای قیمت", "Pricing basis"), Value = pricingMethod },
        new() { Label = T("قیمت فی تن", "Unit price"), Value = Model.LoadingPriceUsd?.ToString("N2"), Unit = "USD/MT", IsNumeric = true },
        new() { Label = T("ارزش بارگیری", "Loading value"), Value = Model.LoadingValueUsd?.ToString("N2"), Unit = "USD", IsNumeric = true },
        new() { Label = T("مجموع مصارف", "Total expenses"), Value = loadingCostsGrandTotal.ToString("N2"), Unit = "USD", IsNumeric = true }
    };

    // ارزش روبلی از منبع واحد پروژه خوانده می‌شود، نه فقط از ارقام فایل بارگیری.
    // LoadingRubValuation.Resolve همان ترتیب اولویتی را دارد که دفترکل و پروفایل
    // تأمین‌کننده استفاده می‌کنند، پس این صفحه عدد متفاوتی از بقیهٔ سیستم نمی‌دهد.
    var rubValue = LoadingRubValuation.Resolve(
        new LoadingRubFacts(
            Model.LoadedQuantityMt,
            Model.LoadingPriceUsd,
            Model.RubRateStatus,
            Model.RubPerUsdRate,
            Model.AmountRubAtRubLock,
            Model.SettlementUnitPriceRub,
            Model.SettlementValueRub),
        contractFinalPriceUsd: null);

    if (Model.RubPerUsdRate is > 0m)
    {
        pricingItems.Add(new AkInfoItem
        {
            Label = T("نرخ ارز تسویه", "Settlement rate"),
            Value = Model.RubPerUsdRate.Value.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture),
            Unit = "RUB/USD",
            IsNumeric = true
        });
    }

    if (rubValue.HasValue)
    {
        pricingItems.Add(new AkInfoItem
        {
            Label = T("معادل ارز تسویه", "Settlement value"),
            Value = rubValue.AmountRub!.Value.ToString("N2"),
            Unit = "RUB",
            IsNumeric = true
        });
    }
    else if (isRubSettlement)
    {
        // بارگیری روبلی بدون نرخ: به‌جای سطر خالی، دلیلِ نبودِ رقم گفته می‌شود.
        pricingItems.Add(new AkInfoItem
        {
            Label = T("معادل ارز تسویه", "Settlement value"),
            Value = T("در انتظار نرخ", "Awaiting rate"),
            Tone = "warning"
        });
    }

    // آواتارهای این صفحه عمداً با صفحهٔ جزئیات حمل فرق دارند تا کاربر از نگاه اول
    // بفهمد کجاست: پرکردن وسیله ← رسید سند ← کسری وزن ← باقی در مخزن.
    var quantityMetrics = new List<AkKpiItem>
    {
        new() { Title = T("بارگیری", "Loaded"), Value = NumberDisplay.Quantity(Model.LoadedQuantityMt), Unit = "MT", State = "accent", Avatar = "flow-nozzle" },
        new()
        {
            Title = T("رسید", "Received"),
            Value = transportDetailsUrl is null
                ? NumberDisplay.Quantity(Model.TotalReceivedQuantityMt)
                : T("به حمل تبدیل شده", "Converted to transport"),
            Unit = transportDetailsUrl is null ? "MT" : null,
            State = transportDetailsUrl is null ? null : "success",
            Avatar = transportDetailsUrl is null ? "flow-receipt-check" : "flow-truck",
            Href = transportDetailsUrl
        },
        new() { Title = T("کسری", "Shortage"), Value = NumberDisplay.Quantity(shortageTotal), Unit = "MT", State = shortageTotal > 0m ? "warning" : null, Avatar = "flow-weight-minus" },
        new() { Title = T("باقی", "Remaining"), Value = NumberDisplay.Quantity(Model.RemainingToReceiveMt), Unit = "MT", Avatar = "flow-tank-gauge" }
    };

    var timelineItems = new List<AkTimelineItem>
    {
        new() { Title = T("بارگیری ثبت شد", "Loading registered"), Date = Model.LoadingDate.ToDisplayDate(), Timestamp = Model.LoadingDate,
                Icon = "bi-box-arrow-up", State = "is-current", Meta = $"{NumberDisplay.Quantity(Model.LoadedQuantityMt)} MT" }
    };
    timelineItems.AddRange(Model.ReceiptItems.Where(item => !item.IsCancelled).Select(item => new AkTimelineItem
    {
        Title = T("رسید بارگیری ثبت شد", "Loading receipt recorded"), Date = item.ReceiptDate.ToDisplayDate(), Timestamp = item.ReceiptDate,
        Icon = "bi-box-arrow-in-down", Href = Url.Action("Details", "LoadingReceipts", new { id = item.Id, returnUrl = currentPageReturnUrl }),
        Meta = $"{NumberDisplay.Quantity(item.ReceivedQuantityMt)} MT"
    }));
    timelineItems.AddRange(Model.CustomsItems.Select(item => new AkTimelineItem
    {
        Title = T("گمرک ثبت شد", "Customs recorded"), Date = item.DeclarationDate.ToDisplayDate(), Timestamp = item.DeclarationDate,
        Icon = "bi-shield-check", Href = Url.Action("Details", "CustomsDeclarations", new { id = item.Id, returnUrl = currentPageReturnUrl }),
        Meta = $"{item.TotalUsd:N2} USD"
    }));
    timelineItems.AddRange(Model.LossItems.Select(item => new AkTimelineItem
    {
        Title = T("کسری ثبت شد", "Shortage recorded"), Date = item.EventDate.ToDisplayDate(), Timestamp = item.EventDate,
        Icon = "bi-exclamation-diamond", Href = Url.Action("Details", "LossEvents", new { id = item.Id, returnUrl = currentPageReturnUrl }),
        Meta = $"{NumberDisplay.Quantity(item.ChargeableLossMt)} MT"
    }));

    var editUrl = Url.Action("Edit", new { id = Model.Id, returnUrl = currentPageReturnUrl });
    var receiptAction = new AkHeaderMenuItem { Label = T("ثبت رسید", "Register receipt"), Href = receiptEditorUrl, Icon = "bi-box-arrow-in-down" };
    var transportAction = new AkHeaderMenuItem { Label = T("تبدیل به حمل", "Convert to transport"), Href = Url.Action("FromLoading", "Transports", new { loadingRegisterId = Model.Id }), Icon = "bi-truck" };
    var customsAction = new AkHeaderMenuItem { Label = T("ثبت گمرک", "Register customs"), Href = Url.Action("Create", "CustomsDeclarations", new { loadingRegisterId = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-shield-check" };
    var editAction = new AkHeaderMenuItem { Label = T("ویرایش", "Edit"), Href = editUrl, Icon = "bi-pencil-square" };
    var expenseAction = new AkHeaderMenuItem { Label = T("ثبت مصارف", "Register expenses"), Href = expenseEditorUrl, Icon = "bi-receipt-cutoff" };
    var lossAction = new AkHeaderMenuItem { Label = T("ثبت کسری", "Register shortage"), Href = Url.Action("Create", "LossEvents", new { contractId = Model.ContractId, loadingRegisterId = Model.Id, returnUrl = currentPageReturnUrl }), Icon = "bi-exclamation-diamond" };

    // تمام عملیات صفحه در هدر جمع می‌شوند: گام بعدی واضح است، یک اکشن مستقیم
    // کنارش می‌ماند و گزینه‌های فرعی در منوی سه‌نقطه قرار می‌گیرند.
    var primaryAction = Model.CanRegisterReceipt ? receiptAction : customsAction;
    ViewData["AkHeaderCompanionAction"] = Model.CanRegisterReceipt ? transportAction : editAction;
    var headerMenu = new List<AkHeaderMenuItem>
    {
        editAction,
        customsAction,
        expenseAction,
        lossAction,
        new() { Label = T("نمای قرارداد", "Contract journey"), Href = contractUrl, Icon = "bi-diagram-3" },
        new() { Label = T("حمل‌های این بارگیری", "Transports of this loading"), Href = Url.Action("CancelFromLoading", "Transports", new { loadingId = Model.Id }), Icon = "bi-truck" }
    };
    if (!Model.CanRegisterReceipt)
    {
        headerMenu.Remove(editAction);
    }
    if (showRubRateForm)
    {
        headerMenu.Add(new AkHeaderMenuItem { Label = T("تعیین نرخ ارز تسویه", "Set settlement rate"), ModalTarget = "loadingRubleRateModal", Icon = "bi-currency-exchange" });
    }
    ViewData["AkHeaderKebab"] = headerMenu;

    // کرایه: مسئول، حالت ترانسپورت و طرف‌حساب واقعیِ هر سند. چند طرف‌حساب ⇒ هرکدام سطر خودش را دارد.
    var freightResponsibilityText = Model.FreightCostResponsibility switch
    {
        PTGOilSystem.Web.Models.Entities.CostResponsibility.Buyer => T("بدوش خریدار (شرکت ما)", "Buyer (our company)"),
        PTGOilSystem.Web.Models.Entities.CostResponsibility.Seller => T("بدوش فروشنده", "Seller"),
        PTGOilSystem.Web.Models.Entities.CostResponsibility.Shared => T("مشترک", "Shared"),
        PTGOilSystem.Web.Models.Entities.CostResponsibility.Unspecified => T("نامشخص", "Unspecified"),
        _ => null
    };
    var freightTotalUsd = Model.FreightParties.Sum(p => p.AmountUsd);
    var freightItems = new List<AkInfoItem>
    {
        // نرخ و مجموع یک خط، مسئول و اثر مالی خط بعد؛ هر خط دو خانهٔ کامل.
        new() { Label = T("کرایه فی تن", "Freight rate"), Value = NumberDisplay.UnitPrice(Model.FreightRateUsdPerMt, "USD/MT"), IsNumeric = true },
        new() { Label = T("مجموع کرایه", "Freight total"), Value = Model.FreightParties.Count > 0 ? freightTotalUsd.ToString("N2") : null, Unit = "USD", IsNumeric = true },
        new() { Label = T("کرایه بدوش", "Freight paid by"), Value = freightResponsibilityText, Tone = "info" },
        new()
        {
            // جملهٔ کوتاه و ساده برای کاربر؛ معنای مالی همان قبلی است.
            Label = T("اثر برای شرکت", "Effect on company"),
            Value = Model.FreightCostResponsibility switch
            {
                PTGOilSystem.Web.Models.Entities.CostResponsibility.Seller
                    => T("فقط جهت اطلاع؛ بدهی و هزینه ندارد", "Info only; no payable, no cost"),
                PTGOilSystem.Web.Models.Entities.CostResponsibility.Shared or PTGOilSystem.Web.Models.Entities.CostResponsibility.Unspecified
                    => T("سهم شرکت ثبت نشده؛ فعلاً بدهی و هزینه ندارد", "Company share not set; no payable, no cost yet"),
                _ => null
            },
            Tone = Model.FreightCostResponsibility == PTGOilSystem.Web.Models.Entities.CostResponsibility.Seller ? "info" : "warning"
        }
    };
    // نوع ترانسپورت و راننده آزاد جدا تکرار نمی‌شوند: طرف‌حساب هر سند (شرکت خدماتی،
    // راننده یا وسیلهٔ داخلی شرکت) همین‌جا با مبلغش و راننده در کارت اصلی آمده است.
    freightItems.AddRange(Model.FreightParties.Select(party => new AkInfoItem
    {
        Label = party.IsInternal
            ? $"{party.PartyKindLabel} ({T("داخلی، بدون بدهی", "internal, no payable")})"
            : party.PartyKindLabel,
        Value = $"{party.PartyName} · {party.AmountUsd:N2} USD",
        Tone = party.IsInternal ? null : "primary",
        IsWide = true,
        Href = party.ServiceProviderId.HasValue
            ? Url.Action("Details", "ServiceProviders", new { id = party.ServiceProviderId.Value, returnUrl = currentPageReturnUrl })
            : party.DriverId.HasValue
                ? Url.Action("Details", "Drivers", new { id = party.DriverId.Value })
                : null
    }));

    var cardsModel = new AkDetailCardsModel
    {
        Code = $"LD-{Model.Id:0000}",
        CodeLabel = T("کد بارگیری", "Loading code"),
        Status = statusText,
        StatusState = statusState,
        StripItems = new List<AkInfoItem>
        {
            new() { Label = T("قرارداد", "Contract"), Value = Model.ContractNumber, Href = contractUrl, IsNumeric = true },
            new() { Label = T("محصول", "Product"), Value = Model.ProductName },
            new() { Label = T("تاریخ", "Date"), Value = Model.LoadingDate.ToDisplayDate(), IsNumeric = true }
        },
        // ترتیب خواندن: وضعیت بار (چقدر بار شد، رسید، ماند) ← وسیله و مسیر ← پول ← کرایه.
        // مقدار بارگیری فقط در کارت مقادیر می‌آید، نه در نوار بالا.
        Cards = new List<AkDetailCard>
        {
            new()
            {
                Title = T("وضعیت بارگیری", "Loading status"),
                Icon = "bi-rulers",
                Metrics = quantityMetrics,
                VisualAvatar = transportVisualAvatar,
                VisualTitle = transportVisualTitle,
                VisualMeta = Model.VehicleSummary,
                IsWide = true
            },
            new() { Title = T("اطلاعات اصلی", "Main information"), Icon = "bi-info-circle", RouteNodes = routeNodes, Rows = mainItems },
            new() { Title = T("ارزش و مصارف", "Value & expenses"), Icon = "bi-cash-coin", Rows = pricingItems },
            new() { Title = T("کرایه حمل", "Freight"), Icon = "bi-truck", Rows = freightItems },
            new() { Title = T("یادداشت", "Notes"), Icon = "bi-journal-text", Text = Model.Notes, IsWide = true }
        }
    };

    var moreModel = new AkDetailMoreModel
    {
        CombineActivityAndHistory = true,
        JourneyTitle = T("روند بارگیری", "Loading journey"),
        Secondary = new AkDetailSecondaryModel
        {
            Timeline = timelineItems,
            TimelineTitle = T("همه رویدادهای بارگیری", "All loading events"),
            ShowTimelineDescription = false
        }
    };
}

<div class="ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail ptg-record-detail" dir="rtl"
     data-loading-details data-ak-detail-v2="true" data-ak-operations-detail="true">
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = T("جزئیات بارگیری", "Loading details"),
           Eyebrow = $"LD-{Model.Id:0000}",
           Icon = "bi-box-arrow-up"
       }; }
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("جزئیات بارگیری", "Loading details"), false,
                       primaryAction.Label, primaryAction.Icon, primaryAction.Href, primaryAction.ModalTarget,
                       T("بازگشت", "Back"), "bi-arrow-right", (string?)effectiveReturnUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailCards.cshtml" model="@cardsModel" />
    <partial name="~/Views/Shared/Partials/_DetailMore.cshtml" model="@moreModel" />

    @if (showRubRateForm)
    {
        <div class="modal fade" id="loadingRubleRateModal" tabindex="-1" aria-labelledby="loadingRubleRateModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <form asp-action="SetRubleRate" asp-route-id="@Model.Id" method="post" class="ak-form">
                        @Html.AntiForgeryToken()
                        <input name="Id" value="@Model.RubleRateEditor.Id" type="hidden" />
                        <input name="ReturnUrl" value="@currentPageReturnUrl" type="hidden" />
                        <div class="modal-header">
                            <h2 class="modal-title" id="loadingRubleRateModalLabel">@T("تعیین نرخ ارز تسویه", "Set settlement rate")</h2>
                            <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                        </div>
                        <div class="modal-body">
                            <div class="ak-form-grid">
                                <div class="ak-field">
                                    <label class="ak-label" for="RubPerUsdRate">@T($"هر ۱ دالر چند {Model.SettlementCurrencyCode}؟", $"{Model.SettlementCurrencyCode} per USD")</label>
                                    <input class="ak-input" id="RubPerUsdRate" name="RubPerUsdRate" value="@(Model.RubleRateEditor.RubPerUsdRate?.ToString("0.######"))" type="number" min="0.000001" step="0.000001" required />
                                </div>
                                <div class="ak-field">
                                    <label class="ak-label" for="RubRateDate">@T("تاریخ نرخ", "Rate date")</label>
                                    <input class="ak-input" id="RubRateDate" name="RubRateDate" value="@(Model.RubleRateEditor.RubRateDate?.ToHtmlDateInput())" type="date" required />
                                </div>
                                <div class="ak-field ak-field-full">
                                    <label class="ak-label" for="RubRateSource">@T("مرجع نرخ", "Rate source")</label>
                                    <input class="ak-input" id="RubRateSource" name="RubRateSource" value="@Model.RubleRateEditor.RubRateSource" type="text" maxlength="200" />
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-light" data-bs-dismiss="modal">@T("انصراف", "Cancel")</button>
                            <button type="submit" class="btn btn-primary">@T("ثبت نرخ", "Save rate")</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
