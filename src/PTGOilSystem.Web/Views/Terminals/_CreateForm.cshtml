@model Terminal
@using PTGOilSystem.Web.Models.Custody
@inject PTGOilSystem.Web.Services.Custody.ICustodyReadService CustodyReader
@{
    var custodians = await CustodyReader.GetCustodianOptionsAsync();
    var currentCustodian = Model.CustodianPartyType.HasValue && Model.CustodianPartyId.HasValue
        ? CustodyParty.Key(Model.CustodianPartyType.Value, Model.CustodianPartyId.Value)
        : null;
}

@Html.AntiForgeryToken()
<div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

<section class="ak-form-section">
    <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
             model="@(("اطلاعات ترمینال", (string?)"کد، نام و موقعیت ترمینال را وارد کنید."))" />
    <div class="ak-form-grid">
        <div class="ak-field">
            <label asp-for="Code" class="ak-label">کد <span class="ak-req">*</span></label>
            <input asp-for="Code" class="ak-input" />
            <span asp-validation-for="Code" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label asp-for="Name" class="ak-label">نام <span class="ak-req">*</span></label>
            <input asp-for="Name" class="ak-input" />
            <span asp-validation-for="Name" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label asp-for="Location" class="ak-label">موقعیت</label>
            <input asp-for="Location" class="ak-input" />
            <span asp-validation-for="Location" class="ak-field-error"></span>
        </div>
        <div class="ak-field">
            <label for="custodianKey" class="ak-label">متعلق به طرف دیگر؟</label>
            <select id="custodianKey" name="custodianKey" class="ak-input" data-ak-entity-combobox>
                <option value="">خیر — تأسیسات خودِ ما</option>
                @foreach (var group in custodians.GroupBy(c => c.PartyType))
                {
                    <optgroup label="@CustodyParty.GroupLabel(group.Key)">
                        @foreach (var c in group)
                        {
                            var key = CustodyParty.Key(c.PartyType, c.PartyId);
                            <option value="@key" selected="@(key == currentCustodian)">@c.Name</option>
                        }
                    </optgroup>
                }
            </select>
            <span class="ak-note">اگر مخزنِ کسِ دیگری است، تیلِ ما اینجا «نزد دیگران» شمرده می‌شود و جزو موجودی فزیکی مخازن ما نیست.</span>
        </div>
        <div class="ak-toggle-field">
            <div class="form-check form-switch">
                <input asp-for="IsActive" class="form-check-input" role="switch" />
                <label asp-for="IsActive" class="form-check-label">فعال</label>
            </div>
        </div>
        <div class="ak-field ak-col-full">
            <label asp-for="Notes" class="ak-label">یادداشت</label>
            <textarea asp-for="Notes" class="ak-input" rows="3"></textarea>
            <span asp-validation-for="Notes" class="ak-field-error"></span>
        </div>
    </div>
</section>
