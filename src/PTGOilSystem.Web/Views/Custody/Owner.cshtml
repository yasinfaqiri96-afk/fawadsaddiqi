@model PTGOilSystem.Web.Services.Custody.CustodyOwnerAccount
@using PTGOilSystem.Web.Models.Custody
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.Shared
@using PTGOilSystem.Web.Services.Custody
@{
    var key = CustodyParty.Key(Model.Owner.PartyType, Model.Owner.PartyId);
    var canManage = PTGOilSystem.Web.Security.RoleAccessRules.CanManageData(User) && Model.SupportsFinance;
    var lots = ViewBag.Lots as IReadOnlyList<CustodyLotSummary> ?? [];
    ViewData["Title"] = UiText.T(Context, "حساب امانی", "Custody account") + " — " + Model.OwnerName;
    ViewData["HideSectionTabs"] = true;
    ViewData["AkHeaderContext"] = CustodyParty.TypeLabel(Model.Owner.PartyType);
    var summaries = Model.Summaries;
    ViewData["AkHeaderKebab"] = canManage
        ? new List<AkHeaderMenuItem>
        {
            new() { Label = CustodyFinanceForm.Title(CustodyFinanceKind.ReimbursableExpense), Href = Url.Action("Finance", new { key, kind = CustodyFinanceKind.ReimbursableExpense }), Icon = "bi-receipt" },
            new() { Label = CustodyFinanceForm.Title(CustodyFinanceKind.ProviderCharge), Href = Url.Action("Finance", new { key, kind = CustodyFinanceKind.ProviderCharge }), Icon = "bi-truck" },
            new() { Label = CustodyFinanceForm.Title(CustodyFinanceKind.ServiceFee), Href = Url.Action("Finance", new { key, kind = CustodyFinanceKind.ServiceFee }), Icon = "bi-tools" }
        }
        : null;
    if (canManage)
    {
        var menu = ViewData["AkHeaderKebab"] as List<AkHeaderMenuItem> ?? new();
        menu.Add(new() { Label = "راپور دفتر کل امانی", Href = Url.Action("LedgerReport"), Icon = "bi-journal-check" });
        ViewData["AkHeaderKebab"] = menu;
    }
    if (User.IsInRole(PTGOilSystem.Web.Security.AuthRoles.Admin) && Model.SupportsFinance)
    {
        var menu = ViewData["AkHeaderKebab"] as List<AkHeaderMenuItem> ?? new();
        menu.Add(new() { Label = "تطبیق دفتر کل", Href = Url.Action("Reconcile", new { key }), Icon = "bi-check2-square" });
        ViewData["AkHeaderKebab"] = menu;
    }

    // هر ارز جدا: ارزها با هم جمع یا تهاتر نمی‌شوند.
    var kpis = new List<AkKpiItem>();
    foreach (var sum in summaries)
    {
        if (sum.Outstanding != 0m)
            kpis.Add(new() { Title = UiText.T(Context, "وصول‌نشده از مشتری", "Not yet collected"), Value = sum.Outstanding.ToString("N2"), Unit = sum.Currency, State = "warning" });
        // ارزی که فقط فروش دارد و مالک در آن ارز حسابی ندارد، کارت «قابل پرداخت صفر» نمی‌گیرد.
        if (sum.Balance != 0m || sum.Currency == "USD" && summaries.All(x => x.Balance == 0m))
            kpis.Add(new() { Title = sum.Balance >= 0m ? UiText.T(Context, "قابل پرداخت به مالک", "Payable to owner") : UiText.T(Context, "طلب شرکت از مالک", "Owner owes company"),
                Value = Math.Abs(sum.Balance).ToString("N2"), Unit = sum.Currency, State = sum.Balance >= 0m ? "success" : "danger" });
    }

    string KindLabel(CustodyFinanceKind kind) => CustodyFinanceForm.Title(kind);
}

<div class="ak-form-page ak-detail-page" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "حساب امانی", "Custody account") + " — " + Model.OwnerName, false,
                       canManage ? CustodyFinanceForm.Title(CustodyFinanceKind.OwnerPayout) : (string?)null, "bi-cash-coin",
                       canManage ? (string?)Url.Action("Finance", new { key, kind = CustodyFinanceKind.OwnerPayout }) : (string?)null, (string?)null,
                       UiText.T(Context, "امانی", "Custody"), "bi-arrow-right", (string?)Url.Action("Index")))" />

    @if (!Model.SupportsFinance && Model.FinancialOwner is { } financialOwner)
    {
        <div class="alert alert-secondary">
            @UiText.T(Context,
                "این شریک با سند تأییدشده به نقش فروشندهٔ همان شخص پیوند دارد؛ فروش امانی و حساب مالیِ تیلِ او در همان نقش فروشنده ثبت می‌شود.",
                "This partner is linked to the same person's supplier role; custody sales and money are kept on that supplier account.")
            <a asp-action="Owner" asp-route-key="@CustodyParty.Key(financialOwner.PartyType, financialOwner.PartyId)">@UiText.T(Context, "حساب مالی امانی", "Custody money account")</a>
        </div>
    }
    else if (!Model.SupportsFinance)
    {
        <div class="alert alert-secondary">
            @UiText.T(Context,
                "فروش و حساب مالی امانی فعلاً فقط برای مالکی است که مشتری یا فروشنده ثبت شده است (یا شریکی که با نقش فروشندهٔ همان شخص پیوند تأییدشده دارد). نگهداری، تحویل و انتقال برای این مالک کامل کار می‌کند.",
                "Custody sales and money are supported for owners registered as customers or suppliers (or partners linked to their supplier role).")
        </div>
    }

    <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)kpis)" />

    @foreach (var sum in summaries)
    {
        var cur = sum.Currency;
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "خلاصهٔ حساب", "Account summary") + " — " + cur,
                               (string?)UiText.T(Context, "سهم مالک از پولِ وصول‌شده نزد شرکت، منهای کمیشن، مصارف، حق خدمات، استرداد و پرداخت‌ها؛ همه به همین ارز. پولی که مشتری مستقیم به مالک داده بدهی شرکت نیست.",
                                                 "Owner's share of money collected by the company less commission, charges, refunds and payouts, all in this currency.")))" />
            <dl class="row mb-0">
                @if (sum.SalesTotal != 0m)
                {
                    <dt class="col-sm-5">@UiText.T(Context, "فروش‌های همین ارز (خالص برگشت)", "Sales in this currency (net)")</dt>
                    <dd class="col-sm-7 ak-num">@sum.SalesTotal.ToString("N2") @cur · @UiText.T(Context, "وصول‌نشده", "outstanding") @sum.Outstanding.ToString("N2")</dd>
                }
                <dt class="col-sm-5">@UiText.T(Context, "وصول‌شده توسط شرکت (سهم مالک)", "Collected by company (owner's share)")</dt>
                <dd class="col-sm-7 ak-num">@sum.CollectedByCompany.ToString("N2") @cur</dd>
                @if (sum.FxOwnerShare != 0m)
                {
                    <dt class="col-sm-5">@UiText.T(Context, "از آن، سهم مالک از تفاوت نرخ", "Of which owner's FX share")</dt>
                    <dd class="col-sm-7 ak-num text-muted">@sum.FxOwnerShare.ToString("N2") @cur</dd>
                }
                <dt class="col-sm-5">@UiText.T(Context, "پرداخت مستقیم مشتری به مالک", "Paid directly to owner")</dt>
                <dd class="col-sm-7 ak-num">@sum.PaidDirectlyToOwner.ToString("N2") @cur</dd>
                <dt class="col-sm-5">@UiText.T(Context, "کمیشن درآمدشده", "Commission earned")</dt>
                <dd class="col-sm-7 ak-num">− @sum.CommissionRecognized.ToString("N2") @cur</dd>
                <dt class="col-sm-5">@UiText.T(Context, "مصارف به حساب مالک", "Expenses charged to owner")</dt>
                <dd class="col-sm-7 ak-num">− @sum.Expenses.ToString("N2") @cur</dd>
                @if (sum.ProviderUnpaid > 0m)
                {
                    <dt class="col-sm-5">@UiText.T(Context, "از این مصارف، هنوز به خدمات‌دهنده پرداخت نشده", "Of which still owed to providers")</dt>
                    <dd class="col-sm-7 ak-num text-muted">@sum.ProviderUnpaid.ToString("N2") @cur</dd>
                }
                <dt class="col-sm-5">@UiText.T(Context, "حق خدمات شرکت", "Company service fees")</dt>
                <dd class="col-sm-7 ak-num">− @sum.ServiceFees.ToString("N2") @cur</dd>
                @if (sum.Refunds != 0m)
                {
                    <dt class="col-sm-5">@UiText.T(Context, "استرداد به مشتری از پول مالک", "Refunded to customers")</dt>
                    <dd class="col-sm-7 ak-num">− @sum.Refunds.ToString("N2") @cur</dd>
                }
                <dt class="col-sm-5">@UiText.T(Context, "پرداخت‌شده به مالک", "Paid to owner")</dt>
                <dd class="col-sm-7 ak-num">− @sum.Payouts.ToString("N2") @cur</dd>
                <dt class="col-sm-5"><strong>@(sum.Balance >= 0m ? UiText.T(Context, "مانده قابل پرداخت به مالک", "Balance payable to owner") : UiText.T(Context, "مالک به شرکت بدهکار است", "Owner owes the company"))</strong></dt>
                <dd class="col-sm-7 ak-num"><strong>@Math.Abs(sum.Balance).ToString("N2") @cur</strong></dd>
            </dl>
        </section>
    }

    <section class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                 model="@((UiText.T(Context, "فروش‌های امانی", "Custody sales"), (string?)Model.Sales.Count.ToString("N0")))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead><tr>
                    <th>@UiText.T(Context, "فروش", "Sale")</th>
                    <th>@UiText.T(Context, "تاریخ", "Date")</th>
                    <th class="ak-col-grow">@UiText.T(Context, "مشتری", "Customer")</th>
                    <th class="text-end">@UiText.T(Context, "مقدار (MT)", "Qty (MT)")</th>
                    <th class="text-end">@UiText.T(Context, "مبلغ", "Amount")</th>
                    <th class="text-end">@UiText.T(Context, "وصول‌نشده", "Outstanding")</th>
                    <th class="text-end">@UiText.T(Context, "کمیشن", "Commission")</th>
                    <th></th>
                </tr></thead>
                <tbody>
                    @foreach (var s in Model.Sales)
                    {
                        var cancelled = s.Status == CustodyDocumentStatus.Cancelled;
                        <tr class="@(cancelled ? "text-muted" : null)">
                            <td>
                                <strong>@s.SaleNumber</strong>
                                <div class="small">
                                    @if (!string.IsNullOrEmpty(s.SourceLots) && s.SourceLots != s.LotNumber)
                                    {
                                        @s.SourceLots
                                    }
                                    else
                                    {
                                        <a asp-action="Details" asp-route-id="@s.LotId">@s.LotNumber</a>
                                    }
                                </div>
                                @if (cancelled)
                                {
                                    <span class="ak-status is-inactive">@UiText.T(Context, "لغو شده", "Cancelled")</span>
                                }
                            </td>
                            <td>@s.SaleDate.ToDisplayDate()</td>
                            <td class="ak-col-grow">@s.CustomerName <small class="text-muted">· @s.ProductName</small></td>
                            <td class="text-end ak-num">
                                @NumberDisplay.Quantity(s.NetQuantityMt)
                                @if (s.ReturnedQuantityMt > 0m)
                                {
                                    <small class="text-muted d-block">@UiText.T(Context, "برگشت", "returned") @NumberDisplay.Quantity(s.ReturnedQuantityMt)</small>
                                }
                            </td>
                            <td class="text-end ak-num">@s.NetAmountUsd.ToString("N2") <small class="text-muted">@s.Currency</small>
                                @if (s.IsCrossCurrency)
                                {
                                    <small class="text-muted d-block">@UiText.T(Context, "تعهد به مالک", "Owner in") @s.OwnerCurrency · @UiText.T(Context, "نرخ قفل", "locked") @s.OwnerAgreedPerUsd?.ToString("0.####")</small>
                                }
                            </td>
                            <td class="text-end ak-num">@s.OutstandingUsd.ToString("N2")</td>
                            <td class="text-end ak-num">
                                @s.CommissionRecognizedUsd.ToString("N2")
                                @if (s.NetCommissionUsd != s.CommissionRecognizedUsd && !cancelled)
                                {
                                    <small class="text-muted">/ @s.NetCommissionUsd.ToString("N2")</small>
                                }
                            </td>
                            <td>
                                @if (canManage && !cancelled)
                                {
                                    <div class="ak-list-toolbar-actions">
                                        @if (s.OutstandingUsd > 0m)
                                        {
                                            <a class="btn btn-sm btn-light ak-secondary-action" asp-action="Finance" asp-route-key="@key" asp-route-kind="@CustodyFinanceKind.Collection" asp-route-saleId="@s.Id">@UiText.T(Context, "دریافت", "Collect")</a>
                                            <a class="btn btn-sm btn-light ak-secondary-action" asp-action="Finance" asp-route-key="@key" asp-route-kind="@CustodyFinanceKind.DirectToOwner" asp-route-saleId="@s.Id">@UiText.T(Context, "پرداخت به مالک شد", "Paid to owner")</a>
                                        }
                                        @if (s.NetQuantityMt > 0m)
                                        {
                                            <a class="btn btn-sm btn-light ak-secondary-action" asp-action="SaleReturn" asp-route-id="@s.Id" asp-route-key="@key">@UiText.T(Context, "برگشت", "Return")</a>
                                        }
                                        @if (s.NeedsFxAgreement)
                                        {
                                            <a class="btn btn-sm btn-light ak-secondary-action" asp-action="FxAgreement" asp-route-id="@s.Id" asp-route-key="@key">@UiText.T(Context, "توافق تفاوت نرخ", "FX agreement")</a>
                                        }
                                        <form asp-action="CancelSale" asp-route-id="@s.Id" method="post" class="ak-list-toolbar-actions"
                                              data-ptg-confirm="true"
                                              data-ptg-confirm-title="@UiText.T(Context, "لغو فروش امانی", "Cancel custody sale")"
                                              data-ptg-confirm-message="@UiText.T(Context, "تیل به موجودی مالک برمی‌گردد و اسناد مالی فروش معکوس می‌شود. ادامه می‌دهید؟", "Stock returns to the owner and the sale's financial records are reversed. Continue?")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="key" value="@key" />
                                            <input name="reason" class="ak-input" maxlength="300" required placeholder="@UiText.T(Context, "دلیل لغو", "Reason")" aria-label="@UiText.T(Context, "دلیل لغو", "Reason")" />
                                            <button type="submit" class="btn btn-sm btn-light ak-secondary-action text-danger">@UiText.T(Context, "لغو", "Cancel")</button>
                                        </form>
                                    </div>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Sales.Any())
                    {
                        <tr><td colspan="8"><div class="ak-empty">@UiText.T(Context, "فروش امانی ثبت نشده. فروش را از صفحهٔ همان بار ثبت کنید.", "No custody sales. Record a sale from the lot page.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    <section class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                 model="@((UiText.T(Context, "دریافت‌ها، مصارف و پرداخت‌ها", "Receipts, charges and payouts"), (string?)Model.Entries.Count.ToString("N0")))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead><tr>
                    <th>@UiText.T(Context, "تاریخ", "Date")</th>
                    <th>@UiText.T(Context, "سند", "Document")</th>
                    <th class="ak-col-grow">@UiText.T(Context, "جزئیات", "Details")</th>
                    <th class="text-end">@UiText.T(Context, "مبلغ", "Amount")</th>
                    <th class="text-end">@UiText.T(Context, "کمیشن", "Commission")</th>
                    <th></th>
                </tr></thead>
                <tbody>
                    @foreach (var e in Model.Entries)
                    {
                        var cancelled = e.Status == CustodyDocumentStatus.Cancelled;
                        var parts = new List<string>();
                        if (e.SaleNumber is not null) parts.Add(e.SaleNumber);
                        if (e.CashAccountName is not null) parts.Add(e.CashAccountName);
                        if (e.ExpenseTypeName is not null) parts.Add(e.ExpenseTypeName);
                        if (e.ServiceProviderName is not null) parts.Add(e.ServiceProviderName);
                        if (e.PayeeName is not null) parts.Add(e.PayeeName);
                        if (e.SettlesFinanceEntryId is { } settles) parts.Add($"AF-{settles:D5}");
                        if (e.Kind == CustodyFinanceKind.ProviderCharge && !cancelled)
                            parts.Add(UiText.T(Context, "پرداخت‌نشده ", "Unpaid ") + e.ProviderUnpaidUsd.ToString("N2"));
                        if (e.DocumentNumber is not null) parts.Add(UiText.T(Context, "سند ", "Doc ") + e.DocumentNumber);
                        if (e.Description is not null) parts.Add(e.Description);
                        if (cancelled && e.CancellationReason is not null) parts.Add(UiText.T(Context, "لغو: ", "Cancelled: ") + e.CancellationReason);
                        if (e.RateSource is not null) parts.Add(e.RateSource);
                        if (!string.Equals(e.OwnerCurrency, e.Currency, StringComparison.OrdinalIgnoreCase) && e.Kind is CustodyFinanceKind.Collection or CustodyFinanceKind.CustomerRefund)
                            parts.Add(UiText.T(Context, "به حساب مالک ", "Owner ") + e.OwnerAmount.ToString("N2") + " " + e.OwnerCurrency);
                        if (e.FxCompanyUsd is { } fx && fx != 0m)
                            parts.Add((fx > 0m ? UiText.T(Context, "سود تسعیر شرکت ", "FX gain ") : UiText.T(Context, "زیان تسعیر شرکت ", "FX loss ")) + Math.Abs(fx).ToString("N2") + " USD");
                        <tr class="@(cancelled ? "text-muted" : null)">
                            <td>@e.EntryDate.ToDisplayDate()</td>
                            <td>
                                @KindLabel(e.Kind)
                                @if (cancelled)
                                {
                                    <span class="ak-status is-inactive">@UiText.T(Context, "لغو شده", "Cancelled")</span>
                                }
                            </td>
                            <td class="ak-col-grow">@string.Join(" · ", parts)</td>
                            <td class="text-end ak-num">@e.AmountUsd.ToString("N2") <small class="text-muted">@e.Currency</small></td>
                            <td class="text-end ak-num">@(e.OwnerCommission > 0m ? e.OwnerCommission.ToString("N2") + " " + e.OwnerCurrency : "")</td>
                            <td>
                                @if (canManage && !cancelled && e.ProviderUnpaidUsd > 0m)
                                {
                                    <a class="btn btn-sm btn-light ak-secondary-action" asp-action="Finance" asp-route-key="@key" asp-route-kind="@CustodyFinanceKind.ProviderPayment" asp-route-chargeId="@e.Id">@UiText.T(Context, "پرداخت", "Pay")</a>
                                }
                                @if (canManage && !cancelled)
                                {
                                    <form asp-action="CancelFinance" asp-route-id="@e.Id" method="post" class="ak-list-toolbar-actions"
                                          data-ptg-confirm="true"
                                          data-ptg-confirm-title="@UiText.T(Context, "لغو سند", "Cancel document")"
                                          data-ptg-confirm-message="@UiText.T(Context, "اثر این سند (صندوق، حساب مالک و دفتر) معکوس می‌شود و تاریخچه باقی می‌ماند. ادامه می‌دهید؟", "This document's effect is reversed; history is kept. Continue?")">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="key" value="@key" />
                                        <input name="reason" class="ak-input" maxlength="300" required placeholder="@UiText.T(Context, "دلیل لغو", "Reason")" aria-label="@UiText.T(Context, "دلیل لغو", "Reason")" />
                                        <button type="submit" class="btn btn-sm btn-light ak-secondary-action text-danger">@UiText.T(Context, "لغو", "Cancel")</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                    @if (!Model.Entries.Any())
                    {
                        <tr><td colspan="6"><div class="ak-empty">@UiText.T(Context, "سندی ثبت نشده", "No documents")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.SaleReturns.Any())
    {
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "برگشت‌های فروش", "Sale returns"), (string?)Model.SaleReturns.Count.ToString("N0")))" />
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead><tr>
                        <th>@UiText.T(Context, "برگشت", "Return")</th>
                        <th>@UiText.T(Context, "تاریخ", "Date")</th>
                        <th class="ak-col-grow">@UiText.T(Context, "فروش", "Sale")</th>
                        <th class="text-end">@UiText.T(Context, "مقدار (MT)", "Qty (MT)")</th>
                        <th class="text-end">@UiText.T(Context, "مبلغ", "Amount")</th>
                        <th class="text-end">@UiText.T(Context, "کاهش کمیشن", "Commission reduced")</th>
                        <th></th>
                    </tr></thead>
                    <tbody>
                        @foreach (var r in Model.SaleReturns)
                        {
                            var cancelled = r.Status == CustodyDocumentStatus.Cancelled;
                            <tr class="@(cancelled ? "text-muted" : null)">
                                <td>
                                    <strong>@r.ReturnNumber</strong>
                                    @if (cancelled)
                                    {
                                        <span class="ak-status is-inactive">@UiText.T(Context, "لغو شده", "Cancelled")</span>
                                    }
                                </td>
                                <td>@r.ReturnDate.ToDisplayDate()</td>
                                <td class="ak-col-grow">@r.SaleNumber@(r.DocumentNumber is null ? "" : " · " + r.DocumentNumber)</td>
                                <td class="text-end ak-num">@NumberDisplay.Quantity(r.QuantityMt)</td>
                                <td class="text-end ak-num">@r.AmountUsd.ToString("N2") <small class="text-muted">@r.Currency</small></td>
                                <td class="text-end ak-num">@r.CommissionUsd.ToString("N2")</td>
                                <td>
                                    @if (canManage && !cancelled)
                                    {
                                        <form asp-action="CancelReturn" asp-route-id="@r.Id" method="post" class="ak-list-toolbar-actions"
                                              data-ptg-confirm="true"
                                              data-ptg-confirm-title="@UiText.T(Context, "لغو برگشت فروش", "Cancel sale return")"
                                              data-ptg-confirm-message="@UiText.T(Context, "تیلِ برگشتی دوباره از بار خارج و طلب مشتری و کمیشن به حالت قبل برمی‌گردد. ادامه می‌دهید؟", "Returned stock leaves the lot again and the receivable and commission are restored. Continue?")">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="key" value="@key" />
                                            <input name="reason" class="ak-input" maxlength="300" required placeholder="@UiText.T(Context, "دلیل لغو", "Reason")" aria-label="@UiText.T(Context, "دلیل لغو", "Reason")" />
                                            <button type="submit" class="btn btn-sm btn-light ak-secondary-action text-danger">@UiText.T(Context, "لغو", "Cancel")</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (lots.Any())
    {
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@((UiText.T(Context, "بارهای این مالک", "This owner's lots"), (string?)null))" />
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead><tr>
                        <th>@UiText.T(Context, "بار", "Lot")</th>
                        <th class="ak-col-grow">@UiText.T(Context, "جنس / محل", "Product / location")</th>
                        <th class="text-end">@UiText.T(Context, "موجودی (MT)", "Balance (MT)")</th>
                        <th class="text-end">@UiText.T(Context, "قابل تحویل (MT)", "Deliverable (MT)")</th>
                    </tr></thead>
                    <tbody>
                        @foreach (var l in lots)
                        {
                            <tr>
                                <td><a asp-action="Details" asp-route-id="@l.LotId">@l.LotNumber</a></td>
                                <td class="ak-col-grow">@l.ProductName <small class="text-muted">· @l.Locations</small></td>
                                <td class="text-end ak-num">@NumberDisplay.Quantity(l.BalanceMt)</td>
                                <td class="text-end ak-num">@NumberDisplay.Quantity(l.FreeMt)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }
</div>
