@model PTGOilSystem.Web.Models.Custody.CustodyFinanceViewModel
@using PTGOilSystem.Web.Models.Custody
@using PTGOilSystem.Web.Models.Entities
@{
    var form = Model.Form;
    var kind = form.Kind;
    var account = Model.Account;
    var title = CustodyFinanceForm.Title(kind);
    ViewData["Title"] = title;
    var backUrl = Url.Action("Owner", new { key = form.OwnerKey });
    var collects = kind is CustodyFinanceKind.Collection or CustodyFinanceKind.DirectToOwner;
    var usesCash = kind is CustodyFinanceKind.Collection or CustodyFinanceKind.OwnerPayout or CustodyFinanceKind.ReimbursableExpense
        or CustodyFinanceKind.ProviderPayment;
    var isCharge = kind is CustodyFinanceKind.ReimbursableExpense or CustodyFinanceKind.ServiceFee or CustodyFinanceKind.ProviderCharge;
    var charge = Model.ProviderCharge;
    // وصول همان ارز فروش و پرداخت به خدمات‌دهنده همان ارز مصرف است؛ برای بقیه ارز انتخابی.
    var fixedCurrency = collects || kind == CustodyFinanceKind.ProviderPayment;
    var currency = string.IsNullOrWhiteSpace(form.Currency) ? "USD" : form.Currency;
    var balanceText = string.Join(" · ", account.Summaries.Select(x =>
        (x.Balance >= 0m ? UiText.T(Context, "قابل پرداخت", "Payable") : UiText.T(Context, "بدهکار", "Owes")) + " " + Math.Abs(x.Balance).ToString("N2") + " " + x.Currency));
}

<div class="ak-form-page">
    <div class="ak-form-page-content">
        <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
                 model="@((title + " — " + account.OwnerName, true,
                           (string?)null, (string?)null, (string?)null, (string?)null,
                           UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right",
                           (string?)backUrl))" />

        <form asp-action="Finance" method="post" class="ak-form">
            @Html.AntiForgeryToken()
            @Html.FormToken()
            <input type="hidden" name="Kind" value="@kind" />
            <input type="hidden" name="OwnerKey" value="@form.OwnerKey" />
            @if (kind == CustodyFinanceKind.ProviderPayment)
            {
                <input type="hidden" name="ProviderChargeId" value="@form.ProviderChargeId" />
            }
            <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

            <div class="alert alert-info ak-form-alert">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                @CustodyFinanceForm.Explanation(kind)
            </div>

            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((account.OwnerName, (string?)(UiText.T(Context, "حساب مالک", "Owner account") + ": " + balanceText)))" />
                <div class="ak-form-grid">
                    @if (collects)
                    {
                        <div class="ak-field ak-col-full">
                            <label for="SaleId" class="ak-label">@UiText.T(Context, "فروش", "Sale") <span class="ak-req">*</span></label>
                            <select id="SaleId" name="SaleId" class="ak-input">
                                <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                                @foreach (var s in Model.OpenSales)
                                {
                                    <option value="@s.Id" selected="@(s.Id == form.SaleId)">
                                        @s.SaleNumber — @s.CustomerName — @UiText.T(Context, "وصول‌نشده", "outstanding") @s.OutstandingUsd.ToString("N2") @s.Currency
                                    </option>
                                }
                            </select>
                            <span class="ak-field-error">@Html.ValidationMessage("SaleId")</span>
                        </div>
                    }
                    else if (kind == CustodyFinanceKind.ProviderPayment && charge is not null)
                    {
                        <div class="ak-field ak-col-full">
                            <span class="ak-label">@UiText.T(Context, "مصرف نسیه", "Unpaid charge")</span>
                            <div>
                                AF-@charge.Id.ToString("D5") · @charge.ServiceProviderName · @charge.ExpenseTypeName ·
                                @UiText.T(Context, "پرداخت‌نشده", "unpaid") @charge.ProviderUnpaidUsd.ToString("N2") @charge.Currency
                            </div>
                        </div>
                    }
                    else if (isCharge && Model.Account.Sales.Any(s => s.Status == CustodyDocumentStatus.Posted))
                    {
                        <div class="ak-field">
                            <label for="SaleId" class="ak-label">@UiText.T(Context, "مربوط به فروش (اختیاری)", "Related sale (optional)")</label>
                            <select id="SaleId" name="SaleId" class="ak-input">
                                <option value="">@UiText.T(Context, "- هیچ -", "- None -")</option>
                                @foreach (var s in Model.Account.Sales.Where(s => s.Status == CustodyDocumentStatus.Posted))
                                {
                                    <option value="@s.Id" selected="@(s.Id == form.SaleId)">@s.SaleNumber — @s.CustomerName</option>
                                }
                            </select>
                        </div>
                    }
                    @if (fixedCurrency)
                    {
                        <input type="hidden" name="Currency" value="@form.Currency" />
                    }
                    else
                    {
                        <div class="ak-field">
                            <label for="Currency" class="ak-label">@UiText.T(Context, "ارز", "Currency")</label>
                            <select id="Currency" name="Currency" class="ak-input">
                                <option value="USD" selected="@(currency == "USD")">@UiText.T(Context, "دالر (USD)", "USD")</option>
                                <option value="AFN" selected="@(currency == "AFN")">@UiText.T(Context, "افغانی (AFN)", "AFN")</option>
                            </select>
                        </div>
                    }
                    <div class="ak-field">
                        <label for="AmountUsd" class="ak-label">@UiText.T(Context, "مبلغ", "Amount")@(fixedCurrency && !string.IsNullOrWhiteSpace(form.Currency) ? " (" + form.Currency + ")" : "") <span class="ak-req">*</span></label>
                        <input id="AmountUsd" name="AmountUsd" type="number" step="0.01" min="0" class="ak-input" value="@form.AmountUsd" />
                        <span class="ak-field-error">@Html.ValidationMessage("AmountUsd")</span>
                    </div>
                    <div class="ak-field">
                        <label for="Date" class="ak-label">@UiText.T(Context, "تاریخ", "Date") <span class="ak-req">*</span></label>
                        <input id="Date" name="Date" type="date" class="ak-input" value="@form.Date.ToString("yyyy-MM-dd")" />
                    </div>
                    @if (usesCash)
                    {
                        <div class="ak-field">
                            <label for="CashAccountId" class="ak-label">@UiText.T(Context, "صندوق / بانک", "Till / bank") <span class="ak-req">*</span></label>
                            <select id="CashAccountId" name="CashAccountId" class="ak-input">
                                <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                                @foreach (var a in Model.CashAccounts)
                                {
                                    <option value="@a.Id" selected="@(a.Id == form.CashAccountId)">@a.Name</option>
                                }
                            </select>
                            <span class="ak-field-error">@Html.ValidationMessage("CashAccountId")</span>
                        </div>
                    }
                    @if (kind == CustodyFinanceKind.ProviderCharge)
                    {
                        <div class="ak-field">
                            <label for="ServiceProviderId" class="ak-label">@UiText.T(Context, "خدمات‌دهندهٔ طلبکار", "Provider owed") <span class="ak-req">*</span></label>
                            <select id="ServiceProviderId" name="ServiceProviderId" class="ak-input" data-ak-entity-combobox>
                                <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                                @foreach (var p in Model.ServiceProviders)
                                {
                                    <option value="@p.Id" selected="@(p.Id == form.ServiceProviderId)">@p.Name</option>
                                }
                            </select>
                            <span class="ak-field-error">@Html.ValidationMessage("ServiceProviderId")</span>
                        </div>
                    }
                    @if (isCharge)
                    {
                        <div class="ak-field">
                            <label for="ExpenseTypeId" class="ak-label">@UiText.T(Context, "نوع", "Type")@if (kind == CustodyFinanceKind.ProviderCharge) {<span class="ak-req"> *</span>}</label>
                            <select id="ExpenseTypeId" name="ExpenseTypeId" class="ak-input">
                                <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                                @foreach (var t in Model.ExpenseTypes)
                                {
                                    <option value="@t.Id" selected="@(t.Id == form.ExpenseTypeId)">@t.Name</option>
                                }
                            </select>
                            <span class="ak-field-error">@Html.ValidationMessage("ExpenseTypeId")</span>
                        </div>
                    }
                    @if (kind == CustodyFinanceKind.ReimbursableExpense)
                    {
                        <div class="ak-field">
                            <label for="PayeeName" class="ak-label">@UiText.T(Context, "به چه کسی پرداخت شد", "Paid to")</label>
                            <input id="PayeeName" name="PayeeName" class="ak-input" value="@form.PayeeName" maxlength="200" />
                        </div>
                    }
                    <div class="ak-field">
                        <label for="DocumentNumber" class="ak-label">@UiText.T(Context, "شماره سند", "Document no.")</label>
                        <input id="DocumentNumber" name="DocumentNumber" class="ak-input" value="@form.DocumentNumber" maxlength="100" />
                    </div>
                    <div class="ak-field ak-col-full">
                        <label for="Description" class="ak-label">@UiText.T(Context, "توضیحات (اختیاری)", "Notes (optional)")</label>
                        <textarea id="Description" name="Description" class="ak-input" rows="2" maxlength="1000">@form.Description</textarea>
                    </div>
                    <details class="ak-advanced ak-col-full" open="@form.AgreedCurrencyPerUsd.HasValue">
                        <summary class="ak-advanced-summary">@UiText.T(Context, "نرخ توافقیِ همین سند (اختیاری؛ وگرنه نرخ روزانهٔ سیستم)", "Agreed rate for this document (optional)")</summary>
                        <div class="ak-form-grid">
                            <div class="ak-field">
                                <label for="AgreedCurrencyPerUsd" class="ak-label">@UiText.T(Context, "۱ دالر = ؟ افغانی", "AFN per USD")</label>
                                <input id="AgreedCurrencyPerUsd" name="AgreedCurrencyPerUsd" type="number" step="0.000001" min="0" class="ak-input" value="@form.AgreedCurrencyPerUsd" />
                            </div>
                            <div class="ak-field">
                                <label for="RateReference" class="ak-label">@UiText.T(Context, "مرجع تأیید نرخ", "Rate reference")</label>
                                <input id="RateReference" name="RateReference" class="ak-input" maxlength="300" value="@form.RateReference" />
                            </div>
                        </div>
                    </details>
                </div>
            </section>

            <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                     model="@((UiText.T(Context, "ثبت", "Save"), backUrl ?? "/", UiText.T(Context, "انصراف", "Cancel")))" />
        </form>
    </div>
</div>
