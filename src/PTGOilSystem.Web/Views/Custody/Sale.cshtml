@model PTGOilSystem.Web.Models.Custody.CustodySaleViewModel
@using PTGOilSystem.Web.Models.Custody
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Services.Custody
@{
    var form = Model.Form;
    var lot = Model.Lot;
    var title = UiText.T(Context, "فروش امانی", "Custody sale") + " — " + lot.LotNumber;
    ViewData["Title"] = title;
    var backUrl = Url.Action("Details", new { id = lot.LotId });
    var methods = new[]
    {
        (CustodyCommissionMethod.PercentOfSale, UiText.T(Context, "فیصدی از مبلغ فروش", "Percent of sale")),
        (CustodyCommissionMethod.PerMt, UiText.T(Context, "مبلغ ثابت فی تُن (به ارز فروش)", "Fixed per MT (sale currency)")),
        (CustodyCommissionMethod.FixedPerSale, UiText.T(Context, "مبلغ ثابت برای همین فروش (به ارز فروش)", "Fixed for this sale (sale currency)")),
        (CustodyCommissionMethod.None, UiText.T(Context, "بدون کمیشن", "No commission"))
    };
    var currencies = new[] { ("USD", UiText.T(Context, "دالر (USD)", "US dollar (USD)")), ("AFN", UiText.T(Context, "افغانی (AFN)", "Afghani (AFN)")) };
    var fxOpen = !string.IsNullOrWhiteSpace(form.OwnerCurrency) && form.OwnerCurrency != form.Currency
        || form.AgreedCurrencyPerUsd.HasValue || form.FxResponsibility.HasValue;
    var settlements = new[]
    {
        (CustodySaleSettlement.Credit, UiText.T(Context, "نسیه — بعداً وصول می‌شود", "Credit — collected later")),
        (CustodySaleSettlement.CashToCompany, UiText.T(Context, "نقد — پول به صندوق/بانک شرکت آمد", "Cash to company till/bank")),
        (CustodySaleSettlement.DirectToOwner, UiText.T(Context, "مشتری مستقیم به مالک پرداخت کرد", "Customer paid the owner directly"))
    };
}

<div class="ak-form-page">
    <div class="ak-form-page-content">
        <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
                 model="@((title, true,
                           (string?)null, (string?)null, (string?)null, (string?)null,
                           UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right",
                           (string?)backUrl))" />

        <form asp-action="Sale" method="post" class="ak-form">
            @Html.AntiForgeryToken()
            @Html.FormToken()
            <input type="hidden" name="LotId" value="@lot.LotId" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

            <div class="alert alert-info ak-form-alert">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                @UiText.T(Context,
                    "شرکت به نمایندگی مالک می‌فروشد. تیل از موجودی همین مالک کم می‌شود؛ مبلغ فروش از آنِ مالک است و فقط کمیشن درآمد شرکت است. موجودی ملکی و فروش شرکت تغییر نمی‌کند.",
                    "The company sells on the owner's behalf. Stock leaves this owner's lot; the sale amount belongs to the owner and only the commission is company revenue.")
                <div class="small mt-1">
                    @UiText.T(Context, "اگر شرکت فروشندهٔ اصلی است، اول تیل را بخرد و سپس از موجودی ملکی بفروشد:", "If the company is the principal seller, buy the stock first, then sell from company stock:")
                    <a asp-action="ConvertPurchase" asp-route-id="@lot.LotId">@UiText.T(Context, "تبدیل به خرید قطعی", "Convert to purchase")</a>
                </div>
            </div>

            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((lot.OwnerName + " · " + lot.ProductName,
                                   (string?)(UiText.T(Context, "قابل فروش", "Available") + ": " + NumberDisplay.Quantity(lot.FreeMt, "MT"))))" />
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label for="CustomerId" class="ak-label">@UiText.T(Context, "مشتری (خریدار)", "Customer") <span class="ak-req">*</span></label>
                        <select id="CustomerId" name="CustomerId" class="ak-input" data-ak-entity-combobox>
                            <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.Id" selected="@(c.Id == form.CustomerId)">@c.Name</option>
                            }
                        </select>
                        <span class="ak-field-error">@Html.ValidationMessage("CustomerId")</span>
                    </div>
                    <div class="ak-field">
                        <label for="LocationKey" class="ak-label">@UiText.T(Context, "از مخزن", "From") <span class="ak-req">*</span></label>
                        <select id="LocationKey" name="LocationKey" class="ak-input">
                            <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                            @foreach (var l in Model.SourceLocations)
                            {
                                <option value="@l.Key" selected="@(l.Key == form.LocationKey)">@l.Label</option>
                            }
                        </select>
                        <span class="ak-field-error">@Html.ValidationMessage("LocationKey")</span>
                    </div>
                    <partial name="_CustodyMeasureFields" model="@(new CustodyMeasureFieldsModel("Measure", form.Measure, "QuantityMt", form.QuantityMt, UiText.T(Context, "مقدار از همین بار (MT)", "Quantity from this lot (MT)")))" />
                    <div class="ak-field">
                        <label for="Currency" class="ak-label">@UiText.T(Context, "ارز فروش به مشتری", "Sale currency")</label>
                        <select id="Currency" name="Currency" class="ak-input">
                            @foreach (var (code, label) in currencies)
                            {
                                <option value="@code" selected="@(code == form.Currency)">@label</option>
                            }
                        </select>
                    </div>
                    <div class="ak-field">
                        <label for="UnitPriceUsd" class="ak-label">@UiText.T(Context, "قیمت فی تُن (به ارز فروش)", "Price per MT (sale currency)") <span class="ak-req">*</span></label>
                        <input id="UnitPriceUsd" name="UnitPriceUsd" type="number" step="0.0001" min="0" class="ak-input" value="@form.UnitPriceUsd" />
                        <span class="ak-field-error">@Html.ValidationMessage("UnitPriceUsd")</span>
                    </div>
                    <div class="ak-field">
                        <label for="Date" class="ak-label">@UiText.T(Context, "تاریخ فروش", "Sale date") <span class="ak-req">*</span></label>
                        <input id="Date" name="Date" type="date" class="ak-input" value="@form.Date.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="ak-field">
                        <label for="DocumentNumber" class="ak-label">@UiText.T(Context, "شماره بل / سند", "Invoice / document no.")</label>
                        <input id="DocumentNumber" name="DocumentNumber" class="ak-input" value="@form.DocumentNumber" maxlength="100" />
                    </div>
                </div>
            </section>

            @if (Model.OtherSources.Any())
            {
                var extraOpen = form.Extra.Any(x => x.QuantityMt is > 0m);
                <details class="ak-advanced" open="@extraOpen">
                    <summary class="ak-advanced-summary fw-bold">@UiText.T(Context, "تأمین بخشی از همین فروش از بارهای دیگرِ همین مالک (اختیاری)", "Supply part of this sale from the owner's other lots (optional)")</summary>
                    <p class="text-muted small mb-2">@UiText.T(Context, "مقدار کلِ فروش = مقدار بالا + مقدارهای این بخش. یک سند فروش و یک کمیشن ثبت می‌شود و سهم هر بار جدا در تاریخچهٔ همان بار می‌ماند.", "Total = quantity above + these quantities. One sale document and one commission; each lot keeps its own share in its history.")</p>
                    <div class="ak-form-grid">
                        @for (var i = 0; i < Model.OtherSources.Count; i++)
                        {
                            var option = Model.OtherSources[i];
                            var value = form.Extra.FirstOrDefault(x => x.Key == option.Key)?.QuantityMt;
                            <div class="ak-field">
                                <input type="hidden" name="Extra[@i].Key" value="@option.Key" />
                                <label for="Extra_@(i)_QuantityMt" class="ak-label">@option.LotNumber · @option.Location <small class="text-muted">(@UiText.T(Context, "آزاد", "free") @NumberDisplay.Quantity(option.AvailableMt, "MT"))</small></label>
                                <input id="Extra_@(i)_QuantityMt" name="Extra[@i].QuantityMt" type="number" step="0.0001" min="0" class="ak-input" value="@value" />
                            </div>
                        }
                    </div>
                    <span class="ak-field-error">@Html.ValidationMessage("Extra")</span>
                </details>
            }

            <details class="ak-advanced" open="@fxOpen">
                <summary class="ak-advanced-summary fw-bold">@UiText.T(Context, "نرخ ارز و ارز تعهد به مالک (اختیاری)", "Exchange rate and owner currency (optional)")</summary>
                <p class="text-muted small mb-2">
                    @UiText.T(Context,
                        "نرخ از «نرخ روزانهٔ ارز» همان تاریخ گرفته می‌شود؛ نرخ توافقی فقط با مرجعِ تأییدشده. اگر مالک پولش را به ارز دیگری می‌خواهد، نرخِ توافق او قفل می‌شود و مسئول تفاوت نرخ باید صریحاً تعیین شود؛ تا تعیین نشود، وصولی که تفاوت نرخ دارد ثبت نمی‌شود.",
                        "Rates come from the daily FX table, or an agreed rate with a reference. A different owner currency locks the owner's agreed rate; collections with an FX difference wait until the responsibility is recorded.")
                </p>
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label for="AgreedCurrencyPerUsd" class="ak-label">@UiText.T(Context, "نرخ توافقیِ فروش (۱ دالر = ؟ افغانی)", "Agreed sale rate (AFN per USD)")</label>
                        <input id="AgreedCurrencyPerUsd" name="AgreedCurrencyPerUsd" type="number" step="0.000001" min="0" class="ak-input" value="@form.AgreedCurrencyPerUsd" />
                    </div>
                    <div class="ak-field">
                        <label for="RateReference" class="ak-label">@UiText.T(Context, "مرجع تأیید نرخ توافقی", "Agreed rate reference")</label>
                        <input id="RateReference" name="RateReference" class="ak-input" maxlength="300" value="@form.RateReference" />
                    </div>
                    <div class="ak-field">
                        <label for="OwnerCurrency" class="ak-label">@UiText.T(Context, "ارز تعهد به مالک", "Owner currency")</label>
                        <select id="OwnerCurrency" name="OwnerCurrency" class="ak-input">
                            <option value="">@UiText.T(Context, "همان ارز فروش", "Same as sale")</option>
                            @foreach (var (code, label) in currencies)
                            {
                                <option value="@code" selected="@(code == form.OwnerCurrency)">@label</option>
                            }
                        </select>
                    </div>
                    <div class="ak-field">
                        <label for="OwnerAgreedPerUsd" class="ak-label">@UiText.T(Context, "نرخ قفل‌شدهٔ توافق مالک (۱ دالر = ؟ افغانی)", "Owner's locked rate (AFN per USD)")</label>
                        <input id="OwnerAgreedPerUsd" name="OwnerAgreedPerUsd" type="number" step="0.000001" min="0" class="ak-input" value="@form.OwnerAgreedPerUsd"
                               placeholder="@UiText.T(Context, "خالی = نرخ روزانهٔ تاریخ فروش", "Empty = daily rate of sale date")" />
                    </div>
                    <div class="ak-field">
                        <label for="OwnerRateReference" class="ak-label">@UiText.T(Context, "مرجع نرخ توافق مالک", "Owner rate reference")</label>
                        <input id="OwnerRateReference" name="OwnerRateReference" class="ak-input" maxlength="300" value="@form.OwnerRateReference" />
                    </div>
                    <div class="ak-field">
                        <label for="FxResponsibility" class="ak-label">@UiText.T(Context, "مسئول تفاوت نرخ طبق توافق", "FX difference borne by")</label>
                        <select id="FxResponsibility" name="FxResponsibility" class="ak-input">
                            <option value="">@UiText.T(Context, "هنوز تعیین نشده", "Not agreed yet")</option>
                            <option value="@CustodyFxResponsibility.Owner" selected="@(form.FxResponsibility == CustodyFxResponsibility.Owner)">@UiText.T(Context, "مالک", "Owner")</option>
                            <option value="@CustodyFxResponsibility.Company" selected="@(form.FxResponsibility == CustodyFxResponsibility.Company)">@UiText.T(Context, "شرکت", "Company")</option>
                            <option value="@CustodyFxResponsibility.Split" selected="@(form.FxResponsibility == CustodyFxResponsibility.Split)">@UiText.T(Context, "تقسیم طبق توافق", "Split per agreement")</option>
                        </select>
                    </div>
                    <div class="ak-field">
                        <label for="FxOwnerSharePercent" class="ak-label">@UiText.T(Context, "سهم مالک از تفاوت (٪، فقط برای تقسیم)", "Owner share % (split only)")</label>
                        <input id="FxOwnerSharePercent" name="FxOwnerSharePercent" type="number" step="0.0001" min="0" max="100" class="ak-input" value="@form.FxOwnerSharePercent" />
                    </div>
                    <div class="ak-field ak-col-full">
                        <label for="FxAgreementReference" class="ak-label">@UiText.T(Context, "مرجع توافق مالک دربارهٔ تفاوت نرخ", "Owner FX agreement reference")</label>
                        <input id="FxAgreementReference" name="FxAgreementReference" class="ak-input" maxlength="300" value="@form.FxAgreementReference" />
                    </div>
                </div>
            </details>

            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((UiText.T(Context, "کمیشن شرکت", "Company commission"),
                                   (string?)UiText.T(Context, "فقط کمیشن درآمد شرکت است و از پولِ مالک کسر می‌شود.", "Only the commission is company revenue; it is deducted from the owner's money.")))" />
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label for="CommissionMethod" class="ak-label">@UiText.T(Context, "روش کمیشن", "Method")</label>
                        <select id="CommissionMethod" name="CommissionMethod" class="ak-input">
                            @foreach (var (value, label) in methods)
                            {
                                <option value="@value" selected="@(value == form.CommissionMethod)">@label</option>
                            }
                        </select>
                    </div>
                    <div class="ak-field">
                        <label for="CommissionRate" class="ak-label">@UiText.T(Context, "مقدار کمیشن (فیصد یا مبلغ به ارز فروش)", "Rate (percent or sale-currency amount)")</label>
                        <input id="CommissionRate" name="CommissionRate" type="number" step="0.000001" min="0" class="ak-input" value="@form.CommissionRate" />
                        <span class="ak-field-error">@Html.ValidationMessage("CommissionRate")</span>
                    </div>
                    <div class="ak-field ak-col-full">
                        <label for="CommissionRecognition" class="ak-label">@UiText.T(Context, "حق کمیشن چه زمانی قطعی است؟", "When is the commission earned?")</label>
                        <select id="CommissionRecognition" name="CommissionRecognition" class="ak-input">
                            <option value="@CustodyCommissionRecognition.OnCollection" selected="@(form.CommissionRecognition == CustodyCommissionRecognition.OnCollection)">
                                @UiText.T(Context, "به تناسب وصول پول از مشتری (پیش‌فرض)", "As the customer pays (default)")
                            </option>
                            <option value="@CustodyCommissionRecognition.OnSale" selected="@(form.CommissionRecognition == CustodyCommissionRecognition.OnSale)">
                                @UiText.T(Context, "با انجام فروش، حتی اگر مشتری هنوز نپرداخته", "On sale, even if not yet paid")
                            </option>
                        </select>
                    </div>
                </div>
            </section>

            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((UiText.T(Context, "دریافت پول", "Payment"), (string?)null))" />
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label for="Settlement" class="ak-label">@UiText.T(Context, "پول فروش", "Sale money")</label>
                        <select id="Settlement" name="Settlement" class="ak-input">
                            @foreach (var (value, label) in settlements)
                            {
                                <option value="@value" selected="@(value == form.Settlement)">@label</option>
                            }
                        </select>
                    </div>
                    <div class="ak-field">
                        <label for="CashAccountId" class="ak-label">@UiText.T(Context, "صندوق / بانک (فقط برای نقد)", "Till / bank (cash only)")</label>
                        <select id="CashAccountId" name="CashAccountId" class="ak-input">
                            <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                            @foreach (var a in Model.CashAccounts)
                            {
                                <option value="@a.Id" selected="@(a.Id == form.CashAccountId)">@a.Name</option>
                            }
                        </select>
                        <span class="ak-field-error">@Html.ValidationMessage("CashAccountId")</span>
                    </div>
                    <div class="ak-field ak-col-full">
                        <label for="Notes" class="ak-label">@UiText.T(Context, "توضیحات (اختیاری)", "Notes (optional)")</label>
                        <textarea id="Notes" name="Notes" class="ak-input" rows="2" maxlength="1000">@form.Notes</textarea>
                    </div>
                </div>
            </section>

            <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                     model="@((UiText.T(Context, "ثبت فروش امانی", "Record custody sale"), backUrl ?? "/", UiText.T(Context, "انصراف", "Cancel")))" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/custody-measurement.js" asp-append-version="true" defer></script>
}
