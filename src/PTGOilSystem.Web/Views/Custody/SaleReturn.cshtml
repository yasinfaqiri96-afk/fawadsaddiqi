@model PTGOilSystem.Web.Models.Custody.CustodySaleReturnViewModel
@using PTGOilSystem.Web.Models.Custody
@{
    var form = Model.Form;
    var sale = Model.Sale;
    var title = UiText.T(Context, "برگشت فروش امانی", "Custody sale return") + " — " + sale.SaleNumber;
    ViewData["Title"] = title;
    var backUrl = Url.Action("Owner", new { key = form.OwnerKey });
}

<div class="ak-form-page">
    <div class="ak-form-page-content">
        <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
                 model="@((title, true,
                           (string?)null, (string?)null, (string?)null, (string?)null,
                           UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right",
                           (string?)backUrl))" />

        <form asp-action="SaleReturn" method="post" class="ak-form">
            @Html.AntiForgeryToken()
            @Html.FormToken()
            <input type="hidden" name="SaleId" value="@form.SaleId" />
            <input type="hidden" name="OwnerKey" value="@form.OwnerKey" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

            <div class="alert alert-info ak-form-alert">
                <i class="bi bi-info-circle" aria-hidden="true"></i>
                @UiText.T(Context,
                    "تیلِ برگشتی به همان بار و مخزنی برمی‌گردد که از آن فروخته شده بود. طلب مشتری به اندازهٔ مبلغ برگشت کم می‌شود و کمیشن با همان روشِ فروش اصلاح می‌شود. برگشت فقط تا مبلغِ وصول‌نشده ممکن است.",
                    "Returned stock goes back to the lot and tank it was sold from. The customer's receivable and the commission are adjusted. Allowed only up to the uncollected amount.")
            </div>

            <section class="ak-form-section">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((sale.CustomerName + " · " + sale.ProductName,
                                   (string?)(UiText.T(Context, "وصول‌نشده", "Outstanding") + ": " + sale.OutstandingUsd.ToString("N2") + " USD · "
                                             + UiText.T(Context, "قیمت فی تُن", "Price/MT") + ": " + sale.UnitPriceUsd.ToString("N4"))))" />
                <div class="ak-form-grid">
                    @if (Model.Sources.Count == 1)
                    {
                        var only = Model.Sources[0];
                        <input type="hidden" name="Lines[0].Key" value="@only.Key" />
                        <p class="ak-col-full text-muted small mb-0">@only.LotNumber · @only.Location — @UiText.T(Context, "قابل برگشت", "returnable") @NumberDisplay.Quantity(only.AvailableMt, "MT")</p>
                        <partial name="_CustodyMeasureFields" model="@(new CustodyMeasureFieldsModel("Measure", form.Measure, "Lines[0].QuantityMt", form.Lines.FirstOrDefault()?.QuantityMt, UiText.T(Context, "مقدار برگشت (MT)", "Return quantity (MT)")))" />
                    }
                    else
                    {
                        @for (var i = 0; i < Model.Sources.Count; i++)
                        {
                            var option = Model.Sources[i];
                            var value = form.Lines.FirstOrDefault(x => x.Key == option.Key)?.QuantityMt;
                            <div class="ak-field">
                                <input type="hidden" name="Lines[@i].Key" value="@option.Key" />
                                <label for="Lines_@(i)_QuantityMt" class="ak-label">@option.LotNumber · @option.Location <small class="text-muted">(@UiText.T(Context, "قابل برگشت", "returnable") @NumberDisplay.Quantity(option.AvailableMt, "MT"))</small></label>
                                <input id="Lines_@(i)_QuantityMt" name="Lines[@i].QuantityMt" type="number" step="0.0001" min="0" class="ak-input" value="@value" />
                            </div>
                        }
                    }
                    <div class="ak-field">
                        <label for="Date" class="ak-label">@UiText.T(Context, "تاریخ برگشت", "Return date") <span class="ak-req">*</span></label>
                        <input id="Date" name="Date" type="date" class="ak-input" value="@form.Date.ToString("yyyy-MM-dd")" />
                    </div>
                    <div class="ak-field">
                        <label for="DocumentNumber" class="ak-label">@UiText.T(Context, "شماره سند", "Document no.")</label>
                        <input id="DocumentNumber" name="DocumentNumber" class="ak-input" value="@form.DocumentNumber" maxlength="100" />
                    </div>
                    <div class="ak-field ak-col-full">
                        <label for="Notes" class="ak-label">@UiText.T(Context, "توضیحات (اختیاری)", "Notes (optional)")</label>
                        <textarea id="Notes" name="Notes" class="ak-input" rows="2" maxlength="1000">@form.Notes</textarea>
                    </div>
                </div>
                <span class="ak-field-error">@Html.ValidationMessage("Lines")</span>
            </section>

            @if (sale.CollectedByCompanyUsd > 0m || sale.CollectedByOwnerUsd > 0m)
            {
                var refundOpen = (form.RefundFromCompanyUsd ?? 0m) + (form.RefundByOwnerUsd ?? 0m) > 0m;
                <details class="ak-advanced" open="@refundOpen">
                    <summary class="ak-advanced-summary fw-bold">@UiText.T(Context, "استرداد پولِ وصول‌شده (اگر مبلغ برگشت از وصول‌نشده بیشتر است)", "Refund of collected money")</summary>
                    <p class="text-muted small mb-2">
                        @UiText.T(Context, "جمعِ استرداد باید دقیقاً برابر بخشی از برگشت باشد که پولش قبلاً وصول شده. استرداد از صندوق فقط با سند واقعی پرداخت؛ اگر پول به مالک پرداخت شده، فقط با سندِ قابل وصول از مالک.", "Refunds must exactly cover the collected part; a real payment document is required.")
                        @UiText.T(Context, "نزد شرکت", "Held by company"): @sale.CollectedByCompanyUsd.ToString("N2") USD ·
                        @UiText.T(Context, "مستقیم به مالک", "Paid to owner directly"): @sale.CollectedByOwnerUsd.ToString("N2") USD
                    </p>
                    <div class="ak-form-grid">
                        @if (sale.CollectedByCompanyUsd > 0m)
                        {
                            <div class="ak-field">
                                <label for="RefundFromCompanyUsd" class="ak-label">@UiText.T(Context, "استرداد از صندوق شرکت (USD)", "Refund from company (USD)")</label>
                                <input id="RefundFromCompanyUsd" name="RefundFromCompanyUsd" type="number" step="0.01" min="0" class="ak-input" value="@form.RefundFromCompanyUsd" />
                            </div>
                            <div class="ak-field">
                                <label for="RefundCashAccountId" class="ak-label">@UiText.T(Context, "صندوق / بانک", "Till / bank")</label>
                                <select id="RefundCashAccountId" name="RefundCashAccountId" class="ak-input">
                                    <option value="">@UiText.T(Context, "- انتخاب -", "- Select -")</option>
                                    @foreach (var a in Model.CashAccounts)
                                    {
                                        <option value="@a.Id" selected="@(a.Id == form.RefundCashAccountId)">@a.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="ak-field">
                                <label for="RefundDocumentNumber" class="ak-label">@UiText.T(Context, "شمارهٔ سند پرداخت", "Payment document no.")</label>
                                <input id="RefundDocumentNumber" name="RefundDocumentNumber" class="ak-input" maxlength="100" value="@form.RefundDocumentNumber" />
                            </div>
                            <div class="ak-field ak-col-full">
                                <label><input type="checkbox" name="OwnerRecoveryConfirmed" value="true" checked="@form.OwnerRecoveryConfirmed" />
                                    @UiText.T(Context, "پول به مالک پرداخت شده و این مبلغ طبق سند از مالک قابل وصول است", "Owner was paid; this amount is recoverable from the owner per document")</label>
                                <input name="OwnerRecoveryReference" class="ak-input" maxlength="300" value="@form.OwnerRecoveryReference" aria-label="@UiText.T(Context, "سند قابل وصول از مالک", "Owner recovery document")" placeholder="@UiText.T(Context, "سند قابل وصول از مالک", "Owner recovery document")" />
                            </div>
                        }
                        @if (sale.CollectedByOwnerUsd > 0m)
                        {
                            <div class="ak-field">
                                <label for="RefundByOwnerUsd" class="ak-label">@UiText.T(Context, "مالک مستقیم پس داد (USD)", "Refunded by owner directly (USD)")</label>
                                <input id="RefundByOwnerUsd" name="RefundByOwnerUsd" type="number" step="0.01" min="0" class="ak-input" value="@form.RefundByOwnerUsd" />
                            </div>
                            <div class="ak-field">
                                <label for="OwnerRefundReference" class="ak-label">@UiText.T(Context, "سند استرداد مالک", "Owner refund document")</label>
                                <input id="OwnerRefundReference" name="OwnerRefundReference" class="ak-input" maxlength="100" value="@form.OwnerRefundReference" />
                            </div>
                        }
                    </div>
                </details>
            }

            <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                     model="@((UiText.T(Context, "ثبت برگشت", "Record return"), backUrl ?? "/", UiText.T(Context, "انصراف", "Cancel")))" />
        </form>
    </div>
</div>

@section Scripts {
    <script src="~/js/custody-measurement.js" asp-append-version="true" defer></script>
}
