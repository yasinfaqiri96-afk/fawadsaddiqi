@model PTGOilSystem.Web.Models.Sales.GroupSaleCreateViewModel
@using PTGOilSystem.Web.Models
@using PTGOilSystem.Web.Models.Sales
@using PTGOilSystem.Web.Models.Shared
@{
    ViewData["Title"] ="ثبت فروش گروهی";
    ViewData["HideSectionTabs"] = true;
    var sources = (List<GroupSaleSourceItem>)ViewBag.Sources;
    var cancelUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl)
        ? Model.ReturnUrl
        : Url.Action("Index");
    IReadOnlyList<AkFilterOption> FilterOptions(IEnumerable<string> values) => values
        .Where(value => !string.IsNullOrWhiteSpace(value))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(value => value)
        .Select(value => new AkFilterOption(value, value))
        .ToList();
    var sourceSearchFilter = new AkSearchFilterModel(
        "fQuery",
        null,
        "جستجو در شماره، مسیر، قرارداد...",
        new List<AkFilterDefinition>
        {
            AkFilterDefinition.MultiSelect("fKind", "نوع منبع", FilterOptions(sources.Select(item => item.KindLabel)), null),
            AkFilterDefinition.MultiSelect("fVehicle", "نوع وسیله", FilterOptions(sources.Select(item => item.VehicleKind)), null),
            AkFilterDefinition.MultiSelect("fContract", "قرارداد", FilterOptions(sources.Select(item => item.ContractNumber)), null),
            AkFilterDefinition.MultiSelect("fProduct", "کالا", FilterOptions(sources.Select(item => item.ProductName)), null),
            AkFilterDefinition.MultiSelect("fStatus", "وضعیت", FilterOptions(sources.Select(item => item.StatusLabel)), null)
        });
}

<div class="ak-form-page ak-group-operation-page ak-group-operation-page--wide ak-group-wizard-page">
    @* data-no-spa + novalidate: مانند فرم مصرف گروهی؛ نرخ تبدیل مخفی نباید native-validation را بلاک کند.
       data-no-submit-guard: گاردِ سراسریِ core.js روی فرمِ novalidate راهِ آزادسازی ندارد و دکمه را
       روی «در حال ثبت…» قفل می‌کرد؛ این فرم قفلِ ضدِ دابل‌کلیکِ خودش را با آزادسازیِ امنِ زمان‌دار دارد. *@
    <form asp-action="CreateGroup" method="post" id="gsaleForm" class="ak-form" data-no-spa data-no-submit-guard novalidate>
        @Html.AntiForgeryToken()
        @Html.FormToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <div id="gsaleItemsContainer"></div>

        <header class="ak-page-header">
            <div class="ak-page-heading">
                <span class="ak-page-icon"><i class="bi bi-cart-plus"></i></span>
                <div>
                    <h1>ثبت فروش گروهی</h1>
                    <p>فروش همزمان از چند منبع: بارگیری‌ها، موجودی مخازن، موترها، واگن‌ها و بارهای در راه</p>
                </div>
            </div>
            <a href="@cancelUrl" class="btn btn-light ak-secondary-action" aria-label="بستن"><i class="bi bi-x-lg"></i></a>
        </header>

        <partial name="~/Views/Shared/Components/_WizardSteps.cshtml" model="@(new WizardStepsViewModel("مراحل ثبت فروش گروهی", "data-step-btn", new[] { new WizardStepItem(1, "انتخاب منابع", true), new WizardStepItem(2, "تعیین مقدار"), new WizardStepItem(3, "مشخصات فروش"), new WizardStepItem(4, "بررسی و ثبت") }))" />

        <div asp-validation-summary="All" class="alert alert-danger ak-form-alert"></div>

        <!-- مرحله ۱: انتخاب منابع -->
        <section class="ak-form-section ak-group-wizard-workspace" data-step-panel="1">
            <div class="ak-group-wizard-main">
                <div class="ak-form-section">
                    <h2 class="ak-section-title">انتخاب منابع قابل فروش</h2>
                    <partial name="_AkClientSearchFilter" model="@sourceSearchFilter" />

                    <label class="form-check">
                        <input type="checkbox" id="chkAll" class="form-check-input" />
                        <span class="form-check-label">انتخاب همه نتایج (<span id="lblResultCount">0</span> منبع)</span>
                    </label>

                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th class="ak-col-check"></th>
                                    <th>#</th>
                                    <th>نوع منبع</th>
                                    <th>وسیله</th>
                                    <th>شماره</th>
                                    <th>مسیر</th>
                                    <th>کالا</th>
                                    <th>شرکت</th>
                                    <th>موجودی/مقدار</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody id="srcBody"></tbody>
                        </table>
                        <div class="ak-empty" id="srcEmpty" hidden>
                            <i class="bi bi-inbox"></i>
                            هیچ منبع قابل فروشی با این فیلتر یافت نشد
                        </div>
                    </div>

                    <div class="ak-pager">
                        <label class="ak-field">
                            <select class="ak-input" id="pageSize">
                                <option value="10" selected>10</option>
                                <option value="25">25</option>
                                <option value="50">50</option>
                            </select>
                            <span>تعداد در صفحه</span>
                        </label>
                        <div class="ak-section-desc" id="pageInfo"></div>
                        <div class="ak-pager" id="pager"></div>
                    </div>
                </div>
            </div>

            <aside class="ak-form-section ak-group-wizard-summary">
                <div class="ak-form-section ak-list">
                    <h2 class="ak-section-title">خلاصه انتخاب</h2>
                    <div class="ak-list-row">
                        <span>تعداد منابع انتخاب شده</span>
                        <strong class="ak-num" id="sumCount">0</strong>
                    </div>
                    <div class="ak-list-row">
                        <span>مجموع مقدار</span>
                        <strong class="ak-num"><span id="sumQty">0</span> تن</strong>
                    </div>
                    <div class="ak-list-row">
                        <span>نوع منابع</span>
                        <div id="sumKinds" class="ak-list"></div>
                    </div>
                </div>
            </aside>
        </section>

        <!-- مرحله ۲: تعیین مقدار -->
        <section class="ak-form-section" data-step-panel="2" hidden>
            <div>
                <div class="ak-form-section">
                    <h2 class="ak-section-title">تعیین مقدار فروش هر منبع</h2>
                    <p class="ak-note">بارگیری‌ها و موجودی مخازن به مقدار انتخابی فروخته می‌شوند؛ موتر و واگن به صورت کامل فروخته می‌شوند.</p>
                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>نوع منبع</th>
                                    <th>شماره</th>
                                    <th>مسیر</th>
                                    <th>کالا</th>
                                    <th>موجودی (تن)</th>
                                    <th>مقدار فروش (تن)</th>
                                </tr>
                            </thead>
                            <tbody id="qtyBody"></tbody>
                        </table>
                    </div>
                    <div class="ak-subform-toolbar"><span id="qtyPageInfo" class="ak-note" aria-live="polite"></span><nav id="qtyPager" aria-label="صفحه‌های مقدار فروش"></nav></div>
                </div>
            </div>
        </section>

        <!-- مرحله ۳: مشخصات فروش -->
        <section class="ak-form-section" data-step-panel="3" hidden>
            <div>
                <div class="ak-form-section">
                    <h2 class="ak-section-title">مشخصات فروش</h2>
                    <div class="ak-field">
                        <label asp-for="LoadingSaleTerminalId">محل فروش مستقیم بارگیری</label>
                        <select asp-for="LoadingSaleTerminalId" asp-items="ViewBag.LoadingSaleTerminals" class="ak-input">
                            <option value="">انتخاب محل (برای فروش از بارگیری الزامی)</option>
                        </select>
                        <span asp-validation-for="LoadingSaleTerminalId" class="ak-field-error"></span>
                        <small>این محل فقط برای ثبت سند فروش بارگیری است؛ جنس وارد مخزن نمی‌شود.</small>
                    </div>
                    <div class="ak-form-grid">
                        <div class="ak-field">
                            <label asp-for="BuyerKey">خریدار <em>*</em></label>
                            <select asp-for="BuyerKey" asp-items="ViewBag.Buyers" class="ak-input">
                                <option value="">انتخاب خریدار</option>
                            </select>
                            <span asp-validation-for="BuyerKey" class="ak-field-error"></span>
                        </div>
                        <div class="ak-field">
                            <label asp-for="SaleDate">تاریخ فروش <em>*</em></label>
                            <input asp-for="SaleDate" type="date" class="ak-input" />
                        </div>
                        <div class="ak-field">
                            <label asp-for="Currency">ارز <em>*</em></label>
                            <select asp-for="Currency" asp-items="ViewBag.Currencies" class="ak-input" id="currencySelect"></select>
                        </div>
                        <div class="ak-field" data-fx-rate-group data-fx-currency-source="#currencySelect">
                            <div data-fx-rate-field>
                                <label>نرخ دالر به <span data-fx-currency-name>ارز</span></label>
                                <input type="text" inputmode="decimal" class="ak-input" data-fx-rate-input data-sale-price-pending-target autocomplete="off" placeholder="مثال: ۷۷" />
                                <input asp-for="AppliedFxRateToUsd" type="hidden" data-fx-rate-technical data-sale-price-pending-target />
                            </div>
                            <div data-fx-usd-note class="d-none">
                                <small class="form-text text-muted"><i class="bi bi-info-circle"></i> فروش دالری است؛ نرخ تبدیل لازم نیست.</small>
                            </div>
                        </div>
                        <div class="ak-field">
                            <label asp-for="UnitPriceInCurrency">نرخ فروش هر تن <em>*</em></label>
                            <div class="ak-input-unit">
                                <span data-cur-tag>USD</span>
                                <input asp-for="UnitPriceInCurrency" type="number" step="0.0001" min="0" class="ak-input" placeholder="0.00" data-sale-price-pending-target />
                            </div>
                        </div>
                        @* فروش با قیمت باز: بار ثبت می‌شود؛ قیمت بعداً از صفحهٔ همان فروش تعیین می‌شود. *@
                        <div class="ak-field ak-col-full">
                            <div class="form-check">
                                <input asp-for="IsSalePricePending" class="form-check-input" type="checkbox" data-sale-price-pending-toggle />
                                <label asp-for="IsSalePricePending" class="form-check-label">@UiText.T(Context, "قیمت فروش هنوز مشخص نیست", "Sale price not yet known")</label>
                            </div>
                            <div class="form-text" data-sale-price-pending-hint hidden>@UiText.T(Context, "بار و موجودی همین حالا ثبت می‌شود؛ طلب مشتری، عاید و مفاد پس از تعیین قیمت از صفحهٔ همین فروش ثبت می‌شود.", "Delivery is recorded now; receivable, revenue and profit are posted once the price is set from the sale page.")</div>
                        </div>
                        <div class="ak-field">
                            <label asp-for="PaymentNote">پرداخت / شرایط</label>
                            <input asp-for="PaymentNote" class="ak-input" placeholder="مثلاً: نقد، بعد از تخلیه، ..." />
                        </div>
                        <div class="ak-field ak-col-full">
                            <label asp-for="Notes">توضیحات</label>
                            <textarea asp-for="Notes" class="ak-input" rows="2" placeholder="توضیحات (اختیاری)..."></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- مرحله ۴: بررسی و ثبت -->
        <section class="ak-form-section" data-step-panel="4" hidden>
            <div>
                <div class="ak-form-section">
                    <h2 class="ak-section-title">پیش‌نمایش فروش گروهی</h2>
                    <div class="ak-list" id="previewMeta"></div>
                    <div class="ak-table-wrap">
                        <table class="ak-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>نوع منبع</th>
                                    <th>شماره</th>
                                    <th>کالا</th>
                                    <th>مقدار (تن)</th>
                                    <th>مبلغ ردیف</th>
                                </tr>
                            </thead>
                            <tbody id="previewBody"></tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="4" class="ak-table-total">مجموع مقدار</td>
                                    <td class="ak-num"><span id="previewQty">0</span> تن</td>
                                    <td class="ak-num"><span id="previewTotal">0.00</span> <span data-cur-tag>USD</span></td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                    <div class="ak-subform-toolbar"><span id="previewPageInfo" class="ak-note" aria-live="polite"></span><nav id="previewPager" aria-label="صفحه‌های پیش‌نمایش فروش"></nav></div>
                    <div class="ak-note">
                        <i class="bi bi-shield-check"></i>
                        برای هر منبع یک سند فروش جداگانه در همین گروه ثبت می‌شود. ماندهٔ بار و شرایط ثبت اسناد مالی هنگام ثبت دوباره بررسی می‌شوند.
                    </div>
                </div>
            </div>
        </section>

        <footer class="ak-form-section">
            <div class="ak-note">
                <i class="bi bi-info-circle"></i>
                <span id="footerNote">در مرحله بعد، مقدار فروش هر منبع را تعیین می‌کنید.</span>
            </div>
            <div class="ak-footer-actions">
                <a href="@cancelUrl" class="btn ak-secondary-action">انصراف</a>
                <button type="button" class="btn ak-secondary-action" id="btnPrev" hidden>مرحله قبلی</button>
                <button type="button" class="btn ak-primary-action" id="btnNext">مرحله بعدی <i class="bi bi-arrow-left"></i></button>
                <button type="submit" class="btn ak-primary-action" id="btnSubmit" hidden>
                    <i class="bi bi-check2-circle"></i> ثبت نهایی فروش گروهی
                </button>
            </div>
        </footer>
    </form>
</div>

<script id="gsaleSrcData" type="application/json">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(sources.Select(o => new
{
    key = o.Key,
    kind = (int)o.Kind,
    id = o.Id,
    kindLabel = o.KindLabel,
    vehicle = o.VehicleKind,
    number = o.Number,
    route = o.Route,
    product = o.ProductName,
    company = o.CompanyName,
    contract = o.ContractNumber,
    available = o.AvailableMt,
    isFull = o.IsFullVehicle,
    status = o.StatusLabel,
    date = o.MoveDate.ToString("yyyy-MM-dd"),
    productId = o.ProductId,
    terminalId = o.TerminalId,
    tankId = o.StorageTankId,
    contractId = o.SourcePurchaseContractId,
    companyId = o.CompanyId
})))</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/fx-rate-field.js" asp-append-version="true" defer></script>
    <script src="~/js/sale-price-pending.js" asp-append-version="true" defer></script>
    <script>
    (function () {
        'use strict';
        var sources = JSON.parse(document.getElementById('gsaleSrcData').textContent || '[]');
        var state = {
            step: 1,
            page: 1,
            pageSize: 10,
            qtyPage: 1,
            previewPage: 1,
            selectedPageSize: 50,
            selected: new Map(), // key -> { src, qty }
            filtered: sources.slice()
        };

        var $ = function (id) { return document.getElementById(id); };
        // Metadata can contain user-entered product, vehicle and customer names.
        // Escape display text and attribute values before inserting HTML.
        function escapeHtml(value) {
            return String(value == null ? '' : value).replace(/[&<>"']/g, function (ch) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch];
            });
        }
        function selectedPage(items, property, pager, info, render) {
            var pages = Math.max(1, Math.ceil(items.length / state.selectedPageSize));
            state[property] = Math.min(state[property], pages);
            var start = (state[property] - 1) * state.selectedPageSize;
            $(info).textContent = items.length === 0 ? '' : 'نمایش ' + (start + 1) + ' تا ' + Math.min(start + state.selectedPageSize, items.length) + ' از ' + items.length + ' مورد';
            renderPager($(pager), state[property], pages, function (page) { state[property] = page; render(); });
            return { start: start, items: items.slice(start, start + state.selectedPageSize) };
        }
        function fmt(n) { return (Math.round(n * 100) / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
        function fmtQty(n) { return Number(n).toLocaleString('en-US', { maximumFractionDigits: 4 }); }

        // صفحه‌بندی هم‌شکل با کامپوننت مشترک سیستم (_Pagination.cshtml): پنجرهٔ ۵تایی،
        // «/» ابتدا/انتها، «…» و صفحهٔ اول/آخر. کلاینت‌ساید چون داده در همین ویزارد است.
        function renderPager(container, current, pageCount, go) {
            container.innerHTML = '';
            if (pageCount <= 1) { return; }
            var ul = document.createElement('ul');
            ul.className = 'pagination pagination-sm mb-0';
            function li(label, page, active, disabled) {
                var item = document.createElement('li');
                item.className = 'page-item' + (active ? ' active' : '') + (disabled ? ' disabled' : '');
                var link = document.createElement(disabled || active ? 'span' : 'a');
                link.className = 'page-link';
                link.textContent = label;
                if (!disabled && !active && page) {
                    link.href = '#';
                    link.addEventListener('click', function (e) { e.preventDefault(); go(page); });
                }
                item.appendChild(link);
                ul.appendChild(item);
            }
            var start = Math.max(1, current - 2);
            var end = Math.min(pageCount, start + 4);
            if (end - start < 4) { start = Math.max(1, end - 4); }
            li('«', current - 1, false, current === 1);
            if (start > 1) { li('1', 1, false, false); if (start > 2) { li('…', null, false, true); } }
            for (var i = start; i <= end; i++) { li(String(i), i, i === current, false); }
            if (end < pageCount) { if (end < pageCount - 1) { li('…', null, false, true); } li(String(pageCount), pageCount, false, false); }
            li('»', current + 1, false, current === pageCount);
            container.appendChild(ul);
        }

        // ---------- فیلترها ----------
        var sourceFilter = document.querySelector('#gsaleForm [data-ak-filter-client]');
        function filterValues(key) {
            // چندانتخابی: هر مقدار یک input پنهان با همان نام است (OR بین مقادیر).
            return Array.prototype.map.call(
                sourceFilter.querySelectorAll('[data-ak-filter-param][name="' + key + '"]'),
                function (field) { return field.value; });
        }
        function matchesAny(key, value) {
            var values = filterValues(key);
            return values.length === 0 || values.indexOf(value) !== -1;
        }
        function filterValue(key) {
            var field = sourceFilter.querySelector('[data-ak-filter-param][name="' + key + '"]');
            return field ? field.value : '';
        }

        function applyFilters() {
            var q = ($('fQuery').value || '').trim().toLowerCase();
            state.filtered = sources.filter(function (o) {
                if (!matchesAny('fKind', o.kindLabel)) return false;
                if (!matchesAny('fVehicle', o.vehicle)) return false;
                if (!matchesAny('fContract', o.contract)) return false;
                if (!matchesAny('fProduct', o.product)) return false;
                if (!matchesAny('fStatus', o.status)) return false;
                if (q && (o.number + ' ' + escapeHtml(o.route) + ' ' + o.contract + ' ' + escapeHtml(o.kindLabel) + ' ' + escapeHtml(o.company) + ' ' + o.product).toLowerCase().indexOf(q) < 0) return false;
                return true;
            });
            state.page = 1;
            renderTable();
        }
        sourceFilter.addEventListener('ak:filter-change', applyFilters);

        // ---------- جدول ----------
        function renderTable() {
            var body = $('srcBody');
            body.innerHTML = '';
            var total = state.filtered.length;
            $('lblResultCount').textContent = total;
            $('srcEmpty').hidden = total > 0;

            var pages = Math.max(1, Math.ceil(total / state.pageSize));
            if (state.page > pages) state.page = pages;
            var start = (state.page - 1) * state.pageSize;
            var slice = state.filtered.slice(start, start + state.pageSize);

            slice.forEach(function (o, idx) {
                var tr = document.createElement('tr');
                var checked = state.selected.has(o.key);
                if (checked) tr.classList.add('is-selected');
                tr.innerHTML =
                    '<td class="ak-col-check"><input type="checkbox" ' + (checked ? 'checked' : '') + '></td>' +
                    '<td>' + (start + idx + 1) + '</td>' +
                    '<td>' + escapeHtml(o.kindLabel) + '</td>' +
                    '<td>' + escapeHtml(o.vehicle) + '</td>' +
                    '<td class="ak-num">' + escapeHtml(o.number) + '</td>' +
                    '<td>' + escapeHtml(o.route) + '</td>' +
                    '<td>' + escapeHtml(o.product) + '</td>' +
                    '<td>' + escapeHtml(o.company) + '</td>' +
                    '<td class="ak-num">' + fmtQty(o.available) + '</td>' +
                    '<td><span class="ak-status is-active">' + escapeHtml(o.status) + '</span></td>';
                tr.addEventListener('click', function (e) {
                    if (e.target.tagName === 'INPUT') return;
                    toggle(o);
                });
                tr.querySelector('input').addEventListener('change', function () { toggle(o); });
                body.appendChild(tr);
            });

            $('pageInfo').textContent = total === 0 ? '' :
                'نمایش ' + (start + 1) + ' تا ' + Math.min(start + state.pageSize, total) + ' از ' + total + ' مورد';

            renderPager($('pager'), state.page, pages, function (pp) { state.page = pp; renderTable(); });

            $('chkAll').checked = state.filtered.length > 0 && state.filtered.every(function (o) { return state.selected.has(o.key); });
            renderSummary();
        }

        function toggle(o) {
            if (state.selected.has(o.key)) state.selected.delete(o.key);
            else state.selected.set(o.key, { src: o, qty: o.available });
            renderTable();
        }

        $('chkAll').addEventListener('change', function () {
            if (this.checked) state.filtered.forEach(function (o) { if (!state.selected.has(o.key)) state.selected.set(o.key, { src: o, qty: o.available }); });
            else state.filtered.forEach(function (o) { state.selected.delete(o.key); });
            renderTable();
        });
        $('pageSize').addEventListener('change', function () { state.pageSize = parseInt(this.value, 10) || 10; state.page = 1; renderTable(); });

        function renderSummary() {
            var items = Array.from(state.selected.values());
            $('sumCount').textContent = items.length;
            $('sumQty').textContent = fmtQty(items.reduce(function (a, s) { return a + Number(s.qty || 0); }, 0));
            var byKind = {};
            items.forEach(function (s) { byKind[s.src.kindLabel] = (byKind[s.src.kindLabel] || 0) + 1; });
            $('sumKinds').innerHTML = Object.keys(byKind).map(function (v) {
                return '<div><span>' + escapeHtml(v) + '</span><b>' + byKind[v] + '</b></div>';
            }).join('') || '<div class="ak-note">—</div>';
        }

        // ---------- مرحله ۲: مقدار ----------
        function renderQty() {
            var body = $('qtyBody');
            body.innerHTML = '';
            var items = Array.from(state.selected.values());
            var page = selectedPage(items, 'qtyPage', 'qtyPager', 'qtyPageInfo', renderQty);
            page.items.forEach(function (s, i) {
                var tr = document.createElement('tr');
                var qtyCell;
                if (s.src.isFull) {
                    qtyCell = '<td class="ak-num"><b>' + fmtQty(s.src.available) + '</b> <small class="ak-note">(کامل)</small></td>';
                } else {
                    qtyCell = '<td><input type="number" step="0.0001" min="0" max="' + s.src.available + '" class="ak-input gsale-qty-input" data-key="' + escapeHtml(s.src.key) + '" value="' + (s.qty || '') + '"></td>';
                }
                tr.innerHTML =
                    '<td>' + (page.start + i + 1) + '</td>' +
                    '<td>' + escapeHtml(s.src.kindLabel) + '</td>' +
                    '<td class="ak-num">' + escapeHtml(s.src.number) + '</td>' +
                    '<td>' + escapeHtml(s.src.route) + '</td>' +
                    '<td>' + escapeHtml(s.src.product) + '</td>' +
                    '<td class="ak-num">' + fmtQty(s.src.available) + '</td>' +
                    qtyCell;
                body.appendChild(tr);
            });
            body.querySelectorAll('.gsale-qty-input').forEach(function (inp) {
                inp.addEventListener('input', function () {
                    var entry = state.selected.get(this.dataset.key);
                    if (entry) entry.qty = parseFloat(this.value) || 0;
                });
            });
        }

        // ---------- ارز ----------
        var curSel = $('currencySelect');
        function syncCurrencyTags() { document.querySelectorAll('[data-cur-tag]').forEach(function (t) { t.textContent = curSel.value || 'USD'; }); }
        if (curSel) { curSel.addEventListener('change', syncCurrencyTags); syncCurrencyTags(); }

        // ---------- پیش‌نمایش ----------
        function isPricePending() { var toggle = $('IsSalePricePending'); return !!(toggle && toggle.checked); }
        function fmtAmount(n) { return isPricePending() ? 'نامشخص' : fmt(n); }
        function renderPreview() {
            var items = Array.from(state.selected.values());
            var price = parseFloat($('UnitPriceInCurrency').value) || 0;
            var body = $('previewBody');
            body.innerHTML = '';
            var totalQty = 0, total = 0;
            items.forEach(function (s) {
                var qty = s.src.isFull ? Number(s.src.available) : Number(s.qty || 0);
                totalQty += qty;
                total += Math.round(qty * price * 100) / 100;
            });
            var page = selectedPage(items, 'previewPage', 'previewPager', 'previewPageInfo', renderPreview);
            page.items.forEach(function (s, i) {
                var qty = s.src.isFull ? Number(s.src.available) : Number(s.qty || 0);
                var amount = Math.round(qty * price * 100) / 100;
                var tr = document.createElement('tr');
                tr.innerHTML =
                    '<td>' + (page.start + i + 1) + '</td>' +
                    '<td>' + escapeHtml(s.src.kindLabel) + '</td>' +
                    '<td class="ak-num">' + escapeHtml(s.src.number) + '</td>' +
                    '<td>' + escapeHtml(s.src.product) + '</td>' +
                    '<td class="ak-num">' + fmtQty(qty) + '</td>' +
                    '<td class="ak-num">' + fmtAmount(amount) + '</td>';
                body.appendChild(tr);
            });
            var cust = $('BuyerKey');
            $('previewMeta').innerHTML =
                '<span><b>مشتری:</b> ' + escapeHtml(cust.options[cust.selectedIndex] ? cust.options[cust.selectedIndex].text : '-') + '</span>' +
                '<span><b>نرخ هر تن:</b> ' + fmtAmount(price) + ' ' + escapeHtml(curSel.value || 'USD') + '</span>' +
                '<span><b>تعداد منابع:</b> ' + items.length + '</span>';
            $('previewQty').textContent = fmtQty(totalQty);
            $('previewTotal').textContent = fmtAmount(total);
        }

        // All selected rows are submitted, including rows outside the visible page.
        // FormData avoids creating thousands of hidden DOM inputs on modern browsers.
        function writeItems(append) {
            var i = 0;
            state.selected.forEach(function (s) {
                var mk = function (name, value) { append('Items[' + i + '].' + name, value == null ? '' : String(value)); };
                mk('Kind', s.src.kind);
                mk('Id', s.src.id);
                mk('QuantityMt', s.src.isFull ? s.src.available : (s.qty || 0));
                if (s.src.kind === 1) {
                    mk('ProductId', s.src.productId);
                    mk('TerminalId', s.src.terminalId);
                    mk('StorageTankId', s.src.tankId);
                    mk('SourcePurchaseContractId', s.src.contractId);
                    mk('CompanyId', s.src.companyId);
                }
                i++;
            });
        }

        var form = $('gsaleForm');
        var usesFormDataEvent = 'FormDataEvent' in window;
        if (usesFormDataEvent) {
            form.addEventListener('formdata', function (event) { writeItems(function (name, value) { event.formData.append(name, value); }); });
        }
        function syncItemsInputs() {
            var container = $('gsaleItemsContainer');
            container.innerHTML = '';
            if (usesFormDataEvent) return;
            writeItems(function (name, value) {
                var input = document.createElement('input');
                input.type = 'hidden'; input.name = name; input.value = value;
                container.appendChild(input);
            });
        }

        // ---------- ویزارد ----------
        var notes = {
            1: 'در مرحله بعد، مقدار فروش هر منبع را تعیین می‌کنید.',
            2: 'در مرحله بعد، مشخصات مشتری و نرخ فروش را وارد می‌کنید.',
            3: 'در مرحله بعد، پیش‌نمایش فروش را می‌بینید و ثبت نهایی را انجام می‌دهید.',
            4: 'با ثبت نهایی، برای هر منبع یک سند فروش جداگانه ساخته می‌شود.'
        };

        function validateStep2() {
            var bad = Array.from(state.selected.values()).some(function (s) {
                if (s.src.isFull) return false;
                var q = Number(s.qty || 0);
                return !(q > 0) || q > Number(s.src.available) + 0.0001;
            });
            if (bad) { alert('مقدار فروش باید بزرگ‌تر از صفر و حداکثر برابر ماندهٔ قابل فروش همان بار یا مخزن باشد.'); return false; }
            return true;
        }

        function validateStep3() {
            if (Array.from(state.selected.values()).some(function (s) { return s.src.kind === 5; }) && !$('LoadingSaleTerminalId').value) {
                alert('محل فروش مستقیم بارگیری را انتخاب کنید.'); return false;
            }
            if (!$('BuyerKey').value) { alert('خریدار را انتخاب کنید.'); return false; }
            // قیمت باز: نرخ فروش و نرخ تبدیل غیرفعال و خالی‌اند و بعداً از صفحهٔ هر فروش تعیین می‌شوند.
            if (isPricePending()) return true;
            if (!(parseFloat($('UnitPriceInCurrency').value) > 0)) { alert('نرخ فروش هر تن را وارد کنید.'); return false; }
            var cur = (curSel && curSel.value) || 'USD';
            if (cur !== 'USD') {
                var tech = document.querySelector('[data-fx-rate-technical]');
                if (!tech || !(parseFloat(tech.value) > 0)) { alert('برای ارز ' + cur + ' نرخ تبدیل را وارد کنید.'); return false; }
            }
            return true;
        }

        function goStep(n) {
            if (n < 1 || n > 4) return;
            if (n > 1 && state.selected.size === 0) { alert('حداقل یک منبع را انتخاب کنید.'); return; }
            if (n > 2 && !validateStep2()) return;
            if (n > 3 && !validateStep3()) return;
            state.step = n;
            document.querySelectorAll('[data-step-panel]').forEach(function (p) { p.hidden = parseInt(p.dataset.stepPanel, 10) !== n; });
            document.querySelectorAll('[data-step-btn]').forEach(function (b) {
                var bn = parseInt(b.dataset.stepBtn, 10);
                b.classList.toggle('is-active', bn === n);
                b.classList.toggle('is-done', bn < n);
                if (bn === n) b.setAttribute('aria-current', 'step');
                else b.removeAttribute('aria-current');
            });
            $('btnPrev').hidden = n === 1;
            $('btnNext').hidden = n === 4;
            $('btnSubmit').hidden = n !== 4;
            $('footerNote').textContent = notes[n];
            if (n === 2) renderQty();
            if (n === 4) renderPreview();
        }

        document.querySelectorAll('[data-step-btn]').forEach(function (b) {
            b.addEventListener('click', function () { goStep(parseInt(this.dataset.stepBtn, 10)); });
        });
        $('btnNext').addEventListener('click', function () { goStep(state.step + 1); });
        $('btnPrev').addEventListener('click', function () { goStep(state.step - 1); });

        document.getElementById('gsaleForm').addEventListener('submit', function (e) {
            if (state.selected.size === 0 || !validateStep2() || !validateStep3()) { e.preventDefault(); return; }
            syncItemsInputs();

            // قفلِ سادهٔ ضدِ دابل‌کلیک. اگر ناوبری انجام نشد (خطای شبکه/سرور)،
            // بعد از چند ثانیه دکمه آزاد می‌شود تا هرگز روی «در حال ثبت…» گیر نکند.
            var btn = $('btnSubmit');
            if (btn && !btn.disabled) {
                var original = btn.innerHTML;
                setTimeout(function () {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="bi bi-hourglass-split"></i> در حال ثبت…';
                }, 0);
                setTimeout(function () {
                    btn.disabled = false;
                    btn.innerHTML = original;
                }, 8000);
            }
        });

        renderTable();
        goStep(1);
    })();
    </script>
}
