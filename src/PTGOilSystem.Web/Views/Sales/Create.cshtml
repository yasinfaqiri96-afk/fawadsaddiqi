@model PTGOilSystem.Web.Models.Sales.SalesCreateViewModel
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.Sales
@{
    var isEdit = ViewData["IsEdit"] as bool? ?? false;
    var editId = ViewData["EditId"] as int?;
    ViewData["Title"] = isEdit ? "ویرایش فاکتور فروش" : "ثبت فاکتور فروش";
    ViewData["HideSectionTabs"] = true;
    ViewData["LoadingCreateAssets"] = true;
    var hasLocalReturnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl);
    var cancelUrl = hasLocalReturnUrl ? Model.ReturnUrl : Url.Action("Index");
    var baseCurrencyCode = PTGOilSystem.Web.Services.SystemCurrency.BaseCurrencyCode;
    var showFxRateField = !string.Equals(Model.Currency, baseCurrencyCode, StringComparison.OrdinalIgnoreCase);
    var displayCurrencyCode = string.IsNullOrWhiteSpace(Model.Currency) ? baseCurrencyCode : Model.Currency;
    var shipmentContractMapJson = System.Text.Json.JsonSerializer.Serialize(ViewData["ShipmentContractMap"] ?? Array.Empty<object>());
    // ترمینال مبدا از روی مخزن انتخاب‌شده پر می‌شود؛ فرم دیگر فیلد ترمینال ندارد.
    var tankTerminalMapJson = System.Text.Json.JsonSerializer.Serialize(ViewData["SourceTankTerminalMap"] ?? Array.Empty<object>());
    var pageTitle = isEdit ? UiText.T(Context, "ویرایش فاکتور فروش", "Edit Sales Invoice") : UiText.T(Context, "ثبت فاکتور فروش", "New Sales Invoice");
    var submitLabel = isEdit ? UiText.T(Context, "ذخیره تغییرات", "Save changes") : UiText.T(Context, "ذخیره و ثبت", "Save & submit");
    // انتخاب نوع تحویل فقط در ثبتِ فروشِ تازه معنی دارد؛ در ویرایش و در فروشِ جایگزین نه.
    var showDeliveryModeChoice = !isEdit && !Model.CorrectedFromSaleId.HasValue;
    var fullDeliveryUrl = Url.Action("Create", new { returnUrl = Model.ReturnUrl }) ?? "#";
    var stagedDeliveryUrl = Url.Action("PreSaleCreate") ?? "#";
}

<div class="page-stack ak-form-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((pageTitle, false, (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right", (string?)cancelUrl))" />

    @if (showDeliveryModeChoice)
    {
        <partial name="~/Views/Sales/_SaleDeliveryModeChoice.cshtml"
                 model="@(("full", fullDeliveryUrl, stagedDeliveryUrl))" />
    }

    <form asp-action="@(isEdit ? "Edit" : "Create")" asp-route-id="@(isEdit ? editId : null)" method="post"
          class="ak-form"
          data-sales-create-form="true"
          data-sales-stock-balance-url="@Url.Action("SourceStockBalance", "Sales")"
          data-sales-base-currency="@baseCurrencyCode"
          data-sales-shipment-contract-map="@shipmentContractMapJson"
          data-sales-tank-terminal-map="@tankTerminalMapJson">
        @{ ViewData["OpHeaderBackUrl"] = cancelUrl; }
        @Html.AntiForgeryToken()
        @Html.FormToken()
        <input asp-for="ReturnUrl" type="hidden" />
        <input asp-for="Version" type="hidden" />
        @* PTG-P2-03 — پیوند به سندِ ابطال‌شده، فقط در جریانِ اصلاح. *@
        <input asp-for="CorrectedFromSaleId" type="hidden" />
        <input asp-for="DestinationLocationId" type="hidden" data-sales-destination-id />
        @if (Model.ContractId.HasValue)
        {
            <input asp-for="ContractId" type="hidden" />
        }
        <div asp-validation-summary="All" class="alert alert-danger ak-form-alert"></div>

        <section class="ak-form-section" aria-label="@UiText.T(Context, "اطلاعات فروش", "Sale information")">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "اطلاعات فروش", "Sale Information"), (string?)UiText.T(Context, "مشخصات خریدار، شرکت و سند فروش را وارد کنید.", "Enter the buyer, company and sales document details.")))" />
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="BuyerKey" class="ak-label">@UiText.T(Context, "خریدار", "Buyer") <span class="ak-req">*</span></label>
                    <select asp-for="BuyerKey" asp-items="ViewBag.Buyers" class="ak-input" data-ak-entity-combobox>
                        <option value="">@UiText.T(Context, "انتخاب خریدار", "Select buyer")</option>
                    </select>
                    <span asp-validation-for="BuyerKey" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="CompanyId" class="ak-label">@UiText.T(Context, "شرکت", "Company") <span class="ak-req">*</span></label>
                    <select asp-for="CompanyId" asp-items="ViewBag.Companies" class="ak-input" data-sales-company><option value="">@UiText.T(Context, "انتخاب شرکت", "Select company")</option></select>
                    <span asp-validation-for="CompanyId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="SaleDate" class="ak-label">@UiText.T(Context, "تاریخ فروش", "Sale date") <span class="ak-req">*</span></label>
                    <input asp-for="SaleDate" type="date" class="ak-input" data-sales-date data-ptg-date-guard data-ptg-today="@BusinessClock.Today.ToString("yyyy-MM-dd")" />
                    <span asp-validation-for="SaleDate" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="InvoiceNumber" class="ak-label">@UiText.T(Context, "شماره فاکتور", "Invoice number") <span class="ak-req">*</span></label>
                    <input asp-for="InvoiceNumber" class="ak-input" placeholder="@UiText.T(Context, "شماره فاکتور", "Invoice number")" />
                    <span asp-validation-for="InvoiceNumber" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="SaleStage" class="ak-label">@UiText.T(Context, "مرحله فروش", "Sale stage") <span class="ak-req">*</span></label>
                    <select asp-for="SaleStage" asp-items="ViewBag.SaleStages" class="ak-input" data-sales-stage></select>
                    <div id="saleStageHelp" class="form-text"></div>
                    <span asp-validation-for="SaleStage" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="Currency" class="ak-label">@UiText.T(Context, "ارز", "Currency") <span class="ak-req">*</span></label>
                    <select asp-for="Currency" asp-items="ViewBag.Currencies" class="ak-input" data-sales-currency><option value=""></option></select>
                    <span asp-validation-for="Currency" class="ak-field-error"></span>
                </div>
                <div class="ak-field" data-sales-fx-rate-field @(showFxRateField ? null : "hidden")>
                    <label asp-for="AppliedFxRateToUsd" class="ak-label">@UiText.T(Context, "نرخ تبدیل به USD", "FX rate to USD")</label>
                    <input asp-for="AppliedFxRateToUsd" class="ak-input" data-sales-fx-rate />
                    <span asp-validation-for="AppliedFxRateToUsd" class="ak-field-error"></span>
                </div>
            </div>
        </section>

        <section class="ak-form-section" data-sales-stage-scope="terminal" aria-label="@UiText.T(Context, "منبع فروش", "Sale source")">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "منبع فروش", "Sale Source"), (string?)UiText.T(Context, "مخزنی را انتخاب کنید که کالا از آن خارج می‌شود؛ ترمینال از همان مخزن گرفته می‌شود.", "Select the tank the product will leave from; its terminal is taken from the tank.")))" />
            <div class="ak-form-grid">
                @* ترمینال مبدا فیلد جدا ندارد و با انتخاب مخزن از نگاشت مخزن←ترمینال پر می‌شود. *@
                <input asp-for="SourceTerminalId" type="hidden" data-sales-source-terminal />
                <div class="ak-field">
                    <label asp-for="SourceStorageTankId" class="ak-label">@UiText.T(Context, "مخزن منبع", "Source tank") <span class="ak-req">*</span></label>
                    <select asp-for="SourceStorageTankId" asp-items="ViewBag.SourceStorageTanks" class="ak-input" data-sales-source-tank><option value=""></option></select>
                    @* خلاصهٔ همان مخزن: فقط مقدار قابل فروش. *@
                    <p class="ak-stock-chip" data-sales-stock-alert hidden>
                        <span class="ak-stock-chip__message" data-sales-stock-message hidden></span>
                        <span class="ak-stock-chip__item">
                            <span>@UiText.T(Context, "موجودی قابل فروش", "Sellable stock")</span>
                            <strong class="ak-num" data-sales-stock-alert-value>--</strong>
                        </span>
                    </p>
                    <span asp-validation-for="SourceStorageTankId" class="ak-field-error"></span>
                    <span asp-validation-for="SourceTerminalId" class="ak-field-error"></span>
                </div>
                <div class="ak-field ak-col-full">
                    <label asp-for="SourcePurchaseContractId" class="ak-label">@UiText.T(Context, "قرارداد خرید منبع (اختیاری)", "Source purchase contract (optional)")</label>
                    <select asp-for="SourcePurchaseContractId" asp-items="ViewBag.SourcePurchaseContracts" class="ak-input" data-suggested-price-url="@Url.Action("SuggestedPrice", "Sales")" data-sales-source-contract>
                        <option value="">@UiText.T(Context, "نمی‌دانم — محاسبه خودکار از موجودی مخزن", "Unknown — auto-allocate from tank stock")</option>
                    </select>
                    <div class="form-text">@UiText.T(Context, "اگر قرارداد را نمی‌دانید، سیستم فروش را از موجودی همین شرکت و مخزن به‌صورت خودکار تخصیص می‌دهد.", "If unknown, the system automatically allocates the sale from this company and tank stock.")</div>
                    <span asp-validation-for="SourcePurchaseContractId" class="ak-field-error"></span>
                </div>
            </div>
        </section>

        <section class="ak-form-section" data-sales-stage-scope="transit border customs" aria-label="@UiText.T(Context, "ردیابی مسیر", "Route trace")">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "موجودی در مسیر", "In-transit stock"), (string?)UiText.T(Context, "باری را انتخاب کنید که همین حالا در راه است؛ موجودی مخزن کم نمی‌شود.", "Pick the load that is currently on the way; tank stock is not reduced.")))" />
            <div class="ak-form-grid">
                @* همان فیلد ShipmentId است، اما گزینه‌ها بارهای در راه با مقدارشان‌اند نه فهرست خشک محموله‌ها. *@
                <div class="ak-field ak-col-full">
                    <label asp-for="ShipmentId" class="ak-label">@UiText.T(Context, "بار در مسیر", "In-transit load") <span class="ak-req">*</span></label>
                    <select asp-for="ShipmentId" asp-items="ViewBag.InTransitStocks" class="ak-input" data-sales-shipment>
                        <option value="">@UiText.T(Context, "انتخاب بار در مسیر", "Select an in-transit load")</option>
                    </select>
                    <div class="form-text">@UiText.T(Context, "فهرست از حمل‌های بارگیری‌شده و در راه ساخته می‌شود.", "The list is built from loaded and in-transit legs.")</div>
                    <span asp-validation-for="ShipmentId" class="ak-field-error"></span>
                </div>
            </div>
            <details class="ak-advanced">
                <summary class="ak-advanced-summary">
                    <span><i class="bi bi-sliders2" aria-hidden="true"></i>@UiText.T(Context, "گزینه‌های بیشتر", "More options")</span>
                </summary>
                <div class="ak-form-grid">
                    <div class="ak-field">
                        <label asp-for="TicketSerialNumber" class="ak-label">@UiText.T(Context, "سریال تکت", "Ticket serial")</label>
                        <input asp-for="TicketSerialNumber" class="ak-input" data-sales-ticket />
                    </div>
                    <div class="ak-field">
                        <label asp-for="StockSourceType" class="ak-label">@UiText.T(Context, "منبع ردیابی", "Trace source")</label>
                        <select asp-for="StockSourceType" asp-items="Html.GetEnumSelectList<StockSourceType>()" class="ak-input" data-sales-stock-source><option value=""></option></select>
                    </div>
                </div>
            </details>
        </section>

        <section class="ak-form-section" aria-label="@UiText.T(Context, "اقلام فروش", "Sale items")">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "اقلام فروش", "Sale Items"), (string?)UiText.T(Context, "این فاکتور یک قلم فروش دارد.", "This invoice contains one sale item.")))" />
            @* واحد همیشه MT است و ارز در سربرگ ستون آمده؛ داخل ردیف تکرار نمی‌شوند. *@
            <div class="ak-table-wrap ak-table-wrap--flush" data-sales-line-items>
                <table class="ak-table">
                    <thead><tr><th>@UiText.T(Context, "محصول", "Product") <span class="ak-req">*</span></th><th class="ak-col-num">@UiText.T(Context, "مقدار", "Quantity") (MT) <span class="ak-req">*</span></th><th class="ak-col-num">@UiText.T(Context, "قیمت واحد", "Unit price") (@displayCurrencyCode) <span class="ak-req">*</span></th><th class="ak-col-num">@UiText.T(Context, "مبلغ کل", "Total") (@displayCurrencyCode)</th></tr></thead>
                    <tbody><tr>
                        <td><select asp-for="ProductId" asp-items="ViewBag.Products" class="ak-input" data-sales-product data-ak-entity-combobox><option value="">@UiText.T(Context, "انتخاب محصول", "Select product")</option></select><span asp-validation-for="ProductId" class="ak-field-error"></span></td>
                        <td class="ak-col-num"><input asp-for="QuantityMt" class="ak-input text-end" data-sales-quantity /><span asp-validation-for="QuantityMt" class="ak-field-error"></span></td>
                        <td class="ak-col-num"><input asp-for="UnitPriceInCurrency" class="ak-input text-end" data-sales-unit-price /><span asp-validation-for="UnitPriceInCurrency" class="ak-field-error"></span></td>
                        <td class="ak-col-num" data-sales-total-preview><strong data-sales-total-value>0.00</strong></td>
                    </tr></tbody>
                </table>
            </div>
            @* فروش با قیمت باز: تحویل و موجودی ثبت می‌شود، سند مالی پس از «تعیین قیمت فروش». *@
            <div class="ak-field ak-col-full">
                <div class="form-check">
                    <input asp-for="IsSalePricePending" class="form-check-input" type="checkbox" data-sales-price-pending disabled="@isEdit" />
                    <label asp-for="IsSalePricePending" class="form-check-label">@UiText.T(Context, "قیمت فروش هنوز مشخص نیست", "Sale price not yet known")</label>
                </div>
                <div class="form-text">@UiText.T(Context, "بار و موجودی همین حالا ثبت می‌شود؛ طلب مشتری، عاید و مفاد پس از تعیین قیمت از صفحهٔ همین فروش ثبت می‌شود.", "Delivery and stock are recorded now; receivable, revenue and profit are posted once the price is set from this sale's page.")</div>
            </div>
            <div hidden>
                <span id="suggestedPriceHint"></span><span id="suggestedPriceReason"></span><span id="suggestedPriceFallback"></span><span id="suggestedPriceFormula"></span>
            </div>
        </section>

        <section class="ak-form-section" data-sales-save-summary aria-live="polite" aria-label="@UiText.T(Context, "مرور نهایی فروش", "Final sale review")">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((UiText.T(Context, "مرور نهایی فروش", "Final Sale Review"), (string?)UiText.T(Context, "پیش از ثبت، شرایط فروش را بررسی کنید.", "Review the sale conditions before saving.")))" />
            @* فقط دو عدد نهایی: مقدار فروش و مبلغ کل فاکتور. *@
            <dl class="ak-summary-hero">
                <div>
                    <dt>@UiText.T(Context, "مقدار فروش", "Sale quantity")</dt>
                    <dd class="ak-num"><span data-sales-summary-qty>0.000</span> <span class="ak-summary-hero__unit">MT</span></dd>
                </div>
                <div>
                    <dt>@UiText.T(Context, "مبلغ کل فاکتور", "Invoice total")</dt>
                    <dd class="ak-num"><span data-sales-summary-amount>0.00</span> <span class="ak-summary-hero__unit" data-sales-summary-amount-unit>@displayCurrencyCode</span></dd>
                </div>
            </dl>
            <div class="form-text" data-sales-save-summary-warning hidden></div>
            <details class="ak-advanced">
                <summary class="ak-advanced-summary">
                    <span><i class="bi bi-card-text" aria-hidden="true"></i>@UiText.T(Context, "توضیحات", "Notes")</span>
                </summary>
                <div class="ak-form-grid">
                    <div class="ak-field ak-col-full"><label asp-for="Notes" class="ak-label">@UiText.T(Context, "توضیحات (اختیاری)", "Notes (optional)")</label><textarea asp-for="Notes" rows="3" class="ak-input" placeholder="@UiText.T(Context, "توضیحات را وارد کنید...", "Enter notes...")"></textarea></div>
                </div>
            </details>
        </section>

        <input asp-for="Loss.Enabled" type="hidden" />
        <input asp-for="Loss.Stage" type="hidden" />
        <input asp-for="Loss.QuantityMt" type="hidden" />
        <input asp-for="Loss.Notes" type="hidden" />

        <partial name="~/Views/Shared/_ClosedPeriodOverride.cshtml" />

        <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                 model="@((submitLabel, cancelUrl ?? "#", UiText.T(Context, "انصراف", "Cancel")))" />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
