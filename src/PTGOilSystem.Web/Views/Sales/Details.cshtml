@model PTGOilSystem.Web.Models.Sales.SalesDetailsViewModel
@using PTGOilSystem.Web.Models.Sales
@inject Microsoft.Extensions.Options.IOptions<PTGOilSystem.Web.Configuration.ClientProfileOptions> ClientProfileOptionsAccessor
@{
    string T(string fa, string en) => UiText.T(Context, fa, en);

    var returnUrl = ViewBag.ReturnUrl as string;
    var backUrl = !string.IsNullOrWhiteSpace(returnUrl)
        ? returnUrl
        : Url.Action("Index", "Sales") ?? "/Sales";
    var currentReturnUrl = Context.Request.Path + Context.Request.QueryString;
    var contractText = SalesContractText.Display(Model.ContractNumber);
    var stageText = SaleStageLabels.ToPersian(Model.SaleStage);
    var customerText = string.IsNullOrWhiteSpace(Model.CustomerName)
        ? T("خریدار نامشخص", "Unknown buyer")
        : Model.CustomerName;
    // فروش با قیمت باز: مبلغ و مانده «نامشخص»اند، نه صفر. دریافت پیش از تعیین قیمت به همین فروش
    // وصل می‌شود و تا تعیین قیمت پیش‌دریافت روی حساب مشتری می‌ماند.
    var pricePending = Model.IsSalePricePending && !Model.IsCancelled;
    var pricingAwaiting = !Model.IsCancelled && Model.PricingState != SalePricingState.Final;
    var pricingLabel = SalePricingText.Label(Model.PricingState);
    var unknownText = T(SalePricingText.Unknown, "Unknown");
    var canRegisterReceipt = !Model.IsSupplierBuyer && !Model.IsCancelled && Model.CustomerId > 0
        && (Model.ReceivableBalanceUsd > 0m || pricePending);
    var directApplications = Model.Payments.Where(p => p.IsAdvanceApplication == false && p.ApplicationId != null).ToList();
    var canApplyReceipt = !Model.IsSupplierBuyer && !Model.IsCancelled && Model.ReceivableBalanceUsd > 0m && Model.ApplicableReceipts.Count > 0;
    var firstReceipt = Model.ApplicableReceipts.FirstOrDefault();
    var firstReceiptSuggestion = firstReceipt is null
        ? 0m
        : Math.Min(firstReceipt.UnappliedAmountUsd, Model.ReceivableBalanceUsd);
    var stockSourceText = Model.StockSourceType?.ToString() switch
    {
        "Wagon" => T("واگن", "Wagon"),
        "Stock" => T("انبار / مخزن", "Stock / tank"),
        "Tank" => T("تانک", "Tank"),
        _ => null
    };

    ViewData["AkHeaderStatus"] = Model.IsCancelled
        ? T("لغو شده", "Cancelled")
        : pricingAwaiting ? pricingLabel : T("تکمیل شده", "Completed");
    ViewData["AkHeaderStatusState"] = Model.IsCancelled ? "is-danger" : pricingAwaiting ? "is-warning" : "is-active";
    // خط زمینهٔ سربرگ حذف شد: مشتری، تاریخ و مرحله عیناً در کارت «اطلاعات فروش» می‌آیند.

    // Action split shared by every Operations detail page:
    //   action bar = the next operations of THIS record, first one is the single CTA;
    //   kebab      = edit, side routes and destructive actions.
    // No action is listed in both places, and no "create another record" link
    // takes the primary slot.
    var editUrl = Url.Action("Edit", new { id = Model.Id, returnUrl = currentReturnUrl });
    // «ویرایش» در نوار شناسه دیده می‌شود، پس در kebab تکرار نمی‌شود.
    var salesKebab = new List<AkHeaderMenuItem>
    {
        new()
        {
            Label = T("فروش جدید", "New sale"),
            Href = Url.Action("Create", new { returnUrl = backUrl }),
            Icon = "bi-plus-lg"
        }
    };
    if (!Model.IsCancelled)
    {
        // PTG-P2-03 — ابطال دیگر یک کلیکِ بی‌سؤال نیست: صفحهٔ اصلاح دلیل می‌خواهد و
        // جایگزینِ پیونددار را پیشنهاد می‌دهد.
        salesKebab.Add(new AkHeaderMenuItem
        {
            Label = T("ابطال / اصلاح فروش", "Cancel / correct sale"),
            Href = Url.Action("Correct", new { id = Model.Id, returnUrl = currentReturnUrl }),
            Icon = "bi-slash-circle",
            IsDestructive = true
        });
    }
    ViewData["AkHeaderKebab"] = salesKebab;

    var amountMetrics = new List<AkKpiItem>
    {
        new() { Title = T("مقدار فروش", "Sale quantity"), Value = NumberDisplay.Quantity(Model.QuantityMt), Unit = "MT", Avatar = "flow-weight-mt" },
        new() { Title = T("مبلغ کل", "Total amount"), Value = pricePending ? unknownText : Model.TotalInCurrency.ToString("N2"), Unit = pricePending ? null : Model.Currency, State = pricePending ? "warning" : "accent", Avatar = "flow-cash" },
        new() { Title = pricePending ? T("پیش‌دریافت", "Received in advance") : T("دریافت‌شده", "Received"), Value = Model.ReceivedUsd.ToString("N2"), Unit = "USD", Avatar = "flow-receipt-check" },
        new() { Title = T("مانده قابل دریافت", "Outstanding receivable"), Value = pricePending ? unknownText : Model.ReceivableBalanceUsd.ToString("N2"), Unit = pricePending ? null : "USD", State = pricePending || Model.ReceivableBalanceUsd > 0 ? "warning" : null, Avatar = "flow-invoice-check" }
    };

    // زون ۳: یک کارت هویتی + یک کارت منبع. اعداد پول از این گرید بیرون کشیده شده‌اند
    // و در «صورت‌حساب» زیر می‌آیند، چون ردیف‌بندیِ عدد-کنار-برچسب خواناتر از سلول‌های هم‌وزن است.
    // رنگ فقط روی مقادیر state‌دار (مرحله). هویت با وزن و اندازه برجسته می‌شود، نه با رنگ.
    var summaryItems = new List<AkInfoItem>
    {
        new() { Label = T("خریدار", "Buyer"), Value = customerText },
        new() { Label = T("تاریخ فروش", "Sale date"), Value = Model.SaleDate.ToDisplayDate(), IsNumeric = true },
        new() { Label = T("مرحله", "Stage"), Value = stageText, Tone = "info" },
        new() { Label = T("کالا", "Product"), Value = Model.ProductName },
        new() { Label = T("شرکت / جواز", "Company / licence"), Value = Model.CompanyName },
        new() { Label = T("قیمت فی تن", "Unit price / MT"), Value = pricePending ? unknownText : $"{Model.UnitPriceInCurrency:N2} {Model.Currency}", IsNumeric = !pricePending, Tone = pricePending ? "warning" : null }
    };
    if (!Model.IsCancelled)
    {
        summaryItems.Add(new AkInfoItem
        {
            Label = T("وضعیت قیمت", "Pricing status"),
            Value = pricingLabel,
            Tone = pricingAwaiting ? "warning" : "success"
        });
    }
    if (Model.IsPurchasePricePending && !Model.IsCancelled)
    {
        // بهای خرید از قرارداد خرید منبع می‌آید؛ تکمیلش در صفحهٔ نرخ همان قرارداد است، نه این‌جا.
        var pendingContract = Model.PendingPurchaseContracts[0];
        summaryItems.Add(new AkInfoItem
        {
            Label = T("قیمت خرید", "Purchase price"),
            Value = T("در انتظار نرخ قرارداد ", "Awaiting contract price ")
                + string.Join("، ", Model.PendingPurchaseContracts.Select(c => c.Label)),
            Href = Url.Action("Details", "Contracts", new { id = pendingContract.ContractId }),
            Tone = "warning"
        });
    }
    if (Model.SalePriceFixedAtUtc.HasValue)
    {
        summaryItems.Add(new AkInfoItem
        {
            Label = T("تعیین قیمت فروش", "Sale price fixed"),
            Value = Model.SalePriceFixedAtUtc.Value.ToDisplayDate()
                + (string.IsNullOrWhiteSpace(Model.SalePriceFixedByName) ? string.Empty : $" · {Model.SalePriceFixedByName}")
        });
    }
    if (Model.SalePriceAccountingDate.HasValue && Model.SalePriceAccountingDate.Value.Date != Model.SaleDate.Date)
    {
        // دورهٔ تاریخ تحویل بسته بود؛ اسناد مالی قیمت‌گذاری در دورهٔ باز ثبت شده‌اند.
        summaryItems.Add(new AkInfoItem
        {
            Label = T("تاریخ ثبت مالی", "Accounting date"),
            Value = Model.SalePriceAccountingDate.Value.ToDisplayDate(),
            IsNumeric = true,
            Tone = "info"
        });
    }
    // کارت منبع فقط واقعیت عملیاتی است؛ هیچ‌کدام state نیستند، پس بدون رنگ می‌مانند.
    var sourceItems = new List<AkInfoItem>
    {
        new() { Label = T("نوع منبع", "Source type"), Value = stockSourceText },
        new()
        {
            Label = T("قرارداد خرید منبع", "Source purchase contract"),
            Value = Model.SourcePurchaseContractNumber,
            Href = Model.SourcePurchaseContractId.HasValue ? Url.Action("Details", "Contracts", new { id = Model.SourcePurchaseContractId.Value }) : null
        },
        new() { Label = T("ترمینال مبدأ", "Source terminal"), Value = Model.SourceTerminalName },
        new() { Label = T("مخزن مبدأ", "Source tank"), Value = Model.SourceStorageTankCode },
        new()
        {
            Label = T("مرجع حمل", "Transport reference"),
            Value = Model.InventoryTransportReference,
            Href = Model.InventoryTransportLegId.HasValue ? Url.Action("Details", "InventoryTransportLegs", new { id = Model.InventoryTransportLegId.Value, returnUrl = currentReturnUrl }) : null
        },
        new() { Label = T("مقصد", "Destination"), Value = Model.DestinationName }
    };

    // ردیابی فنی و شناسه‌های داخلی — پشت آکاردئون بسته.
    var advancedItems = new List<AkInfoItem>
    {
        new() { Label = T("شماره داخلی", "Internal id"), Value = $"#{Model.Id}", IsNumeric = true },
        new() { Label = T("سریال تکت", "Ticket serial"), Value = Model.TicketSerialNumber },
        new() { Label = T("حرکت‌های موجودی", "Inventory movements"), Value = Model.InventoryMovementIdsText },
        new() { Label = T("شناسه تخصیص رسید", "Receipt allocation id"), Value = Model.LoadingReceiptAllocationId.HasValue ? $"#{Model.LoadingReceiptAllocationId.Value}" : null, IsNumeric = true },
        new() { Label = T("شناسه رسید حمل", "Transport receipt id"), Value = Model.InventoryTransportReceiptId.HasValue ? $"#{Model.InventoryTransportReceiptId.Value}" : null, IsNumeric = true },
        new() { Label = T("ثبت‌کننده", "Recorded by"), Value = Model.CreatedByName },
        new() { Label = T("تاریخ ثبت", "Recorded at"), Value = Model.CreatedAtUtc.ToDisplayDate() }
    };

    var timelineItems = new List<AkTimelineItem>
    {
        new()
        {
            Title = T("فروش ثبت شد", "Sale recorded"),
            Date = Model.SaleDate.ToDisplayDate(),
            Timestamp = Model.SaleDate,
            Icon = "bi-receipt",
            State = Model.Payments.Count == 0 ? "is-current" : null,
            Meta = pricePending ? T(SalePricingText.PendingSalePrice, "Awaiting sale price") : $"{Model.TotalUsd:N2} USD"
        }
    };
    foreach (var payment in Model.Payments)
    {
        timelineItems.Add(new AkTimelineItem
        {
            Title = payment.IsAdvanceApplication
                ? T("مصرف پیش‌دریافت", "Advance applied")
                : payment.IsIncoming ? T("دریافت", "Receipt") : T("برگشت وجه", "Refund"),
            Date = payment.PaymentDate.ToDisplayDate(),
            Timestamp = payment.PaymentDate,
            Icon = payment.IsAdvanceApplication ? "bi-arrow-repeat" : payment.IsIncoming ? "bi-arrow-down-left" : "bi-arrow-up-right",
            Href = Url.Action("Details", "Payments", new { id = payment.PaymentTransactionId, returnUrl = currentReturnUrl }),
            Meta = $"{(payment.IsIncoming ? "+" : "-")}{payment.Amount.ToString("N2")} {payment.Currency}"
        });
    }
    var showTimeline = timelineItems.Count > 1;

    var relatedRecords = new List<AkRelatedRecord>();
    if (Model.ContractId.HasValue)
    {
        relatedRecords.Add(new AkRelatedRecord
        {
            TypeLabel = T("قرارداد", "Contract"),
            Label = contractText,
            Href = Url.Action("Details", "ContractJourney", new { contractId = Model.ContractId.Value, tab = "summary", lockContract = true }),
            Icon = "bi-file-earmark-text"
        });
    }
    if (Model.ShipmentId.HasValue && !string.IsNullOrWhiteSpace(Model.ShipmentCode))
    {
        relatedRecords.Add(new AkRelatedRecord
        {
            TypeLabel = T("محموله", "Shipment"),
            Label = Model.ShipmentCode,
            Href = Url.Action("Details", "ShipmentPnl", new { id = Model.ShipmentId.Value }),
            Icon = "bi-box-seam"
        });
    }
    if (Model.PreSaleOrderId.HasValue)
    {
        relatedRecords.Add(new AkRelatedRecord
        {
            TypeLabel = T("فروش مرحله‌ای", "Staged-delivery sale"),
            Label = $"#{Model.PreSaleOrderId.Value}",
            Href = Url.Action("PreSaleDetails", "Sales", new { id = Model.PreSaleOrderId.Value }),
            Icon = "bi-calendar-check"
        });
    }
    if (Model.LedgerEntryId.HasValue)
    {
        relatedRecords.Add(new AkRelatedRecord
        {
            TypeLabel = T("سند دفتر کل", "Ledger entry"),
            Label = $"#{Model.LedgerEntryId.Value}",
            Href = Url.Action("Details", "Ledger", new { id = Model.LedgerEntryId.Value, returnUrl = currentReturnUrl }),
            Icon = "bi-journal-text"
        });
    }
    if (Model.LoadingReceiptId.HasValue)
    {
        relatedRecords.Add(new AkRelatedRecord
        {
            TypeLabel = T("رسید بارگیری", "Loading receipt"),
            Label = $"#{Model.LoadingReceiptId.Value}",
            Href = Url.Action("Details", "LoadingReceipts", new { id = Model.LoadingReceiptId.Value, returnUrl = currentReturnUrl }),
            Icon = "bi-receipt"
        });
    }
    if (Model.InventoryTransportLegId.HasValue)
    {
        relatedRecords.Add(new AkRelatedRecord
        {
            TypeLabel = T("مسیر حمل", "Transport leg"),
            Label = $"#{Model.InventoryTransportLegId.Value}",
            Href = Url.Action("Details", "InventoryTransportLegs", new { id = Model.InventoryTransportLegId.Value, returnUrl = currentReturnUrl }),
            Icon = "bi-truck"
        });
    }

    // Next operations of this sale. Recording the receipt is the CTA while money
    // is still outstanding; otherwise printing the invoice is.
    var nextActions = new List<AkHeaderMenuItem>();
    if (pricePending)
    {
        nextActions.Add(new AkHeaderMenuItem
        {
            Label = T("تعیین قیمت فروش", "Set sale price"),
            Href = Url.Action("SetPrice", new { id = Model.Id, returnUrl = currentReturnUrl }),
            Icon = "bi-tag"
        });
    }
    if (canRegisterReceipt)
    {
        nextActions.Add(new AkHeaderMenuItem
        {
            Label = pricePending ? T("ثبت پیش‌دریافت", "Record advance receipt") : T("ثبت دریافت", "Record receipt"),
            Href = Url.Action("Create", "Payments", new { customerId = Model.CustomerId, salesTransactionId = Model.Id, returnUrl = currentReturnUrl }),
            Icon = "bi-cash-coin"
        });
    }
    // فاکتور بدون قیمت چاپ نمی‌شود؛ پس از تعیین قیمت دوباره در دسترس است.
    // Instanceی که قالب اختصاصی دارد (مثلاً Mashal) فقط همان یک فاکتور را می‌بیند.
    var instanceInvoiceTemplates = SalesInvoiceTemplateOptions.AllowedFor(ClientProfileOptionsAccessor.Value.InvoiceTemplate);
    if (!pricePending && instanceInvoiceTemplates.Count == 1)
    {
        nextActions.Add(new AkHeaderMenuItem
        {
            Label = T("فاکتور", "Invoice"),
            Href = Url.Action("Invoice", new { id = Model.Id, template = instanceInvoiceTemplates[0].ToString().ToLowerInvariant() }),
            Icon = "bi-receipt"
        });
    }
    else if (!pricePending)
    {
        nextActions.Add(new AkHeaderMenuItem
        {
            Label = T("فاکتور ۱", "Invoice 1"),
            Href = Url.Action("Invoice", new { id = Model.Id, template = "faisal" }),
            Icon = "bi-receipt"
        });
        nextActions.Add(new AkHeaderMenuItem
        {
            Label = T("فاکتور ۲", "Invoice 2"),
            Href = Url.Action("Invoice", new { id = Model.Id, template = "fawad" }),
            Icon = "bi-receipt-cutoff"
        });
    }
    var activityRows = new List<AkDetailActivityRow>
    {
        new() { Label = T("دریافت‌ها", "Receipts"), Value = Model.Payments.Count.ToString("N0"), Meta = Model.Payments.Count > 0 ? T("پرداخت ثبت شده", "Recorded payments") : T("بدون پرداخت", "No payment"), Status = pricePending ? T("در انتظار قیمت", "Awaiting price") : Model.ReceivableBalanceUsd <= 0m ? T("تکمیل", "Complete") : T("باز", "Open"), StatusTone = !pricePending && Model.ReceivableBalanceUsd <= 0m ? "success" : "warning", Href = "#sale-payments", Icon = "bi-cash-coin" },
        new() { Label = T("منبع و تحویل", "Source & delivery"), Value = stockSourceText, Meta = Model.DestinationName, Status = !string.IsNullOrWhiteSpace(stockSourceText) ? T("مشخص", "Defined") : null, StatusTone = !string.IsNullOrWhiteSpace(stockSourceText) ? "success" : null, Icon = "bi-box-arrow-right" },
        new() { Label = T("رکوردهای مرتبط", "Related records"), Value = relatedRecords.Count > 0 ? relatedRecords.Count.ToString("N0") : null, Status = relatedRecords.Count > 0 ? T("متصل", "Linked") : null, StatusTone = relatedRecords.Count > 0 ? "success" : null, Icon = "bi-link-45deg" }
    };

    var statusText = Model.IsCancelled ? T("لغو شده", "Cancelled") : pricingAwaiting ? pricingLabel : T("تکمیل شده", "Completed");

    var cardsModel = new AkDetailCardsModel
    {
        Code = Model.InvoiceNumber,
        CodeLabel = T("شماره فاکتور", "Invoice no."),
        Status = statusText,
        StatusState = Model.IsCancelled ? "is-danger" : pricingAwaiting ? "is-warning" : "is-active",
        StripItems = new List<AkInfoItem>
        {
            new() { Label = T("خریدار", "Buyer"), Value = customerText },
            new() { Label = T("کالا", "Product"), Value = Model.ProductName },
            new() { Label = T("مقدار", "Quantity"), Value = $"{NumberDisplay.Quantity(Model.QuantityMt)} MT", IsNumeric = true },
            new() { Label = T("تاریخ", "Date"), Value = Model.SaleDate.ToDisplayDate(), IsNumeric = true }
        },
        PrimaryLabel = T("ویرایش", "Edit"),
        PrimaryHref = editUrl,
        Cards = new List<AkDetailCard>
        {
            new() { Title = T("اطلاعات فروش", "Sale information"), Icon = "bi-info-circle", Rows = summaryItems },
            new() { Title = T("مبالغ", "Amounts"), Icon = "bi-cash-coin", Metrics = amountMetrics },
            new() { Title = T("منبع و تحویل", "Source & delivery"), Icon = "bi-box-arrow-right", Rows = sourceItems }
        }
    };

    var moreModel = new AkDetailMoreModel
    {
        Activity = activityRows,
        Secondary = new AkDetailSecondaryModel
        {
            TimelineTitle = T("آخرین فعالیت‌ها", "Latest activities"),
            TimelineLimit = 4,
            Timeline = showTimeline ? timelineItems : Array.Empty<AkTimelineItem>(),
            Related = relatedRecords,
            Technical = advancedItems
        },
        NextActions = nextActions
    };

    ViewData["Title"] = T("جزئیات فروش", "Sale details");
    ViewData["HideSectionTabs"] = true;
}

<div class="ak-form-page ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail ptg-record-detail" dir="rtl" data-ak-detail-v2="true" data-ak-operations-detail="true">
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = $"{customerText} · {Model.ProductName}",
           Eyebrow = $"{T("فروش", "Sale")} {Model.InvoiceNumber}",
           Meta = $"{Model.SaleDate.ToDisplayDate()} · {stageText}",
           Icon = "bi-receipt"
       }; }
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((T("فروش", "Sale") + " " + Model.InvoiceNumber, false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                        T("بازگشت", "Back"), "bi-arrow-right", (string?)backUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailCards.cshtml" model="@cardsModel" />

    <section class="ak-form-section ak-detail-section" id="sale-payments">
        <header class="ak-section-head ak-detail-section-header">
            <h2 class="ak-section-title">@T("پرداخت‌های مرتبط", "Linked payments")</h2>
            <span class="ak-status">@Model.Payments.Count</span>
        </header>
        @if (Model.Payments.Count > 0)
        {
            <div class="ak-list" aria-label="@T("پرداخت‌های مرتبط", "Linked payments")">
                @foreach (var payment in Model.Payments)
                {
                    <a class="ak-list-row" asp-controller="Payments" asp-action="Details" asp-route-id="@payment.PaymentTransactionId" asp-route-returnUrl="@currentReturnUrl">
                        <span class="ak-field">
                            <strong>@(payment.IsAdvanceApplication ? T("مصرف پیش‌دریافت", "Advance applied") : payment.IsIncoming ? T("دریافت", "Receipt") : T("برگشت وجه", "Refund"))</strong>
                            <small>@payment.PaymentDate.ToDisplayDate()@(!string.IsNullOrWhiteSpace(payment.Reference) ? $" · {payment.Reference}" : "")</small>
                        </span>
                        <span class="ak-num @(payment.IsIncoming ? "text-success" : "text-danger")">
                            @(payment.IsIncoming ? "+" : "-")@payment.Amount.ToString("N2") @payment.Currency
                        </span>
                    </a>
                }
            </div>
        }
        else
        {
            <partial name="~/Views/Shared/Partials/_DetailEmptyState.cshtml" model="@T("هیچ پرداخت مستقیمی برای این فروش ثبت نشده است.", "No direct payment is linked to this sale.")" />
        }

        @if (directApplications.Count > 0)
        {
            <div class="ak-detail-subsection">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((T("تطبیق‌های ثبت‌شده", "Recorded applications"), (string?)null))" />
                <div class="ak-list" aria-label="@T("تطبیق‌های ثبت‌شده", "Recorded applications")">
                    @foreach (var a in directApplications)
                    {
                        <div class="ak-list-row">
                            <span class="ak-field">
                                <strong>@T("تطبیق دریافت", "Receipt applied")</strong>
                                <small>@a.PaymentDate.ToDisplayDate()@(!string.IsNullOrWhiteSpace(a.Reference) ? $" · {a.Reference}" : "")</small>
                            </span>
                            <span class="ak-num">@a.AmountUsd.ToString("N2") USD</span>
                            <form asp-action="ReverseReceiptApplication" method="post" class="d-inline"
                                  asp-route-applicationId="@a.ApplicationId" asp-route-returnUrl="@currentReturnUrl"
                                  data-no-spa="true" data-ptg-confirm="true"
                                  data-ptg-confirm-title="@T("برگشت تطبیق", "Reverse application")"
                                  data-ptg-confirm-message="@T("این تطبیق برگشت بخورد و مانده دریافت آزاد شود؟", "Reverse this application and free the receipt balance?")">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="ak-row-menu-btn"
                                        title="@T("برگشت تطبیق", "Reverse application")" aria-label="@T("برگشت تطبیق", "Reverse application")"><i class="bi bi-arrow-counterclockwise"></i></button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }

        @if (canApplyReceipt)
        {
            <div class="ak-detail-subsection" id="sale-apply-receipt">
                <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                         model="@((T("تطبیق دریافت با این فروش", "Apply a receipt to this sale"), (string?)T("دریافت مشتری قبلاً ثبت شده است؛ اینجا فقط مشخص می‌شود چه مقدار از آن روی این فاکتور می‌نشیند.", "The customer receipt is already recorded; this only says how much of it lands on this invoice.")))" />
                <form asp-action="ApplyReceipt" method="post" class="ak-form"
                      asp-route-returnUrl="@currentReturnUrl" data-no-spa="true" data-sale-apply-form>
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="saleIds" value="@Model.Id" />
                    <div class="ak-form-grid">
                        <div class="ak-field">
                            <label class="ak-label" for="sale-apply-receipt-select">@T("دریافت با مانده تطبیق‌نشده", "Receipt with unapplied balance")</label>
                            <select id="sale-apply-receipt-select" name="paymentTransactionId" class="ak-input" data-ak-entity-combobox data-sale-apply-receipt>
                                @foreach (var r in Model.ApplicableReceipts)
                                {
                                    <option value="@r.PaymentTransactionId" data-unapplied-usd="@r.UnappliedAmountUsd.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)">
                                        @r.PaymentDate.ToDisplayDate() — @T("مانده", "Unapplied") @r.UnappliedAmount.ToString("N2") @T("از", "of") @r.Amount.ToString("N2") @r.Currency
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="ak-field">
                            <label class="ak-label" for="sale-apply-amount">@T("مبلغ تطبیق (USD)", "Applied amount (USD)")</label>
                            <input id="sale-apply-amount" type="number" step="0.01" min="0" class="ak-input ak-num" name="amounts" dir="ltr"
                                   data-sale-apply-amount data-open-usd="@Model.ReceivableBalanceUsd.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture)"
                                   value="@firstReceiptSuggestion.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                            <div class="form-text">
                                @T("مانده قابل دریافت این فروش:", "Outstanding on this sale:")
                                <span class="ak-num">@Model.ReceivableBalanceUsd.ToString("N2")</span> USD
                            </div>
                        </div>
                    </div>
                    <div class="ak-footer-actions">
                        <button type="submit" class="btn btn-primary ak-save">@T("ثبت تطبیق", "Save application")</button>
                    </div>
                </form>
            </div>
        }
    </section>

    @if (!string.IsNullOrWhiteSpace(Model.Notes))
    {
        <section class="ak-form-section ak-detail-section ak-sale-notes">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@((T("یادداشت", "Notes"), (string?)null))" />
            <p class="ak-note mb-0">@Model.Notes</p>
        </section>
    }

    <partial name="~/Views/Shared/Partials/_DetailMore.cshtml" model="@moreModel" />

</div>

@section Scripts {
    <script>
        (function () {
            // The suggested amount is the smaller of the receipt's unapplied balance and this
            // invoice's outstanding. The server re-checks both caps.
            function init() {
                var form = document.querySelector('[data-sale-apply-form]');
                if (!form || form.dataset.saleApplyReady === '1') { return; }
                form.dataset.saleApplyReady = '1';

                var select = form.querySelector('[data-sale-apply-receipt]');
                var amount = form.querySelector('[data-sale-apply-amount]');
                if (!select || !amount) { return; }

                var open = parseFloat(amount.getAttribute('data-open-usd')) || 0;

                function suggest() {
                    var option = select.options[select.selectedIndex];
                    var budget = option ? parseFloat(option.getAttribute('data-unapplied-usd')) || 0 : 0;
                    var take = Math.min(budget, open);
                    amount.max = take;
                    amount.value = take > 0 ? (Math.round(take * 100) / 100).toFixed(2) : '0';
                }

                select.addEventListener('change', suggest);
                suggest();
            }

            document.addEventListener('DOMContentLoaded', init);
            document.addEventListener('ptg:page-ready', init);
            init();
        })();
    </script>
}
