@model PTGOilSystem.Web.Models.Auth.LoginViewModel
@{
    var requestedLanguage = Context.Request.Cookies["ptg-ui-lang"] ?? "fa";
    var isEn = string.Equals(requestedLanguage, "en", StringComparison.OrdinalIgnoreCase);
    string T(string fa, string en) => isEn ? en : fa;
    ViewData["Title"] = T("ورود به سیستم", "Sign In");
    ViewData["ModalDesignSystemAssets"] = false;
}

@section Styles {
    <link rel="stylesheet" href="@(isEn ? Url.Content("~/vendor/bootstrap/css/bootstrap.min.css") : Url.Content("~/vendor/bootstrap/css/bootstrap.rtl.min.css"))" />
    <link rel="stylesheet" href="~/vendor/fonts/vazirmatn/vazirmatn.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/vendor/fonts/iransans/iransans.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/ptg/90-auth-login.css" asp-append-version="true" />
}

<div class="ptg-login-page">
    <div class="ptg-login-card">
        <section class="ptg-login-art">
            <img class="ptg-login-brand" src="~/images/saddiqi-logo-transparent.webp" asp-append-version="true" alt="گروپ کمپنی‌های فواد صدیقی" width="1008" height="460" />
            <img class="ptg-login-ribbon" src="~/images/auth/login-art.jpeg" asp-append-version="true" alt="" aria-hidden="true" width="1600" height="1900" />
        </section>

        <section class="ptg-login-panel" aria-labelledby="ptg-login-title">
            <form asp-action="Login" method="post" class="ptg-login-form" novalidate>
                @Html.AntiForgeryToken()
                <input asp-for="ReturnUrl" type="hidden" />

                <header class="ptg-login-heading">
                    <h1 class="ptg-login-title" id="ptg-login-title">Welcome!</h1>
                    <p class="ptg-login-subtitle">Sign in to your Account</p>
                </header>

                <div asp-validation-summary="ModelOnly" class="ptg-login-alert" role="alert"></div>

                <div class="ptg-login-fields">
                    <div class="ptg-login-field">
                        <input asp-for="Username"
                               class="ptg-login-input"
                               autocomplete="username"
                               autocapitalize="none"
                               spellcheck="false"
                               placeholder=" " />
                        <label asp-for="Username" class="ptg-login-label">Username</label>
                        <span asp-validation-for="Username" class="ptg-login-error"></span>
                    </div>

                    <div class="ptg-login-field">
                        <input asp-for="Password"
                               class="ptg-login-input"
                               autocomplete="current-password"
                               placeholder=" " />
                        <label asp-for="Password" class="ptg-login-label">Password</label>
                        <span asp-validation-for="Password" class="ptg-login-error"></span>
                    </div>
                </div>

                <label class="ptg-login-remember">
                    <input type="checkbox" name="RememberMe" value="true" />
                    <span>Remember this computer</span>
                </label>

                <button type="submit" class="ptg-login-submit">Log In</button>

                <span class="ptg-login-help"
                      title="Contact your system administrator to restore access.">Unable to login?</span>
            </form>
        </section>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
