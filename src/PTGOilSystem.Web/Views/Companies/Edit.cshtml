@model Company
@{ ViewData["Title"] = "ویرایش شرکت"; }

<div class="ak-form-page mashal-business-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(("ویرایش شرکت", true,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "بازگشت", "Back"), "bi-arrow-right",
                       (string?)Url.Action("Details", new { id = Model.Id })))" />

    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" class="ak-form">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

        <section class="ak-form-section mashal-business-main">
            <div class="mashal-business-identity"><img src="~/images/لوکو شمعل فارسی رنک ابی.webp" width="110" height="110" alt="مشعل" /><span>کسب‌وکار</span></div>
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("اطلاعات کسب‌وکار", (string?)null))" />
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="Code" class="ak-label">کد <span class="ak-req">*</span></label>
                    <input asp-for="Code" class="ak-input" autocomplete="off" />
                    <span asp-validation-for="Code" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="Name" class="ak-label">شرکت <span class="ak-req">*</span></label>
                    <input asp-for="Name" class="ak-input" autocomplete="off" />
                    <span asp-validation-for="Name" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="NamePersian" class="ak-label">نام فارسی</label>
                    <input asp-for="NamePersian" class="ak-input" autocomplete="off" />
                    <span asp-validation-for="NamePersian" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="Country" class="ak-label">کشور</label>
                    <input asp-for="Country" class="ak-input" autocomplete="off" />
                    <span asp-validation-for="Country" class="ak-field-error"></span>
                </div>
            </div>
        </section>

        <section class="ak-form-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("جزئیات بیشتر", (string?)"آدرس، یادداشت و وضعیت فعال بودن شرکت."))" />
            <div class="ak-form-grid">
                <div class="ak-field ak-col-full">
                    <label asp-for="Address" class="ak-label">نشانی</label>
                    <input asp-for="Address" class="ak-input" autocomplete="off" />
                    <span asp-validation-for="Address" class="ak-field-error"></span>
                </div>
                <div class="ak-field ak-col-full">
                    <label asp-for="Notes" class="ak-label">یادداشت</label>
                    <textarea asp-for="Notes" class="ak-input" rows="2"></textarea>
                    <span asp-validation-for="Notes" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="OwnerPartnerId" class="ak-label">مالک دفتر</label>
                    <select asp-for="OwnerPartnerId" class="ak-input"
                            asp-items="@((List<SelectListItem>)(ViewBag.OwnerPartners ?? new List<SelectListItem>()))">
                        <option value="">— شرکت مستقل —</option>
                    </select>
                    <small class="ak-help">اگر دفتر این شرکت، دفتر شخصی یکی از شرکاست، همان شریک را انتخاب کنید. پرداخت این شرکت روی قرارداد شراکتی، سرمایه‌گذاری همان شریک شمرده می‌شود.</small>
                    <span asp-validation-for="OwnerPartnerId" class="ak-field-error"></span>
                </div>
                <div class="ak-toggle-field">
                    <div class="form-check form-switch">
                        <input asp-for="IsActive" class="form-check-input" role="switch" />
                        <label asp-for="IsActive" class="form-check-label">فعال</label>
                    </div>
                </div>
            </div>
        </section>

        <partial name="~/Views/Shared/Components/Ak/_AkFooterActions.cshtml"
                 model="@(("ذخیره تغییرات", Url.Action("Details", new { id = Model.Id }) ?? "#", "انصراف"))" />
    </form>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
