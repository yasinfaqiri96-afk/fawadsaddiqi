@model PTGOilSystem.Web.Models.Balance.CustomersBalanceViewModel
@{
    ViewData["Title"] = UiText.T(Context,"گردش حساب مشتریان","Customer Accounts");
    var totalSalesUsd = Model.FilteredTotalSalesUsd;
    var totalReceivedUsd = Model.FilteredTotalReceivedUsd;
    var totalBaseBalanceUsd = Model.FilteredBalanceUsd;
    var hasAdvancedFilter = Model.Filter.FromDate.HasValue || Model.Filter.ToDate.HasValue
        || Model.Filter.CustomerId.Length > 0 || Model.Filter.Country.Length > 0;
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context,"گردش حساب مشتریان","Customer Accounts"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index", "Reports")))" />

    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "آمار گردش حساب مشتریان", "Customer account metrics")">
        <vc:stat-card title="@UiText.T(Context,"مشتریان","Customers")" value="@Model.TotalCount.ToString("N0")" unit="@UiText.T(Context,"مشتری","customers")" avatar="customers"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"مجموع فروش","Total Sales")" value="@totalSalesUsd.ToString("N2")" unit="USD" avatar="sales-value"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"مجموع رسید","Total Received")" value="@totalReceivedUsd.ToString("N2")" unit="USD" avatar="receipts"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"مانده","Balance")" value="@totalBaseBalanceUsd.ToString("N2")" unit="USD" avatar="statement"></vc:stat-card>
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> BcOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            string? BcQ(string k) { var v = Context.Request.Query[k].ToString(); return string.IsNullOrEmpty(v) ? null : v; }
            var balCustFilter = new AkSearchFilterModel("Filter.Search", Model.Filter.Search,
                "نام مشتری، کشور، تماس یا کد...",
                new List<AkFilterDefinition>
                {
                    new("Filter.FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    AkFilterDefinition.MultiSelect("Filter.CustomerId", UiText.T(Context, "مشتری", "Customer"), BcOpts(ViewBag.Customers), AkFilterQuery.Values(Context, "Filter.CustomerId")),
                    AkFilterDefinition.MultiSelect("Filter.Country", UiText.T(Context, "کشور", "Country"), BcOpts(ViewBag.Countries), AkFilterQuery.Values(Context, "Filter.Country"))
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="balCustFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("CustomersExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context,"نام مشتری","Customer")</th>
                        <th class="ak-col-num">@UiText.T(Context,"مجموع فروش","Total Sales")</th>
                        <th class="ak-col-num">@UiText.T(Context,"مجموع رسید","Total Received")</th>
                        <th class="ak-col-num">@UiText.T(Context,"مانده","Balance")</th>
                        <th class="ak-col-num">@UiText.T(Context,"اسناد","Documents")</th>
                        <th class="ak-col-actions">@UiText.T(Context,"عملیات","Operations")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ak-col-grow"><a class="ak-name" asp-controller="Customers" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td>
                            <td class="ak-col-num ak-num">@item.TotalSalesUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@item.TotalReceivedUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num @(item.BaseBalanceUsd < 0m ? "ak-number--negative" : null)">@item.BaseBalanceUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@item.RelatedLedgerCount.ToString("N0")</td>
                            <td class="ak-col-actions">
                                <a asp-controller="PartyStatements" asp-action="Customer" asp-route-id="@item.Id">@UiText.T(Context,"گردش حساب","Statement")</a>
                                ·
                                <a asp-controller="Customers" asp-action="Details" asp-route-id="@item.Id">@UiText.T(Context,"جزئیات","Details")</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6"><div class="ak-empty"><i class="bi bi-people"></i> @UiText.T(Context,"مشتری‌ای برای نمایش گردش حساب پیدا نشد","No customers found for this view")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
        </div>
    </div>
</div>

