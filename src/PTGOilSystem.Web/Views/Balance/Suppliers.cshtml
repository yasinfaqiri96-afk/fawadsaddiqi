@model PTGOilSystem.Web.Models.Balance.SuppliersBalanceViewModel
@{
    ViewData["Title"] = UiText.T(Context,"گردش حساب تأمین‌کننده‌ها","Supplier Accounts");
    var totalPurchaseUsd = Model.FilteredTotalPurchaseUsd;
    var totalPaidUsd = Model.FilteredTotalPaidUsd;
    var totalSalesUsd = Model.FilteredTotalSalesUsd;
    var totalBaseBalanceUsd = Model.FilteredBalanceUsd;
    var hasAdvancedFilter = Model.Filter.FromDate.HasValue || Model.Filter.ToDate.HasValue
        || Model.Filter.SupplierId.Length > 0 || Model.Filter.Country.Length > 0;
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context,"گردش حساب تأمین‌کننده‌ها","Supplier Accounts"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index", "Reports")))" />

    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "آمار بیلانس تأمین‌کنندگان", "Supplier balance metrics")">
        <vc:stat-card title="@UiText.T(Context,"جمع خرید","Total Purchases")" value="@totalPurchaseUsd.ToString("N2")" unit="USD" avatar="purchase-value"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"جمع پرداخت","Total Paid")" value="@totalPaidUsd.ToString("N2")" unit="USD" avatar="payments-out"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"جمع فروش","Total Sales")" value="@totalSalesUsd.ToString("N2")" unit="USD" avatar="sales-value"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context,"مانده","Balance")" value="@totalBaseBalanceUsd.ToString("N2")" unit="USD" avatar="statement"></vc:stat-card>
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> BsOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            string? BsQ(string k) { var v = Context.Request.Query[k].ToString(); return string.IsNullOrEmpty(v) ? null : v; }
            var balSuppFilter = new AkSearchFilterModel("Filter.Search", Model.Filter.Search,
                "نام تأمین‌کننده، کشور، تماس یا کد...",
                new List<AkFilterDefinition>
                {
                    new("Filter.FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    AkFilterDefinition.MultiSelect("Filter.SupplierId", UiText.T(Context, "تأمین‌کننده", "Supplier"), BsOpts(ViewBag.Suppliers), AkFilterQuery.Values(Context, "Filter.SupplierId")),
                    AkFilterDefinition.MultiSelect("Filter.Country", UiText.T(Context, "کشور", "Country"), BsOpts(ViewBag.Countries), AkFilterQuery.Values(Context, "Filter.Country"))
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="balSuppFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("SuppliersExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context,"نام تأمین‌کننده","Supplier")</th>
                        <th class="ak-col-num">@UiText.T(Context,"قراردادها","Contracts")</th>
                        <th class="ak-col-num">@UiText.T(Context,"جمع خرید","Total Purchases")</th>
                        <th class="ak-col-num">@UiText.T(Context,"جمع پرداخت","Total Paid")</th>
                        <th class="ak-col-num">@UiText.T(Context,"جمع فروش","Total Sales")</th>
                        <th class="ak-col-num">@UiText.T(Context,"مانده","Balance")</th>
                        <th class="ak-col-actions">@UiText.T(Context,"عملیات","Operations")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Items)
                    {
                        <tr>
                            <td class="ak-col-grow"><a class="ak-name" asp-controller="Suppliers" asp-action="Details" asp-route-id="@item.Id">@item.Name</a></td>
                            <td class="ak-col-num ak-num">@item.RelatedContractsCount.ToString("N0")</td>
                            <td class="ak-col-num ak-num">@item.TotalPurchaseUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@item.TotalPaidUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@item.TotalSalesUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num @(item.BaseBalanceUsd < 0m ? "ak-number--negative" : null)">@item.BaseBalanceUsd.ToString("N2")</td>
                            <td class="ak-col-actions">
                                <a asp-controller="PartyStatements" asp-action="Supplier" asp-route-id="@item.Id">@UiText.T(Context,"گردش حساب","Statement")</a>
                                ·
                                <a asp-controller="Suppliers" asp-action="Details" asp-route-id="@item.Id">@UiText.T(Context,"جزئیات","Details")</a>
                            </td>
                        </tr>
                    }
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7"><div class="ak-empty"><i class="bi bi-building"></i> @UiText.T(Context,"تأمین‌کننده‌ای برای نمایش گردش حساب پیدا نشد","No suppliers found for this view")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="ak-pager">
            @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
        </div>
    </div>
</div>

