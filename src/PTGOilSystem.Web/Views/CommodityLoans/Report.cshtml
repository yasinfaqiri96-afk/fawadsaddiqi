@model PTGOilSystem.Web.Services.CommodityLoans.CommodityLoanReport
@{
    ViewData["Title"] = UiText.T(Context, "راپور باقی قرض تیل", "In-kind loan report");
}
<div class="ak-form-page ak-detail-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "راپور باقی قرض تیل", "In-kind loan report"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "قرض تیل", "Commodity loans"), "bi-arrow-right", (string?)Url.Action("Index")))" />
    <form method="get" class="ak-list-toolbar">
        <div class="ak-list-toolbar-actions">
            <label for="asOf" class="ak-label mb-0">@UiText.T(Context, "تا تاریخ", "As of")</label>
            <input id="asOf" name="asOf" type="date" class="ak-input" value="@Model.AsOf.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-sm btn-light ak-secondary-action">@UiText.T(Context, "نمایش", "Show")</button>
        </div>
    </form>
    <section class="ak-form-section ak-detail-section">
        <dl class="row mb-0">
            <dt class="col-sm-6">@UiText.T(Context, "باقی تیلی که قرض دادیم", "Lent outstanding")</dt><dd class="col-sm-6 ak-num">@NumberDisplay.Quantity(Model.LentOutstandingMt, "MT")</dd>
            <dt class="col-sm-6">@UiText.T(Context, "باقی تیلی که قرض گرفتیم", "Borrowed outstanding")</dt><dd class="col-sm-6 ak-num">@NumberDisplay.Quantity(Model.BorrowedOutstandingMt, "MT")</dd>
            <dt class="col-sm-6">@UiText.T(Context, "قرض‌های وقت برگشت گذشته", "Overdue loans")</dt><dd class="col-sm-6 ak-num">@Model.OverdueLoans</dd>
            <dt class="col-sm-6">@UiText.T(Context, "مفاد / ضرر برگشت قرض‌ها", "Settlement gain / loss")</dt><dd class="col-sm-6 ak-num">@Model.SettlementGainUsd.ToString("N2") / @Model.SettlementLossUsd.ToString("N2") USD</dd>
        </dl>
    </section>
    <section class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@((UiText.T(Context, "به تفکیک طرف و جنس", "By counterparty and product"), (string?)null))" />
        <div class="ak-table-wrap"><table class="ak-table ak-detail-table">
            <thead><tr>
                <th class="ak-col-grow">@UiText.T(Context, "طرف / جنس", "Counterparty / product")</th>
                <th class="text-end">@UiText.T(Context, "تیل طلب داریم (MT)", "Lent (MT)")</th>
                <th class="text-end">@UiText.T(Context, "تیل قرضداریم (MT)", "Borrowed (MT)")</th>
                <th class="text-end">@UiText.T(Context, "ارزش باقی قرض (USD)", "Open value (USD)")</th>
                <th class="text-end">@UiText.T(Context, "وقت برگشت گذشته", "Overdue")</th>
            </tr></thead>
            <tbody>
                @foreach (var p in Model.Positions)
                {
                    <tr>
                        <td class="ak-col-grow">@p.CounterpartyName <small class="text-muted">· @p.ProductName</small>
                            @if (p.UnvaluedLoans > 0) {<small class="text-muted d-block">@UiText.T(Context, "قرض بدون قیمت ثبت‌شده", "unvalued loans"): @p.UnvaluedLoans</small>}</td>
                        <td class="text-end ak-num">@NumberDisplay.Quantity(p.LentOutstandingMt)</td>
                        <td class="text-end ak-num">@NumberDisplay.Quantity(p.BorrowedOutstandingMt)</td>
                        <td class="text-end ak-num">@((p.LentValueUsd - p.BorrowedValueUsd).ToString("N2"))</td>
                        <td class="text-end ak-num">@p.OverdueLoans</td>
                    </tr>
                }
                @if (!Model.Positions.Any())
                {
                    <tr><td colspan="5"><div class="ak-empty">@UiText.T(Context, "قرض باقی نمانده است.", "No open loans.")</div></td></tr>
                }
            </tbody>
        </table></div>
    </section>
    <section class="ak-form-section ak-detail-section">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                 model="@((UiText.T(Context, "تطبیق با دفتر کل", "GL tie-out"),
                           (string?)UiText.T(Context, "ارزش باقی قرض با باقی همان حساب در دفتر کل مقایسه می‌شود.", "Open carrying value vs. the same account in commodity-loan journals.")))" />
        <div class="ak-table-wrap"><table class="ak-table ak-detail-table">
            <thead><tr><th class="ak-col-grow">@UiText.T(Context, "حساب", "Account")</th><th class="text-end">@UiText.T(Context, "ارزش باقی قرض", "Open value")</th><th class="text-end">@UiText.T(Context, "دفتر کل", "GL")</th><th class="text-end">@UiText.T(Context, "تفاوت", "Difference")</th></tr></thead>
            <tbody>
                @foreach (var c in Model.GlChecks)
                {
                    <tr class="@(c.DifferenceUsd != 0m ? "text-danger" : null)">
                        <td class="ak-col-grow">@c.AccountName</td>
                        <td class="text-end ak-num">@c.OpenCarryingUsd.ToString("N2")</td>
                        <td class="text-end ak-num">@c.GlBalanceUsd.ToString("N2")</td>
                        <td class="text-end ak-num">@c.DifferenceUsd.ToString("N2")</td>
                    </tr>
                }
                @if (!Model.GlChecks.Any())
                {
                    <tr><td colspan="4"><div class="ak-empty">@UiText.T(Context, "قرضِ با قیمت ثبت‌شده‌ای وجود ندارد.", "No valued loans.")</div></td></tr>
                }
            </tbody>
        </table></div>
    </section>
</div>
