@using PTGOilSystem.Web.Models.ShipmentPnl
@using PTGOilSystem.Web.Models.Shared
@using PTGOilSystem.Web.Services
@model PTGOilSystem.Web.Models.ShipmentPnl.ShipmentPnlDetailsViewModel
@{
    ViewData["Title"] = "پرونده کشتی / محموله";
    ViewData["HideSectionTabs"] = true;
    string T(string fa, string en) => UiText.T(Context, fa, en);
    string MoneyCard(decimal value) => value.ToString("#,0.##");
    string UnitMt() => T("تن", "MT");
    string UnitUsd() => T("دالر", "USD");
    var selfUrl = Url.Action("Details", "ShipmentPnl", new { id = Model.Id });
    var shipmentGroupKey = $"SHIP:{Model.Id}";
    ViewData["LoadingExpenseEditorAssets"] = true;
    var canRegisterDirectLoss = Model.TotalShortageRegisterableQuantityMt > 0m;
    var todayValue = BusinessClock.Today.ToString("yyyy-MM-dd");
    string DecimalInput(decimal value) => value.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
    string MoneyInput(decimal value) => value.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    var defaultLossAmountUsd = Model.EstimateLossValueUsd(Model.TotalShortageRegisterableQuantityMt);
    var hasVesselName = !string.IsNullOrWhiteSpace(Model.VesselName);
    var shipmentTitle = hasVesselName ? Model.VesselName! : Model.ShipmentCode;
    // eyebrow فقط کد محموله است. برچسب توضیحی «حمل با کشتی» حذف شد؛ آیکن کشتی
    // همین را می‌رساند. وقتی نام کشتی نباشد، عنوان خودش کد است و eyebrow خالی می‌ماند.
    var shipmentEyebrow = hasVesselName ? Model.ShipmentCode : null;
    var primaryDate = Model.DepartureDate ?? Model.ArrivalDate;
    var shipmentHeroItems = new List<AkInfoItem>
    {
        new() { Label = T("محصول", "Product"), Value = Model.ProductName },
        new() { Label = T("تأمین‌کننده", "Supplier"), Value = Model.SupplierName },
        new() { Label = T("مبدأ", "Origin"), Value = Model.OriginName },
        new() { Label = T("مقصد", "Destination"), Value = Model.DestinationName }
    };
    var saleDisplayRows = Model.SaleDisplayRows;
    var lossDisplayRows = Model.LossDisplayRows;
    var transportDisplayGroups = Model.TransportDisplayRows;
    var vesselMovementGroups = transportDisplayGroups.Where(group => group.IsOriginalVesselMovement).ToList();
    // تنها عدد رسمی سود/زیان صفحه: نتیجهٔ کل محموله.
    // = کل فروش − قیمت کامل خرید همهٔ بار − تمام مصارف.
    // بار فروش‌نشده برای منفی‌شدن نتیجه نیاز به ثبت ضایعات ندارد.
    var shipmentResultIsProfit = Model.NetResultIsProfit;
    var shipmentResultClass = shipmentResultIsProfit ? "is-profit" : "is-loss";
    var shipmentResultLabel = shipmentResultIsProfit ? T("سود کل محموله", "Shipment profit") : T("زیان کل محموله", "Shipment loss");
    var shipmentResultAvatar = shipmentResultIsProfit ? "shipment-profit" : "shipment-loss";
    // دسته‌بندی مصارف فقط از منبع واحد مدل (ShipmentExpenseCategorizer) خوانده می‌شود؛
    // KPI، گروه‌های تب مصارف و جدول سود و زیان همگی از همین اعداد استفاده می‌کنند.
    var expenseCategoryGroups = Model.ExpenseCategoryGroups;
    // کارت‌های KPI مصارف باید با «کل مصارف» جمع بزنند. دسته‌بندی همهٔ ردیف‌ها را بین
    // پنج سطل تقسیم می‌کند، ولی ردیف کارت‌ها فقط کرایه/گمرک/سایر را نشان می‌داد و
    // ترمینال و اسناد نامرئی می‌ماندند؛ پس جمع سه کارت کمتر از «کل» درمی‌آمد.
    // اینجا سه سطلِ غیرکرایه/غیرگمرک زیر همان عنوان «سایر مصارف» جمع می‌شوند.
    // تفکیک کامل پنج دسته در تب «مصارف و کسورات» باقی است.
    // جمعِ هر دسته هم از همان منبع خوانده می‌شود؛ جمع‌زدنِ دوباره در Razor یعنی دو منبع.
    var freightExpenseUsd = ShipmentExpenseCategorizer.TotalFor(expenseCategoryGroups, ShipmentExpenseCategory.Freight);
    var customsExpenseUsd = ShipmentExpenseCategorizer.TotalFor(expenseCategoryGroups, ShipmentExpenseCategory.Customs);
    var otherExpenseUsd = Model.TotalOperationalExpensesUsd - freightExpenseUsd - customsExpenseUsd;
    // درصد حاشیهٔ سود فقط نمایشی است و از همان دو عدد رسمی صفحه ساخته می‌شود.
    var shipmentMarginPercent = Model.TotalSalesUsd > 0m
        ? Model.ShipmentNetResultUsd / Model.TotalSalesUsd * 100m
        : 0m;
    // ===== نمای خطی پروندهٔ محموله =====
    // شش شبکهٔ کارتِ مخصوصِ هر تب جای خود را به همان ترکیبِ خطی‌ای دادند که
    // بقیهٔ صفحه‌های عملیاتی دارند: چهار عددِ سرشاخه بالا، بقیهٔ اعداد در
    // فهرستِ فعالیت. هیچ عددی حذف نشد؛ فقط دیگر پشتِ تبِ فعال پنهان نمی‌ماند.
    var shipmentOverviewMetrics = new List<AkKpiItem>
    {
        new() { Title = T("بار کل محموله", "Total cargo"), Value = NumberDisplay.Quantity(Model.OriginalShipmentQuantityMt), Unit = UnitMt(), Avatar = "shipment-loaded" },
        new() { Title = T("تخلیه‌شده از کشتی", "Discharged from vessel"), Value = NumberDisplay.Quantity(Model.VesselUnloadedQuantityMt), Unit = UnitMt(), Avatar = "shipment-discharged" },
        new() { Title = T("فروخته‌شده", "Sold"), Value = NumberDisplay.Quantity(Model.SoldQuantityMt), Unit = UnitMt(), Avatar = "shipment-sales" },
        new() { Title = shipmentResultLabel, Value = MoneyCard(Model.NetResultAbsUsd), Unit = UnitUsd(), Avatar = shipmentResultAvatar, State = shipmentResultIsProfit ? null : "warning" }
    };

    string WarnWhenPositive(decimal value) => value > 0m ? "warning" : null;

    var shipmentActivityRows = new List<AkDetailActivityRow>
    {
        // مسیر بار: بار کل = تخلیه‌شده + کسری تخلیه + تخلیه‌نشده.
        new() { Label = T("تخلیه‌های ثبت‌شده", "Registered discharges"), Value = Model.RegisteredVesselReceiptGroups.Count.ToString("N0"), Unit = T("تخلیه", "discharges"), Icon = "bi-file-earmark-text" },
        new() { Label = T("بار تخلیه‌نشده", "Not yet discharged"), Value = NumberDisplay.Quantity(Model.NotYetDischargedQuantityMt), Unit = UnitMt(), Icon = "bi-hourglass-split" },
        new() { Label = T("موجودی در مخزن", "In storage tank"), Value = NumberDisplay.Quantity(Model.RemainingInSourceTankQuantityMt), Unit = UnitMt(), Icon = "bi-database" },
        new() { Label = T("باقی‌ماندهٔ نافروخته", "Unsold remainder"), Value = NumberDisplay.Quantity(Model.RemainingUnsoldQuantityMt), Unit = UnitMt(), Icon = "bi-box-seam" },

        // کسری‌ها: سه سطلِ بدون هم‌پوشانی و جمعِ همان سه.
        new() { Label = T("کسری تخلیه (کشتی → مخزن)", "Discharge shortage"), Value = NumberDisplay.Quantity(Model.VesselUnloadingShortageQuantityMt), Unit = UnitMt(), Icon = "bi-exclamation-diamond", StatusTone = WarnWhenPositive(Model.VesselUnloadingShortageQuantityMt) },
        new() { Label = T("کسری حمل داخلی", "Internal transport shortage"), Value = NumberDisplay.Quantity(Model.InventoryTransportShortageQuantityMt), Unit = UnitMt(), Icon = "bi-exclamation-diamond", StatusTone = WarnWhenPositive(Model.InventoryTransportShortageQuantityMt) },
        new() { Label = T("سایر ضایعات ثبت‌شده", "Other recorded losses"), Value = NumberDisplay.Quantity(Model.DirectLossQuantityMt), Unit = UnitMt(), Icon = "bi-exclamation-diamond", StatusTone = WarnWhenPositive(Model.DirectLossQuantityMt) },
        new() { Label = T("مجموع کسری و ضایعات", "Total shortage & losses"), Value = NumberDisplay.Quantity(Model.TotalLossAndShortageMt), Unit = UnitMt(), Icon = "bi-clipboard-data", StatusTone = WarnWhenPositive(Model.TotalLossAndShortageMt) },

        // مصارف: جمع سه سطرِ تفکیکی دقیقاً برابر «کل مصارف» است.
        new() { Label = T("کل مصارف (با گمرک)", "Total expenses"), Value = MoneyCard(Model.TotalOperationalExpensesUsd), Unit = UnitUsd(), Icon = "bi-receipt-cutoff" },
        new() { Label = T("کرایه و حمل", "Freight"), Value = MoneyCard(freightExpenseUsd), Unit = UnitUsd(), Icon = "bi-truck" },
        new() { Label = T("گمرک", "Customs"), Value = MoneyCard(customsExpenseUsd), Unit = UnitUsd(), Icon = "bi-shield-check" },
        new() { Label = T("سایر مصارف", "Other expenses"), Value = MoneyCard(otherExpenseUsd), Unit = UnitUsd(), Icon = "bi-three-dots" },

        // فروش و نتیجه.
        new() { Label = T("تعداد فروش", "Sales count"), Value = saleDisplayRows.Count.ToString("N0"), Unit = T("فروش", "sales"), Icon = "bi-cart-check" },
        new() { Label = T("درآمد فروش", "Sales revenue"), Value = MoneyCard(Model.TotalSalesUsd), Unit = UnitUsd(), Icon = "bi-cash-coin" },
        new() { Label = T("حاشیهٔ سود", "Profit margin"), Value = shipmentMarginPercent.ToString("0.#"), Unit = "%", Icon = "bi-graph-up" },
        new() { Label = T("ارزش موجودی باقی‌مانده", "Remaining inventory value"), Value = MoneyCard(Model.RemainingInventoryValueUsd), Unit = UnitUsd(), Icon = "bi-box-seam" },
        new() { Label = T("مانده وصول‌نشده", "Outstanding receivable"), Value = MoneyCard(Model.OutstandingReceivableUsd), Unit = UnitUsd(), Icon = "bi-hourglass-bottom", StatusTone = WarnWhenPositive(Model.OutstandingReceivableUsd) }
    };

    var activeShipmentTab = Context.Request.Query["tab"].ToString().Trim().ToLowerInvariant();
    activeShipmentTab = activeShipmentTab is "flow" or "compliance" or "balance" or "sales" or "finance"
        ? activeShipmentTab
        : "summary";
    // پنل فعال باید کلاس `show active` بگیرد. همهٔ پنل‌ها همین‌جا رندر می‌شوند و
    // ptg-tabs.js آن‌ها را محلی عوض می‌کند؛ تعویض تب نباید صفحه را دوباره از سرور بگیرد.
    string PaneClass(string slug, string? extra = null) =>
        $"tab-pane{(activeShipmentTab == slug ? " show active" : "")}{(string.IsNullOrWhiteSpace(extra) ? "" : " " + extra)}";
    var shipmentTabs = new[]
    {
        $"#shipment-summary|{T("خلاصه", "Summary")}|bi-grid-1x2|{(activeShipmentTab == "summary" ? "active" : "")}",
        $"#shipment-flow|{T("تخلیه‌ها", "Discharges")}|bi-box-arrow-in-down|{(activeShipmentTab == "flow" ? "active" : "")}",
        $"#shipment-compliance|{T("مصارف و گمرک", "Expenses & customs")}|bi-receipt-cutoff|{(activeShipmentTab == "compliance" ? "active" : "")}",
        $"#shipment-balance|{T("کسری‌ها", "Shortages")}|bi-clipboard-minus|{(activeShipmentTab == "balance" ? "active" : "")}",
        $"#shipment-sales|{T("فروش‌ها", "Sales")}|bi-cart-check|{(activeShipmentTab == "sales" ? "active" : "")}",
        $"#shipment-finance|{T("سود و زیان", "Profit & loss")}|bi-graph-up-arrow|{(activeShipmentTab == "finance" ? "active" : "")}"
    };
    var shipmentExportTabs = new[] { "summary", "flow", "compliance", "balance", "sales", "finance" };

    // ===== مقدارهای نمایشی مدیریتی (فقط نمایش؛ از همان فیلدهای موجود ViewModel مشتق می‌شوند) =====
    var hasActiveLineage = Model.IsLineageCalculationActive && Model.HasLineageData;
    var hasVerifiedLineage = hasActiveLineage
        && string.Equals(Model.OverallLineageConfidence, "Verified", StringComparison.Ordinal);
    var isApproxLineage = !hasVerifiedLineage;
    var lineageBadgeClass = Model.LineageBadgeTone switch
    {
        "success" => "is-green",
        "danger" => "is-red",
        "muted" => "is-gray",
        _ => "is-amber"
    };
    var totalSourceAllocationMt = Model.ContractLines.Sum(c => c.AllocatedQuantityMt);
    var lineageNoteFa = hasActiveLineage && isApproxLineage
        ? T("بخشی از اطلاعات این پرونده از داده‌های قدیمی یا تخمینی ساخته شده است.",
            "Some information in this file is based on legacy or estimated data.")
        : !hasActiveLineage
            ? T("این اعداد بر اساس اتصال‌های فعلی سیستم محاسبه شده‌اند و نیازمند ردیابی دقیق موجودی در فاز بعدی هستند.",
                "These figures are computed from the system's current links and need exact inventory tracing in the next phase.")
            : null;
    // نشان وضعیت فقط وقتی حرف تازه‌ای دارد (وضعیت ردیابی بار). برچسب خنثای
    // «پرونده عملیاتی» چیزی به کاربر نمی‌گفت و حذف شد.
    ViewData["AkHeaderStatus"] = hasActiveLineage ? Model.LineageBadgeText : null;
    ViewData["AkHeaderStatusState"] = hasVerifiedLineage ? "is-active" : "is-warning";
    // خط context حذف شد: کد محموله در eyebrow و تاریخ در Meta همین header آمده‌اند.
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = T("ویرایش محموله", "Edit shipment"), Href = Url.Action("Edit", "Shipments", new { id = Model.Id }), Icon = "bi-pencil-square" }
    };
}

<div class="ak-form-page sf-detail ak-detail-page ak-operations-detail ak-operations-clean-page ak-linear-detail" dir="rtl" data-ak-detail-v2="true" data-ak-operations-detail="true" data-instant-tabs data-shipment-details-page>
    @{ ViewData["AkHeaderIdentity"] = new AkDetailHeroModel
       {
           Title = shipmentTitle,
           Eyebrow = shipmentEyebrow,
           Meta = primaryDate.HasValue ? primaryDate.Value.ToDisplayDate() : null,
           Icon = "bi-water",
           Status = ViewData["AkHeaderStatus"]?.ToString(),
           StatusState = ViewData["AkHeaderStatusState"]?.ToString(),
           Items = shipmentHeroItems
       }; }
    @* هدر اکشن اصلی ندارد. «ثبت کسری» فقط در تب «کسری‌ها» می‌ماند، کنار همان
       جدولی که روی آن اثر می‌گذارد؛ نه بالای هر هفت تب. *@
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((shipmentTitle, false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                        T("برگشت", "Back"), "bi-arrow-right", Url.Action("Index")))" />


    @* ترکیب خطی مشترک: سرشاخه‌ها بالا، بقیهٔ اعداد در یک فهرستِ فشرده،
       مستقل از تبِ فعال — عددی پشتِ تب مخفی نمی‌ماند. *@
    <partial name="~/Views/Shared/Partials/_DetailOverview.cshtml"
             model="@(new AkDetailOverviewModel
                      {
                          AriaLabel = T("آمار کلی محموله", "Shipment overview statistics"),
                          Metrics = shipmentOverviewMetrics
                      })" />

    <partial name="~/Views/Shared/Partials/_DetailActivityList.cshtml"
             model="@((IReadOnlyList<AkDetailActivityRow>)shipmentActivityRows)" />

    <section class="ak-form-page">
        @* ریل تب و دکمهٔ خروجی یک ردیف‌اند: تب‌ها یک سر، خروجیِ همان تب سر مقابل. *@
        <div class="sf-tabs-row">
            <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml"
                     model="@(T("بخش‌های پرونده محموله", "Shipment file sections"), shipmentTabs)" />

            @foreach (var exportTab in shipmentExportTabs)
            {
                <div class="ak-page-actions" data-ak-tab="shipment-@exportTab"
                     hidden="@(activeShipmentTab == exportTab ? null : "hidden")">
                    @* همان کامپوننت مشترک سیستم، با خروجی اختصاصی تب فعال. *@
                    <partial name="~/Views/Shared/_ExportMenu.cshtml"
                             model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel(
                                 "DetailsExport",
                                 RouteValues: new Dictionary<string, string?>
                                 {
                                     ["id"] = Model.Id.ToString(System.Globalization.CultureInfo.InvariantCulture),
                                     ["tab"] = exportTab
                                 }))" />
                </div>
            }
        </div>

        @if (hasActiveLineage)
        {
            <section class="ak-form-section ak-detail-section" aria-label="@T("خلاصه ردیابی بار", "Cargo lineage summary")">
                <div class="ak-section-head ak-detail-section-header">
                    <strong>@T("ردیابی بار", "Cargo lineage")</strong>
                    <span class="ak-status @lineageBadgeClass"><span></span>@Model.LineageBadgeText</span>
                </div>
                <dl class="ak-form-grid">
                    <div><dt>@T("بار داخل کشتی", "Cargo in vessel")</dt><dd>@NumberDisplay.Quantity(Model.LineageCargoInVesselMt ?? 0m) MT</dd></div>
                    <div><dt>@T("موجودی در مخزن", "In stock")</dt><dd>@NumberDisplay.Quantity(Model.LineageInStockMt ?? 0m) MT</dd></div>
                    <div><dt>@T("باقی‌مانده در مخزن", "Remaining in source tank")</dt><dd>@NumberDisplay.Quantity(Model.RemainingInSourceTankQuantityMt) MT</dd></div>
                    <div><dt>@T("فروش وصل‌شده", "Linked sales")</dt><dd>@NumberDisplay.Quantity(Model.LineageSoldMt ?? 0m) MT</dd></div>
                    <div><dt>@T("کسری وصل‌شده", "Linked shortage")</dt><dd>@NumberDisplay.Quantity(Model.LineageLossMt ?? 0m) MT</dd></div>
                </dl>
                @if (Model.LineageWarnings.Count > 0)
                {
                    <p class="ak-note"><i class="bi bi-info-circle"></i>@string.Join(" ", Model.LineageWarnings)</p>
                }
            </section>
        }
        @if (Model.DraftTransportQuantityMt > 0m || Model.CancelledTransportQuantityMt > 0m)
        {
            <p class="small text-muted mb-2">
                @T("انتقال پیش‌نویس", "Draft transport"): @NumberDisplay.Quantity(Model.DraftTransportQuantityMt) MT
                · @T("انتقال لغوشده", "Cancelled transport"): @NumberDisplay.Quantity(Model.CancelledTransportQuantityMt) MT
            </p>
        }
    </section>

    <div class="tab-content ak-detail-content ak-tab-content">

        <div class="@PaneClass("summary", "ak-form-section")" id="shipment-summary" role="tabpanel">
            <div class="ak-form-grid sf-summary-grid">
                <div>
                    <section class="ak-form-section ak-detail-section sf-summary-card sf-source-list">
                        <header class="ak-section-head ak-detail-section-header">
                            <h2 class="ak-section-title">@T("منابع بار", "Cargo sources")</h2>
                        </header>
                        <div class="ak-list">
                            @if (totalSourceAllocationMt > 0m)
                            {
                                foreach (var line in Model.ContractLines.Where(c => c.AllocatedQuantityMt > 0m).OrderByDescending(c => c.AllocatedQuantityMt))
                                {
                                    var sharePercent = decimal.Round(line.AllocatedQuantityMt / totalSourceAllocationMt * 100m, 1, MidpointRounding.AwayFromZero);
                                    var shareWidth = sharePercent.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);
                                    var sourceTitle = line.SupplierName ?? line.ContractName;
                                    var hasUnitPrice = line.UnitPriceUsd.HasValue && line.UnitPriceUsd.Value > 0m;
                                    var hasTotalValue = line.TotalValueUsd.HasValue && line.TotalValueUsd.Value > 0m;
                                    <button type="button" class="ak-list-row" aria-haspopup="dialog"
                                            data-source-contract-row data-title="@sourceTitle" data-subtitle="@line.DisplayLabel">
                                        <div class="ak-section-head ak-detail-section-header">
                                            <span class="ak-label">
                                                <strong>@sourceTitle</strong>
                                                <small>@line.DisplayLabel</small>
                                            </span>
                                            <span class="ak-num">
                                                <strong>@NumberDisplay.Quantity(line.AllocatedQuantityMt) @T("تن", "MT")</strong>
                                                <small>@sharePercent.ToString("0.#")٪</small>
                                            </span>
                                        </div>
                                        <div class="sf-bar" role="progressbar" aria-valuenow="@shareWidth" aria-valuemin="0" aria-valuemax="100"><span style="width:@(shareWidth)%"></span></div>
                                        @* بدنهٔ مودال همین قرارداد: چهار عدد تصمیم‌ساز در کاشی‌های مشترک،
                                           سپس شناسنامهٔ قرارداد در info-grid مشترک. با کلیک روی ردیف کپی می‌شود. *@
                                        <div class="ak-section-desc" hidden>
                                            <div class="ak-summary ak-detail-summary">
                                                <div>
                                                    <span>@T("مقدار این قرارداد", "Contract quantity") · @T("تن", "MT")</span>
                                                    <strong class="ak-num">@NumberDisplay.Quantity(line.AllocatedQuantityMt)</strong>
                                                </div>
                                                <div>
                                                    <span>@T("قیمت خرید هر تن", "Purchase price per MT") · USD</span>
                                                    <strong class="ak-num">@(hasUnitPrice ? MoneyCard(line.UnitPriceUsd!.Value) : "—")</strong>
                                                </div>
                                                <div>
                                                    <span>@T("مجموع قیمت خرید", "Total purchase price") · USD</span>
                                                    <strong class="ak-num">@(hasTotalValue ? MoneyCard(line.TotalValueUsd!.Value) : "—")</strong>
                                                </div>
                                                <div>
                                                    <span>@T("سهم از بار", "Share of cargo") · ٪</span>
                                                    <strong class="ak-num">@sharePercent.ToString("0.#")</strong>
                                                </div>
                                            </div>
                                            <dl class="ak-info-grid mt-3">
                                                <div class="ak-info-cell">
                                                    <dt class="ak-info-label">@T("قرارداد", "Contract")</dt>
                                                    <dd class="ak-info-value"><bdi>@line.DisplayLabel</bdi></dd>
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(line.SupplierName))
                                                {
                                                    <div class="ak-info-cell">
                                                        <dt class="ak-info-label">@T("تأمین‌کننده", "Supplier")</dt>
                                                        <dd class="ak-info-value"><bdi>@line.SupplierName</bdi></dd>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(line.ProductName))
                                                {
                                                    <div class="ak-info-cell">
                                                        <dt class="ak-info-label">@T("محصول", "Product")</dt>
                                                        <dd class="ak-info-value"><bdi>@line.ProductName</bdi></dd>
                                                    </div>
                                                }
                                                <div class="ak-info-cell">
                                                    <dt class="ak-info-label">@T("وضعیت نرخ خرید", "Purchase price status")</dt>
                                                    <dd class="ak-info-value">
                                                        <partial name="~/Views/Shared/Partials/_Capsule.cshtml"
                                                                 model="@(line.HasFinalPrice
                                                                     ? (T("نرخ نهایی ثبت شده", "Final price recorded"), (string?)"success")
                                                                     : (T("نرخ نهایی ثبت نشده", "Final price missing"), (string?)"warning"))" />
                                                    </dd>
                                                </div>
                                            </dl>
                                            @if (!line.HasFinalPrice)
                                            {
                                                <p class="ak-note mt-3"><i class="bi bi-info-circle"></i>@T("نرخ نهایی خرید این قرارداد ثبت نشده است؛ بهای آن در سود کل محموله شمرده نمی‌شود.", "This contract has no final purchase price; its cost is excluded from the shipment result.")</p>
                                            }
                                        </div>
                                    </button>
                                }
                            }
                            else
                            {
                                <p class="ak-empty ak-detail-empty-state">@T("ثبت نشده است.", "Not recorded.")</p>
                            }
                        </div>
                    </section>

                </div>

                <aside class="sf-summary-aside">
                    <section class="ak-form-section ak-detail-section sf-summary-card sf-account-summary">
                        <header class="ak-section-head ak-detail-section-header">
                            <h2 class="ak-section-title">@T("خلاصه حساب", "Account summary")</h2>
                        </header>
                        <div class="ak-list">
                            <div class="ak-list-row">
                                <span class="ak-label"><span class="sf-row-icon"><i class="bi bi-bag"></i></span>@T("قیمت خرید کل بار", "Total cargo purchase")</span>
                                <strong class="sf-amount is-negative">@MoneyCard(Model.TotalPurchaseCostUsd)</strong>
                            </div>
                            <div class="ak-list-row">
                                <span class="ak-label"><span class="sf-row-icon"><i class="bi bi-truck"></i></span>@T("کل مصارف (با گمرک)", "Total expenses")</span>
                                <strong class="sf-amount is-negative">@MoneyCard(Model.TotalOperationalExpensesUsd)</strong>
                            </div>
                            <div class="ak-list-row">
                                <span class="ak-label"><span class="sf-row-icon"><i class="bi bi-exclamation-diamond"></i></span>@T("ضایعات ثبت‌شده", "Recorded losses")</span>
                                <strong class="sf-amount is-neutral">@NumberDisplay.Quantity(Model.RecordedLossQuantityMt) @T("تن", "MT")</strong>
                            </div>
                            <div class="ak-list-row">
                                <span class="ak-label"><span class="sf-row-icon"><i class="bi bi-cash-stack"></i></span>@T("درآمد فروش", "Sales revenue")</span>
                                <strong class="sf-amount is-positive">@MoneyCard(Model.TotalSalesUsd)</strong>
                            </div>
                            <div class="ak-list-row is-total">
                                <span class="ak-label"><span class="sf-row-icon"><i class="bi bi-graph-up-arrow"></i></span>@shipmentResultLabel</span>
                                <strong class="ak-num sf-amount @shipmentResultClass">@MoneyCard(Model.ShipmentNetResultUsd)</strong>
                            </div>
                        </div>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(Model.Notes))
                    {
                        <section class="ak-form-section ak-detail-section">
                            <header class="ak-section-head ak-detail-section-header">
                                <h2 class="ak-section-title">@T("یادداشت", "Notes")</h2>
                            </header>
                            <div class="ak-section-body ak-detail-section-body">
                                <p>@Model.Notes</p>
                            </div>
                        </section>
                    }
                </aside>
            </div>
        </div>

        @* ============ تب: مسیر بار (داستان حرکت بار از کشتی تا فروش) ============ *@
        <div class="@PaneClass("flow", "ak-form-section")" id="shipment-flow" role="tabpanel">
            <section class="ak-form-section ak-detail-section">
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">
                        @T("تخلیه‌های ثبت‌شده از کشتی", "Registered vessel discharges")
                        <span class="ptg-capsule-badge">@Model.RegisteredVesselReceiptGroups.Count.ToString("N0")</span>
                    </h2>
                    <div class="ak-list-toolbar-actions no-print">
                        <a asp-controller="InventoryTransportLegs"
                           asp-action="CreateGroupReceipt"
                           asp-route-groupKey="SHIP:@Model.Id"
                           asp-route-returnUrl="@selfUrl"
                           class="btn btn-primary ak-primary-action">
                            <i class="bi bi-box-arrow-in-down"></i><span>@T("ثبت تخلیه", "Register discharge")</span>
                        </a>
                    </div>
                </header>
                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th scope="col">@T("تاریخ", "Date")</th>
                                <th scope="col">@T("شماره تخلیه", "Discharge no.")</th>
                                <th scope="col">@T("قرارداد", "Contract")</th>
                                <th scope="col" class="ak-col-grow">@T("مقصد", "Destination")</th>
                                <th scope="col">@T("مخزن تخلیه", "Unload tank")</th>
                                <th scope="col" class="ak-col-num">@T("مقدار تخلیه", "Discharged")</th>
                                <th scope="col" class="ak-col-actions no-print">@T("عملیات", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var receiptGroup in Model.RegisteredVesselReceiptGroups)
                        {
                            // یک بار «ثبت تخلیه» به‌ازای هر قرارداد منبع یک تخلیهٔ جدا می‌سازد؛ سطر بالا
                            // مقدار کل همان ثبت است و با باز کردنش سهم هر قرارداد دیده می‌شود.
                            var receiptBreakdownKey = $"vessel-receipt-{receiptGroup.Key}";
                            var firstReceipt = receiptGroup.Items[0];
                            <tr>
                                <td class="ak-num">@receiptGroup.ReceiptDate.ToDisplayDate()</td>
                                <td class="ak-num">
                                    @if (receiptGroup.IsSplitAcrossContracts)
                                    {
                                        <span class="ak-name">@T($"{receiptGroup.Items.Count:N0} تخلیه", $"{receiptGroup.Items.Count:N0} discharges")</span>
                                    }
                                    else
                                    {
                                        <a class="ak-name" asp-controller="InventoryTransportLegs" asp-action="Details" asp-route-id="@firstReceipt.InventoryTransportLegId" asp-route-returnUrl="@selfUrl">#@firstReceipt.Id</a>
                                    }
                                </td>
                                <td>
                                    @if (receiptGroup.IsSplitAcrossContracts)
                                    {
                                        @T($"{receiptGroup.Items.Count:N0} قرارداد", $"{receiptGroup.Items.Count:N0} contracts")
                                    }
                                    else
                                    {
                                        @firstReceipt.ContractNumber
                                    }
                                </td>
                                <td class="ak-col-grow">@receiptGroup.DestinationTerminalName</td>
                                <td>@(string.IsNullOrWhiteSpace(receiptGroup.DestinationTankName) ? "—" : receiptGroup.DestinationTankName)</td>
                                <td class="ak-num ak-col-num">@NumberDisplay.Quantity(receiptGroup.ReceivedQuantityMt) @T("تن", "MT")</td>
                                <td class="ak-col-actions no-print">
                                    @if (receiptGroup.IsSplitAcrossContracts)
                                    {
                                        <button type="button"
                                                class="ak-row-menu-btn"
                                                title="@T("سهم هر قرارداد", "Per-contract breakdown")"
                                                aria-label="@T("سهم هر قرارداد از این تخلیه", "Per-contract breakdown for this discharge")"
                                                data-contract-breakdown-toggle="@receiptBreakdownKey"
                                                aria-expanded="false">
                                            <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <div class="dropdown ak-row-menu">
                                            <button type="button" class="ak-row-menu-btn" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="@T($"عملیات تخلیه شماره {firstReceipt.Id}", $"Actions for discharge {firstReceipt.Id}")">
                                                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                            </button>
                                            <ul class="dropdown-menu dropdown-menu-end">
                                                <li>
                                                    <a class="dropdown-item" asp-controller="InventoryTransportLegs" asp-action="Details" asp-route-id="@firstReceipt.InventoryTransportLegId" asp-route-returnUrl="@selfUrl">
                                                        <i class="bi bi-eye"></i><span>@T("جزئیات تخلیه", "Discharge details")</span>
                                                    </a>
                                                </li>
                                                @if (firstReceipt.CanChainOnward)
                                                {
                                                    <li>
                                                        <a class="dropdown-item"
                                                           asp-controller="InventoryTransportLegs"
                                                           asp-action="CreateFromInventory"
                                                           asp-route-shipmentId="@Model.Id"
                                                           asp-route-sourceTerminalId="@firstReceipt.DestinationTerminalId"
                                                           asp-route-sourceStorageTankId="@firstReceipt.DestinationStorageTankId"
                                                           asp-route-productId="@firstReceipt.ProductId"
                                                           asp-route-returnUrl="@selfUrl">
                                                            <i class="bi bi-arrow-right-circle"></i><span>@T("حمل بعدی از این مخزن", "Next leg from this tank")</span>
                                                        </a>
                                                    </li>
                                                }
                                            </ul>
                                        </div>
                                    }
                                </td>
                            </tr>
                            @if (receiptGroup.IsSplitAcrossContracts)
                            {
                                <tr data-contract-breakdown-row="@receiptBreakdownKey" hidden>
                                    <td colspan="7">
                                        <table class="ak-table ak-detail-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col" class="ak-col-grow">@T("قرارداد", "Contract")</th>
                                                    <th scope="col">@T("شماره تخلیه", "Discharge no.")</th>
                                                    <th scope="col" class="ak-col-num">@T("سهم مقدار", "Quantity share")</th>
                                                    <th scope="col" class="ak-col-actions no-print">@T("عملیات", "Actions")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var receipt in receiptGroup.Items)
                                                {
                                                    <tr>
                                                        <td class="ak-col-grow">@receipt.ContractNumber</td>
                                                        <td class="ak-num">
                                                            <a class="ak-name" asp-controller="InventoryTransportLegs" asp-action="Details" asp-route-id="@receipt.InventoryTransportLegId" asp-route-returnUrl="@selfUrl">#@receipt.Id</a>
                                                        </td>
                                                        <td class="ak-num ak-col-num">@NumberDisplay.Quantity(receipt.ReceivedQuantityMt) @T("تن", "MT")</td>
                                                        <td class="ak-col-actions no-print">
                                                            <div class="dropdown ak-row-menu">
                                                                <button type="button" class="ak-row-menu-btn" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false" aria-label="@T($"عملیات تخلیه شماره {receipt.Id}", $"Actions for discharge {receipt.Id}")">
                                                                    <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                                                </button>
                                                                <ul class="dropdown-menu dropdown-menu-end">
                                                                    <li>
                                                                        <a class="dropdown-item" asp-controller="InventoryTransportLegs" asp-action="Details" asp-route-id="@receipt.InventoryTransportLegId" asp-route-returnUrl="@selfUrl">
                                                                            <i class="bi bi-eye"></i><span>@T("جزئیات تخلیه", "Discharge details")</span>
                                                                        </a>
                                                                    </li>
                                                                    @if (receipt.CanChainOnward)
                                                                    {
                                                                        <li>
                                                                            <a class="dropdown-item"
                                                                               asp-controller="InventoryTransportLegs"
                                                                               asp-action="CreateFromInventory"
                                                                               asp-route-shipmentId="@Model.Id"
                                                                               asp-route-sourceTerminalId="@receipt.DestinationTerminalId"
                                                                               asp-route-sourceStorageTankId="@receipt.DestinationStorageTankId"
                                                                               asp-route-productId="@receipt.ProductId"
                                                                               asp-route-returnUrl="@selfUrl">
                                                                                <i class="bi bi-arrow-right-circle"></i><span>@T("حمل بعدی از این مخزن", "Next leg from this tank")</span>
                                                                            </a>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                        @if (!Model.RegisteredVesselReceipts.Any())
                        {
                            <tr>
                                <td colspan="7">
                                    <div class="ak-empty"><i class="bi bi-inbox"></i>@T("هنوز تخلیه‌ای از فورم ثبت تخلیهٔ کشتی برای این محموله ثبت نشده است.", "No vessel discharge has been registered from the discharge form for this shipment.")</div>
                                </td>
                            </tr>
                        }
                        </tbody>
                        @if (Model.RegisteredVesselReceipts.Any())
                        {
                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="5">@T("مجموع تخلیه‌ها", "Discharges total")</th>
                                    <th class="ak-num ak-col-num">@NumberDisplay.Quantity(Model.RegisteredVesselReceiptQuantityMt) @T("تن", "MT")</th>
                                    <th class="ak-col-actions no-print"></th>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
            </section>
        </div>

        @* ============ تب ۲: مصارف و کسورات ============ *@
        <div class="@PaneClass("compliance")" id="shipment-compliance" role="tabpanel">
            @{
                // گروه‌بندی از منبع واحد مدل می‌آید؛ اینجا فقط برچسب و آیکن نمایش تعیین می‌شود.
                // گمرک هم مثل بقیه یک دسته است و در «جمع کل» شمرده می‌شود.
                var expenseGroups = expenseCategoryGroups
                    .Select(group => (
                        Slug: group.Category.ToString().ToLowerInvariant(),
                        Icon: group.Category switch
                        {
                            ShipmentExpenseCategory.Freight => "bi-truck",
                            ShipmentExpenseCategory.Customs => "bi-shield-check",
                            ShipmentExpenseCategory.Terminal => "bi-buildings",
                            ShipmentExpenseCategory.Documents => "bi-file-earmark-text",
                            _ => "bi-three-dots"
                        },
                        Fa: group.Category switch
                        {
                            ShipmentExpenseCategory.Freight => "کرایه و حمل",
                            ShipmentExpenseCategory.Customs => "گمرک",
                            ShipmentExpenseCategory.Terminal => "ترمینال و گدام",
                            ShipmentExpenseCategory.Documents => "اسناد و مجوز",
                            _ => "سایر مصارف"
                        },
                        En: group.Category switch
                        {
                            ShipmentExpenseCategory.Freight => "Freight & transport",
                            ShipmentExpenseCategory.Customs => "Customs",
                            ShipmentExpenseCategory.Terminal => "Terminal & storage",
                            ShipmentExpenseCategory.Documents => "Documents & permits",
                            _ => "Other expenses"
                        },
                        Rows: group.Rows))
                    .ToList();
            }

            <section class="ak-form-section ak-detail-section mb-3">
                <div class="ak-section-head ak-detail-section-header">
                    <h3>@T("هزینه‌های محموله (بار تا فروش)", "Shipment costs (cargo to sale)")</h3>
                    <button type="button" class="btn ak-secondary-action is-primary no-print"
                            data-bs-toggle="modal" data-bs-target="#shipmentExpensesModal"
                            data-expense-url="@Url.Action("CreateGroupExpenseModal", "InventoryTransportLegs", new { groupKey = shipmentGroupKey, returnUrl = selfUrl })"><i class="bi bi-receipt-cutoff me-1"></i> @T("ثبت مصرف", "Add expense")</button>
                </div>
                <p class="ak-section-desc no-print">@T("", "These costs cover every stage from cargo to sale, split into the categories below.")</p>
            </section>

            @if (expenseGroups.Count == 0)
            {
                <section class="ak-form-section ak-detail-section">
                    <div class="ak-empty ak-detail-empty-state">@T("هیچ مصرف یا گمرکی برای این محموله ثبت نشده است.", "No expenses or customs recorded for this shipment.")</div>
                </section>
            }
            @foreach (var cat in expenseGroups)
            {
                var catTotal = cat.Rows.Sum(r => r.AmountUsd);
                <section class="ak-form-section ak-detail-section">
                    <header class="ak-section-head ak-detail-section-header">
                        <h2 class="ak-section-title">
                            <i class="bi @cat.Icon" aria-hidden="true"></i>
                            @T(cat.Fa, cat.En)
                            <span class="ptg-capsule-badge">@cat.Rows.Count.ToString("N0")</span>
                        </h2>
                        <span class="ak-num">@MoneyCard(catTotal) @T("دالر", "USD")</span>
                    </header>
                    <div class="ak-table-wrap">
                        <table class="ak-table ak-detail-table">
                            <thead>
                                <tr>
                                    <th scope="col">@T("تاریخ", "Date")</th>
                                    <th scope="col" class="ak-col-grow">@T("نوع", "Type")</th>
                                    <th scope="col">@T("نمبر وسیله", "Vehicle no.")</th>
                                    <th scope="col">@T("شرح", "Description")</th>
                                    <th scope="col" class="ak-col-num">@T("مبلغ", "Amount")</th>
                                    <th scope="col" class="ak-col-actions no-print">@T("عملیات", "Actions")</th>
                                </tr>
                            </thead>
                            <tbody>
                            @foreach (var item in cat.Rows)
                            {
                                var breakdownKey = $"expcat-{cat.Slug}-{item.Id}";
                                <tr data-breakdown-parent="@breakdownKey">
                                    <td class="ak-num">@item.ExpenseDate.ToDisplayDate()</td>
                                    <td class="ak-col-grow">
                                        <span class="ak-name">@item.ExpenseTypeName</span>
                                        <div class="ak-cell-note">@T(cat.Fa, cat.En)</div>
                                    </td>
                                    <td>@(item.VehicleNumber ?? "-")</td>
                                    <td title="@item.Description">@(item.Description ?? "-")</td>
                                    <td class="ak-num ak-col-num">@MoneyCard(item.AmountUsd) @T("دالر", "USD")</td>
                                    <td class="ak-col-actions no-print">
                                        <button type="button"
                                                class="ak-row-menu-btn"
                                                title="@T("جزئیات قراردادها", "Contract details")"
                                                aria-label="@T($"جزئیات قراردادهای مصرف شماره {item.Id}", $"Contract breakdown for expense {item.Id}")"
                                                data-contract-breakdown-toggle="@breakdownKey"
                                                aria-expanded="false"
                                                @(item.ContractBreakdownLines.Count == 0 ? "disabled" : null)>
                                            <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                                <tr data-contract-breakdown-row="@breakdownKey" hidden>
                                    <td colspan="6">
                                        <table class="ak-table ak-detail-table">
                                            <thead>
                                                <tr>
                                                    <th scope="col" class="ak-col-grow">@T("قرارداد", "Contract")</th>
                                                    <th scope="col" class="ak-col-num">@T("سهم مقدار", "Quantity share")</th>
                                                    <th scope="col" class="ak-col-num">@T("سهم مبلغ", "Amount share")</th>
                                                    <th scope="col">@T("توضیح", "Description")</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var line in item.ContractBreakdownLines)
                                                {
                                                    <tr>
                                                        <td class="ak-col-grow">@line.ContractNumber</td>
                                                        <td class="ak-num ak-col-num">@NumberDisplay.Quantity(line.QuantityMt) @T("تن", "MT")</td>
                                                        <td class="ak-num ak-col-num">@MoneyCard(line.AmountUsd) @T("دالر", "USD")</td>
                                                        <td>@(line.Description ?? "-")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                            @if (cat.Rows.Count == 0)
                            {
                                <tr>
                                    <td colspan="6">
                                        <div class="ak-empty"><i class="bi bi-receipt"></i>@T("در این دسته مصرفی ثبت نشده است.", "No expenses in this category.")</div>
                                    </td>
                                </tr>
                            }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <th scope="row" colspan="4">@T("جمع این دسته", "Category subtotal")</th>
                                    <th class="ak-num ak-col-num">@MoneyCard(catTotal) @T("دالر", "USD")</th>
                                    <th class="ak-col-actions no-print"></th>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </section>
            }

            @* کسری‌ها به تب مستقل «کسری‌ها» منتقل شده‌اند. *@
        </div>

        @* ============ تب: فروش‌ها ============ *@
        <div class="@PaneClass("sales")" id="shipment-sales" role="tabpanel">
            @{
                var salesCustomerCount = saleDisplayRows
                    .Select(s => s.CustomerName)
                    .Where(n => !string.IsNullOrWhiteSpace(n))
                    .Distinct(StringComparer.OrdinalIgnoreCase)
                    .Count();
            }

            @* جدول فروش — همان جدول مشترک سیستم (.ak-table) که لیست‌های دیگر استفاده می‌کنند. *@
            <section class="ak-form-section ak-detail-section">
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">
                        @T("فروش‌ها", "Sales")
                        <span class="ptg-capsule-badge">@saleDisplayRows.Count.ToString("N0")</span>
                    </h2>
                    <div class="ak-list-toolbar-actions no-print">
                        <a asp-controller="Sales" asp-action="CreateFromShipment" asp-route-shipmentId="@Model.Id" asp-route-returnUrl="@selfUrl" class="btn btn-primary ak-primary-action">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i><span>@T("ثبت فروش", "Add sale")</span>
                        </a>
                    </div>
                </header>
                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th scope="col" class="ak-col-grow">@T("مشتری", "Customer")</th>
                                <th scope="col">@T("تاریخ", "Date")</th>
                                <th scope="col">@T("نمبر وسیله", "Vehicle no.")</th>
                                <th scope="col" class="ak-col-num">@T("مقدار", "Quantity")</th>
                                <th scope="col" class="ak-col-num">@T("قیمت واحد", "Unit price")</th>
                                <th scope="col" class="ak-col-num">@T("مبلغ", "Amount")</th>
                                <th scope="col">@T("وضعیت", "Status")</th>
                                <th scope="col" class="ak-col-actions no-print">@T("عملیات", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in saleDisplayRows)
                        {
                            var breakdownKey = $"sales-sale-{item.Id}";
                            var hasTime = item.SaleDate.TimeOfDay != TimeSpan.Zero;
                            <tr data-breakdown-parent="@breakdownKey">
                                @* شمارهٔ فاکتور خودکار (SHIP-…) زیر نام مشتری چیزی به کاربر نمی‌گفت و حذف شد. *@
                                <td class="ak-col-grow">
                                    <span class="ak-name">@(item.CustomerName ?? "-")</span>
                                </td>
                                <td class="ak-num">
                                    @item.SaleDate.ToDisplayDate()
                                    @if (hasTime)
                                    {
                                        <div class="ak-cell-note">@item.SaleDate.ToString("h:mm tt")</div>
                                    }
                                </td>
                                <td>@(item.VehicleNumber ?? "-")</td>
                                <td class="ak-num ak-col-num">@NumberDisplay.Quantity(item.QuantityMt) @T("تن", "MT")</td>
                                @if (item.IsSalePricePending)
                                {
                                    <td class="ak-col-num">@T("نامشخص", "Unknown")</td>
                                    <td class="ak-col-num"><span class="ak-status is-warning">@T("در انتظار قیمت", "Awaiting price")</span></td>
                                }
                                else
                                {
                                    <td class="ak-num ak-col-num">@MoneyCard(item.UnitPriceUsd) @T("دالر", "USD")</td>
                                    <td class="ak-num ak-col-num">@MoneyCard(item.TotalUsd) @T("دالر", "USD")</td>
                                }
                                <td>
                                    <partial name="~/Views/Shared/Partials/_Capsule.cshtml" model="@((T("فروخته‌شده", "Sold"), (string?)"success"))" />
                                    <div class="ak-cell-note">@(item.IsDirectShipmentSale ? T("مستقیم از محموله", "Direct from shipment") : T("پس از ورود به مخزن", "After entering storage"))</div>
                                </td>
                                <td class="ak-col-actions no-print">
                                    <button type="button"
                                            class="ak-row-menu-btn"
                                            title="@T("جزئیات قراردادها", "Contract details")"
                                            aria-label="@T($"جزئیات قراردادهای فروش {item.InvoiceNumber}", $"Contract breakdown for sale {item.InvoiceNumber}")"
                                            data-contract-breakdown-toggle="@breakdownKey"
                                            aria-expanded="false"
                                            @(item.ContractBreakdownLines.Count == 0 ? "disabled" : null)>
                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr data-contract-breakdown-row="@breakdownKey" hidden>
                                <td colspan="8">
                                    <table class="ak-table ak-detail-table">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="ak-col-grow">@T("قرارداد", "Contract")</th>
                                                <th scope="col" class="ak-col-num">@T("سهم مقدار", "Quantity share")</th>
                                                <th scope="col" class="ak-col-num">@T("سهم مبلغ", "Amount share")</th>
                                                <th scope="col">@T("توضیح", "Description")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in item.ContractBreakdownLines)
                                            {
                                                <tr>
                                                    <td class="ak-col-grow">@line.ContractNumber</td>
                                                    <td class="ak-num ak-col-num">@NumberDisplay.Quantity(line.QuantityMt) @T("تن", "MT")</td>
                                                    <td class="ak-num ak-col-num">@MoneyCard(line.AmountUsd) @T("دالر", "USD")</td>
                                                    <td>@(line.Description ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                        @if (!saleDisplayRows.Any())
                        {
                            <tr>
                                <td colspan="8">
                                    <div class="ak-empty"><i class="bi bi-cart-x"></i>@T("فروشی ثبت نشده است.", "No sales recorded.")</div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </section>
            @if (Model.Sales.Any())
            {
                <p class="small text-muted mb-0 mt-2">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i>
                    @T("فروش مستقیم از محموله", "Direct sale from shipment"): <strong>@NumberDisplay.Quantity(Model.DirectSaleQuantityMt) @T("تن", "MT")</strong> · @MoneyCard(Model.DirectSaleUsd) @T("دالر", "USD")
                    @if (Model.HasStorageOriginSales)
                    {
                        <text> — @T("فروش پس از ورود به مخزن", "Sale after entering storage"): <strong>@NumberDisplay.Quantity(Model.StorageSaleQuantityMt) @T("تن", "MT")</strong> · @MoneyCard(Model.StorageSaleUsd) @T("دالر", "USD")</text>
                    }
                    — @T("کل فروش منتسب", "Total attributed sales"): <strong>@NumberDisplay.Quantity(Model.SoldQuantityMt) @T("تن", "MT")</strong> · @MoneyCard(Model.TotalSalesUsd) @T("دالر", "USD")
                    <span class="text-muted">(@T("هر فروش فقط یک بار", "each sale counted once"))</span>
                </p>
            }
        </div>

        @* ============ تب: سود و زیان — خلاصهٔ مدیریتی و بدون تکرار تب‌های دیگر ============ *@
        <div class="@PaneClass("finance")" id="shipment-finance" role="tabpanel">
            @{
                var netResultClass = shipmentResultClass;
                var netResultLabel = shipmentResultLabel;
                var pnlUnpricedContracts = Model.ContractLines
                    .Where(c => c.AllocatedQuantityMt > 0.0001m && !c.HasFinalPrice)
                    .ToList();
            }

            @if (Model.PurchasePricingIncomplete)
            {
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    @T("نرخ نهاییِ خرید این قرارداد(ها) هنوز ثبت نشده، پس بهای خرید آن مقدار ناقص است و سود/زیان زیر قطعی نیست:",
                       "Final purchase price is not set for these contract(s), so the purchase cost is incomplete and the profit/loss below is not definite yet:")
                    <strong>@string.Join("، ", pnlUnpricedContracts.Select(c => $"{c.ContractNumber} ({NumberDisplay.Quantity(c.AllocatedQuantityMt)} MT)"))</strong>.
                    @T("ابتدا نرخ نهایی خرید این قراردادها را ثبت کنید.", "Set the final purchase price for these contracts first.")
                </div>
            }

            <section class="ak-form-section ak-detail-section">
                <div class="ak-section-heading">
                    <div>
                        <h3>@T("جمع‌بندی مالی محموله", "Shipment financial summary")</h3>
                        <p class="ak-section-desc">@T("نتیجهٔ کل از درآمد فروش پس از کسر بهای کامل خرید و مصارف عملیاتی محاسبه شده است.", "The whole-shipment result is sales revenue less the full purchase cost and operating expenses.")</p>
                    </div>
                </div>
                <div class="ak-summary ak-detail-summary">
                    <div><span>@T("درآمد فروش", "Sales revenue")</span><strong>@MoneyCard(Model.TotalSalesUsd) @T("دالر", "USD")</strong></div>
                    <div><span>@T("منهای قیمت کامل خرید بار", "Less full cargo purchase")</span><strong>@MoneyCard(Model.TotalPurchaseCostUsd) @T("دالر", "USD")</strong></div>
                    <div><span>@T("منهای مصارف عملیاتی", "Less operating expenses")</span><strong>@MoneyCard(Model.TotalOperationalExpensesUsd) @T("دالر", "USD")</strong></div>
                    <div class="is-total"><span>= @netResultLabel</span><strong class="@netResultClass">@MoneyCard(Model.ShipmentNetResultUsd) @T("دالر", "USD")</strong></div>
                </div>
                @if (Model.RealisedPnl.HasUncostedSales)
                {
                    <div class="alert alert-danger mt-2 mb-0">
                        <i class="bi bi-exclamation-octagon"></i>
                        @T($"بهای تمام‌شدهٔ {Model.RealisedPnl.UncostedSaleCount} فروش کامل نیست؛ نتیجه تا تکمیل این اطلاعات قطعی نیست.",
                           $"Cost data is incomplete for {Model.RealisedPnl.UncostedSaleCount} sale(s); the result is not final until this is resolved.")
                    </div>
                }
                @if (!Model.IsFullySold)
                {
                    <p class="small text-muted mb-0 mt-2">
                        <i class="bi bi-info-circle"></i>
                        @T($"{NumberDisplay.Quantity(Model.RemainingUnsoldQuantityMt)} تن هنوز فروخته نشده است؛ بهای خرید آن در نتیجهٔ کل بالا کسر شده و ارزش موجودی، سود محسوب نمی‌شود.",
                           $"{NumberDisplay.Quantity(Model.RemainingUnsoldQuantityMt)} MT remains unsold; its purchase cost is included above and inventory value is not treated as profit.")
                    </p>
                }
            </section>
        </div>

        <div class="@PaneClass("balance")" id="shipment-balance" role="tabpanel">
            @* جدول زیر همهٔ LossEventهای محموله را فهرست می‌کند — از جمله کسریِ خودکارِ رسیدهای
               حمل که در کارت‌های «کسری تخلیه»/«کسری حمل داخلی» شمرده شده است. پس جمع جدول با
               کارت «سایر ضایعات ثبت‌شده» یکی نیست. هر دو عدد اینجا صریح می‌آیند. *@
            <p class="ak-operations-tab-fact">
                <span>@T("مجموع ضایعات ثبت‌شده", "Recorded loss events total"): <strong dir="ltr">@NumberDisplay.Quantity(Model.RecordedLossQuantityMt) MT</strong></span>
                <span>@T("ارزش تخمینی کسری", "Estimated shortage value"): <strong dir="ltr">@MoneyCard(Model.EstimatedShortageValueUsd) USD</strong></span>
            </p>
            <section class="ak-form-section ak-detail-section">
                <header class="ak-section-head ak-detail-section-header">
                    <h2 class="ak-section-title">
                        @T("کسری‌ها و ضایعات ثبت‌شده", "Recorded losses & shortages")
                        <span class="ptg-capsule-badge">@lossDisplayRows.Count.ToString("N0")</span>
                    </h2>
                    <div class="ak-list-toolbar-actions no-print">
                        <button type="button" class="btn btn-primary ak-primary-action" data-bs-toggle="modal" data-bs-target="#shipmentDirectLossModal" @(canRegisterDirectLoss ? null : "disabled")>
                            <i class="bi bi-plus-lg" aria-hidden="true"></i><span>@T("ثبت کسری", "Add loss")</span>
                        </button>
                    </div>
                </header>
                <div class="ak-table-wrap">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th scope="col">@T("تاریخ", "Date")</th>
                                <th scope="col">@T("نمبر وسیله", "Vehicle no.")</th>
                                <th scope="col" class="ak-col-num">@T("مقدار کل کسرات", "Total shortage")</th>
                                <th scope="col" class="ak-col-num">@T("ارزش تخمینی", "Estimated value")</th>
                                <th scope="col" class="ak-col-grow">@T("نوع مسئولیت", "Responsibility")</th>
                                <th scope="col" class="ak-col-actions no-print">@T("عملیات", "Actions")</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in lossDisplayRows)
                        {
                            var breakdownKey = $"loss-{item.Id}";
                            <tr data-breakdown-parent="@breakdownKey">
                                <td class="ak-num">@item.EventDate.ToDisplayDate()</td>
                                <td>@(item.VehicleNumber ?? "-")</td>
                                <td class="ak-num ak-col-num">@NumberDisplay.Quantity(item.QuantityMt) @T("تن", "MT")</td>
                                <td class="ak-num ak-col-num">@MoneyCard(item.EstimatedValueUsd) @T("دالر", "USD")</td>
                                <td class="ak-col-grow">
                                    <span class="ak-name">@item.ResponsibilityTypeName</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="ak-cell-note">@item.Description</div>
                                    }
                                </td>
                                <td class="ak-col-actions no-print">
                                    <button type="button"
                                            class="ak-row-menu-btn"
                                            title="@T("جزئیات قراردادها", "Contract details")"
                                            aria-label="@T($"جزئیات قراردادهای کسری شماره {item.Id}", $"Contract breakdown for loss {item.Id}")"
                                            data-contract-breakdown-toggle="@breakdownKey"
                                            aria-expanded="false"
                                            @(item.ContractBreakdownLines.Count == 0 ? "disabled" : null)>
                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr data-contract-breakdown-row="@breakdownKey" hidden>
                                <td colspan="6">
                                    <table class="ak-table ak-detail-table">
                                        <thead>
                                            <tr>
                                                <th scope="col" class="ak-col-grow">@T("قرارداد", "Contract")</th>
                                                <th scope="col" class="ak-col-num">@T("سهم مقدار", "Quantity share")</th>
                                                <th scope="col" class="ak-col-num">@T("سهم مبلغ", "Amount share")</th>
                                                <th scope="col">@T("توضیح", "Description")</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var line in item.ContractBreakdownLines)
                                            {
                                                <tr>
                                                    <td class="ak-col-grow">@line.ContractNumber</td>
                                                    <td class="ak-num ak-col-num">@NumberDisplay.Quantity(line.QuantityMt) @T("تن", "MT")</td>
                                                    <td class="ak-num ak-col-num">@MoneyCard(line.AmountUsd) @T("دالر", "USD")</td>
                                                    <td>@(line.Description ?? item.Description ?? "-")</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </td>
                            </tr>
                        }
                        @if (!lossDisplayRows.Any())
                        {
                            <tr>
                                <td colspan="6">
                                    <div class="ak-empty"><i class="bi bi-clipboard-check"></i>@T("کسری یا ضایعاتی ثبت نشده است.", "No losses or shortages recorded.")</div>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                @if (Model.Warnings.Any())
                {
                    <div class="ak-list">
                        @foreach (var warning in Model.Warnings)
                        {
                            <div><i class="bi bi-info-circle"></i>@warning</div>
                        }
                    </div>
                }
            </section>
        </div>
    </div>

    <div class="modal fade" id="shipmentDirectLossModal" tabindex="-1"
         aria-labelledby="shipmentDirectLossModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content ak-modal-content">
                <form asp-action="RegisterDirectLoss"
                      method="post"
                      class="ak-form"
                      data-ship-shortage-form
                      data-loaded="@DecimalInput(Model.ShipShortageLoadedQuantityMt)"
                      data-sold="@DecimalInput(Model.SoldQuantityMt)"
                      data-current-shortage="@DecimalInput(Model.ShipShortageQuantityMt)"
                      data-current-remaining="@DecimalInput(Model.TotalShortageRegisterableQuantityMt)"
                      data-unit-cost="@MoneyInput(Model.AverageCostPerMtUsd)">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="ShipmentId" value="@Model.Id" />
                    <input type="hidden" name="ReturnUrl" value="@selfUrl" />
                    <div class="ak-modal-head ak-section-head">
                        <div>
                            <h2 class="modal-title" id="shipmentDirectLossModalLabel">
                                <i class="bi bi-clipboard2-check text-primary"></i>
                                @T("ثبت کسری کشتی", "Register ship shortage")
                            </h2>
                        </div>
                        <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                    </div>
                    <div class="ak-modal-body ak-section-body">
                        <div class="ak-summary ak-detail-summary">
                            <div class="summary-tile">
                                <div class="summary-tile-label">@T("بار کشتی برای کسری", "Vessel cargo for shortage")</div>
                                <div class="summary-tile-value ak-num"><span data-shortage-loaded>@NumberDisplay.Quantity(Model.ShipShortageLoadedQuantityMt)</span> <span class="small text-muted">@T("تن", "MT")</span></div>
                                <i class="bi bi-ship text-primary"></i>
                            </div>
                            <div class="summary-tile">
                                <div class="summary-tile-label">@T("مقدار فروخته‌شده", "Sold quantity")</div>
                                <div class="summary-tile-value ak-num"><span data-shortage-sold>@NumberDisplay.Quantity(Model.SoldQuantityMt)</span> <span class="small text-muted">@T("تن", "MT")</span></div>
                                <i class="bi bi-cart-check text-success"></i>
                            </div>
                            <div class="summary-tile">
                                <div class="summary-tile-label">@T("کسری", "Shortage")</div>
                                <div class="summary-tile-value ak-num"><span data-shortage-qty>@NumberDisplay.Quantity(Model.ShipShortageQuantityMt)</span> <span class="small text-muted">@T("تن", "MT")</span></div>
                                <i class="bi bi-exclamation-triangle text-warning"></i>
                            </div>
                            <div class="summary-tile">
                                <div class="summary-tile-label">@T("درصد کسری", "Shortage percent")</div>
                                <div class="summary-tile-value ak-num"><span data-shortage-percent>@Model.ShipShortagePercent.ToString("N2")</span>%</div>
                                <i class="bi bi-percent text-info"></i>
                            </div>
                            <div class="summary-tile">
                                <div class="summary-tile-label">@T("ارزش تخمینی", "Estimated value")</div>
                                <div class="summary-tile-value ak-num"><span data-shortage-value>@MoneyCard(Model.EstimatedShortageValueUsd)</span> <span class="small text-muted">@T("دالر", "USD")</span></div>
                                <i class="bi bi-coin text-warning"></i>
                            </div>
                        </div>
                        <div class="ak-section-title">
                            <h3>@T("مسئول کسری", "Shortage responsibility")</h3>
                        </div>
                        <div class="ak-form-grid" role="radiogroup" aria-label="@T("نوع مسئولیت کسری", "Shortage responsibility")">
                            <label class="ak-toggle-field is-selected">
                                <input type="radio" name="ResponsibilityType" value="CompanyLoss" checked data-shortage-option />
                                <i class="bi bi-building"></i><span>@T("ضرر شرکت", "Company loss")</span>
                            </label>
                            <label class="ak-toggle-field">
                                <input type="radio" name="ResponsibilityType" value="SupplierDeduction" data-shortage-option />
                                <i class="bi bi-person-lines-fill"></i><span>@T("کسر از حساب تأمین‌کننده", "Supplier deduction")</span>
                            </label>
                            <label class="ak-toggle-field">
                                <input type="radio" name="ResponsibilityType" value="ServiceProviderClaim" data-shortage-option />
                                <i class="bi bi-truck"></i><span>@T("طلب از شرکت خدماتی", "Service claim")</span>
                            </label>
                            <label class="ak-toggle-field">
                                <input type="radio" name="ResponsibilityType" value="PartnerShareDeduction" data-shortage-option />
                                <i class="bi bi-people"></i><span>@T("کسر از سهم شریک", "Partner share")</span>
                            </label>
                            <label class="ak-toggle-field">
                                <input type="radio" name="ResponsibilityType" value="Split" data-shortage-option />
                                <i class="bi bi-diagram-3"></i><span>@T("تقسیم بین چند طرف", "Split")</span>
                            </label>
                        </div>
                        <div class="ak-form-grid">
                            <section class="ak-form-section ak-detail-section">
                        <div class="ak-form-grid g-3">
                            <div class="ak-field" data-shortage-field="party">
                                <label class="ak-label fw-semibold" for="shipmentLossPartyName">@T("نام طرف", "Party name") <span class="text-danger">*</span></label>
                                <input id="shipmentLossPartyName" name="ResponsiblePartyName" class="ak-input" maxlength="200" />
                            </div>
                            <div class="ak-field" data-shortage-field="contract">
                                <label class="ak-label fw-semibold" for="shipmentLossContract">@T("قرارداد مربوطه", "Related contract")</label>
                                <select id="shipmentLossContract" name="ContractId" class="ak-input" data-ak-entity-combobox data-ak-placeholder="@T("تقسیم نسبتی بین قراردادها", "Proportional by contracts")">
                                    <option value="" data-unit-cost="@MoneyInput(Model.AverageCostPerMtUsd)">@T("تقسیم نسبتی بین قراردادها", "Proportional by contracts")</option>
                                    @foreach (var line in Model.ContractLines)
                                    {
                                        <option value="@line.ContractId" data-unit-cost="@MoneyInput(line.UnitPriceUsd ?? 0m)">@line.DisplayLabel - @NumberDisplay.Quantity(line.ShortageRegisterableQuantityMt) @T("تن قابل ثبت", "MT available")</option>
                                    }
                                </select>
                            </div>
                            <div class="ak-field" data-shortage-field="status">
                                <label class="ak-label fw-semibold" for="shipmentLossStatus">@T("وضعیت", "Status") <span class="text-danger">*</span></label>
                                <select id="shipmentLossStatus" name="ClaimStatus" class="ak-input">
                                    <option>@T("در انتظار", "Pending")</option>
                                    <option>@T("تأیید شده", "Confirmed")</option>
                                    <option>@T("دریافت شده", "Collected")</option>
                                </select>
                            </div>
                            <div class="ak-field">
                                <label class="ak-label fw-semibold" for="shipmentLossQuantity">@T("مقدار ضایعات (MT)", "Loss quantity (MT)")</label>
                                <input id="shipmentLossQuantity"
                                       name="LossQuantityMt"
                                       type="number"
                                       step="0.0001"
                                       min="0.0001"
                                       max="@DecimalInput(Model.TotalShortageRegisterableQuantityMt)"
                                       class="ak-input text-end"
                                       data-shortage-quantity
                                       required />
                            </div>
                            <div class="ak-field">
                                <label class="ak-label fw-semibold" for="shipmentLossAmount">@T("مبلغ قابل مطالبه", "Claimable amount")</label>
                                <div class="input-group">
                                    <input id="shipmentLossAmount"
                                           name="LossAmountUsd"
                                           type="number"
                                           step="0.01"
                                           min="0"
                                           value="@MoneyInput(defaultLossAmountUsd)"
                                           class="ak-input text-end"
                                           data-shortage-amount />
                                    <span class="input-group-text">@T("دالر", "USD")</span>
                                </div>
                                <div class="ak-section-desc">
                                    @T("قیمت خرید هر تن:", "Purchase price per MT:")
                                    <strong data-shortage-unit-cost-text>@MoneyCard(Model.AverageCostPerMtUsd)</strong>
                                    @T("دالر", "USD")
                                </div>
                            </div>
                            <div class="ak-field">
                                <label class="ak-label fw-semibold" for="shipmentLossDate">@T("تاریخ", "Date")</label>
                                <input id="shipmentLossDate" name="EventDate" type="date" value="@todayValue" class="ak-input" required />
                            </div>
                            <div class="ak-field">
                                <label class="ak-label fw-semibold" for="shipmentLossNotes">@T("توضیحات", "Notes")</label>
                                <textarea id="shipmentLossNotes" name="Notes" rows="3" maxlength="1000" class="ak-input"></textarea>
                            </div>
                        </div>

                        <div class="ak-form-grid" data-shortage-field="split">
                            <div class="ak-section-head ak-detail-section-header">
                                <strong>@T("تقسیم کسری", "Split shortage")</strong>
                                <span>@T("جمع مقدار ردیف‌ها باید برابر مقدار کل کسری باشد.", "Line quantities must equal the total shortage.")</span>
                            </div>
                            <div class="ak-table-wrap">
                                <table class="ak-table ak-detail-table align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>@T("نوع حساب", "Type")</th>
                                            <th>@T("طرف مسئول", "Party")</th>
                                            <th class="text-end">@T("مقدار تن", "MT")</th>
                                            <th class="text-end">@T("مبلغ", "Amount")</th>
                                            <th>@T("وضعیت", "Status")</th>
                                            <th>@T("یادداشت کوتاه", "Note")</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                    @for (var i = 0; i < 4; i++)
                                    {
                                        <tr>
                                            <td>
                                                <select name="SplitLines[@i].ResponsibilityType" class="ak-input">
                                                    <option value="">-</option>
                                                    <option value="CompanyLoss">@T("ضرر شرکت", "Company loss")</option>
                                                    <option value="SupplierDeduction">@T("کسر از تأمین‌کننده", "Supplier deduction")</option>
                                                    <option value="ServiceProviderClaim">@T("طلب از خدماتی", "Service claim")</option>
                                                    <option value="PartnerShareDeduction">@T("سهم شریک", "Partner share")</option>
                                                </select>
                                            </td>
                                            <td><input name="SplitLines[@i].ResponsiblePartyName" class="ak-input" maxlength="200" /></td>
                                            <td><input name="SplitLines[@i].QuantityMt" type="number" step="0.0001" min="0" class="ak-input text-end" /></td>
                                            <td><input name="SplitLines[@i].AmountUsd" type="number" step="0.01" min="0" class="ak-input text-end" /></td>
                                            <td><input name="SplitLines[@i].Status" class="ak-input" maxlength="100" /></td>
                                            <td><input name="SplitLines[@i].Notes" class="ak-input" maxlength="200" /></td>
                                        </tr>
                                    }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                            </section>

                            <aside class="ak-note">
                                <div class="ak-page-icon"><i class="bi bi-bank"></i></div>
                                <h3>@T("اثر حسابداری", "Accounting effect")</h3>
                                <ul>
                                    <li><span></span><strong>@T("مقدار:", "Quantity:")</strong> <span data-effect-qty>@NumberDisplay.Quantity(Model.TotalShortageRegisterableQuantityMt)</span> @T("تن کسری", "MT shortage")</li>
                                    <li><span></span><span data-effect-line-1>@T("ثبت ضرر شرکت", "Register company loss")</span></li>
                                    <li><span></span><span data-effect-line-2>@T("کاهش سود/سرمایه شرکت", "Reduce company profit/capital")</span></li>
                                    <li><span></span><span data-effect-line-3>@T("صندوق و بانک تغییر نمی‌کند", "Cash and bank do not change")</span></li>
                                </ul>
                            </aside>
                        </div>
                    </div>
                    <div class="ak-modal-foot ak-footer-actions">
                        <button type="button" class="btn btn-light ak-secondary-action" data-bs-dismiss="modal">@T("انصراف", "Cancel")</button>
                        <button type="submit" class="btn btn-primary ak-primary-action" @(canRegisterDirectLoss ? null : "disabled")><i class="bi bi-clipboard-check me-1"></i> @T("ثبت نهایی کسری", "Save shortage")</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @* مودال «ثبت مصرف» — همان مودال و منطق صفحه جزئیات جریان حمل؛ فرم AJAX از CreateGroupExpenseModal با groupKey محموله بارگذاری می‌شود. *@
    <div class="modal fade" id="shipmentExpensesModal" tabindex="-1"
         aria-labelledby="shipmentExpensesModalLabel" aria-hidden="true" data-loading-expense-remote-modal>
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content ak-modal-content">
                <div class="ak-modal-head">
                    <h2 class="modal-title" id="shipmentExpensesModalLabel">
                        <i class="bi bi-receipt-cutoff text-primary"></i>
                        @T("ثبت مصرف این محموله", "Add shipment expense")
                    </h2>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                </div>
                <div class="ak-modal-body" data-loading-expense-remote-body>
                    <div class="ak-empty ak-detail-empty-state">
                        <div class="spinner-border spinner-border-sm text-primary" role="status" aria-hidden="true"></div>
                        <span>@T("در حال بارگذاری فرم مصارف...", "Loading expense form...")</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* مودال «منابع بار» — فقط نمایش؛ بدنه از همان ردیف قرارداد کپی می‌شود. *@
    <div class="modal fade" id="shipmentSourceContractModal" tabindex="-1"
         aria-labelledby="shipmentSourceContractModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content ak-modal-content">
                <div class="ak-modal-head">
                    <div>
                        <h2 class="ak-modal-title modal-title" id="shipmentSourceContractModalLabel"></h2>
                        <p class="ak-modal-subtitle" data-source-contract-modal-subtitle></p>
                    </div>
                    <button type="button" class="btn-close ms-0" data-bs-dismiss="modal" aria-label="@T("بستن", "Close")"></button>
                </div>
                <div class="ak-modal-body" data-source-contract-modal-body></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        @* منابع بار: کلیک روی ردیف قرارداد → مودال فشرده با مقدار و بهای خرید همان قرارداد. *@
        (function () {
            const modalEl = document.getElementById('shipmentSourceContractModal');
            const titleEl = document.getElementById('shipmentSourceContractModalLabel');
            const subtitleEl = modalEl?.querySelector('[data-source-contract-modal-subtitle]');
            const bodyEl = modalEl?.querySelector('[data-source-contract-modal-body]');
            if (!modalEl || !titleEl || !bodyEl) { return; }

            document.querySelectorAll('[data-source-contract-row]').forEach(row => {
                row.addEventListener('click', () => {
                    const detail = row.querySelector('.ak-section-desc');
                    if (!detail || !window.bootstrap) { return; }
                    const subtitle = row.getAttribute('data-subtitle') || '';
                    titleEl.textContent = row.getAttribute('data-title') || '';
                    if (subtitleEl) {
                        subtitleEl.textContent = subtitle;
                        subtitleEl.hidden = subtitle.length === 0;
                    }
                    bodyEl.innerHTML = detail.innerHTML;
                    bootstrap.Modal.getOrCreateInstance(modalEl).show();
                });
            });
        })();

        @* Detail-row disclosure only; tab state is server-driven through ?tab=. *@
        (function () {
            const detailRows = Array.from(document.querySelectorAll('[data-contract-breakdown-row]'));
            document.querySelectorAll('[data-contract-breakdown-toggle]').forEach(button => {
                button.addEventListener('click', () => {
                    const key = button.dataset.contractBreakdownToggle;
                    const detailRow = detailRows.find(row => row.dataset.contractBreakdownRow === key);
                    if (!detailRow) {
                        return;
                    }

                    const shouldOpen = detailRow.hidden;
                    detailRow.hidden = !shouldOpen;
                    button.setAttribute('aria-expanded', shouldOpen ? 'true' : 'false');
                });
            });
        })();

        @* صفحه‌بندی این جدول‌ها از کامپوننت مشترک سیستم می‌آید (tables.js → .ptg-client-pager)؛
           اسکریپت اختصاصی این صفحه حذف شد تا فقط یک منبع صفحه‌بندی وجود داشته باشد. *@

        (function () {
            const form = document.querySelector('[data-ship-shortage-form]');
            if (!form) { return; }

            const number = (value) => Number.parseFloat(value || '0') || 0;
            const loaded = number(form.dataset.loaded);
            const sold = number(form.dataset.sold);
            const currentShortage = number(form.dataset.currentShortage);
            const defaultUnitCost = number(form.dataset.unitCost);
            const quantityInput = form.querySelector('[data-shortage-quantity]');
            const amountInput = form.querySelector('[data-shortage-amount]');
            const contractSelect = form.querySelector('#shipmentLossContract');
            const unitCostText = form.querySelector('[data-shortage-unit-cost-text]');
            const optionInputs = Array.from(form.querySelectorAll('[data-shortage-option]'));
            const fields = Array.from(form.querySelectorAll('[data-shortage-field]'));
            const effectQty = form.querySelector('[data-effect-qty]');
            const effectLine1 = form.querySelector('[data-effect-line-1]');
            const effectLine2 = form.querySelector('[data-effect-line-2]');
            const effectLine3 = form.querySelector('[data-effect-line-3]');

            const effectText = {
                CompanyLoss: ['ثبت ضرر شرکت', 'کاهش سود/سرمایه شرکت', 'صندوق و بانک تغییر نمی‌کند'],
                SupplierDeduction: ['کاهش بدهی تأمین‌کننده', 'برای مقدار پذیرفته‌شده ضرر شرکت ثبت نمی‌شود', 'صندوق و بانک تغییر نمی‌کند'],
                ServiceProviderClaim: ['ثبت طلب از شرکت خدماتی', 'تا زمان وصول، نقد/بانک تغییر نمی‌کند', 'کاهش سود کشتی تا زمان وصول'],
                PartnerShareDeduction: ['کسر از سهم شریک', 'اثر از حساب شریک پیگیری می‌شود', 'صندوق و بانک تغییر نمی‌کند'],
                Split: ['تقسیم مسئولیت بین چند طرف', 'جمع ردیف‌ها باید کامل باشد', 'صندوق و بانک تغییر نمی‌کند']
            };

            function formatQuantity(value) {
                return value.toLocaleString('fa-AF', { maximumFractionDigits: 4 });
            }

            function formatMoney(value) {
                return value.toLocaleString('fa-AF', { maximumFractionDigits: 2 });
            }

            function selectedType() {
                return optionInputs.find(input => input.checked)?.value || 'CompanyLoss';
            }

            function currentUnitCost() {
                const selectedOption = contractSelect?.selectedOptions?.[0];
                const selectedCost = number(selectedOption?.dataset.unitCost);
                return selectedCost > 0 ? selectedCost : defaultUnitCost;
            }

            function setFieldVisibility(type) {
                fields.forEach(field => {
                    const key = field.dataset.shortageField;
                    const show = key === 'split'
                        ? type === 'Split'
                        : key === 'party'
                            ? ['SupplierDeduction', 'ServiceProviderClaim', 'PartnerShareDeduction'].includes(type)
                            : key === 'contract'
                                ? true
                                : key === 'status'
                                    ? ['ServiceProviderClaim', 'Split'].includes(type)
                                    : true;
                    field.classList.toggle('d-none', !show);
                });

                optionInputs.forEach(input => {
                    input.closest('.ak-toggle-field')?.classList.toggle('is-selected', input.checked);
                });
            }

            function updateNumbers() {
                const inputQuantity = number(quantityInput?.value);
                const unitCost = currentUnitCost();
                const displayShortage = inputQuantity > 0 ? inputQuantity : currentShortage;
                const percent = loaded > 0 ? (displayShortage / loaded * 100) : 0;
                const value = displayShortage * unitCost;
                const inputValue = inputQuantity * unitCost;

                const qtyEl = form.querySelector('[data-shortage-qty]');
                const soldEl = form.querySelector('[data-shortage-sold]');
                const percentEl = form.querySelector('[data-shortage-percent]');
                const valueEl = form.querySelector('[data-shortage-value]');
                if (qtyEl) { qtyEl.textContent = formatQuantity(displayShortage); }
                if (soldEl) { soldEl.textContent = formatQuantity(sold); }
                if (percentEl) { percentEl.textContent = percent.toLocaleString('fa-AF', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
                if (valueEl) { valueEl.textContent = formatMoney(value); }
                if (unitCostText) { unitCostText.textContent = formatMoney(unitCost); }
                if (amountInput && inputQuantity > 0) { amountInput.value = inputValue.toFixed(2); }
                if (effectQty) { effectQty.textContent = formatQuantity(inputQuantity > 0 ? inputQuantity : currentShortage); }
            }

            function updateEffect() {
                const type = selectedType();
                const lines = effectText[type] || effectText.CompanyLoss;
                if (effectLine1) { effectLine1.textContent = lines[0]; }
                if (effectLine2) { effectLine2.textContent = lines[1]; }
                if (effectLine3) { effectLine3.textContent = lines[2]; }
                setFieldVisibility(type);
                updateNumbers();
            }

            optionInputs.forEach(input => input.addEventListener('change', updateEffect));
            contractSelect?.addEventListener('change', updateNumbers);
            quantityInput?.addEventListener('input', updateNumbers);
            updateEffect();
        })();
    </script>
}
