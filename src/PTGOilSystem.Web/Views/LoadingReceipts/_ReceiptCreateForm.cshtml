@model PTGOilSystem.Web.Models.Loading.LoadingReceiptCreateViewModel
@using System.Globalization
@using PTGOilSystem.Web.Models.Entities
@{
    var isReceiptModal = ViewData["IsReceiptModal"] as bool? == true;
    var isReceiptIframeModal = ViewData["IsReceiptIframeModal"] as bool? == true;
    var isEnglish = UiText.IsEn(Context);
    var viewDirection = isEnglish ? "ltr" : "rtl";
    string T(string fa, string en) => UiText.T(Context, fa, en);
    // اگر فیلدی داخل بخش «اطلاعات تکمیلی» خطا داشت، آن بخش باز نمایش داده می‌شود.
    bool HasError(params string[] keys) => keys.Any(k => ViewData.ModelState.TryGetValue(k, out var entry) && entry.Errors.Count > 0);
    string Qty(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);

    var iframeModalRouteValue = isReceiptIframeModal ? "1" : null;
    var cancelUrl = ViewData["CancelUrl"] as string;
    var hasLocalReturnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl) && Url.IsLocalUrl(Model.ReturnUrl);
    var fallbackCancelUrl = Url.Action("Details", "Loading", new { id = Model.LoadingRegisterId }) ?? "#";
    var resolvedCancelUrl = !string.IsNullOrWhiteSpace(cancelUrl)
        ? cancelUrl
        : hasLocalReturnUrl
            ? Model.ReturnUrl
            : fallbackCancelUrl;

    // شناسهٔ بارگیری منبع + وسیلهٔ حمل، برای نوار «۱. بارگیری».
    var loadingCode = $"LD-{Model.LoadingRegisterId:D4}";
    var transportText = string.Join(" / ", new[] { Model.VesselName, Model.WagonNumber, Model.TruckPlateNumber }.Where(v => !string.IsNullOrWhiteSpace(v)));
    var referenceText = string.Join(" / ", new[] { Model.BillOfLadingNumber, Model.RwbNo }.Where(v => !string.IsNullOrWhiteSpace(v)));
    var supplierText = string.Join(" — ", new[] { Model.SupplierName, Model.ContractNumber }.Where(v => !string.IsNullOrWhiteSpace(v)));
    var referenceDocumentValue = string.IsNullOrWhiteSpace(Model.ReferenceDocument)
        ? (string.IsNullOrWhiteSpace(referenceText) ? loadingCode : referenceText)
        : Model.ReferenceDocument;
    var receiptDateValue = Model.ReceiptDate == default ? BusinessClock.Today : Model.ReceiptDate;
    var saleDateValue = Model.SaleDate ?? receiptDateValue.Date;
    var dispatchDateValue = Model.DirectDispatchDate ?? receiptDateValue.Date;
    var displayedReceivedQuantity = Model.ReceivedQuantityMt > 0m ? Model.ReceivedQuantityMt : Math.Max(Model.RemainingToReceiveMt, 0m);
    var displayedActualQuantity = Model.ActualArrivedQuantityMt ?? displayedReceivedQuantity;

    // یک رسید = یک مقصد. حالت ترکیبی حذف شده است.
    var currentScenario = (Model.ReceiptDestination, Model.AllocationDestination) switch
    {
        (LoadingReceiptDestination.DirectDispatch, LoadingReceiptAllocationDestination.DirectSale) => "sale",
        (LoadingReceiptDestination.DirectDispatch, LoadingReceiptAllocationDestination.DirectDispatchToTruck) => "truck",
        (LoadingReceiptDestination.DirectDispatch, LoadingReceiptAllocationDestination.TransferToOtherTerminal) => "transfer",
        _ => "inventory"
    };
    var hasLoss = Model.Loss.Enabled;
}

<form asp-controller="LoadingReceipts"
      asp-action="Create"
      asp-route-modal="@iframeModalRouteValue"
      method="post"
      class="ak-form @(isReceiptModal ?"is-modal" : "")"
      dir="@viewDirection"
      data-receipt-create-form="true"
      data-receipt-to-inventory="@((int)LoadingReceiptDestination.ToInventory)"
      data-receipt-direct-dispatch="@((int)LoadingReceiptDestination.DirectDispatch)"
      data-alloc-to-inventory="@((int)LoadingReceiptAllocationDestination.ToInventory)"
      data-alloc-direct-truck="@((int)LoadingReceiptAllocationDestination.DirectDispatchToTruck)"
      data-alloc-direct-sale="@((int)LoadingReceiptAllocationDestination.DirectSale)"
      data-alloc-transfer="@((int)LoadingReceiptAllocationDestination.TransferToOtherTerminal)"
      novalidate>
    @Html.AntiForgeryToken()
    @Html.FormToken()
    @if (isReceiptIframeModal)
    {
        <input type="hidden" name="modal" value="1" />
    }
    <input asp-for="LoadingRegisterId" type="hidden" />
    <input asp-for="ReturnUrl" type="hidden" />
    <input asp-for="Loss.Stage" type="hidden" />
    <input asp-for="ReceiptDestination" type="hidden" id="ReceiptDestination" />
    <input asp-for="AllocationDestination" type="hidden" id="AllocationDestination" />
    <input type="hidden" id="ScenarioKey" name="ScenarioKey" value="@currentScenario" />
    @* مقدار واقعی رسیده = مقدار رسید؛ اختلاف واقعی در بخش کسری ثبت می‌شود. *@
    <input type="hidden" id="ActualArrivedQuantityMt" name="ActualArrivedQuantityMt" value="@Qty(displayedActualQuantity)" />

    @{
        ViewData["OpHeaderBackUrl"] = resolvedCancelUrl;
        ViewData["OpHeaderShowBack"] = !isReceiptModal;
        ViewData["OpHeaderBackLabel"] = T("بازگشت", "Back");
    }

    <div asp-validation-summary="ModelOnly" class="alert alert-danger ak-form-alert"></div>

    @if (Model.CorrectionOfReceiptId is > 0)
    {
        @* اصلاح مقدار: رسید قبلی هنگام ثبت، در همان تراکنش لغو می‌شود. *@
        <input asp-for="CorrectionOfReceiptId" type="hidden" />
        <div class="alert alert-warning">
            @T("اصلاح رسید", "Correcting receipt") #@Model.CorrectionOfReceiptId —
            @T("با ثبت این فرم، رسید قبلی لغو و رسید اصلاح‌شده ثبت می‌شود.",
               "Submitting this form cancels the previous receipt and registers the corrected one.")
        </div>
        <div class="ak-field ak-col-full">
            <label class="ak-label" asp-for="CorrectionReason">@T("دلیل اصلاح", "Correction reason")</label>
            <input class="ak-input" asp-for="CorrectionReason" maxlength="500" required />
            <span asp-validation-for="CorrectionReason" class="ak-field-error"></span>
        </div>
    }

    <main>
        @* ---------- ۱. بارگیری (فقط خواندنی) ---------- *@
        <section class="ak-form-section" aria-labelledby="receiptLoadingTitle">
            <div class="ak-section-head">
                <h2 id="receiptLoadingTitle" class="ak-section-title">@T("۱. بارگیری", "1. Loading")</h2>
                <p class="ak-section-desc">@T("این اطلاعات از بارگیری می‌آید و قابل تغییر نیست.", "Read-only information taken from the loading.")</p>
            </div>

            <section class="ak-summary" aria-label="@T("خلاصهٔ بارگیری", "Loading summary")">
                <article class="ak-field">
                    <span>@T("شماره بارگیری", "Loading no.")</span>
                    <strong>@loadingCode</strong>
                </article>
                <article class="ak-field">
                    <span>@T("جنس", "Product")</span>
                    <strong>@(string.IsNullOrWhiteSpace(Model.ProductName) ? "—" : Model.ProductName)</strong>
                </article>
                <article class="ak-field is-wide">
                    <span>@T("فروشنده / قرارداد", "Supplier / contract")</span>
                    <strong>@(string.IsNullOrWhiteSpace(supplierText) ? "—" : supplierText)</strong>
                </article>
                @if (!string.IsNullOrWhiteSpace(transportText))
                {
                    <article class="ak-field">
                        <span>@T("وسیلهٔ حمل", "Transport")</span>
                        <strong>@transportText</strong>
                    </article>
                }
                <article class="ak-field">
                    <span>@T("مقدار بارنامه", "Loaded quantity")</span>
                    <strong><bdi>@NumberDisplay.Quantity(Model.LoadedQuantityMt) @T("تن", "MT")</bdi></strong>
                </article>
                <article class="ak-field">
                    <span>@T("قبلاً رسید شده", "Already received")</span>
                    <strong><bdi>@NumberDisplay.Quantity(Model.AlreadyReceivedQuantityMt) @T("تن", "MT")</bdi></strong>
                </article>
                <article class="ak-field is-primary">
                    <span>@T("باقیمانده", "Remaining")</span>
                    <strong><bdi>@NumberDisplay.Quantity(Model.RemainingToReceiveMt) @T("تن", "MT")</bdi></strong>
                </article>
            </section>
        </section>

        @* ---------- ۲. مقدار رسیده ---------- *@
        <section class="ak-form-section" aria-labelledby="receiptQuantityTitle">
            <div class="ak-section-head">
                <h2 id="receiptQuantityTitle" class="ak-section-title">@T("۲. مقدار رسیده", "2. Received quantity")</h2>
                <p class="ak-section-desc">@T("چه مقدار از این بارگیری واقعاً رسید؟", "How much of this loading actually arrived?")</p>
            </div>

            <div class="ak-form-grid ak-form-grid--3">
                <div class="ak-field">
                    <label for="ReceivedQuantityMt">@T("مقدار رسیده (تن)", "Received quantity (MT)")</label>
                    <input id="ReceivedQuantityMt"
                           name="ReceivedQuantityMt"
                           type="number"
                           step="0.0001"
                           min="0"
                           class="ak-input"
                           value="@Qty(displayedReceivedQuantity)"
                           data-copy-value-to="ActualArrivedQuantityMt"
                           data-receipt-base-quantity="@Qty(Model.RemainingToReceiveMt)" />
                    <span class="ak-section-desc"
                          data-receipt-shortage-hint
                          data-hint-template="@T("اختلاف با باقیمانده: {0} تن", "Difference vs. remaining: {0} MT")"
                          hidden></span>
                    <span asp-validation-for="ReceivedQuantityMt" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label for="ReceiptDate">@T("تاریخ رسید", "Receipt date")</label>
                    <input id="ReceiptDate"
                           name="ReceiptDate"
                           type="date"
                           class="ak-input"
                           value="@receiptDateValue.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                    <span asp-validation-for="ReceiptDate" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label for="ReferenceDocument">@T("شماره سند / بارنامه", "Document / BL number")</label>
                    <input id="ReferenceDocument"
                           name="ReferenceDocument"
                           class="ak-input"
                           value="@referenceDocumentValue" />
                    <span asp-validation-for="ReferenceDocument" class="ak-field-error"></span>
                </div>
            </div>

            <details class="ak-advanced" open="@HasError("ArrivalDate", "LeakDate", "Notes")">
                <summary class="ak-advanced-summary">@T("اطلاعات تکمیلی (اختیاری)", "Optional details")</summary>
                <div class="ak-advanced-body ak-form-grid">
                    <div class="ak-field">
                        <label asp-for="ArrivalDate">@T("تاریخ ورود به مقصد", "Arrival date")</label>
                        <input asp-for="ArrivalDate" type="date" class="ak-input" />
                        <span asp-validation-for="ArrivalDate" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field">
                        <label asp-for="LeakDate">@T("تاریخ نشت / خرابی", "Leak date")</label>
                        <input asp-for="LeakDate" type="date" class="ak-input" />
                        <span asp-validation-for="LeakDate" class="ak-field-error"></span>
                    </div>
                    <div class="ak-field ak-col-full">
                        <label asp-for="Notes">@T("یادداشت", "Notes")</label>
                        <textarea asp-for="Notes" rows="2" class="ak-input"></textarea>
                        <span asp-validation-for="Notes" class="ak-field-error"></span>
                    </div>
                </div>
            </details>
        </section>

        @* ---------- ۳. مقصد کالا ---------- *@
        <section class="ak-form-section" aria-labelledby="receiptRoutingTitle">
            <div class="ak-section-head">
                <h2 id="receiptRoutingTitle" class="ak-section-title">@T("۳. این کالا کجا رفت؟", "3. Where did this product go?")</h2>
                <p class="ak-section-desc">@T("فقط یک مورد را انتخاب کنید.", "Choose exactly one.")</p>
            </div>

            <div class="ak-choice-grid" role="group" aria-label="@T("مقصد کالا", "Destination")">
                <button type="button"
                        class="ak-choice @(currentScenario =="inventory" ? "is-selected" : "")"
                        data-scenario-pick="inventory"
                        data-scenario-label="@T("ثبت در موجودی مخزن", "To inventory tank")"
                        data-scenario-effect="@T("موجودی مخزن زیاد می‌شود", "Tank inventory increases")"
                        aria-pressed="@(currentScenario == "inventory" ? "true" : "false")">
                    <i class="bi bi-database" aria-hidden="true"></i>
                    <span>@T("ثبت در موجودی مخزن", "To inventory tank")</span>
                </button>
                <button type="button"
                        class="ak-choice @(currentScenario =="sale" ? "is-selected" : "")"
                        data-scenario-pick="sale"
                        data-scenario-label="@T("فروش مستقیم", "Direct sale")"
                        data-scenario-effect="@T("موجودی تغییر نمی‌کند؛ فروش ثبت می‌شود", "No inventory change; a sale is created")"
                        aria-pressed="@(currentScenario == "sale" ? "true" : "false")">
                    <i class="bi bi-currency-dollar" aria-hidden="true"></i>
                    <span>@T("فروش مستقیم", "Direct sale")</span>
                </button>
                <button type="button"
                        class="ak-choice @(currentScenario =="truck" ? "is-selected" : "")"
                        data-scenario-pick="truck"
                        data-scenario-label="@T("ارسال مستقیم به موتر", "Direct truck dispatch")"
                        data-scenario-effect="@T("موجودی تغییر نمی‌کند؛ ارسال ثبت می‌شود", "No inventory change; a dispatch is created")"
                        aria-pressed="@(currentScenario == "truck" ? "true" : "false")">
                    <i class="bi bi-truck" aria-hidden="true"></i>
                    <span>@T("ارسال مستقیم به موتر", "Direct truck dispatch")</span>
                </button>
                <button type="button"
                        class="ak-choice @(currentScenario =="transfer" ? "is-selected" : "")"
                        data-scenario-pick="transfer"
                        data-scenario-label="@T("انتقال به ترمینال دیگر", "Transfer to another terminal")"
                        data-scenario-effect="@T("کالا تا رسیدن، در مسیر می‌ماند", "Product stays in transit until it arrives")"
                        aria-pressed="@(currentScenario == "transfer" ? "true" : "false")">
                    <i class="bi bi-arrow-left-right" aria-hidden="true"></i>
                    <span>@T("انتقال به ترمینال دیگر", "Transfer to another terminal")</span>
                </button>
            </div>

            <p class="ak-note" data-preview-value="inventoryEffect">—</p>

            @* ترمینال رسید در هر چهار حالت لازم است. *@
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label for="TerminalId">@T("ترمینال رسید", "Receipt terminal")</label>
                    <select asp-for="TerminalId" asp-items="ViewBag.Terminals" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="TerminalId" class="ak-field-error"></span>
                </div>

                <div class="ak-field @(currentScenario =="inventory" ? "" : "d-none")" data-scenario-panel="inventory">
                    <label asp-for="StorageTankId">@T("مخزن", "Tank")</label>
                    <select asp-for="StorageTankId" asp-items="ViewBag.StorageTanks" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="StorageTankId" class="ak-field-error"></span>
                </div>
            </div>

            @* --- فروش مستقیم --- *@
            <div class="ak-form-grid @(currentScenario =="sale" ? "" : "d-none")" data-scenario-panel="sale">
                <div class="ak-field">
                    <label asp-for="SaleBuyerKey">@T("خریدار", "Buyer")</label>
                    <select asp-for="SaleBuyerKey" asp-items="ViewBag.SaleBuyers" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="SaleBuyerKey" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="SaleDate">@T("تاریخ فروش", "Sale date")</label>
                    <input asp-for="SaleDate" type="date" class="ak-input" value="@saleDateValue.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                    <span asp-validation-for="SaleDate" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="SaleUnitPriceInCurrency">@T("قیمت واحد (هر تن)", "Unit price (per MT)")</label>
                    <input asp-for="SaleUnitPriceInCurrency" type="number" step="0.0001" min="0" class="ak-input" data-sale-price-pending-target />
                    <span asp-validation-for="SaleUnitPriceInCurrency" class="ak-field-error"></span>
                </div>
                @* فروش با قیمت باز: بار ثبت می‌شود؛ قیمت بعداً از صفحهٔ همان فروش تعیین می‌شود. *@
                <div class="ak-field ak-col-full">
                    <div class="form-check">
                        <input asp-for="SaleIsPricePending" class="form-check-input" type="checkbox" data-sale-price-pending-toggle />
                        <label asp-for="SaleIsPricePending" class="form-check-label">@UiText.T(Context, "قیمت فروش هنوز مشخص نیست", "Sale price not yet known")</label>
                    </div>
                    <div class="form-text" data-sale-price-pending-hint hidden>@UiText.T(Context, "بار و موجودی همین حالا ثبت می‌شود؛ طلب مشتری، عاید و مفاد پس از تعیین قیمت از صفحهٔ همین فروش ثبت می‌شود.", "Delivery is recorded now; receivable, revenue and profit are posted once the price is set from the sale page.")</div>
                </div>
                <div class="ak-field">
                    <label asp-for="SaleCurrency">@T("واحد پول", "Currency")</label>
                    <select asp-for="SaleCurrency" asp-items="ViewBag.SaleCurrencies" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="SaleCurrency" class="ak-field-error"></span>
                </div>

                <details class="ak-advanced ak-col-full" open="@HasError("SaleInvoiceNumber", "SaleAppliedFxRateToUsd", "SaleNotes")">
                    <summary class="ak-advanced-summary">@T("اطلاعات تکمیلی فروش (اختیاری)", "Optional sale details")</summary>
                    <div class="ak-advanced-body ak-form-grid">
                        <div class="ak-field">
                            <label asp-for="SaleInvoiceNumber">@T("شماره فاکتور", "Invoice number")</label>
                            <input asp-for="SaleInvoiceNumber" class="ak-input" />
                            <span class="ak-section-desc">@T("در صورت خالی بودن، خودکار ساخته می‌شود.", "Generated automatically when left empty.")</span>
                            <span asp-validation-for="SaleInvoiceNumber" class="ak-field-error"></span>
                        </div>
                        <div class="ak-field">
                            <label asp-for="SaleAppliedFxRateToUsd">@T("نرخ تبدیل به دالر", "FX rate to USD")</label>
                            <input asp-for="SaleAppliedFxRateToUsd" type="number" step="0.000001" min="0" class="ak-input" data-sale-price-pending-target />
                            <span class="ak-section-desc">@T("در صورت خالی بودن، نرخ روز استفاده می‌شود.", "The daily rate is used when left empty.")</span>
                            <span asp-validation-for="SaleAppliedFxRateToUsd" class="ak-field-error"></span>
                        </div>
                        <div class="ak-field ak-col-full">
                            <label asp-for="SaleNotes">@T("یادداشت فروش", "Sale notes")</label>
                            <textarea asp-for="SaleNotes" rows="2" class="ak-input"></textarea>
                            <span asp-validation-for="SaleNotes" class="ak-field-error"></span>
                        </div>
                    </div>
                </details>
            </div>

            @* --- ارسال مستقیم به موتر --- *@
            <div class="ak-form-grid @(currentScenario =="truck" ? "" : "d-none")" data-scenario-panel="truck">
                <div class="ak-field">
                    <label asp-for="DirectTruckId">@T("موتر", "Truck")</label>
                    <select asp-for="DirectTruckId" asp-items="ViewBag.DirectTrucks" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="DirectTruckId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="DirectDriverId">@T("راننده", "Driver")</label>
                    <select asp-for="DirectDriverId" asp-items="ViewBag.DirectDrivers" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="DirectDriverId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="DirectDispatchDate">@T("تاریخ حرکت", "Dispatch date")</label>
                    <input asp-for="DirectDispatchDate" type="date" class="ak-input" value="@dispatchDateValue.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)" />
                    <span asp-validation-for="DirectDispatchDate" class="ak-field-error"></span>
                </div>

                <details class="ak-advanced ak-col-full" open="@HasError("DirectTruckPlateNumber", "DirectDriverName", "DirectTruckTicketSerialNumber")">
                    <summary class="ak-advanced-summary">@T("موتر یا رانندهٔ جدید (اختیاری)", "New truck or driver (optional)")</summary>
                    <div class="ak-advanced-body ak-form-grid">
                        <div class="ak-field">
                            <label asp-for="DirectTruckPlateNumber">@T("نمبر پلیت موتر جدید", "New truck plate")</label>
                            <input asp-for="DirectTruckPlateNumber" class="ak-input" />
                            <span asp-validation-for="DirectTruckPlateNumber" class="ak-field-error"></span>
                        </div>
                        <div class="ak-field">
                            <label asp-for="DirectDriverName">@T("نام رانندهٔ جدید", "New driver name")</label>
                            <input asp-for="DirectDriverName" class="ak-input" />
                            <span asp-validation-for="DirectDriverName" class="ak-field-error"></span>
                        </div>
                        <div class="ak-field">
                            <label asp-for="DirectTruckTicketSerialNumber">@T("سریال تکت", "Ticket serial")</label>
                            <input asp-for="DirectTruckTicketSerialNumber" class="ak-input" />
                            <span asp-validation-for="DirectTruckTicketSerialNumber" class="ak-field-error"></span>
                        </div>
                    </div>
                </details>
            </div>

            @* --- انتقال به ترمینال دیگر --- *@
            <div class="ak-form-grid @(currentScenario =="transfer" ? "" : "d-none")" data-scenario-panel="transfer">
                <div class="ak-field">
                    <label asp-for="DestinationTerminalId">@T("ترمینال مقصد", "Destination terminal")</label>
                    <select asp-for="DestinationTerminalId" asp-items="ViewBag.DestinationTerminals" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="DestinationTerminalId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="DestinationStorageTankId">@T("مخزن مقصد (اختیاری)", "Destination tank (optional)")</label>
                    <select asp-for="DestinationStorageTankId" asp-items="ViewBag.DestinationStorageTanks" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="DestinationStorageTankId" class="ak-field-error"></span>
                </div>
            </div>

            @* --- مقصد جغرافیایی: مشترک بین موتر و انتقال --- *@
            <div class="ak-form-grid @(currentScenario =="truck" || currentScenario == "transfer" ? "" : "d-none")" data-scenario-panel="truck transfer">
                <div class="ak-field">
                    <label asp-for="DestinationLocationId">@T("شهر / موقعیت مقصد", "Destination city")</label>
                    <select asp-for="DestinationLocationId" asp-items="ViewBag.DestinationLocations" class="ak-input">
                        <option value="">@T("انتخاب کنید", "Select")</option>
                    </select>
                    <span asp-validation-for="DestinationLocationId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="AllocationDestinationName">@T("نام مقصد (اختیاری)", "Destination name (optional)")</label>
                    <input asp-for="AllocationDestinationName" class="ak-input" />
                    <span asp-validation-for="AllocationDestinationName" class="ak-field-error"></span>
                </div>
            </div>
        </section>

        @* ---------- ۴. کسری / ضایعات ---------- *@
        <section class="ak-form-section" aria-labelledby="receiptLossTitle" data-receipt-loss-card>
            <div class="ak-section-head">
                <h2 id="receiptLossTitle" class="ak-section-title">@T("۴. آیا کسری یا ضایعات وجود دارد؟", "4. Any shortage or loss?")</h2>
                <p class="ak-section-desc">
                    @T("اگر مقدار کسری هنوز معلوم نیست، گزینهٔ اول را بزنید؛ کسری بعداً از تسویهٔ نهایی مخزن محاسبه می‌شود.",
                       "If the shortage is not known yet, choose the first option; it is settled later from the final tank settlement.")
                </p>
            </div>

            <input type="hidden" name="Loss.Enabled" id="LossEnabled" value="@(hasLoss ? "true" : "false")" data-loss-enabled-value />

            <div class="ak-choice-grid ak-choice-grid--2" role="group" aria-label="@T("وضعیت کسری", "Shortage state")">
                <button type="button"
                        class="ak-choice @(hasLoss ? "" : "is-selected")"
                        data-loss-pick="no"
                        aria-pressed="@(hasLoss ? "false" : "true")">
                    <i class="bi bi-hourglass-split" aria-hidden="true"></i>
                    <span>@T("فعلاً معلوم نیست — هنگام تسویهٔ مخزن", "Not known yet — at tank settlement")</span>
                </button>
                <button type="button"
                        class="ak-choice @(hasLoss ? "is-selected" : "")"
                        data-loss-pick="yes"
                        aria-pressed="@(hasLoss ? "true" : "false")">
                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                    <span>@T("بله، مقدار کسری معلوم است", "Yes, the shortage is known")</span>
                </button>
            </div>

            <div class="ak-form-grid @(hasLoss ? "" : "d-none")" data-loss-panel>
                <div class="ak-field">
                    <label asp-for="Loss.QuantityMt">@T("مقدار کسری (تن)", "Shortage quantity (MT)")</label>
                    <input asp-for="Loss.QuantityMt" type="number" step="0.0001" min="0" class="ak-input" data-loss-auto-quantity />
                    <span class="ak-section-desc">@T("خودکار از «باقیمانده − مقدار رسیده» حساب می‌شود؛ قابل ویرایش است.", "Auto-calculated from remaining minus received; editable.")</span>
                    <span asp-validation-for="Loss.QuantityMt" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="Loss.ResponsiblePartyName">@T("مسئول کسری (اختیاری)", "Responsible party (optional)")</label>
                    <input asp-for="Loss.ResponsiblePartyName" class="ak-input" />
                    <span asp-validation-for="Loss.ResponsiblePartyName" class="ak-field-error"></span>
                </div>
                <div class="ak-field ak-col-full">
                    <label asp-for="Loss.Notes">@T("دلیل کسری / توضیح", "Reason / notes")</label>
                    <textarea asp-for="Loss.Notes" rows="2" class="ak-input"></textarea>
                    <span asp-validation-for="Loss.Notes" class="ak-field-error"></span>
                </div>

                <details class="ak-advanced ak-col-full" open="@HasError("Loss.ToleranceQuantityMt", "Loss.Reference")">
                    <summary class="ak-advanced-summary">@T("تلورانس و مرجع (اختیاری)", "Tolerance and reference (optional)")</summary>
                    <div class="ak-advanced-body ak-form-grid">
                        <div class="ak-field">
                            <label asp-for="Loss.ToleranceQuantityMt">@T("تلورانس مجاز (تن)", "Allowed tolerance (MT)")</label>
                            <input asp-for="Loss.ToleranceQuantityMt" type="number" step="0.0001" min="0" class="ak-input" />
                            <span asp-validation-for="Loss.ToleranceQuantityMt" class="ak-field-error"></span>
                        </div>
                        <div class="ak-field">
                            <label asp-for="Loss.Reference">@T("سند مرجع کسری", "Shortage reference")</label>
                            <input asp-for="Loss.Reference" class="ak-input" />
                            <span asp-validation-for="Loss.Reference" class="ak-field-error"></span>
                        </div>
                    </div>
                </details>
            </div>
        </section>

        @* ---------- ۵. تأیید نهایی ---------- *@
        <section class="ak-form-section" aria-labelledby="receiptConfirmTitle">
            <div class="ak-section-head">
                <h2 id="receiptConfirmTitle" class="ak-section-title">@T("۵. تأیید نهایی", "5. Final confirmation")</h2>
                <p class="ak-section-desc">@T("پیش از ثبت، این خلاصه را کنترل کنید.", "Check this summary before saving.")</p>
            </div>

            <section class="ak-summary" aria-label="@T("خلاصهٔ رسید", "Receipt summary")" aria-live="polite">
                <article class="ak-field is-primary">
                    <span>@T("مقدار رسید", "Receipt")</span>
                    <strong><span data-preview-value="receivedQuantity">—</span> @(string.IsNullOrWhiteSpace(Model.ProductName) ? "" : Model.ProductName)</strong>
                </article>
                <article class="ak-field">
                    <span>@T("مقصد", "Destination")</span>
                    <strong data-preview-value="destinationType">—</strong>
                </article>
                <article class="ak-field">
                    <span>@T("مقصد دقیق", "Destination detail")</span>
                    <strong data-preview-value="destinationDetail">—</strong>
                </article>
                <article class="ak-field">
                    <span>@T("کسری", "Shortage")</span>
                    <strong data-preview-value="lossQuantity">—</strong>
                </article>
                <article class="ak-field">
                    <span>@T("مصرف از باقیماندهٔ بارگیری", "Consumed from remaining")</span>
                    <strong data-preview-value="consumedQuantity">—</strong>
                </article>
                <article class="ak-field">
                    <span>@T("اثر بر موجودی مخزن", "Effect on tank inventory")</span>
                    <strong data-preview-value="inventoryDelta">—</strong>
                </article>
            </section>
        </section>
    </main>

    <div class="ak-footer-actions">
        @if (isReceiptModal)
        {
            <button type="button" class="ak-cancel" data-bs-dismiss="modal" data-ptg-iframe-modal-close>@T("انصراف", "Cancel")</button>
        }
        else
        {
            <a href="@resolvedCancelUrl" class="ak-cancel">@T("بازگشت", "Back")</a>
        }
        <button type="submit" class="ak-save">
            <i class="bi bi-check-circle me-1" aria-hidden="true"></i>
            @T("ثبت رسید", "Save receipt")
        </button>
    </div>
</form>
<script src="~/js/sale-price-pending.js" asp-append-version="true" defer></script>
