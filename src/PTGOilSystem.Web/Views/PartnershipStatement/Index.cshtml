@using PTGOilSystem.Web.Models.Partners
@using PTGOilSystem.Web.Services.PartyStatements
@using PTGOilSystem.Web.Security
@using Microsoft.AspNetCore.Authorization
@model PartnershipStatementPageViewModel
@inject IAuthorizationService AuthorizationService
@{
    ViewData["Title"] = "صورت‌حساب شراکت";
    var statement = Model.Statement;
    var canManage = (await AuthorizationService.AuthorizeAsync(User, AuthPolicies.ManageData)).Succeeded;
    var selectedContractIds = statement?.ContractOptions.Where(o => o.IsSelected).Select(o => o.ContractId).ToArray()
        ?? System.Array.Empty<int>();
    var isFiltered = statement is not null && statement.ContractOptions.Any(o => !o.IsSelected);
    var filteredContractId = isFiltered && selectedContractIds.Length == 1 ? selectedContractIds[0] : (int?)null;
    var returnUrl = Url.Action("Index", new
    {
        partnerAId = statement?.PartnerAId,
        partnerBId = statement?.PartnerBId,
        contractIds = isFiltered ? selectedContractIds : null
    });
    var allContractsUrl = Url.Action("Index", new { partnerAId = statement?.PartnerAId, partnerBId = statement?.PartnerBId });

    string Money(decimal value) => value.ToString("N2");
    // اثرِ هر ردیف روی حساب شریک: مثبت به نفع او، منفی به ضرر او. جمعِ ستون همان مانده است.
    string Signed(decimal value) => value == 0m ? "—" : (value > 0m ? "+" : "−") + Math.Abs(value).ToString("N2");

    var settlementModel = statement is null
        ? new PartnerSettlementFormViewModel()
        : new PartnerSettlementFormViewModel
        {
            SettlementDate = BusinessClock.Today,
            FromPartnerId = statement.DebtorPartnerId ?? statement.PartnerAId,
            ToPartnerId = statement.CreditorPartnerId ?? statement.PartnerBId,
            ContractId = filteredContractId,
            Amount = statement.AmountDueUsd
        };

    // خروجی Excel/PDF از همان منوی مشترک بقیهٔ صفحات مالی. فیلترِ قرارداد از query
    // خودِ صفحه برداشته می‌شود، پس خروجی دقیقاً همان چیزی است که روی صفحه دیده می‌شود.
    if (statement is not null)
    {
        ViewData["AkHeaderExport"] = new PTGOilSystem.Web.Services.Exports.ExportMenuModel(
            "Export",
            "PartnershipStatement",
            new Dictionary<string, string?>
            {
                ["partnerAId"] = statement.PartnerAId.ToString(),
                ["partnerBId"] = statement.PartnerBId.ToString(),
                ["pair"] = null
            });
    }

    var kpis = statement is null
        ? new List<AkKpiItem>()
        : new List<AkKpiItem>
        {
            new() { Title = "خرید و مصارف", Value = Money(statement.Contracts.Sum(c => c.TotalCostUsd)), Unit = "USD", Avatar = "expenses" },
            new() { Title = "فروش", Value = Money(statement.Contracts.Sum(c => c.SalesUsd)), Unit = "USD", Avatar = "sales-value" },
            new() { Title = "سود / ضرر محقق", Value = Money(statement.Contracts.Sum(c => c.BookProfitUsd)), Unit = "USD", Avatar = "receivables" },
            new() { Title = "پرداخت‌های بین شرکا", Value = statement.Settlements.Count(s => !s.IsReversed).ToString("N0"), Unit = "مورد", Avatar = "payments" }
        };
}

<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@(("صورت‌حساب شراکت", false,
                       canManage && statement is not null ? "ثبت پرداخت بین شرکا" : (string?)null,
                       "bi-arrow-left-right",
                       (string?)null,
                       canManage && statement is not null ? "partnerSettlementCreateModal" : (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    @if (statement is null)
    {
        <div class="ak-empty ak-detail-empty-state">
            <i class="bi bi-diagram-3" aria-hidden="true"></i>
            هیچ قرارداد شراکتی با دو شریک ثبت نشده است.
        </div>
    }
    else
    {
        var totalA = statement.Totals.First(t => t.PartnerId == statement.PartnerAId);
        var totalB = statement.Totals.First(t => t.PartnerId == statement.PartnerBId);

        <form method="get" asp-action="Index" class="ak-detail-toolbar">
            <div class="ak-field">
                <label class="ak-label" for="statementPair">شرکا</label>
                <select id="statementPair" name="pair" class="ak-input" data-ak-entity-combobox>
                    @foreach (var pair in Model.Pairs)
                    {
                        var isActive = pair.PartnerAId == statement.PartnerAId && pair.PartnerBId == statement.PartnerBId;
                        <option value="@pair.PartnerAId-@pair.PartnerBId" selected="@isActive">@pair.PartnerAName و @pair.PartnerBName</option>
                    }
                </select>
            </div>
            <div class="ak-field">
                <label class="ak-label" for="statementContract">قرارداد</label>
                <select id="statementContract" name="contractIds" class="ak-input" data-ak-entity-combobox>
                    <option value="">همهٔ قراردادها</option>
                    @foreach (var option in statement.ContractOptions)
                    {
                        <option value="@option.ContractId" selected="@(filteredContractId == option.ContractId)">@option.ContractLabel</option>
                    }
                </select>
            </div>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <span>نمایش</span>
            </button>
            @if (isFiltered)
            {
                <a href="@allContractsUrl" class="btn btn-light">همهٔ قراردادها</a>
            }
        </form>

        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)kpis)" />

        @* ===== نتیجه: یک عدد، به زبان ساده ===== *@
        <section class="ak-form-section ak-detail-section ak-party-account">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("نتیجهٔ حساب", (string?)(isFiltered ? "فقط برای قرارداد انتخاب‌شده" : "همهٔ قراردادهای مشترک و همهٔ پرداخت‌های بین دو شریک")))" />
            @if (statement.DebtorPartnerId.HasValue)
            {
                @* یک عدد، نه دو. طلبِ شریکِ طلبکار به اندازهٔ باقیماندهٔ تطبیق‌نشده با بدهیِ شریکِ
                   بدهکار فرق دارد؛ آن عدد «مانده نهایی» نیست و اینجا فقط به‌عنوان تفاوت تطبیق
                   با متن کوچک می‌آید. هیچ سیاست حسابداری برای تقسیم این باقیمانده وجود ندارد،
                   پس هیچ میانگینی از دو مانده ساخته نمی‌شود. *@
                <p class="ak-party-meaning is-danger">
                    <i class="bi bi-arrow-left-circle" aria-hidden="true"></i>
                    <span>
                        <strong>@statement.DebtorPartnerName</strong> باید
                        <bdi class="ak-num" dir="ltr">@Money(statement.AmountDueUsd) USD</bdi>
                        به <strong>@statement.CreditorPartnerName</strong> بپردازد.
                    </span>
                </p>
                <p class="ak-note">مبلغ قابل تسویه همین عدد است. با ثبت «پرداخت بین شرکا» از همین صفحه کم می‌شود.</p>
                @if (statement.UnreconciledResidualUsd != 0m)
                {
                    <p class="ak-note">
                        تفاوت تطبیق با دفتر:
                        <bdi dir="ltr">@Money(statement.UnreconciledResidualUsd) USD</bdi>
                        — بخشی از هزینه هنوز پرداخت یا فروخته نشده؛ جزئیات در «جزئیات محاسبه» پایین صفحه است.
                    </p>
                }
            }
            else if (statement.Totals.Count > 1 && statement.Totals.All(t => t.NetPositionUsd < 0m))
            {
                <p class="ak-party-meaning">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>هیچ‌کدام به دیگری بدهکار نیست؛ هر دو سهم خود از هزینهٔ پرداخت‌نشده را دارند.</span>
                </p>
            }
            else if (statement.Totals.Count > 1 && statement.Totals.All(t => t.NetPositionUsd > 0m))
            {
                <p class="ak-party-meaning">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>هیچ‌کدام به دیگری بدهکار نیست؛ هر دو بیش از سهم خود پرداخته‌اند و هر دو از شراکت طلب دارند.</span>
                </p>
            }
            else
            {
                <p class="ak-party-meaning">
                    <i class="bi bi-check-circle" aria-hidden="true"></i>
                    <span>حساب @statement.PartnerAName و @statement.PartnerBName تسویه است.</span>
                </p>
            }
        </section>

        @* ===== حساب هر شریک: هر ردیف اثرش روی حساب، جمعِ ستون همان مانده ===== *@
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("حساب هر شریک", (string?)"+ یعنی به نفع شریک، − یعنی به ضرر شریک. جمع هر ستون، ماندهٔ همان شریک است."))" />
            <div class="ak-table-wrap" data-disable-client-pagination="true">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">شرح</th>
                            <th class="ak-col-num">@statement.PartnerAName (USD)</th>
                            <th class="ak-col-num">@statement.PartnerBName (USD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var accountRows = new (string Title, string Note, decimal A, decimal B)[]
                            {
                                ("پولی که برای قرارداد گذاشته", "پرداخت خرید و مصارف از روزنامچه، منهای پولی که شریک از روزنامچه گرفته", totalA.FundingUsd, totalB.FundingUsd),
                                ("سهم از سود یا ضرر فروش", "به نسبت سهم هر شریک از قرارداد", totalA.ProfitShareUsd, totalB.ProfitShareUsd),
                                ("سهم از هزینهٔ بارِ هنوز فروخته‌نشده", "این بار هنوز سودی نداده؛ هزینه‌اش به نسبت سهم تقسیم می‌شود", -totalA.UnsoldCostShareUsd, -totalB.UnsoldCostShareUsd),
                                ("پول فروش که نزد خودش مانده", "عاید فروشی که هنوز به حساب شراکت برنگشته", -totalA.ProceedsHeldUsd, -totalB.ProceedsHeldUsd),
                                ("پولی که به شریک دیگر پرداخته", "از فهرست «پرداخت‌های بین شرکا»", totalA.SettlementsPaidUsd, totalB.SettlementsPaidUsd),
                                ("پولی که از شریک دیگر گرفته", "از فهرست «پرداخت‌های بین شرکا»", -totalA.SettlementsReceivedUsd, -totalB.SettlementsReceivedUsd)
                            };
                        }
                        @foreach (var row in accountRows.Where(r => r.A != 0m || r.B != 0m))
                        {
                            <tr>
                                <td class="ak-col-grow">
                                    @row.Title
                                    <span class="ak-cell-note">@row.Note</span>
                                </td>
                                <td class="ak-col-num ak-num" dir="ltr">@Signed(row.A)</td>
                                <td class="ak-col-num ak-num" dir="ltr">@Signed(row.B)</td>
                            </tr>
                        }
                        <tr class="ak-table-total">
                            <td class="ak-col-grow">مانده</td>
                            @foreach (var total in new[] { totalA, totalB })
                            {
                                <td class="ak-col-num ak-num">
                                    <bdi dir="ltr">@Money(Math.Abs(total.NetPositionUsd))</bdi>
                                    <span class="ak-cell-note">@(total.NetPositionUsd > 0m ? "طلبکار" : total.NetPositionUsd < 0m ? "بدهکار" : "تسویه")</span>
                                </td>
                            }
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        @* ===== قراردادها: هر قرارداد یک ردیف ===== *@
        <section class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("قراردادها", (string?)$"{statement.Contracts.Count:N0} قرارداد — برای پروندهٔ کامل روی نام قرارداد کلیک کنید."))" />
            <div class="ak-table-wrap" data-disable-client-pagination="true">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">قرارداد</th>
                            <th>سهم شرکا</th>
                            <th class="ak-col-num">خرید و مصارف</th>
                            <th class="ak-col-num">فروش</th>
                            <th class="ak-col-num">سود / ضرر محقق</th>
                            <th class="ak-col-num">مانده @statement.PartnerAName</th>
                            <th class="ak-col-num">مانده @statement.PartnerBName</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var contract in statement.Contracts)
                        {
                            var rowA = contract.Partners.FirstOrDefault(p => p.PartnerId == statement.PartnerAId);
                            var rowB = contract.Partners.FirstOrDefault(p => p.PartnerId == statement.PartnerBId);
                            <tr>
                                <td class="ak-col-grow">
                                    <a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@contract.ContractId">@contract.ContractLabel</a>
                                    <span class="ak-cell-note">
                                        پول فروش نزد: @(contract.ProceedsHolderPartnerName ?? "ثبت نشده")
                                    </span>
                                </td>
                                <td>
                                    @foreach (var share in contract.Partners)
                                    {
                                        <span class="d-block">@share.PartnerName @share.SharePercent.ToString("0.##")٪</span>
                                    }
                                    @if (contract.Partners.Any(p => p.SpansMultipleSharePeriods))
                                    {
                                        <span class="ak-cell-note">سهم در طول قرارداد تغییر کرده؛ سود با سهم هر دوره حساب شده</span>
                                    }
                                </td>
                                <td class="ak-col-num ak-num">@Money(contract.TotalCostUsd)</td>
                                <td class="ak-col-num ak-num">@Money(contract.SalesUsd)</td>
                                <td class="ak-col-num ak-num">@Money(contract.BookProfitUsd)</td>
                                <td class="ak-col-num ak-num" dir="ltr">@(rowA is null ? "—" : Money(rowA.NetPositionUsd))</td>
                                <td class="ak-col-num ak-num" dir="ltr">@(rowB is null ? "—" : Money(rowB.NetPositionUsd))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="ak-note">ماندهٔ هر قرارداد بدون پرداخت‌های بین شرکاست؛ مثبت یعنی طلب و منفی یعنی بدهی همان شریک.</p>
        </section>

        @* ===== پرداخت‌های بین شرکا ===== *@
        var paidAtoB = statement.Settlements.Where(s => !s.IsReversed && s.FromPartnerId == statement.PartnerAId).Sum(s => s.AmountUsd);
        var paidBtoA = statement.Settlements.Where(s => !s.IsReversed && s.FromPartnerId == statement.PartnerBId).Sum(s => s.AmountUsd);
        <section id="partner-settlements" class="ak-form-section ak-detail-section">
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml"
                     model="@(("پرداخت‌های بین شرکا", (string?)"پولی که یک شریک مستقیم به شریک دیگر داده؛ صندوق و بانک شرکت حرکت نکرده."))" />

            <dl class="ak-summary-list">
                <div>
                    <dt>@statement.PartnerAName به @statement.PartnerBName</dt>
                    <dd class="ak-num" dir="ltr">@Money(paidAtoB) USD</dd>
                </div>
                <div>
                    <dt>@statement.PartnerBName به @statement.PartnerAName</dt>
                    <dd class="ak-num" dir="ltr">@Money(paidBtoA) USD</dd>
                </div>
            </dl>

            @if (Model.GeneralSettlementsOutOfView > 0)
            {
                <p class="ak-note">
                    @Model.GeneralSettlementsOutOfView.ToString("N0") پرداخت به قرارداد خاصی وصل نیست و فقط در «همهٔ قراردادها» دیده و حساب می‌شود.
                    <a href="@allContractsUrl#partner-settlements">نمایش همهٔ قراردادها</a>
                </p>
            }

            <div class="ak-table-wrap" data-disable-client-pagination="true">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th>تاریخ</th>
                            <th>پرداخت‌کننده</th>
                            <th>دریافت‌کننده</th>
                            <th class="ak-col-num">مبلغ</th>
                            <th>قرارداد</th>
                            <th class="ak-col-grow">مرجع / توضیح</th>
                            <th class="ak-col-num">خالص پرداختی @statement.PartnerAName به @statement.PartnerBName</th>
                            <th>وضعیت</th>
                            @if (canManage)
                            {
                                <th class="ak-col-actions" aria-label="عملیات"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in statement.Settlements)
                        {
                            <tr>
                                <td>@row.SettlementDate.ToDisplayDate()</td>
                                <td>@row.FromPartnerName</td>
                                <td>@row.ToPartnerName</td>
                                <td class="ak-col-num ak-num">
                                    <bdi dir="ltr">@Money(row.Amount) @row.Currency</bdi>
                                    @if (!string.Equals(row.Currency, "USD", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="ak-cell-note"><bdi dir="ltr">@Money(row.AmountUsd) USD</bdi></span>
                                    }
                                </td>
                                <td>@(row.ContractLabel ?? "کلی")</td>
                                <td class="ak-col-grow">
                                    @(row.Reference ?? "—")
                                    @if (!string.IsNullOrWhiteSpace(row.Description))
                                    {
                                        <span class="ak-cell-note">@row.Description</span>
                                    }
                                </td>
                                <td class="ak-col-num ak-num" dir="ltr">@Money(row.RunningBalanceAfterUsd)</td>
                                <td>
                                    <span class="ak-status @(row.IsReversed ? "is-inactive" : "is-active")">
                                        @(row.IsReversed ? "برگشت‌خورده" : "فعال")
                                    </span>
                                </td>
                                @if (canManage)
                                {
                                    <td class="ak-col-actions">
                                        @if (!row.IsReversed)
                                        {
                                            <form method="post" asp-action="ReverseSettlement" data-no-spa="true"
                                                  data-ptg-confirm="true"
                                                  data-ptg-confirm-title="برگشت پرداخت"
                                                  data-ptg-confirm-message="این پرداخت برگشت می‌خورد و از مانده کنار می‌رود. تاریخچه پاک نمی‌شود.">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@row.Id" />
                                                <input type="hidden" name="returnUrl" value="@returnUrl" />
                                                <button type="submit" class="btn btn-link text-danger p-0"
                                                        title="برگشت پرداخت" aria-label="برگشت پرداخت">
                                                    <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                                </button>
                                            </form>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                        @if (statement.Settlements.Count == 0)
                        {
                            <tr>
                                <td colspan="@(canManage ? 9 : 8)">
                                    <div class="ak-empty ak-detail-empty-state">
                                        <i class="bi bi-cash-coin" aria-hidden="true"></i>
                                        هنوز پرداختی بین این دو شریک ثبت نشده است.
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>

        @* ===== جزئیات محاسبه: برای حسابدار، بسته ===== *@
        <details class="ak-advanced">
            <summary class="ak-advanced-summary">جزئیات محاسبه (برای حسابدار)</summary>

            <div class="ak-table-wrap" data-disable-client-pagination="true">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">تطبیق</th>
                            <th class="ak-col-num">مبلغ (USD)</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="ak-col-grow">مفاد محقق قراردادها — فروش منهای بهای کالای فروخته‌شده و سهم مصارف، ± اثر ارزی</td>
                            <td class="ak-col-num ak-num">@Money(statement.Contracts.Sum(c => c.BookProfitUsd))</td>
                        </tr>
                        <tr>
                            <td class="ak-col-grow">تفاوت پرداخت شرکا با خرید و مصارف ثبت‌شده</td>
                            <td class="ak-col-num ak-num">@Money(statement.Contracts.Sum(c => c.PaymentToBookDifferenceUsd))</td>
                        </tr>
                        <tr>
                            <td class="ak-col-grow">هزینهٔ بارِ هنوز فروخته‌نشده</td>
                            <td class="ak-col-num ak-num">@Money(statement.Contracts.Sum(c => c.UnrealizedCostCarriedUsd))</td>
                        </tr>
                        <tr class="ak-table-total">
                            <td class="ak-col-grow">باقیماندهٔ تطبیق‌نشده — جمع ماندهٔ دو شریک</td>
                            <td class="ak-col-num ak-num">@Money(statement.UnreconciledResidualUsd)</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <p class="ak-note">
                سود هر شریک از «مفاد قرارداد» حساب می‌شود، نه از پرداخت‌هایش. وقتی همهٔ خرید و مصارف
                از پول شرکا پرداخت و همهٔ بار فروخته شود، باقیماندهٔ تطبیق‌نشده صفر می‌شود.
            </p>

            @foreach (var contract in statement.Contracts)
            {
                <h3 class="ak-section-title">@contract.ContractLabel — ریز حرکت‌ها</h3>
                <div class="ak-table-wrap" data-disable-client-pagination="true">
                    <table class="ak-table ak-detail-table">
                        <thead>
                            <tr>
                                <th>تاریخ</th>
                                <th class="ak-col-grow">شرح</th>
                                <th>منبع</th>
                                <th>شریک</th>
                                <th class="ak-col-num">مبلغ (USD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in contract.Lines)
                            {
                                var lineOwner = line.PartnerId.HasValue
                                    ? contract.Partners.FirstOrDefault(p => p.PartnerId == line.PartnerId.Value)?.PartnerName
                                    : null;
                                <tr>
                                    <td>@line.Date.ToDisplayDate()</td>
                                    <td class="ak-col-grow">@line.Title</td>
                                    <td>@line.Source</td>
                                    <td>@(lineOwner ?? "—")</td>
                                    <td class="ak-col-num ak-num">@Money(line.AmountUsd)</td>
                                </tr>
                            }
                            @if (contract.Lines.Count == 0)
                            {
                                <tr>
                                    <td colspan="5"><div class="ak-empty ak-detail-empty-state">ردیفی برای این قرارداد ثبت نشده است.</div></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (canManage)
                {
                    <form method="post" asp-action="SetProceedsHolder" class="ak-detail-toolbar" data-no-spa="true">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="contractId" value="@contract.ContractId" />
                        <input type="hidden" name="returnUrl" value="@returnUrl" />
                        <div class="ak-field">
                            <label class="ak-label" for="holder-@contract.ContractId">پول فروش این قرارداد نزد کدام شریک است؟</label>
                            <select class="ak-input" data-ak-entity-combobox id="holder-@contract.ContractId" name="partnerId">
                                <option value="">— ثبت نشده —</option>
                                @foreach (var partner in contract.Partners)
                                {
                                    <option value="@partner.PartnerId"
                                            selected="@(contract.ProceedsHolderPartnerId == partner.PartnerId)">@partner.PartnerName</option>
                                }
                            </select>
                        </div>
                        <button type="submit" class="btn btn-light">
                            <i class="bi bi-check2" aria-hidden="true"></i>
                            <span>ثبت</span>
                        </button>
                    </form>
                }
            }
        </details>
    }
</div>

@if (canManage && statement is not null)
{
    ViewData["CreateModalId"] = "partnerSettlementCreateModal";
    ViewData["CreateFormId"] = "partnerSettlementCreateForm";
    ViewData["CreateModalTitle"] = "ثبت پرداخت بین شرکا";
    ViewData["CreateModalSubtitle"] = "پولی که یک شریک مستقیم به شریک دیگر داده است.";
    ViewData["CreateModalSubmitText"] = "ثبت پرداخت";
    ViewData["CreateFormAction"] = "CreateSettlement";
    ViewData["CreateFormIdempotent"] = true;
    ViewData["CreateFormController"] = "PartnershipStatement";
    ViewData["CreateFormPartialPath"] = "/Views/PartnershipStatement/_SettlementForm.cshtml";
    ViewData["PartnershipStatement"] = statement;
    ViewData["PartnershipReturnUrl"] = returnUrl;
    ViewData["PartnershipCurrencies"] = Model.Currencies;

    <partial name="~/Views/Shared/_CreateModalShell.cshtml" model="settlementModel" view-data="ViewData" />
}

@section Scripts {
    <script src="~/js/partnership-settlement.js" asp-append-version="true"></script>
}
