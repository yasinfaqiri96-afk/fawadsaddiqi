@model PTGOilSystem.Web.Models.Customers.CustomerProfileViewModel
@using PTGOilSystem.Web.Models.Entities
@using PTGOilSystem.Web.Models.Shared
@{
    ViewData["Title"] = "پروفایل مشتری";
    ViewData["HideSectionTabs"] = true;
    var notRecorded = "ثبت نشده";
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";

    var officialSummary = ViewData["PartyStatementSummary"] as PTGOilSystem.Web.Models.PartyStatements.PartyStatementSummary;
    var bal = officialSummary?.ClosingBalance ?? 0m;
    var balanceLabel = officialSummary?.ClosingBalanceMeaningFor(UiText.IsEn(Context))
        ?? CompanyFlowText.BalanceMeaning(bal, CompanyFlowAccountKind.PartyAccount, Context);
    // tone فقط جهت مالی را نشان می‌دهد: طلب شرکت سبز، بدهی شرکت سرخ، تسویه خنثی.
    var balanceTone = bal > 0 ? "success" : bal < 0 ? "danger" : null;

    var showStatement = Model.ActiveTab == "account";
    var showActivity = Model.ActiveTab == "activity";
    var showOverview = !showStatement && !showActivity;

    var activeSales = Model.Sales.Where(s => !s.IsCancelled).ToList();
    var allocatedPayments = Model.Payments.Where(p => p.SaleId.HasValue).ToList();
    var unallocatedPayments = Model.Payments.Where(p => !p.SaleId.HasValue).ToList();
    // جدول‌های بلند پیش‌فرض ۱۰ مورد اخیر را نشان می‌دهند؛ شمارش سرصفحه روی کل داده می‌ماند.
    // فروش‌ها پیش‌فرض به تفکیک قرارداد + محصول خلاصه می‌شوند؛ هر حمل با دکمهٔ جزئیات باز می‌شود.
    // جمع‌ها فقط نمایشی و از ردیف‌های غیرلغوشده است؛ هیچ مبلغی دوباره محاسبه نمی‌شود.
    var saleGroups = Model.Sales
        .GroupBy(s => new { s.ContractId, s.ContractNumber, s.Product })
        .Select(g =>
        {
            var items = g.OrderByDescending(s => s.SaleDate).ThenByDescending(s => s.SaleId).ToList();
            var active = items.Where(s => !s.IsCancelled).ToList();
            return new
            {
                g.Key.ContractNumber,
                g.Key.Product,
                Items = items,
                ActiveCount = active.Count,
                FirstDate = items.Min(s => s.SaleDate),
                LastDate = items.Max(s => s.SaleDate),
                QuantityMt = active.Sum(s => s.QuantityMt),
                TotalUsd = active.Sum(s => s.TotalUsd),
                ReceivedUsd = active.Sum(s => s.ReceivedUsd),
                ReceivableUsd = active.Where(s => !s.IsSalePricePending).Sum(s => s.ReceivableUsd)
            };
        })
        .OrderByDescending(g => g.LastDate)
        .ToList();
    var saleGroupsShown = DetailListPreview.Take(Context.Request, "customer-sales", saleGroups);
    var allocatedShown = DetailListPreview.Take(Context.Request, "customer-allocated", allocatedPayments);
    var unallocatedShown = DetailListPreview.Take(Context.Request, "customer-unallocated", unallocatedPayments);
    var customerContractsShown = DetailListPreview.Take(Context.Request, "customer-contracts", Model.Contracts);

    var newPaymentUrl = Url.Action("Create", "Payments", new { customerId = Model.CustomerId, returnUrl }) ?? "#";
    var threeWayUrl = Url.Action("Index", "ThreeWaySettlement", new { customerId = Model.CustomerId }) ?? "#";
    var editUrl = Url.Action("Edit", new { id = Model.CustomerId }) ?? "#";
    var indexUrl = Url.Action("Index") ?? "#";
    ViewData["AkHeaderStatus"] = Model.IsActive ? "فعال" : "غیرفعال";
    ViewData["AkHeaderStatusState"] = Model.IsActive ? "is-active" : "is-inactive";
    ViewData["AkHeaderContext"] = $"کد: {(string.IsNullOrWhiteSpace(Model.Code) ? notRecorded : Model.Code)}";
    ViewData["AkHeaderKebab"] = new List<AkHeaderMenuItem>
    {
        new() { Label = "صورت‌حساب رسمی", Href = Url.Action("Customer", "PartyStatements", new { id = Model.CustomerId }), Icon = "bi-file-earmark-text" },
        new() { Label = "تسویه سه‌طرفه", Href = threeWayUrl, Icon = "bi-arrow-left-right" },
        new() { Label = "ویرایش", Href = editUrl, Icon = "bi-pencil" }
    };

    var customerTabs = new[]
    {
        $"overview|خلاصه حساب|bi-grid-1x2|{(showOverview ? "active" : "")}",
        $"account|صورت‌حساب|bi-journal-text|{(showStatement ? "active" : "")}",
        $"activity|فروش‌ها و دریافت‌ها|bi-receipt-cutoff|{(showActivity ? "active" : "")}"
    };

    // کارت‌های آماری تب خلاصه — همان اعداد کارت قبلی، بدون هیچ محاسبهٔ تازه.
    var customerKpis = new List<AkKpiItem>
    {
        new() { Title = "مانده حساب", Value = NumberDisplay.Money(Math.Abs(bal)), Unit = "USD", Avatar = "receivables" },
        new() { Title = "کل فروش", Value = NumberDisplay.Money(Model.SoldValueUsd), Unit = "USD", Avatar = "sales-value" },
        new() { Title = "دریافت‌شده", Value = NumberDisplay.Money(Model.TotalReceivedUsd), Unit = "USD", Avatar = "receipts" }
    };

    // کارت وضعیت حساب تب خلاصه. درصد دریافت یک نسبت نمایشی از دو رقمِ بالاست
    // و هیچ مبلغی دوباره محاسبه نمی‌شود.
    int? customerReceivedShare = Model.SoldValueUsd > 0m
        ? (int)Math.Clamp(Math.Round(Model.TotalReceivedUsd / Model.SoldValueUsd * 100m, MidpointRounding.AwayFromZero), 0m, 100m)
        : null;

    var customerAccountCard = new AkPartyAccountCard
    {
        Meaning = balanceLabel,
        MeaningTone = balanceTone,
        SettledPercent = customerReceivedShare,
        SettledCaption = customerReceivedShare.HasValue
            ? $"{customerReceivedShare.Value:N0}٪ دریافت شده"
            : null,
        Facts = new List<AkInfoItem>
        {
            new() { Label = "فاکتور فعال", Value = activeSales.Count.ToString("N0"), IsNumeric = true },
            new() { Label = "کل فاکتورها", Value = Model.Sales.Count.ToString("N0"), IsNumeric = true },
            new() { Label = "قرارداد فروش", Value = Model.Contracts.Count.ToString("N0"), IsNumeric = true }
        },
        Identity = new List<AkInfoItem>
        {
            new() { Label = "کد", Value = string.IsNullOrWhiteSpace(Model.Code) ? notRecorded : Model.Code },
            new() { Label = "نام فارسی", Value = string.IsNullOrWhiteSpace(Model.NamePersian) ? notRecorded : Model.NamePersian },
            new() { Label = "کشور", Value = string.IsNullOrWhiteSpace(Model.Country) ? notRecorded : Model.Country },
            new() { Label = "طرف تماس", Value = string.IsNullOrWhiteSpace(Model.ContactPerson) ? notRecorded : Model.ContactPerson },
            new() { Label = "تلفن", Value = string.IsNullOrWhiteSpace(Model.Phone) ? notRecorded : Model.Phone },
            new() { Label = "آدرس", Value = string.IsNullOrWhiteSpace(Model.Address) ? notRecorded : Model.Address, IsWide = true },
            new() { Label = "یادداشت", Value = string.IsNullOrWhiteSpace(Model.Notes) ? notRecorded : Model.Notes, IsWide = true }
        }
    };
}

@section Styles {
    @* تب «صورت‌حساب» همان بدنهٔ صفحهٔ مستقل را رندر می‌کند، پس استایل صورت‌حساب اینجا هم لازم است. *@
    <link rel="stylesheet" href="~/css/ptg/62-party-statement.css" asp-append-version="true" data-ptg-page-asset="party-statement" />
}


<div class="ak-form-page ak-party-page ak-detail-page" dir="rtl" data-ak-detail-v2="true">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((Model.Name, false,
                       "ثبت دریافت", "bi-cash-coin", newPaymentUrl, (string?)null,
                       "فهرست مشتری‌ها", "bi-arrow-right", (string?)indexUrl))" />

    <partial name="~/Views/Shared/Partials/_DetailsTabs.cshtml" model="@("بخش‌های پروفایل مشتری", customerTabs)" />

    @* ===== تب خلاصه: کارت‌های آماری، بعد یک کارت واحدِ وضعیت حساب + هویت ===== *@
    <div class="ak-form-grid ak-overview-grid" hidden="@(!showOverview)">
        <partial name="~/Views/Shared/Partials/_DetailKpiStrip.cshtml" model="@((IReadOnlyList<AkKpiItem>)customerKpis)" />

        <partial name="~/Views/Shared/Components/Ak/_AkPartyAccountCard.cshtml" model="@customerAccountCard" />
    </div>

    @* ===== تب ۱: صورت‌حساب ===== *@
    <section id="customer-statement" class="ak-form-section ak-detail-section" hidden="@(!showStatement)">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("صورت‌حساب رسمی مشتری", "مانده، گردش و نرخ‌های تاریخی در سند مشترک محاسبه می‌شود."))" />
        @if (showStatement)
        {
            <div class="ak-party-statement-embed">
                <vc:party-statement party-type="@PTGOilSystem.Web.Models.PartyStatements.PartyStatementPartyType.Customer" party-id="@Model.CustomerId"></vc:party-statement>
            </div>
        }
    </section>
    @* ===== تب ۳: فروش‌ها و دریافت‌ها ===== *@
    <section id="customer-activity" class="ak-form-section ak-detail-section" hidden="@(!showActivity)">
        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("فاکتورهای فروش", $"{Model.Sales.Count:N0} فاکتور"))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th class="ak-col-actions no-print"><span class="visually-hidden">جزئیات</span></th>
                        <th class="ak-col-grow">قرارداد</th>
                        <th>محصول</th>
                        <th class="ak-col-num">تعداد حمل</th>
                        <th>بازهٔ تاریخ</th>
                        <th class="ak-col-num">مقدار MT</th>
                        <th class="ak-col-num">ارزش USD</th>
                        <th class="ak-col-num">دریافت USD</th>
                        <th class="ak-col-num">مانده USD</th>
                        <th>وضعیت</th>
                    </tr>
                </thead>
                <tbody>
                @for (var gi = 0; gi < saleGroupsShown.Count; gi++)
                {
                    var g = saleGroupsShown[gi];
                    var groupDetailId = $"customer-sale-group-{gi}";
                    var groupCancelled = g.ActiveCount == 0;
                    <tr class="@(groupCancelled ? "ak-row-muted" : "")">
                        <td class="ak-col-actions no-print">
                            <button type="button" class="ak-row-menu-btn" data-bs-toggle="collapse" data-bs-target="#@groupDetailId" aria-expanded="false" aria-controls="@groupDetailId" title="جزئیات">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </td>
                        <td class="ak-col-grow"><span class="ak-name">@(g.ContractNumber ?? "بدون قرارداد")</span></td>
                        <td>@g.Product</td>
                        <td class="ak-col-num ak-num">@g.Items.Count.ToString("N0")</td>
                        <td>@(g.FirstDate.Date == g.LastDate.Date ? g.LastDate.ToDisplayDate() : $"{g.FirstDate.ToDisplayDate()} – {g.LastDate.ToDisplayDate()}")</td>
                        <td class="ak-col-num ak-num">@NumberDisplay.Quantity(g.QuantityMt)</td>
                        <td class="ak-col-num ak-num">@g.TotalUsd.ToString("N2")</td>
                        <td class="ak-col-num ak-num">@g.ReceivedUsd.ToString("N2")</td>
                        <td class="ak-col-num ak-num">@g.ReceivableUsd.ToString("N2")</td>
                        <td><span class="ak-status @(groupCancelled ? "is-inactive" : g.ReceivableUsd <= 0 ? "" : "is-active")">@(groupCancelled ? "لغوشده" : g.ReceivableUsd <= 0 ? "تسویه" : "باز")</span></td>
                    </tr>
                    <tr class="collapse" id="@groupDetailId">
                        <td colspan="10">
                            <table class="ak-table ak-detail-table">
                                <thead>
                                    <tr>
                                        <th class="ak-col-grow">فاکتور</th>
                                        <th>واگن / موتر</th>
                                        <th>تاریخ</th>
                                        <th class="ak-col-num">مقدار MT</th>
                                        <th class="ak-col-num">ارزش USD</th>
                                        <th class="ak-col-num">دریافت USD</th>
                                        <th class="ak-col-num">مانده USD</th>
                                        <th>وضعیت</th>
                                    </tr>
                                </thead>
                                <tbody>
                                @foreach (var s in g.Items)
                                {
                                    <tr class="@(s.IsCancelled ? "ak-row-muted" : "")">
                                        <td class="ak-col-grow"><a class="ak-name" asp-controller="Sales" asp-action="Details" asp-route-id="@s.SaleId">@s.InvoiceNumber</a></td>
                                        <td>@(string.IsNullOrWhiteSpace(s.TransportReference) ? "-" : s.TransportReference)</td>
                                        <td>@s.SaleDate.ToDisplayDate()</td>
                                        <td class="ak-col-num ak-num">@NumberDisplay.Quantity(s.QuantityMt)</td>
                                        @if (s.IsSalePricePending && !s.IsCancelled)
                                        {
                                            @* قیمت باز: ارزش و مانده نامشخص است، نه صفر. *@
                                            <td class="ak-col-num">نامشخص</td>
                                            <td class="ak-col-num ak-num">@s.ReceivedUsd.ToString("N2")</td>
                                            <td class="ak-col-num">نامشخص</td>
                                            <td><span class="ak-status is-warning">در انتظار قیمت</span></td>
                                        }
                                        else
                                        {
                                            <td class="ak-col-num ak-num">@s.TotalUsd.ToString("N2")</td>
                                            <td class="ak-col-num ak-num">@s.ReceivedUsd.ToString("N2")</td>
                                            <td class="ak-col-num ak-num">@s.ReceivableUsd.ToString("N2")</td>
                                            <td><span class="ak-status @(s.IsCancelled ? "is-inactive" : s.ReceivableUsd <= 0 ? "" : "is-active")">@(s.IsCancelled ? "لغوشده" : s.ReceivableUsd <= 0 ? "تسویه" : "باز")</span></td>
                                        }
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </td>
                    </tr>
                }
                @if (!Model.Sales.Any())
                {
                    <tr><td colspan="10"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-receipt-cutoff"></i> فاکتور فروش ثبت نشده است.</div></td></tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="~/Views/Shared/Partials/_DetailMoreLink.cshtml" model="@(("customer-sales", saleGroupsShown.Count, saleGroups.Count))" />

        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("دریافت‌های تخصیص‌یافته به فروش", $"{allocatedPayments.Count:N0} مورد"))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th class="ak-col-grow">نوع</th>
                        <th>فاکتور فروش</th>
                        <th>حساب</th>
                        <th class="ak-col-num">مبلغ</th>
                        <th class="ak-col-num">معادل USD</th>
                        <th>مرجع</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in allocatedShown)
                {
                    <tr>
                        <td>@p.PaymentDate.ToDisplayDate()</td>
                        <td class="ak-col-grow">@p.PaymentKindName</td>
                        <td><a asp-controller="Sales" asp-action="Details" asp-route-id="@p.SaleId">@(p.InvoiceNumber ?? "-")</a></td>
                        <td>@p.CashAccount</td>
                        <td class="ak-col-num ak-num">@p.Amount.ToString("N2") @p.Currency</td>
                        <td class="ak-col-num ak-num">@p.AmountUsd.ToString("N2")</td>
                        <td><a asp-controller="Payments" asp-action="Details" asp-route-id="@p.PaymentId">@(p.Reference ?? $"#{p.PaymentId}")</a></td>
                    </tr>
                }
                @if (allocatedPayments.Count == 0)
                {
                    <tr><td colspan="7"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-link-45deg"></i> دریافت تخصیص‌یافته‌ای نیست.</div></td></tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="~/Views/Shared/Partials/_DetailMoreLink.cshtml" model="@(("customer-allocated", allocatedShown.Count, allocatedPayments.Count))" />

        <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("دریافت‌های تخصیص‌نشده / اعتبار آزاد", $"{unallocatedPayments.Count:N0} مورد"))" />
        <div class="ak-table-wrap">
            <table class="ak-table ak-detail-table">
                <thead>
                    <tr>
                        <th>تاریخ</th>
                        <th class="ak-col-grow">نوع</th>
                        <th>قرارداد</th>
                        <th>حساب</th>
                        <th class="ak-col-num">مبلغ</th>
                        <th class="ak-col-num">معادل USD</th>
                        <th>مرجع</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var p in unallocatedShown)
                {
                    <tr>
                        <td>@p.PaymentDate.ToDisplayDate()</td>
                        <td class="ak-col-grow">@p.PaymentKindName</td>
                        <td>@(p.ContractNumber ?? "-")</td>
                        <td>@p.CashAccount</td>
                        <td class="ak-col-num ak-num">@p.Amount.ToString("N2") @p.Currency</td>
                        <td class="ak-col-num ak-num">@p.AmountUsd.ToString("N2")</td>
                        <td><a asp-controller="Payments" asp-action="Details" asp-route-id="@p.PaymentId">@(p.Reference ?? $"#{p.PaymentId}")</a></td>
                    </tr>
                }
                @if (unallocatedPayments.Count == 0)
                {
                    <tr><td colspan="7"><div class="ak-empty ak-detail-empty-state"><i class="bi bi-wallet2"></i> اعتبار آزادی نیست.</div></td></tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="~/Views/Shared/Partials/_DetailMoreLink.cshtml" model="@(("customer-unallocated", unallocatedShown.Count, unallocatedPayments.Count))" />

        @if (Model.Contracts.Any())
        {
            <partial name="~/Views/Shared/Components/Ak/_AkSectionHead.cshtml" model="@(("قراردادهای فروش", $"{Model.Contracts.Count:N0} قرارداد"))" />
            <div class="ak-table-wrap">
                <table class="ak-table ak-detail-table">
                    <thead>
                        <tr>
                            <th class="ak-col-grow">قرارداد</th>
                            <th>محصول</th>
                            <th class="ak-col-num">تعهد MT</th>
                            <th class="ak-col-num">فروش MT</th>
                            <th class="ak-col-num">باقی‌مانده MT</th>
                            <th class="ak-col-num">ارزش باز USD</th>
                            <th>وضعیت</th>
                            <th class="ak-col-actions"></th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var c in customerContractsShown)
                    {
                        <tr>
                            <td class="ak-col-grow"><a class="ak-name" asp-controller="ContractJourney" asp-action="Details" asp-route-contractId="@c.ContractId" asp-route-returnUrl="@returnUrl">@c.ContractNumber</a></td>
                            <td>@c.Product</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Quantity(c.QuantityMt)</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Quantity(c.SoldQuantityMt)</td>
                            <td class="ak-col-num ak-num">@NumberDisplay.Quantity(c.RemainingQuantityMt)</td>
                            <td class="ak-col-num ak-num">@(c.EstimatedRemainingUsd?.ToString("N2") ?? "-")</td>
                            <td><span class="ak-status">@c.StatusName</span></td>
                            <td class="ak-col-actions"><a asp-controller="Sales" asp-action="Create" asp-route-contractId="@c.ContractId" asp-route-returnUrl="@returnUrl">ثبت فروش</a></td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
            <partial name="~/Views/Shared/Partials/_DetailMoreLink.cshtml" model="@(("customer-contracts", customerContractsShown.Count, Model.Contracts.Count))" />
        }
    </section>
</div>
