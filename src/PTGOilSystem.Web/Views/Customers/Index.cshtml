@using PTGOilSystem.Web.Models.Customers
@model IEnumerable<CustomerIndexItemViewModel>
@{
    ViewData["Title"] = UiText.T(Context,"مشتریان","Customers");
    var items = Model.ToList();
    var activeCount = items.Count(item => item.IsActive);
    var countryCount = items.Select(item => item.Country).Where(country => !string.IsNullOrWhiteSpace(country)).Distinct(StringComparer.OrdinalIgnoreCase).Count();
    var q = ViewData["q"]?.ToString();
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
}

<div class="ak-list-page">

    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "مشتریان", "Customers"), true,
                       UiText.T(Context, "مشتری جدید", "New customer"), "bi-plus-lg",
                       (string?)Url.Action("Create", new { returnUrl }), (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <section class="ak-stat-grid mb-3" aria-label="@UiText.T(Context, "آمار مشتریان", "Customer statistics")">
        @* Customer-specific illustrations. Given as paths rather than registry keys
           because "rules-checklist", "losses" and "locations" are shared with ~40
           other cards that must keep their own artwork. *@
        <vc:stat-card title="@UiText.T(Context, "کل مشتریان", "Total customers")" value="@items.Count.ToString("N0")" unit="@UiText.T(Context, "مشتری", "customers")" avatar-path="/images/stat-cards/ref-people/customers-portfolio.webp"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مشتریان فعال", "Active customers")" value="@activeCount.ToString("N0")" unit="@UiText.T(Context, "مشتری", "customers")" avatar-path="/images/stat-cards/ref-people/customers-agreement.webp"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مشتریان غیرفعال", "Inactive customers")" value="@((items.Count - activeCount).ToString("N0"))" unit="@UiText.T(Context, "مشتری", "customers")" avatar-path="/images/stat-cards/ref-people/customers-support.webp"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "کشورها", "Countries")" value="@countryCount.ToString("N0")" unit="@UiText.T(Context, "کشور", "countries")" avatar-path="/images/stat-cards/ref-people/customers-growth.webp"></vc:stat-card>
    </section>

    <partial name="~/Views/Shared/_AkSearchFilter.cshtml"
             model="@AkSearchFilterModel.SearchOnly("q", q, UiText.T(Context, "جستجو یا فیلتر نتایج...", "Search or filter results..."))" />

    <div class="d-flex justify-content-end mb-2 no-print">
        <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("Export"))" />
    </div>

    <div class="ak-list">
        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-check"><input type="checkbox" class="ak-check" aria-label="@UiText.T(Context, "انتخاب همه", "Select all")" /></th>
                        <th class="ak-col-grow">@UiText.T(Context, "نام", "Name")</th>
                        <th>@UiText.T(Context, "کشور", "Country")</th>
                        <th class="ak-col-num">@UiText.T(Context, "مانده حساب (USD)", "Balance (USD)")</th>
                        <th>@UiText.T(Context, "تلفن", "Phone")</th>
                        <th class="ak-col-spacer"></th>
                        <th>@UiText.T(Context, "وضعیت", "Status")</th>
                        <th class="ak-col-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in items)
                    {
                        <tr data-href="@Url.Action("Details", new { id = p.Id })">
                            <td class="ak-col-check"><input type="checkbox" class="ak-check" aria-label="@UiText.T(Context, "انتخاب", "Select")" /></td>
                            <td class="ak-col-grow"><partial name="~/Views/Shared/Partials/_PersonCell.cshtml" model="@((p.Name, (string?)Url.Action("Details", new { id = p.Id }), (string?)null))" /></td>
                            <td>@(string.IsNullOrWhiteSpace(p.Country) ? "-" : p.Country)</td>
                            <td class="ak-col-num ak-num @(p.BalanceUsd < 0m ? "ak-number--negative" : null)">@p.BalanceUsd.ToString("N2")</td>
                            <td class="ak-num">@(string.IsNullOrWhiteSpace(p.Phone) ? "-" : p.Phone)</td>
                            <td class="ak-col-spacer"></td>
                            <td>
                                <span class="ak-status @(p.IsActive ?"is-active" : "is-inactive")">
                                    @(p.IsActive ? UiText.T(Context, "فعال", "Active") : UiText.T(Context, "غیرفعال", "Inactive"))
                                </span>
                            </td>
                            <td class="ak-col-actions">
                                <div class="dropdown ak-row-menu">
                                    <button type="button" class="ak-row-menu-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@UiText.T(Context, "عملیات", "Actions")">
                                        <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@p.Id"><i class="bi bi-eye" aria-hidden="true"></i>@UiText.T(Context, "جزئیات", "Details")</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@p.Id"><i class="bi bi-pencil" aria-hidden="true"></i>@UiText.T(Context, "ویرایش", "Edit")</a></li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li><partial name="~/Views/Shared/Partials/_ToggleActiveButton.cshtml" model="@(("Customers", p.Id, p.IsActive, "dropdown-item ak-danger", (string?)returnUrl))" /></li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!items.Any())
                    {
                        <tr>
                            <td colspan="8">
                                <partial name="~/Views/Shared/_GuidedEmptyState.cshtml"
                                         model="@(("bi-people",
                                                   UiText.T(Context, "هنوز مشتری‌ای ثبت نشده است.", "No customer yet."),
                                                   UiText.T(Context, "مشتری‌ای برای نمایش پیدا نشد", "No customers found"),
                                                   (string?)UiText.T(Context, "کسی که به او جنس می‌فروشید را ثبت کنید.", "Add someone you sell to."),
                                                   (string?)UiText.T(Context, "ثبت اولین مشتری", "Add first customer"),
                                                   (string?)Url.Action("Create", new { returnUrl })))" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @{ ViewData["ShownCount"] = items.Count; }
        <div class="ak-pager">
            @await Html.PartialAsync("_PagedListFooter")
        </div>
    </div>
</div>
