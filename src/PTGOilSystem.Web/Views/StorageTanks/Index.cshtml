@model PTGOilSystem.Web.Models.StorageTanks.StorageTankIndexViewModel
@{
    ViewData["Title"] = "مخازن ذخیره";
    ViewData["StorageTanksAssets"] = true;
    var returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}";
    var hasFilters = Model.TerminalId.Count > 0 || Model.ProductId.Count > 0 || Model.IsActive.HasValue;
    var hasSearch = !string.IsNullOrWhiteSpace(Model.Query) || hasFilters;

    string FormatQuantity(decimal value)
    {
        var rounded = Math.Round(value, 2);
        if (rounded == decimal.Truncate(rounded)) return rounded.ToString("N0");
        if (rounded * 10m == decimal.Truncate(rounded * 10m)) return rounded.ToString("N1");
        return rounded.ToString("N2");
    }
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "مخازن ذخیره", "Storage Tanks"), true,
                       UiText.T(Context, "مخزن جدید", "New tank"), "bi-plus-lg",
                       (string?)Url.Action("Create", new { returnUrl }), (string?)null,
                       (string?)null, (string?)null, (string?)null))" />

    <section class="ak-stat-grid mb-3" aria-label="@UiText.T(Context, "آمار مخازن", "Storage tank statistics")">
        <vc:stat-card title="@UiText.T(Context, "کل مخازن", "Total tanks")" value="@Model.TotalTanks.ToString("N0")" unit="@UiText.T(Context, "مخزن", "tanks")" avatar="storage-tanks"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "مخازن فعال", "Active tanks")" value="@Model.ActiveTanks.ToString("N0")" unit="@UiText.T(Context, "مخزن", "tanks")" avatar="rules-checklist"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "ظرفیت کل", "Total capacity")" value="@FormatQuantity(Model.TotalCapacityMt)" unit="MT" avatar="tank-farm"></vc:stat-card>
        <vc:stat-card title="@UiText.T(Context, "موجودی ملکی", "Owned stock")" value="@FormatQuantity(Model.TotalCurrentQuantityMt)" unit="MT" avatar="total-inventory"></vc:stat-card>
    </section>

    @{
        var tankTerminalOptions = (ViewBag.Terminals as Microsoft.AspNetCore.Mvc.Rendering.SelectList ??
                Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
            .Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
        var tankProductOptions = (ViewBag.Products as Microsoft.AspNetCore.Mvc.Rendering.SelectList ??
                Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
            .Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
        var tankIsActive = Model.IsActive.HasValue ? (Model.IsActive.Value ? "true" : "false") : null;
        var storageTanksFilter = new AkSearchFilterModel(
            "q", Model.Query,
            UiText.T(Context, "جستجو در مخازن...", "Search tanks..."),
            new List<AkFilterDefinition>
            {
                AkFilterDefinition.MultiSelect("terminalId", UiText.T(Context, "ترمینال", "Terminal"),
                    tankTerminalOptions, Model.TerminalId),
                AkFilterDefinition.MultiSelect("productId", UiText.T(Context, "نوع جنس", "Product"),
                    tankProductOptions, Model.ProductId),
                new("isActive", UiText.T(Context, "وضعیت", "Status"), "bool",
                    new List<AkFilterOption>
                    {
                        new("true", UiText.T(Context, "فعال", "Active")),
                        new("false", UiText.T(Context, "غیرفعال", "Inactive"))
                    }, tankIsActive)
            });
    }
    <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="storageTanksFilter" />

    <div class="ak-list">
        <div class="storage-tank-grid">
            @foreach (var item in Model.Items)
            {
                var percent = Math.Max(0m, Math.Min(100m, item.FillPercent));
                var unitText = string.IsNullOrWhiteSpace(item.UnitOfMeasure) ? "MT" : item.UnitOfMeasure.Trim();
                // Liquid level drawn over the tank photo. The constants below are the
                // shell interior measured on images/storage-tank-card.webp (1254x1254):
                // side walls, the front floor line and the ellipse the cylinder shows
                // at that camera angle. Level rides between the floor and the shoulder.
                const decimal tankFloorY = 1000m;
                const decimal tankShoulderY = 290m;
                var levelY = tankFloorY - (tankFloorY - tankShoulderY) * percent / 100m;
                var levelYText = Math.Round(levelY, 1).ToString(System.Globalization.CultureInfo.InvariantCulture);
                <article class="storage-tank-card @(item.IsActive ? "is-normal" : "is-muted")">
                    <a class="storage-tank-card-main" asp-action="Details" asp-route-id="@item.Id">
                        <span class="storage-tank-visual">
                            <img class="storage-tank-image" src="~/images/storage-tank-card.webp" asp-append-version="true" alt="" aria-hidden="true" width="250" height="220" loading="lazy" decoding="async" />
                            @if (percent > 0m)
                            {
                                <svg class="storage-tank-level" viewBox="0 0 1254 1254" preserveAspectRatio="xMidYMid meet" aria-hidden="true" focusable="false">
                                    <g class="storage-tank-level-body">
                                        <path d="M238 @levelYText H1022 V1000 A392 45 0 0 1 238 1000 Z" />
                                        <ellipse cx="630" cy="@levelYText" rx="392" ry="45" />
                                    </g>
                                    <path class="storage-tank-level-gloss" d="M238 @levelYText A392 45 0 0 1 1022 @levelYText" />
                                </svg>
                            }
                        </span>
                        <span class="storage-tank-card-body">
                            <span class="storage-tank-card-head">
                                <span class="ak-name">@item.DisplayName</span>
                                <span class="ak-status @(item.IsActive ? "is-active" : "is-inactive")">
                                    @(item.IsActive ? UiText.T(Context, "فعال", "Active") : UiText.T(Context, "غیرفعال", "Inactive"))
                                </span>
                            </span>
                            <span class="storage-tank-card-facts">
                                <span class="storage-tank-fact">
                                    <span class="storage-tank-fact-label">@UiText.T(Context, "موجودی فعلی", "Current stock")</span>
                                    <span class="storage-tank-fact-value ak-num"><bdi>@FormatQuantity(item.CurrentQuantityMt) @unitText</bdi></span>
                                    <small class="text-muted">امانی: @FormatQuantity(item.CustodyQuantityMt) · مجموع فزیکی: @FormatQuantity(item.PhysicalQuantityMt) @unitText</small>
                                </span>
                                <span class="storage-tank-fact">
                                    <span class="storage-tank-fact-label">@UiText.T(Context, "فیصدی پرشدن", "Fill percentage")</span>
                                    <span class="storage-tank-fact-value ak-num"><bdi>@percent.ToString("N0")%</bdi></span>
                                </span>
                            </span>
                        </span>
                    </a>
                    <div class="storage-tank-card-actions">
                        <span class="ak-muted">@UiText.T(Context, "قراردادها", "Contracts"): <bdi>@item.ContractCount.ToString("N0")</bdi></span>
                        <div class="dropdown ak-row-menu">
                            <button type="button" class="ak-row-menu-btn" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@UiText.T(Context, "عملیات", "Actions")">
                                <i class="bi bi-three-dots-vertical" aria-hidden="true"></i>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li><a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye" aria-hidden="true"></i>@UiText.T(Context, "جزئیات", "Details")</a></li>
                                <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-pencil" aria-hidden="true"></i>@UiText.T(Context, "ویرایش مخزن", "Edit tank")</a></li>
                                @if (item.ContractCount > 0)
                                {
                                    <li><a class="dropdown-item" asp-action="SettleFinal" asp-route-id="@item.Id"><i class="bi bi-cash-coin" aria-hidden="true"></i>@UiText.T(Context, "تسویه نهایی مخزن", "Final tank settlement")</a></li>
                                }
                            </ul>
                        </div>
                    </div>
                </article>
            }
        </div>

        @if (!Model.Items.Any())
        {
            <div class="ak-empty"><i class="bi bi-bounding-box" aria-hidden="true"></i>@UiText.T(Context, "مخازنی یافت نشد", "No tanks found")</div>
        }

        <div class="ak-pager">@await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))</div>
    </div>
</div>
