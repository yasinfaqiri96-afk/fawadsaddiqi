@model PTGOilSystem.Web.Models.Inventory.InventoryStockCardViewModel
@using PTGOilSystem.Web.Models.Entities
@{
    ViewData["Title"] = "کارت موجودی";
}

<div class="ak-form-page">
    <div class="ak-page-header">
        <div class="ak-page-heading">
<h1 class="ak-page-title">کارت موجودی</h1>
            <p class="ak-note">تاریخچه حرکت‌ها همراه با اثر هر سند موجودی روی موجودی تجمعی همان محدوده.</p>
        </div>
        <div class="ak-page-actions compact-toolbar no-print">
            <a asp-action="Create" class="btn ak-primary-action"><i class="bi bi-plus-lg me-1"></i> ثبت حرکت جدید</a>
        </div>
    </div>

    @* خطای بازهٔ تاریخ نامعتبر از کنترلر می‌آید و باید بالای نوار فیلتر دیده شود. *@
    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-0"></div>

    @{
        List<AkFilterOption> StockCardOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
            ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
            .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
        var stockCardFilter = new AkSearchFilterModel("", null,
            UiText.T(Context, "فیلتر کارت موجودی...", "Filter stock card..."),
            new List<AkFilterDefinition>
            {
                new("Filter.FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                    Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "Filter.ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                new("Filter.ProductId", UiText.T(Context, "جنس", "Product"), "select", StockCardOpts(ViewBag.Products),
                    Model.Filter.ProductId?.ToString()),
                new("Filter.ContractId", UiText.T(Context, "قرارداد منبع موجودی", "Stock source contract"), "select", StockCardOpts(ViewBag.Contracts),
                    Model.Filter.ContractId?.ToString()),
                new("Filter.TerminalId", UiText.T(Context, "ترمینال", "Terminal"), "select", StockCardOpts(ViewBag.Terminals),
                    Model.Filter.TerminalId?.ToString())
            });
    }
    <div class="ak-list-toolbar">
        <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="stockCardFilter" />
        <div class="ak-list-toolbar-actions">
            <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("StockCardExport"))" />
        </div>
    </div>

    <div class="ak-table-wrap">
        <div class="ak-table-wrap">
            <table class="ak-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>@UiText.T(Context,"تاریخ","Date")</th>
                        <th>@UiText.T(Context,"نوع حرکت","Movement Type")</th>
                        <th>@UiText.T(Context,"جنس","Product")</th>
                        <th>@UiText.T(Context,"ترمینال","Terminal")</th>
                        <th>قرارداد خرید منبع موجودی</th>
                        <th>مخزن</th>
                        <th class="text-end">مقدار</th>
                        <th class="text-end">اثر روی موجودی</th>
                        <th class="text-end">باقی موجودی</th>
                        <th>@UiText.T(Context,"شماره سند","Reference")</th>
                        <th>دلیل و یادداشت</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>@row.MovementDate.ToDisplayDate()</td>
                            <td>
                                @switch (row.Direction)
                                {
                                    case MovementDirection.In: <span class="ak-status is-active">ورود</span> break;
                                    case MovementDirection.Out: <span class="ak-status is-inactive">خروج</span> break;
                                    case MovementDirection.Transfer: <span class="ak-status is-pending">انتقال</span> break;
                                    case MovementDirection.Adjustment: <span class="ak-status is-pending">اصلاح موجودی</span> break;
                                }
                            </td>
                            <td>@row.ProductName</td>
                            <td>@row.TerminalName</td>
                            <td>@(row.ContractNumber ?? "-")</td>
                            <td>@(row.StorageTankCode ?? "-")</td>
                            <td class="text-end">@NumberDisplay.Quantity(row.QuantityMt)</td>
                            <td class="text-end @(row.SignedQuantityMt < 0 ?"text-danger" : "text-success")">@NumberDisplay.Quantity(row.SignedQuantityMt)</td>
                            <td class="text-end fw-semibold">@NumberDisplay.Quantity(row.RunningBalanceMt)</td>
                            <td>@(row.ReferenceDocument ?? "-")</td>
                            <td class="ak-col-grow">@(row.Notes ?? "—")</td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="11">
                                @await Html.PartialAsync("_EmptyState", ("حرکتی برای فیلتر انتخابی یافت نشد", "بازه یا محدوده فیلتر را تغییر دهید و دوباره تلاش کنید.", "bi-funnel"))
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @await Html.PartialAsync("_Pagination", (Model.CurrentPage, Model.PageCount))
</div>
