@model PTGOilSystem.Web.Models.Inventory.InventoryMovementCreateViewModel
@using PTGOilSystem.Web.Models.Entities
@{
    ViewData["Title"] = "ثبت حرکت موجودی";
}

<div class="ak-form-page">
    <partial name="Components/Ak/_AkPageHeader"
             model='(("ثبت حرکت موجودی", false, (string?)null, (string?)null, (string?)null, (string?)null, "برگشت", "bi-arrow-right", Url.Action("Index")))' />

    <form asp-action="Create" method="post" class="ak-form">
        @Html.AntiForgeryToken()
        @Html.FormToken()
        <div asp-validation-summary="ModelOnly" class="ak-form-alert text-danger"></div>

        <section class="ak-form-section">
            <partial name="Components/Ak/_AkSectionHead"
                     model='(("جنس و محل نگهداری", "جنس، قرارداد منبع و محل ثبت حرکت را مشخص کنید."))' />
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="ProductId" class="ak-label"></label>
                    <select asp-for="ProductId" asp-items="ViewBag.Products" class="ak-input">
                        <option value="">انتخاب جنس</option>
                    </select>
                    <span asp-validation-for="ProductId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="ContractId" class="ak-label"></label>
                    <select asp-for="ContractId" asp-items="ViewBag.Contracts" class="ak-input">
                        <option value="">بدون قرارداد منبع</option>
                    </select>
                    <span asp-validation-for="ContractId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="TerminalId" class="ak-label"></label>
                    <select asp-for="TerminalId" asp-items="ViewBag.Terminals" class="ak-input">
                        <option value="">انتخاب ترمینال</option>
                    </select>
                    <span asp-validation-for="TerminalId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="StorageTankId" class="ak-label"></label>
                    <select asp-for="StorageTankId" asp-items="ViewBag.StorageTanks" class="ak-input">
                        <option value="">بدون مخزن</option>
                    </select>
                    <span asp-validation-for="StorageTankId" class="ak-field-error"></span>
                </div>
            </div>
        </section>

        <section class="ak-form-section">
            <partial name="Components/Ak/_AkSectionHead"
                     model='(("مشخصات حرکت", "نوع حرکت، مقدار و تاریخ سند را وارد کنید."))' />
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="Direction" class="ak-label"></label>
                    <select asp-for="Direction" class="ak-input">
                        <option value="@((int)MovementDirection.In)">ورود (+)</option>
                        <option value="@((int)MovementDirection.Out)">خروج (-)</option>
                        <option value="@((int)MovementDirection.Adjustment)">اصلاح موجودی</option>
                        <option value="@((int)MovementDirection.Transfer)">انتقال به محل دیگر</option>
                    </select>
                </div>
                <div class="ak-field">
                    <label asp-for="QuantityMt" class="ak-label"></label>
                    <input asp-for="QuantityMt" class="ak-input" placeholder="0.0000" />
                    <span asp-validation-for="QuantityMt" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="MovementDate" class="ak-label"></label>
                    <input asp-for="MovementDate" class="ak-input" type="date" />
                    <span asp-validation-for="MovementDate" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="ReferenceDocument" class="ak-label"></label>
                    <input asp-for="ReferenceDocument" class="ak-input" placeholder="شماره سند، بارنامه یا حواله" />
                </div>
                <div class="ak-field ak-col-full">
                    <label asp-for="Notes" class="ak-label"></label>
                    <textarea asp-for="Notes" rows="4" class="ak-input" placeholder="یادداشت اختیاری"></textarea>
                </div>
            </div>
        </section>

        <section class="ak-form-section">
            <partial name="Components/Ak/_AkSectionHead"
                     model='(("انتقال یا اصلاح موجودی", "برای انتقال، مقصد را انتخاب کنید. برای اصلاح، اضافه‌شدن یا کم‌شدن را مشخص کنید. دلیل هر دو الزامی است."))' />
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="DestinationTerminalId" class="ak-label"></label>
                    <select asp-for="DestinationTerminalId" asp-items="ViewBag.DestinationTerminals" class="ak-input">
                        <option value="">انتخاب مقصد انتقال</option>
                    </select>
                    <span asp-validation-for="DestinationTerminalId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="DestinationStorageTankId" class="ak-label"></label>
                    <select asp-for="DestinationStorageTankId" asp-items="ViewBag.DestinationStorageTanks" class="ak-input">
                        <option value="">بدون مخزن</option>
                    </select>
                    <span asp-validation-for="DestinationStorageTankId" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="NegativeAdjustment" class="ak-label"></label>
                    <select asp-for="NegativeAdjustment" class="ak-input">
                        <option value="false">اضافه‌شدن موجودی</option>
                        <option value="true">کم‌شدن موجودی</option>
                    </select>
                </div>
                <div class="ak-field">
                    <label asp-for="Reason" class="ak-label"></label>
                    <textarea asp-for="Reason" class="ak-input" rows="2" maxlength="700"></textarea>
                    <span asp-validation-for="Reason" class="ak-field-error"></span>
                </div>
            </div>
            <p class="ak-note">انتقال برای تیلی است که به مقصد رسیده است؛ برای بار در راه از بخش «حمل‌ها» استفاده کنید.</p>
        </section>

        <details class="ak-form-section">
            <summary>معلومات حسابداری</summary>
            <p class="ak-note">اگر دفتر کل فعال باشد، ارزش ورودی و حساب مقابل لازم است. ارزش خروج و انتقال از حسابداری موجودی خوانده می‌شود.</p>
            <div class="ak-form-grid">
                <div class="ak-field">
                    <label asp-for="ValueUsd" class="ak-label"></label>
                    <input asp-for="ValueUsd" class="ak-input" type="number" min="0.0001" step="0.0001" />
                    <span asp-validation-for="ValueUsd" class="ak-field-error"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="OffsetAccountId" class="ak-label"></label>
                    <select asp-for="OffsetAccountId" asp-items="ViewBag.Accounts" class="ak-input">
                        <option value="">انتخاب حساب</option>
                    </select>
                    <span asp-validation-for="OffsetAccountId" class="ak-field-error"></span>
                </div>
            </div>
        </details>

        <partial name="Components/Ak/_AkFooterActions"
                 model='(("ثبت حرکت موجودی", Url.Action("Index")!, "لغو"))' />
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
