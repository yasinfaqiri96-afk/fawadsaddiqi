@model PTGOilSystem.Web.Models.Dispatch.DispatchDirectFromReceiptSaleCreateViewModel
@{
    ViewData["Title"] = "ثبت فروش از ارسال با موتر";
    ViewData["HideSectionTabs"] = true;
}

<div class="page-stack ak-form-page">
    <div class="ak-page-header ">
        <div class="ak-page-header-main">
<h1 class="ak-page-title">ثبت فروش از ارسال با موتر</h1>
            <p class="page-subtitle">این فروش اختیاری فقط SalesTransaction و Ledger می‌سازد. InventoryMovement جدید نمی‌سازد و StockService را صدا نمی‌زند.</p>
        </div>
        <div class="ak-page-actions ak-page-actions">
            <a asp-action="Details" asp-route-id="@Model.TruckDispatchId" class="btn btn-light ak-secondary-action">@UiText.T(Context,"بازگشت","Back")</a>
        </div>
    </div>

    <div class="warning-note">
        <i class="bi bi-info-circle"></i>
        <div>فروش برای ارسال با موتر اختیاری است. اگر این ارسال فقط انتقال/تحویل است، بدون فروش بگذارید؛ درآمد و Ledger ساخته نمی‌شود.</div>
    </div>

    <form asp-action="CreateSaleFromDirectDispatch" method="post" class="ak-form">
        <div class="ak-section-head">Sale Information</div>
        <div class="ak-section-body">
            <div asp-validation-summary="All" class="text-danger mb-3"></div>
            <input type="hidden" asp-for="TruckDispatchId" />
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="summary-strip mb-3 ak-summary">
                <div class="summary-tile"><div class="summary-tile-label">ارسال با موتر</div><div class="summary-tile-value">#@Model.TruckDispatchId</div></div>
                <div class="summary-tile"><div class="summary-tile-label">Contract</div><div class="summary-tile-value">@Model.ContractNumber</div></div>
                <div class="summary-tile"><div class="summary-tile-label">Product</div><div class="summary-tile-value">@Model.ProductName</div></div>
                <div class="summary-tile"><div class="summary-tile-label">Truck</div><div class="summary-tile-value">@Model.TruckPlateNumber</div></div>
                <div class="summary-tile"><div class="summary-tile-label">مقدار بارگیری MT</div><div class="summary-tile-value">@NumberDisplay.Quantity(Model.DispatchLoadedQuantityMt)</div></div>
                @if (Model.DispatchDischargedQuantityMt.HasValue)
                {
                    <div class="summary-tile"><div class="summary-tile-label">مقدار تخلیه MT</div><div class="summary-tile-value">@NumberDisplay.Quantity(Model.DispatchDischargedQuantityMt.Value)</div></div>
                }
                @if (Model.DispatchSurplusMt > 0m)
                {
                    <div class="summary-tile"><div class="summary-tile-label">اضافه‌بار MT</div><div class="summary-tile-value finance-positive">@NumberDisplay.Quantity(Model.DispatchSurplusMt)</div></div>
                }
                @if (Model.DispatchAlreadySoldQuantityMt > 0m)
                {
                    <div class="summary-tile"><div class="summary-tile-label">فروش‌شده قبلی MT</div><div class="summary-tile-value">@NumberDisplay.Quantity(Model.DispatchAlreadySoldQuantityMt)</div></div>
                    <div class="summary-tile"><div class="summary-tile-label">باقی‌مانده MT</div><div class="summary-tile-value">@NumberDisplay.Quantity(Model.DispatchRemainingQuantityMt)</div></div>
                }
            </div>

            @if (Model.DispatchSurplusMt > 0m)
            {
                <div class="warning-note">
                    <i class="bi bi-arrow-up-circle"></i>
                    <div>
                        این موتر @NumberDisplay.Quantity(Model.DispatchSurplusMt) MT بیشتر از وزن بارگیری تخلیه کرده است.
                        فروش روی مقدار واقعیِ تخلیه‌شده ثبت می‌شود و اثر حساب خریدار هم بر همان مقدار محاسبه می‌گردد.
                        برای این اضافه‌بار هیچ قیمت خریدی ساخته نمی‌شود.
                    </div>
                </div>
            }

            <div class="ak-form-grid g-3">
                <div class="ak-field">
                    <label asp-for="BuyerKey" class="ak-label"></label>
                    <select asp-for="BuyerKey" asp-items="ViewBag.Buyers" class="ak-input">
                        <option value="">Select buyer</option>
                    </select>
                    <span asp-validation-for="BuyerKey" class="text-danger"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="SaleDate" class="ak-label"></label>
                    <input asp-for="SaleDate" class="ak-input" type="date" />
                    <span asp-validation-for="SaleDate" class="text-danger"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="InvoiceNumber" class="ak-label"></label>
                    <input asp-for="InvoiceNumber" class="ak-input" />
                    <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="QuantityMt" class="ak-label"></label>
                    <input asp-for="QuantityMt" class="ak-input" type="number" step="0.0001" min="0.0001" max="@Model.DispatchRemainingQuantityMt" />
                    <span asp-validation-for="QuantityMt" class="text-danger"></span>
                    <div class="ak-section-desc">
                        مبنای فروش، مقدار واقعیِ تخلیه‌شدهٔ موتر است (@NumberDisplay.Quantity(Model.DispatchSellableQuantityMt) MT).
                        فروش قسمتی مجاز است و باقی‌ماندهٔ قابل فروش @NumberDisplay.Quantity(Model.DispatchRemainingQuantityMt) MT می‌باشد.
                    </div>
                </div>
                <div class="ak-field">
                    <label asp-for="Currency" class="ak-label"></label>
                    <select asp-for="Currency" asp-items="ViewBag.Currencies" class="ak-input">
                        <option value="USD">USD</option>
                    </select>
                    <span asp-validation-for="Currency" class="text-danger"></span>
                </div>
                <div class="ak-field">
                    <label asp-for="UnitPriceInCurrency" class="ak-label"></label>
                    <input asp-for="UnitPriceInCurrency" class="ak-input" data-sale-price-pending-target />
                    <span asp-validation-for="UnitPriceInCurrency" class="text-danger"></span>
                </div>
                @* فروش با قیمت باز: بار ثبت می‌شود؛ قیمت بعداً از صفحهٔ همان فروش تعیین می‌شود. *@
                <div class="ak-field ak-col-full">
                    <div class="form-check">
                        <input asp-for="IsSalePricePending" class="form-check-input" type="checkbox" data-sale-price-pending-toggle />
                        <label asp-for="IsSalePricePending" class="form-check-label">@UiText.T(Context, "قیمت فروش هنوز مشخص نیست", "Sale price not yet known")</label>
                    </div>
                    <div class="form-text" data-sale-price-pending-hint hidden>@UiText.T(Context, "بار و موجودی همین حالا ثبت می‌شود؛ طلب مشتری، عاید و مفاد پس از تعیین قیمت از صفحهٔ همین فروش ثبت می‌شود.", "Delivery is recorded now; receivable, revenue and profit are posted once the price is set from the sale page.")</div>
                </div>
                <div class="ak-field" data-fx-rate-group data-fx-currency-source="#Currency">
                    <div data-fx-rate-field>
                        <label class="ak-label">نرخ دالر به <span data-fx-currency-name>ارز</span></label>
                        <input type="text" inputmode="decimal" class="ak-input" data-fx-rate-input
                               id="dispatchSaleFxDisplay" placeholder="مثال: ۷۷ یعنی ۱ دالر = ۷۷ روبل" autocomplete="off" data-sale-price-pending-target />
                        <input asp-for="AppliedFxRateToUsd" type="hidden" data-fx-rate-technical data-sale-price-pending-target />
                        <small class="ak-section-desc text-muted">۱ دالر = چند واحد ارز سند؟</small>
                        <span asp-validation-for="AppliedFxRateToUsd" class="text-danger"></span>
                    </div>
                    <div data-fx-usd-note class="d-none">
                        <small class="ak-section-desc text-muted"><i class="bi bi-info-circle"></i> پرداخت دالری است؛ نرخ تبدیل لازم نیست.</small>
                    </div>
                </div>
                <div class="ak-field">
                    <label asp-for="Notes" class="ak-label"></label>
                    <textarea asp-for="Notes" class="ak-input" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>
            </div>
        </div>
        <div class="ak-footer-actions d-flex gap-2 justify-content-end">
            <a asp-action="Details" asp-route-id="@Model.TruckDispatchId" class="btn btn-light ak-secondary-action">@UiText.T(Context,"لغو","Cancel")</a>
            <button type="submit" class="btn btn-success ak-primary-action">Create Sale</button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/fx-rate-field.js" asp-append-version="true" defer></script>
    <script src="~/js/sale-price-pending.js" asp-append-version="true" defer></script>
}
