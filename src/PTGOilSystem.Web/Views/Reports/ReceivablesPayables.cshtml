@model PTGOilSystem.Web.Models.Reports.ReceivablesPayablesReportViewModel
@{
    ViewData["Title"] = UiText.T(Context, "طلبات و بدهی‌ها", "Receivables & Payables");
}

<div class="ak-list-page">
    <partial name="~/Views/Shared/Components/Ak/_AkPageHeader.cshtml"
             model="@((UiText.T(Context, "طلبات و بدهی‌ها", "Receivables & Payables"), false,
                       (string?)null, (string?)null, (string?)null, (string?)null,
                       UiText.T(Context, "گزارش‌ها", "Reports"), "bi-arrow-right", Url.Action("Index")))" />

    <section class="ak-stat-grid" aria-label="@UiText.T(Context, "آمار طلبات و بدهی‌ها", "Receivable and payable metrics")">
            @foreach (var metric in Model.Metrics.Take(4))
            {
                @await Html.PartialAsync("_ReferenceMetricCard", ("", metric.Icon, metric.Label, metric.Value, metric.Detail ?? "", metric.ToneClass))
            }
    </section>

    <div class="ak-list">
        @{
            List<AkFilterOption> BalanceOpts(object? s) => (s as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>())
                .Where(i => !string.IsNullOrEmpty(i.Value)).Select(i => new AkFilterOption(i.Value, i.Text)).ToList();
            var balanceFilter = new AkSearchFilterModel("", null,
                UiText.T(Context, "فیلتر طلبات و بدهی‌ها...", "Filter receivables and payables..."),
                new List<AkFilterDefinition>
                {
                    new("FromDate", UiText.T(Context, "بازه تاریخ", "Date range"), "daterange", null,
                        Model.Filter.FromDate?.ToString("yyyy-MM-dd"), "ToDate", Model.Filter.ToDate?.ToString("yyyy-MM-dd")),
                    new("ContractId", UiText.T(Context, "قرارداد", "Contract"), "select", BalanceOpts(ViewBag.Contracts),
                        Model.Filter.ContractId?.ToString()),
                    new("CustomerId", UiText.T(Context, "مشتری", "Customer"), "select", BalanceOpts(ViewBag.Customers),
                        Model.Filter.CustomerId?.ToString()),
                    new("SupplierId", UiText.T(Context, "تأمین‌کننده", "Supplier"), "select", BalanceOpts(ViewBag.Suppliers),
                        Model.Filter.SupplierId?.ToString())
                });
        }
        <div class="ak-list-toolbar">
            <partial name="~/Views/Shared/_AkSearchFilter.cshtml" model="balanceFilter" />
            <div class="ak-list-toolbar-actions">
                <partial name="~/Views/Shared/_ExportMenu.cshtml" model="@(new PTGOilSystem.Web.Services.Exports.ExportMenuModel("ReceivablesPayablesExport"))" />
            </div>
        </div>

        <div class="ak-table-wrap">
            <table class="ak-table">
                <thead>
                    <tr>
                        <th class="ak-col-grow">@UiText.T(Context, "طرف حساب", "Party")</th>
                        <th>@UiText.T(Context, "نوع", "Type")</th>
                        <th>@UiText.T(Context, "وضعیت", "Standing")</th>
                        <th class="ak-col-num">@UiText.T(Context, "اول دوره", "Opening")</th>
                        <th class="ak-col-num">@UiText.T(Context, "رسید", "Received")</th>
                        <th class="ak-col-num">@UiText.T(Context, "برد", "Given")</th>
                        <th class="ak-col-num">@UiText.T(Context, "گردش این بازه", "Movement in range")</th>
                        <th>@UiText.T(Context, "آخرین تاریخ", "Last Date")</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td class="ak-col-grow">@row.PartyName</td>
                            <td>@row.PartyType</td>
                            <td>@row.BalanceKind</td>
                            <td class="ak-col-num ak-num">@row.OpeningBalanceUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@row.DebitUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num">@row.CreditUsd.ToString("N2")</td>
                            <td class="ak-col-num ak-num @(row.PeriodMovementUsd < 0m ? "ak-number--negative" : row.PeriodMovementUsd > 0m ? "ak-number--positive" : null)">@row.PeriodMovementUsd.ToString("N2")</td>
                            <td>@(row.LastEntryDate?.ToDisplayDate() ?? "-")</td>
                        </tr>
                    }
                    @if (!Model.Rows.Any())
                    {
                        <tr><td colspan="8"><div class="ak-empty"><i class="bi bi-people"></i> @UiText.T(Context, "مانده‌ای پیدا نشد؛ فیلترها را تغییر دهید.", "No balance found; change the filters.")</div></td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
